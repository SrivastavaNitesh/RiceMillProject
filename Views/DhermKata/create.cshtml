@model RiceMillProject.Models.DhermKata
@{
    ViewData["Title"] = "Add Weighbridge";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-speedometer2"></i>
        </div>
        <div>
            <h3 class="erp-page-title">ADD NEW WEIGHBRIDGE / DHERMKATA</h3>
            <p class="erp-page-subtitle">Configure weighbridge terminal and link to company location</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Weighbridge Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Mainofficeid" class="form-label">Company <span class="req-star">*</span></label>
                        <select asp-items="Model.MainOfficelist" asp-for="Mainofficeid" class="form-select" required>
                            <option value="0">-- Select Company --</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="childofficeName" class="form-label">DhermKata / Weighbridge Name <span class="req-star">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-speedometer"></i></span>
                            <input asp-for="childofficeName" class="form-control" placeholder="Enter Weighbridge / DhermKata Name" required />
                        </div>
                    </div>

                    <!-- Hidden field since IsActive is default true for new -->
                    <input type="hidden" asp-for="IsActive" value="true" />

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save DhermKata
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
