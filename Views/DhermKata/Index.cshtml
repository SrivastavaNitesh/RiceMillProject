@model RiceMillProject.Models.DhermKata
@{
    ViewData["Title"] = "Office Management";
}
@if (ViewBag.Active != null)
{
    if (ViewBag.Active==true)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="activeToast" class="toast text-bg-success" role="alert">
                <div class="toast-body">
                    Record Saved Successfully
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="activeToast" class="toast text-bg-danger" role="alert">
                <div class="toast-body">
                    Some Thing error
                </div>
            </div>
        </div>
    }

}
<script>
    document.addEventListener("DOMContentLoaded",function(){
    var toastelement=document.getElementById("activeToast");
    if(toastelement){
        var toast=new bootstrap.toast(toastelement,{delay:3000});
        toast.show()
    }
      })
</script>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="bi bi-building"></i> DhermKata List
        </h4>
        <a asp-action="Create" class="btn btn-light btn-sm text-primary fw-bold">
            <i class="bi bi-plus-circle"></i> Add New DhermKata
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover table-striped align-middle table-bordered">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Office Name</th>
                    <th>DhermKata Name</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    if (Model.MainLst != null && Model.MainLst.Count > 0)
                    {
                        var groupdata = Model.MainLst.GroupBy(x => new
                        {
                            x.Mainofficeid,
                            x.MainofficeName
                        });

                        foreach (var maingroup in groupdata)
                        {
                            int sr = 0;
                            var childList = maingroup.ToList();
                            for (int i = 0; i < childList.Count; i++)
                            {
                                <tr>
                                    @if (i == 0)
                                    {
                                        <td rowspan="@childList.Count" mainofficeid="@childList[i].Mainofficeid">@(sr + 1)</td>
                                        <td rowspan="@childList.Count" mainofficeid="@childList[i].Mainofficeid">@childList[i].MainofficeName</td>
                                    }
                                    <td childofficeid="@childList[i].childofficeid">@childList[i].childofficeName</td>
                                    <td>
                                        @if (childList[i].IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="#" asp-route-id="@childList[i].childofficeid" class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@childList[i].childofficeid" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this?');">
                                            <button type="button" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>

                            }

                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
