@model RiceMillProject.Models.DhermKata
@{
    ViewData["Title"] = "Company Weighbridges";
}
@if (ViewBag.Active != null)
{
    if (ViewBag.Active==true)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="activeToast" class="toast text-bg-success" role="alert">
                <div class="toast-body">
                    Record Saved Successfully
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <div id="activeToast" class="toast text-bg-danger" role="alert">
                <div class="toast-body">
                    Some Thing error
                </div>
            </div>
        </div>
    }

}
<script>
    document.addEventListener("DOMContentLoaded",function(){
    var toastelement=document.getElementById("activeToast");
    if(toastelement){
        var toast=new bootstrap.toast(toastelement,{delay:3000});
        toast.show()
    }
      })
</script>

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-speedometer2"></i>
        </div>
        <div>
            <h3 class="erp-page-title">WEIGHBRIDGE / DHARAMKATA MASTER</h3>
            <p class="erp-page-subtitle">Configure weighing bridge stations, company mappings, and active scale points</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New DharamKata
    </a>
</div>

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">S.No</th>
                    <th>Company Name</th>
                    <th>DharamKata Scale Name</th>
                    <th>Status</th>
                    <th class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    if (Model.MainLst != null && Model.MainLst.Count > 0)
                    {
                        var groupdata = Model.MainLst.GroupBy(x => new
                        {
                            x.Mainofficeid,
                            x.MainofficeName
                        });

                        int mainSr = 1;
                        foreach (var maingroup in groupdata)
                        {
                            var childList = maingroup.ToList();
                            for (int i = 0; i < childList.Count; i++)
                            {
                                <tr>
                                    @if (i == 0)
                                    {
                                        <td class="ps-4 text-muted font-monospace" rowspan="@childList.Count" mainofficeid="@childList[i].Mainofficeid">#@(mainSr++)</td>
                                        <td rowspan="@childList.Count" mainofficeid="@childList[i].Mainofficeid"><strong class="text-dark">@childList[i].MainofficeName</strong></td>
                                    }
                                    <td childofficeid="@childList[i].childofficeid">@childList[i].childofficeName</td>
                                    <td>
                                        @if (childList[i].IsActive)
                                        {
                                            <span class="badge-erp badge-erp-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge-erp badge-erp-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-action="#" asp-route-id="@childList[i].childofficeid" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@childList[i].childofficeid" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this?');">
                                            <button type="button" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
