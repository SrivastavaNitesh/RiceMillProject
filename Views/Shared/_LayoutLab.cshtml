<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab Quality Portal - RiceMill</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .lab-sidebar { background: linear-gradient(180deg, #1e3c72 0%, #162d56 100%); color: white; width: 270px; min-height: 100vh; position: fixed; left: 0; top: 0; z-index: 1030; }
        .lab-brand { border-bottom: 1px solid rgba(255,255,255,.18); }
        .lab-sidebar .nav-link { color: rgba(255,255,255,.86); border-radius: 8px; font-weight: 500; padding: .75rem 1rem; }
        .lab-sidebar .nav-link:hover, .lab-sidebar .nav-link.active { background-color: rgba(255,255,255,.18); color: #fff; }
        .lab-content { margin-left: 270px; min-height: 100vh; background: #f5f7fb; }
        @@media (max-width: 768px) { .lab-sidebar { width: 220px; } .lab-content { margin-left: 220px; } }
    </style>
</head>
<body>
    <aside class="lab-sidebar p-3 d-flex flex-column">
        <div class="lab-brand pb-3 mb-3">
            <h4 class="mb-1 fw-bold"><i class="bi bi-moisture me-2"></i>Lab Portal</h4>
            <small class="text-white-50">Rice Mill Quality Control</small>
        </div>
        <div class="text-uppercase small text-white-50 mb-2">Lab Navigation</div>
        <nav class="nav flex-column gap-1">
            <a class="nav-link" asp-controller="Lab" asp-action="Index"><i class="bi bi-moisture me-2"></i>Quality Check Log</a>
            <a class="nav-link" asp-controller="Lab" asp-action="Tests"><i class="bi bi-clipboard-plus me-2"></i>Test Master</a>
            <a class="nav-link" asp-controller="Lab" asp-action="Mappings"><i class="bi bi-box me-2"></i>Item Test Mapping</a>
            <a class="nav-link" asp-controller="Lab" asp-action="Reports"><i class="bi bi-file-earmark-bar-graph me-2"></i>Lab Reports</a>
        </nav>
        <div class="mt-auto border-top border-light border-opacity-25 pt-3">
            <div class="small mb-3"><i class="bi bi-person-badge me-2"></i>@User.Identity?.Name<br /><span class="text-white-50">Lab Technician</span></div>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-light text-dark fw-bold w-100"><i class="bi bi-power me-2"></i>Logout</a>
        </div>
    </aside>

    <main class="lab-content">
    <div class="container-fluid p-4">
        @RenderBody()
    </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
