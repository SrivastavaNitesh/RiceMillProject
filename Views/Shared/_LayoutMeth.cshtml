<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Meth Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .meth-shell { display:flex; min-height:100vh; }
        .meth-sidebar { width:245px; flex-shrink:0; background:#1e3c72; color:white; padding:24px 12px; }
        .meth-sidebar a { display:block; color:white; padding:12px; border-radius:6px; text-decoration:none; margin:6px 0; }
        .meth-sidebar a:hover,.meth-sidebar a.active { background:#ffffff26; }
        .meth-content { flex:1; min-width:0; background:#f8f9fa; }
        @@media(max-width:700px) { .meth-shell { flex-direction:column; } .meth-sidebar { width:100%; } }
        @@media print { .meth-sidebar,.meth-header { display:none; } }
    </style>
</head>
<body>
    <div class="meth-shell">
        <aside class="sidebar meth-sidebar" aria-label="Meth navigation">
            <h4 class="px-3 mb-4">Meth Portal</h4>
            <a asp-controller="Meth" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard / Unloading</a>
            <a asp-controller="Report" asp-action="UnloadSummaryReport"><i class="bi bi-file-earmark-text me-2"></i>Unloading Report</a>
            <a asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a>
        </aside>
        <div class="meth-content">
            <header class="meth-header bg-white border-bottom px-4 py-3">@User.Identity?.Name — Meth (Labour Head)</header>
            <main class="p-4">@RenderBody()</main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>