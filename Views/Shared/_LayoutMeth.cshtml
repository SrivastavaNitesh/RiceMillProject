<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Meth Portal - RiceMill
    </title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />


    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />


    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RiceMillProject.styles.css"
          asp-append-version="true" />


    <style>

        /* =========================================================
           RESET
           ========================================================= */

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0 !important;
            padding: 0 !important;
        }

        html {
            background: #f4f7fb;
        }

        body {
            background: #f4f7fb !important;

            font-family:
                'Segoe UI',
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                sans-serif;

            overflow: hidden;
        }


        /* =========================================================
           APP SHELL
           ========================================================= */

        .meth-shell {
            width: 100%;
            height: 100vh;
            height: 100dvh;

            display: flex;

            background: #f4f7fb;

            overflow: hidden;
        }


        /* =========================================================
           SIDEBAR
           ========================================================= */

        .meth-sidebar {
            position: fixed;

            top: 0;
            bottom: 0;
            left: 0;

            z-index: 1040;

            width: 265px;
            height: 100vh;
            height: 100dvh;

            display: flex;
            flex-direction: column;

            color: #ffffff;

            background:
                linear-gradient(
                    180deg,
                    #244b84 0%,
                    #2d5da1 55%,
                    #234a80 100%
                );

            box-shadow:
                4px 0 18px
                rgba(15, 39, 74, 0.10);

            overflow-y: auto;
            overflow-x: hidden;

            scrollbar-width: thin;

            scrollbar-color:
                rgba(255,255,255,.30)
                transparent;
        }


        .meth-sidebar::-webkit-scrollbar {
            width: 5px;
        }


        .meth-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }


        .meth-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.30);
            border-radius: 10px;
        }


        /* =========================================================
           LOGO
           ========================================================= */

        .meth-sidebar-logo {
            padding: 22px 14px 20px;

            text-align: center;

            border-bottom:
                1px solid
                rgba(255,255,255,.15);

            flex-shrink: 0;
        }


        .meth-sidebar-logo-icon {
            width: 58px;
            height: 58px;

            margin: 0 auto 10px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 16px;

            background:
                rgba(255,255,255,.12);

            border:
                1px solid
                rgba(255,255,255,.14);

            font-size: 29px;

            color: #ffffff;
        }


        .meth-sidebar-logo h5 {
            margin: 0;

            color: #ffffff;

            font-size: 18px;

            font-weight: 700;
        }


        .meth-sidebar-logo small {
            display: block;

            margin-top: 4px;

            color:
                rgba(255,255,255,.65);

            font-size: 11px;
        }


        /* =========================================================
           SIDEBAR MENU
           ========================================================= */

        .meth-sidebar-menu {
            flex: 1;

            padding: 14px 0 20px;

            margin: 0;

            list-style: none;
        }


        .meth-sidebar-menu .nav-item {
            width: 100%;
        }


        .meth-sidebar-menu a {
            display: flex;

            align-items: center;

            gap: 8px;

            margin: 3px 12px;

            padding: 11px 13px;

            color:
                rgba(255,255,255,.88);

            border-radius: 8px;

            text-decoration: none;

            font-size: 14px;

            font-weight: 500;

            transition:
                background-color .2s ease,
                color .2s ease,
                transform .2s ease;
        }


        .meth-sidebar-menu a i {
            width: 20px;

            font-size: 16px;

            text-align: center;
        }


        .meth-sidebar-menu a:hover {
            color: #ffffff;

            background:
                rgba(255,255,255,.13);

            transform: translateX(2px);
        }


        .meth-sidebar-menu a.active {
            color: #ffffff;

            background:
                rgba(255,255,255,.18);

            font-weight: 600;
        }


        .meth-sidebar-section {
            margin: 20px 20px 7px;

            color:
                rgba(255,255,255,.58);

            font-size: 11px;

            font-weight: 700;

            letter-spacing: .8px;

            text-transform: uppercase;

            list-style: none;
        }


        .meth-sidebar-menu a.meth-signout {
            color: #ffd43b;

            font-weight: 700;
        }


        .meth-sidebar-menu a.meth-signout:hover {
            color: #ffe066;

            background:
                rgba(255,193,7,.10);
        }


        /* =========================================================
           MAIN AREA
           ========================================================= */

        .meth-main {
            margin-left: 265px;

            width:
                calc(100% - 265px);

            height: 100vh;
            height: 100dvh;

            min-width: 0;

            display: flex;

            flex-direction: column;

            background: #f4f7fb;

            overflow: hidden;
        }


        /* =========================================================
           HEADER
           ========================================================= */

        .meth-top-header {
            min-height: 70px;

            padding: 12px 28px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            flex-shrink: 0;

            background: #ffffff;

            border-bottom:
                1px solid #e8ecf2;

            box-shadow:
                0 2px 10px
                rgba(30,60,114,.04);

            z-index: 20;
        }


        .meth-top-title {
            margin: 0;

            color: #244b84;

            font-size: 20px;

            font-weight: 700;

            letter-spacing: -.3px;
        }


        .meth-header-right {
            display: flex;

            align-items: center;

            gap: 20px;
        }


        .meth-clock {
            color: #697386;

            font-size: 13px;

            white-space: nowrap;
        }


        /* =========================================================
           USER MENU
           ========================================================= */

        .meth-user-toggle {
            display: flex;

            align-items: center;

            color: #24324a;

            text-decoration: none;
        }


        .meth-user-toggle:hover {
            color: #24324a;
        }


        .meth-user-avatar {
            width: 38px;
            height: 38px;

            margin-right: 9px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background: #edf3ff;

            color: #1769e8;

            font-size: 20px;
        }


        .meth-user-name {
            display: block;

            max-width: 150px;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

            font-size: 13px;

            font-weight: 700;

            line-height: 1.15;
        }


        .meth-user-role {
            display: block;

            margin-top: 2px;

            color: #8a94a5;

            font-size: 11px;
        }


        /* =========================================================
           PAGE CONTENT
           ========================================================= */

        .meth-page-content {
            flex: 1 1 auto;

            min-height: 0;

            width: 100%;

            padding: 24px;

            background: #f4f7fb;

            overflow-y: auto;
            overflow-x: hidden;

            scrollbar-width: thin;

            scrollbar-color:
                #c7cfdb
                transparent;
        }


        .meth-page-content::-webkit-scrollbar {
            width: 7px;
        }


        .meth-page-content::-webkit-scrollbar-track {
            background: transparent;
        }


        .meth-page-content::-webkit-scrollbar-thumb {
            background: #c7cfdb;

            border-radius: 20px;
        }


        .meth-page-content::after {
            content: "";

            display: block;

            min-height: 20px;
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 991px) {

            .meth-sidebar {
                width: 225px;
            }


            .meth-main {
                margin-left: 225px;

                width:
                    calc(100% - 225px);
            }


            .meth-top-header {
                padding: 12px 18px;
            }


            .meth-page-content {
                padding: 18px;
            }


            .meth-top-title {
                font-size: 17px;
            }
        }


        @@media (max-width: 767px) {

            .meth-sidebar {
                width: 205px;
            }


            .meth-main {
                margin-left: 205px;

                width:
                    calc(100% - 205px);
            }


            .meth-sidebar-logo {
                padding: 16px 10px;
            }


            .meth-sidebar-logo-icon {
                width: 46px;
                height: 46px;

                font-size: 23px;
            }


            .meth-sidebar-logo h5 {
                font-size: 16px;
            }


            .meth-sidebar-menu a {
                margin: 3px 8px;

                padding: 10px 10px;

                font-size: 13px;
            }


            .meth-top-header {
                padding: 10px 14px;
            }


            .meth-page-content {
                padding: 14px;
            }


            .meth-clock {
                display: none;
            }


            .meth-top-title {
                font-size: 15px;
            }
        }


        /* =========================================================
           PRINT
           Other developer code preserved
           ========================================================= */

        @@media print {

            .meth-sidebar,
            .meth-top-header {
                display: none !important;
            }


            .meth-main {
                margin-left: 0 !important;

                width: 100% !important;

                height: auto !important;

                overflow: visible !important;
            }


            .meth-page-content {
                padding: 0 !important;

                overflow: visible !important;

                background: #ffffff !important;
            }


            body {
                overflow: visible !important;

                background: #ffffff !important;
            }
        }

    </style>

</head>


<body>

    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]
                ?.ToString()
                ?.ToLower()
            ?? "";

        var currentAction =
            ViewContext.RouteData.Values["action"]
                ?.ToString()
                ?.ToLower()
            ?? "";


        string MethActive(
            string controller,
            string action = "")
        {
            bool controllerMatch =
                currentController
                ==
                controller.ToLower();

            bool actionMatch =
                string.IsNullOrWhiteSpace(action)
                ||
                currentAction
                ==
                action.ToLower();

            return
                controllerMatch && actionMatch
                    ? "active"
                    : "";
        }
    }


    <div class="meth-shell">


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside class="meth-sidebar"
               aria-label="Meth navigation">


            <!-- LOGO -->

            <div class="meth-sidebar-logo">

                <div class="meth-sidebar-logo-icon">

                    <i class="bi bi-people-fill"></i>

                </div>


                <h5>
                    Meth Portal
                </h5>


                <small>
                    RiceMill Labour Operations
                </small>

            </div>



            <!-- =================================================
                 MENU
                 ================================================= -->

            <ul class="meth-sidebar-menu">


                <!-- DASHBOARD -->

                <li class="nav-item">

                    <a asp-controller="Meth"
                       asp-action="Index"
                       class="@MethActive("Meth", "Index")">

                        <i class="bi bi-speedometer2"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>

                </li>



                <!-- =================================================
                     WORK
                     ================================================= -->

                <li class="meth-sidebar-section">
                    Work
                </li>


                <li class="nav-item">

                    <a asp-controller="Meth"
                       asp-action="Index"
                       class="@MethActive("Meth", "Index")">

                        <i class="bi bi-truck-flatbed"></i>

                        <span>
                            Assigned Unloading
                        </span>

                    </a>

                </li>


                <li class="nav-item">

                    <a asp-controller="Meth"
                       asp-action="Index"
                       class="@MethActive("Meth", "Index")">

                        <i class="bi bi-list-check"></i>

                        <span>
                            My Work Queue
                        </span>

                    </a>

                </li>



                <!-- =================================================
                     OTHER DEVELOPER:
                     UNLOADING REPORT PRESERVED
                     ================================================= -->

                <li class="nav-item">

                    <a asp-controller="Report"
                       asp-action="UnloadSummaryReport"
                       class="@MethActive("Report", "UnloadSummaryReport")">

                        <i class="bi bi-file-earmark-text"></i>

                        <span>
                            Unloading Report
                        </span>

                    </a>

                </li>



                <!-- =================================================
                     ACCOUNT
                     ================================================= -->

                <li class="meth-sidebar-section">
                    Account
                </li>


                <li class="nav-item">

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="meth-signout">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>
                            Sign Out
                        </span>

                    </a>

                </li>

            </ul>

        </aside>



        <!-- =====================================================
             MAIN AREA
             ===================================================== -->

        <main class="meth-main">


            <!-- =================================================
                 TOP HEADER
                 ================================================= -->

            <header class="meth-top-header">


                <div>

                    <h4 class="meth-top-title">

                        Sri Balaji Rice Mill
                        -
                        Meth Management

                    </h4>

                </div>



                <div class="meth-header-right">


                    <!-- CLOCK -->

                    <div class="meth-clock">

                        <i class="bi bi-clock me-1"></i>

                        <span id="liveClock"
                              class="fw-semibold">

                            --:--:--

                        </span>

                    </div>



                    <!-- USER -->

                    @if (
                        User.Identity != null
                        &&
                        User.Identity.IsAuthenticated
                    )
                    {
                        <div class="dropdown">


                            <a href="#"
                               class="meth-user-toggle dropdown-toggle"
                               id="methUserDropdown"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">


                                <div class="meth-user-avatar">

                                    <i class="bi bi-person-fill"></i>

                                </div>


                                <div>

                                    <strong class="meth-user-name">

                                        @User.Identity.Name

                                    </strong>


                                    <small class="meth-user-role">

                                        Meth (Labour Head)

                                    </small>

                                </div>

                            </a>



                            <ul class="dropdown-menu dropdown-menu-end shadow border-0"
                                aria-labelledby="methUserDropdown">


                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Meth"
                                       asp-action="Index">

                                        <i class="bi bi-speedometer2 me-2"></i>

                                        Dashboard

                                    </a>

                                </li>


                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Report"
                                       asp-action="UnloadSummaryReport">

                                        <i class="bi bi-file-earmark-text me-2"></i>

                                        Unloading Report

                                    </a>

                                </li>


                                <li>

                                    <hr class="dropdown-divider" />

                                </li>


                                <li>

                                    <a class="dropdown-item text-danger fw-semibold"
                                       asp-controller="Account"
                                       asp-action="Logout">

                                        <i class="bi bi-power me-2"></i>

                                        Sign Out

                                    </a>

                                </li>


                            </ul>

                        </div>
                    }

                </div>

            </header>



            <!-- =================================================
                 PAGE BODY
                 ================================================= -->

            <section class="meth-page-content">

                @RenderBody()

            </section>

        </main>

    </div>



    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>


    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>



    <!-- LIVE CLOCK -->

    <script>

        function updateLiveClock()
        {
            const now =
                new Date();


            const time =
                now.toLocaleTimeString(
                    'en-US',
                    {
                        hour12: true,
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    }
                );


            const clock =
                document.getElementById(
                    'liveClock'
                );


            if (clock)
            {
                clock.textContent =
                    time;
            }
        }


        updateLiveClock();


        setInterval(
            updateLiveClock,
            1000
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>