@{ var action = ViewContext.RouteData.Values["action"]?.ToString(); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Annapurna Agro Billing</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/lab.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" />    <link rel="stylesheet" href="~/css/annapurna-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/annapurna-design.css" asp-append-version="true" />
<script src="~/js/annapurna-theme.js" asp-append-version="true"></script>
</head>
<body class="agro-ui lab-shell">
    <a href="#lab-content" class="lab-skip">Skip to content</a>
    <aside class="lab-sidebar" id="lab-sidebar">
        <a class="agro-brand-link" asp-controller="Billing" asp-action="Index"><partial name="_Brand" /></a>
        <div class="lab-nav-label">BILLING SECTION</div>
        <nav aria-label="Billing navigation">
            <a class="lab-nav-link @(action != "Rules" ? "active" : "")" asp-controller="Billing" asp-action="Index">RST billing register</a>
            <a class="lab-nav-link @(action == "Rules" ? "active" : "")" asp-controller="Billing" asp-action="Rules">Lab deduction rules</a>
            <a class="lab-nav-link" asp-controller="Home" asp-action="Index">Admin dashboard</a>
        </nav>
        <div class="lab-sidebar-bottom"><span class="lab-nav-label">SIGNED IN AS</span><strong>@User.Identity?.Name</strong><a asp-controller="Home" asp-action="Index">Home dashboard</a><a asp-controller="Account" asp-action="Logout">Sign out &rarr;</a></div>
    </aside>
    <button class="lab-backdrop" type="button" aria-label="Close navigation" hidden></button>
    <div class="lab-workspace">
        <header class="lab-topbar"><div class="d-flex align-items-center gap-3"><button type="button" class="btn btn-outline-secondary lab-menu-toggle" aria-controls="lab-sidebar" aria-expanded="false">Menu</button><span>Accounts <span class="lab-divider">/</span> <strong>@ViewData["Title"]</strong></span></div><span class="lab-workspace-tag">Admin billing workspace</span></header>
        <main id="lab-content" class="lab-content" tabindex="-1">@RenderBody()</main>
        <footer class="lab-footer">Annapurna Agro &middot; Billing &amp; payment records</footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lab-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/annapurna-ui.js" asp-append-version="true"></script>
    <partial name="_Appearance" />
</body>
</html>
