@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
            <h1 class="display-4 fw-bold mt-3">Oops! Something went wrong.</h1>
            <p class="lead text-muted mt-3">
                We encountered an unexpected error while processing your request. Our technical team has been notified.
            </p>
            <div class="mt-4">
                <a href="/" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                    <i class="bi bi-house-door me-2"></i>Return to Home
                </a>
            </div>
            @if (Context.Items.ContainsKey("ExceptionMessage"))
            {
                <div class="alert alert-secondary mt-5 text-start overflow-auto" style="max-height: 200px;">
                    <small><strong>Error Details (For Developers):</strong><br />
                    @Context.Items["ExceptionMessage"]</small>
                </div>
            }
        </div>
    </div>
</div>
