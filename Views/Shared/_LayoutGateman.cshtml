<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Gateman Portal
    </title>


    <!-- Google Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Inter:ital,wght@0,300..800;1,300..800&display=swap"
          rel="stylesheet">


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">


    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">


    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RiceMillProject.styles.css"
          asp-append-version="true" />


    <style>

        :root {
            --bs-body-font-family:
                'Plus Jakarta Sans',
                'Inter',
                system-ui,
                sans-serif !important;
        }


        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }


        html,
        body,
        button,
        input,
        select,
        textarea,
        .form-control,
        .form-select,
        .table,
        .btn,
        .card,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {

            font-family:
                'Plus Jakarta Sans',
                'Inter',
                -apple-system,
                sans-serif !important;

            -webkit-font-smoothing:
                antialiased;

            letter-spacing:
                -0.01em;
        }


        body {
            background-color: #f8fafc;
            overflow: hidden;
        }


        /* =========================================
           MAIN WRAPPER
           ========================================= */

        .main-wrapper {
            width: 100%;
            height: 100dvh;
            display: flex;
            flex-wrap: nowrap;
            overflow: hidden;
        }


        /* =========================================
           SIDEBAR
           ========================================= */

        .sidebar {

            width: 250px;
            min-width: 250px;
            max-width: 250px;

            height: 100dvh;

            background:
                linear-gradient(
                    180deg,
                    #1e3c72 0%,
                    #2a5298 100%
                );

            color: white;

            overflow-y: auto;
            overflow-x: hidden;

            scrollbar-width: thin;

            scrollbar-color:
                rgba(255,255,255,0.35)
                transparent;

            display: flex;
            flex-direction: column;

            flex-shrink: 0;
        }


        .sidebar::-webkit-scrollbar {
            width: 6px;
        }


        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }


        .sidebar::-webkit-scrollbar-thumb {

            background:
                rgba(255,255,255,0.35);

            border-radius: 10px;
        }


        .sidebar::-webkit-scrollbar-thumb:hover {

            background:
                rgba(255,255,255,0.60);
        }


        .sidebar a {

            color:
                rgba(255,255,255,0.80);

            text-decoration: none;

            display: flex;
            align-items: center;

            padding:
                10px 16px;

            border-radius: 8px;

            margin:
                2px 8px;

            font-size:
                0.875rem;

            font-weight: 500;

            transition:
                background 0.2s,
                color 0.2s;
        }


        .sidebar a:hover,
        .sidebar a.active-link {

            background:
                rgba(255,255,255,0.18);

            color:
                #ffffff;
        }


        .sidebar-brand {

            padding:
                20px 16px
                12px 16px;

            border-bottom:
                1px solid
                rgba(255,255,255,0.15);

            margin-bottom: 8px;
        }


        .sidebar-brand h5 {

            color: white;

            font-weight: 700;

            font-size: 1rem;

            margin: 0;

            letter-spacing:
                -0.3px;
        }


        .sidebar-brand small {

            color:
                rgba(255,255,255,0.55);

            font-size:
                0.72rem;
        }


        .sidebar-section-title {

            color:
                rgba(255,255,255,0.45);

            font-size:
                0.68rem;

            font-weight: 700;

            letter-spacing:
                0.08em;

            padding:
                12px 20px
                4px 20px;

            list-style: none;

            text-transform:
                uppercase;
        }


        .sidebar ul {

            padding: 0;

            margin: 0;

            list-style: none;

            flex: 1;
        }


        .sidebar ul li {
            list-style: none;
        }


        .sidebar-sticky-bottom {

            border-top:
                1px solid
                rgba(255,255,255,0.15);

            padding:
                10px 12px;

            flex-shrink: 0;
        }


        /* =========================================
           MAIN CONTENT
           ========================================= */

        .main-content {

            flex: 1;

            min-width: 0;

            height: 100dvh;

            display: flex;

            flex-direction: column;

            overflow: hidden;
        }


        /* =========================================
           TOP HEADER
           ========================================= */

        .top-header {

            height: 60px;

            min-height: 60px;

            background:
                #ffffff;

            border-bottom:
                1px solid #e8ecf0;

            display: flex;

            align-items: center;

            justify-content:
                space-between;

            padding:
                0 24px;

            flex-shrink: 0;

            box-shadow:
                0 1px 4px
                rgba(0,0,0,0.06);

            z-index: 10;
        }


        /* =========================================
           CONTENT
           ========================================= */

        .content-area {

            flex: 1;

            min-height: 0;

            overflow-y: auto;

            overflow-x: hidden;

            padding: 24px;

            background:
                #f8fafc;
        }


        /* =========================================
           GLOBAL ALERT
           ========================================= */

        #globalAlertContainer {

            position: fixed;

            top: 70px;

            right: 20px;

            z-index: 9999;

            min-width: 300px;

            max-width: 420px;
        }


        /* =========================================
           RESPONSIVE
           ========================================= */

        @@media (max-width: 768px) {

            .sidebar {

                width: 210px;

                min-width: 210px;

                max-width: 210px;
            }


            .top-header {
                padding: 0 15px;
            }


            .content-area {
                padding: 15px;
            }
        }

    </style>

</head>


<body>

    <div class="main-wrapper">


        <!-- ======================================
             SIDEBAR
             ====================================== -->

        <div class="sidebar">


            <!-- BRAND -->

            <div class="sidebar-brand">

                <div class="d-flex align-items-center gap-2">

                    <div class="bg-white bg-opacity-20 rounded p-1"
                         style="line-height:1">

                        <i class="bi bi-door-open-fill text-warning fs-5"></i>

                    </div>


                    <div>

                        <h5>
                            Gateman Portal
                        </h5>

                        <small>
                            Rice Mill Management
                        </small>

                    </div>

                </div>

            </div>


            <!-- ==================================
                 ACTIVE MENU LOGIC
                 ================================== -->

            @{
                var currentController =
                    ViewContext
                        .RouteData
                        .Values["controller"]
                        ?.ToString()
                        ?.ToLower()
                    ?? "";

                var currentAction =
                    ViewContext
                        .RouteData
                        .Values["action"]
                        ?.ToString()
                        ?.ToLower()
                    ?? "";


                string IsActive(
                    string controller,
                    string action)
                {
                    return
                        currentController
                            ==
                        controller.ToLower()

                        &&

                        currentAction
                            ==
                        action.ToLower()

                            ? "active-link"
                            : "";
                }
            }


            <ul class="flex-grow-1">


                <!-- ==================================
                     GATE OPERATIONS
                     ================================== -->

                <li class="sidebar-section-title">

                    Gate Operations

                </li>


                <!-- Other developer Dashboard preserved -->

                <li>

                    <a asp-controller="Gateman"
                       asp-action="Dashboard"
                       class="@IsActive("Gateman", "Dashboard")">

                        <i class="bi bi-speedometer2 me-2"></i>

                        Dashboard

                    </a>

                </li>


                <!-- Other developer Gate Entries preserved -->

                <li>

                    <a asp-controller="Gateman"
                       asp-action="Index"
                       class="@IsActive("Gateman", "Index")">

                        <i class="bi bi-sign-turn-right me-2"></i>

                        Gate Inward Entry

                    </a>

                </li>


                <li>

                    <a asp-controller="Gateman"
                       asp-action="Report"
                       class="@IsActive("Gateman", "Report")">

                        <i class="bi bi-journal-text me-2"></i>

                        Inward Register

                    </a>

                </li>



                <!-- ==================================
                     SECURITY
                     ================================== -->

                <li class="sidebar-section-title">

                    Security

                </li>


                <!-- Other developer Visitor Register preserved -->

                <li>

                    <a asp-controller="Visitor"
                       asp-action="Index"
                       class="@IsActive("Visitor", "Index")">

                        <i class="bi bi-card-heading me-2"></i>

                        Visitor Register

                    </a>

                </li>


                <!-- Other developer Temp Tools preserved -->

                <li>

                    <a asp-controller="TempMaterial"
                       asp-action="Index"
                       class="@IsActive("TempMaterial", "Index")">

                        <i class="bi bi-tools me-2"></i>

                        Temp Tools Register

                    </a>

                </li>


                <!-- Other developer Incidents preserved -->

                <li>

                    <a asp-controller="Incident"
                       asp-action="Index"
                       class="@IsActive("Incident", "Index")">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        Security Incidents

                    </a>

                </li>



                <!-- ==================================
                     MASTERS
                     ================================== -->

                <li class="sidebar-section-title">

                    Masters

                </li>


                <!-- Other developer Vehicles preserved -->

                <li>

                    <a asp-controller="Vehicle"
                       asp-action="Index"
                       class="@IsActive("Vehicle", "Index")">

                        <i class="bi bi-truck me-2"></i>

                        Vehicles

                    </a>

                </li>

            </ul>


            <!-- ==================================
                 SIGN OUT
                 ================================== -->

            <div class="sidebar-sticky-bottom">

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="btn btn-sm btn-outline-light w-100 py-1 d-flex align-items-center justify-content-center gap-1 text-white-50">

                    <i class="bi bi-box-arrow-right text-danger"></i>

                    <span>
                        Sign Out
                    </span>

                </a>

            </div>

        </div>


        <!-- ======================================
             MAIN CONTENT
             ====================================== -->

        <div class="main-content">


            <!-- TOP HEADER -->

            <header class="top-header">


                <div class="d-flex align-items-center">

                    <h5 class="mb-0 fw-bold text-primary"
                        style="letter-spacing:-0.5px;">

                        Sri Balaji Rice Mill

                    </h5>

                </div>


                <div class="d-flex align-items-center gap-3">


                    <!-- LIVE CLOCK -->

                    <div class="me-2 text-muted d-none d-md-block">

                        <i class="bi bi-clock me-1"></i>

                        <span id="liveClock"
                              class="fw-bold">

                            --:--:--

                        </span>

                    </div>


                    <!-- USER -->

                    @if (
                        User.Identity != null
                        &&
                        User.Identity.IsAuthenticated
                    )
                    {
                        <div class="dropdown">


                            <a href="#"
                               class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle"
                               id="dropdownUser"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="bi bi-person-circle fs-4 me-2 text-primary"></i>


                                <div>

                                    <strong class="d-block lh-1">

                                        @User.Identity.Name

                                    </strong>


                                    <small class="text-muted"
                                           style="font-size:0.75rem;">

                                        Gate Man

                                    </small>

                                </div>

                            </a>


                            <ul class="dropdown-menu dropdown-menu-end shadow"
                                aria-labelledby="dropdownUser">

                                <li>

                                    <a class="dropdown-item text-danger fw-bold"
                                       asp-controller="Account"
                                       asp-action="Logout">

                                        <i class="bi bi-box-arrow-right me-2"></i>

                                        Sign out

                                    </a>

                                </li>

                            </ul>

                        </div>
                    }

                </div>

            </header>



            <!-- ==================================
                 GLOBAL ALERT
                 ================================== -->

            <div id="globalAlertContainer">

                @if (
                    TempData["SuccessMessage"]
                    != null
                )
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm"
                         role="alert">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                @if (
                    TempData["ErrorMessage"]
                    != null
                )
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                         role="alert">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }

            </div>



            <!-- ==================================
                 PAGE CONTENT
                 ================================== -->

            <main class="content-area">

                @RenderBody()

            </main>

        </div>

    </div>



    <!-- ======================================
         SCRIPTS
         ====================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- LIVE CLOCK -->

    <script>

        function updateClock() {

            const now =
                new Date();

            const h =
                String(
                    now.getHours()
                ).padStart(
                    2,
                    '0'
                );

            const m =
                String(
                    now.getMinutes()
                ).padStart(
                    2,
                    '0'
                );

            const s =
                String(
                    now.getSeconds()
                ).padStart(
                    2,
                    '0'
                );

            const el =
                document.getElementById(
                    'liveClock'
                );

            if (el) {

                el.textContent =
                    h
                    + ':'
                    + m
                    + ':'
                    + s;
            }
        }


        updateClock();

        setInterval(
            updateClock,
            1000
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>