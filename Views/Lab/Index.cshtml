@model IEnumerable<RiceMillProject.Models.GateEntry>
@{
    ViewData["Title"] = "Lab Dashboard";
}

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="bi bi-moisture"></i> Lab Dashboard (Pending Quality Checks)
        </h4>
    </div>
    <div class="card-body">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>RST Number</th>
                    <th>Vehicle</th>
                    <th>Party</th>
                    <th>Gross Wt.</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="text-center text-muted">No pending tests at the moment.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.RSTNumber</td>
                        <td>@item.VehicleNumber</td>
                        <td>@item.PartyName</td>
                        <td>@item.GrossWeight kg</td>
                        <td>
                            <span class="badge bg-secondary">@item.Status</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Create" asp-route-rstNumber="@item.RSTNumber" class="btn btn-sm btn-outline-warning text-dark fw-bold">
                                <i class="bi bi-clipboard-check"></i> Enter Lab Report
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
