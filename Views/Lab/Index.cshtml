@model List<RiceMillProject.Models.LabRstSummary>
@{ ViewData["Title"] = "Lab quality checks"; }
<partial name="_Navigation" />
<h2>RST quality checks</h2>
<p class="text-muted">Select an RST to test the items recorded during unloading. Multiple categories and items can be tested together.</p>
<div class="lab-metrics"><div class="lab-metric"><span>Ready RSTs</span><strong>@Model.Count</strong></div><div class="lab-metric"><span>Unloaded items</span><strong>@Model.Sum(r => r.ItemCount)</strong></div><div class="lab-metric"><span>Recorded results</span><strong>@Model.Sum(r => r.CompletedTests)</strong></div></div><div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>RST number</th><th>Vehicle / party</th><th>Unloaded items</th><th>Test coverage</th><th>Actions</th></tr></thead><tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="5" class="text-center py-5 text-muted">No item-wise unloading is ready for testing.<br />Record the actual unloaded items on the unloading form first.</td></tr>
    }
    @foreach (var rst in Model)
    {
        <tr><td class="fw-bold">@rst.RSTNumber</td><td>@rst.VehicleNumber<small class="d-block text-muted">@rst.PartyName</small></td><td>@rst.ItemCount</td>
            <td>@rst.CompletedTests / @rst.RequiredTests results recorded
                @if (rst.UnmappedItems > 0) { <small class="d-block text-warning">@rst.UnmappedItems item(s) need test mapping</small> }
                else if (rst.IsComplete) { <span class="badge bg-success">Complete</span> }
            </td>
            <td>@if (rst.IsComplete) { <button type="button" class="btn btn-sm btn-secondary" disabled title="All item tests submitted">Entry completed</button> } else { <a asp-action="Create" asp-route-rstNumber="@rst.RSTNumber" class="btn btn-sm btn-primary">Enter details</a> }
                <a asp-action="Reports" asp-route-rstNumber="@rst.RSTNumber" class="btn btn-sm btn-outline-secondary">Reports</a></td></tr>
    }
    </tbody></table></div>
