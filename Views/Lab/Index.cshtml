@model IEnumerable<RiceMillProject.Models.GateEntry>
@{
    ViewData["Title"] = "Lab Dashboard";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-moisture"></i>
        </div>
        <div>
            <h3 class="erp-page-title">LAB QUALITY DASHBOARD</h3>
            <p class="erp-page-subtitle">Pending quality checks, moisture analysis, and grain sample test logs</p>
        </div>
    </div>
</div>

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">RST Number</th>
                    <th>Vehicle</th>
                    <th>Party</th>
                    <th>Gross Wt.</th>
                    <th>Status</th>
                    <th class="text-center pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Any()) {
                    <tr><td colspan="6" class="text-center py-4 text-muted">No pending tests at the moment.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-primary">@item.RSTNumber</td>
                        <td><strong class="text-dark">@item.VehicleNumber</strong></td>
                        <td>@item.PartyName</td>
                        <td><span class="badge-erp badge-erp-info">@item.GrossWeight kg</span></td>
                        <td>
                            <span class="badge-erp badge-erp-warning">@item.Status</span>
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Create" asp-route-rstNumber="@item.RSTNumber" class="btn btn-sm btn-outline-primary fw-bold">
                                <i class="bi bi-clipboard-check me-1"></i> Enter Lab Report
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
