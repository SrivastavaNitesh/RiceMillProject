@model RiceMillProject.Models.LabQualityCheck
@{
    ViewData["Title"] = "Lab Report Entry";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Lab Quality Report (RST: @Model.RSTNumber)</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="RSTNumber" />
                    
                    <div class="mb-3">
                        <label asp-for="TestedBy" class="form-label fw-bold">Lab Technician</label>
                        <select asp-for="TestedBy" class="form-select" asp-items="ViewBag.LabTechs" required>
                            <option value="">-- Select Technician --</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MoisturePct" class="form-label fw-bold">Moisture (%)</label>
                            <div class="input-group">
                                <input asp-for="MoisturePct" type="number" step="0.01" class="form-control" required />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">Standard Limit: 14%</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DustPct" class="form-label fw-bold">Dust/DD (%)</label>
                            <div class="input-group">
                                <input asp-for="DustPct" type="number" step="0.01" class="form-control" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PayiaPct" class="form-label fw-bold">Payia (%)</label>
                            <div class="input-group">
                                <input asp-for="PayiaPct" type="number" step="0.01" class="form-control" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="GrainQualityPct" class="form-label fw-bold">Grain Quality/Damage (%)</label>
                            <div class="input-group">
                                <input asp-for="GrainQualityPct" type="number" step="0.01" class="form-control" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Deductions will be automatically calculated based on limits if percentages exceed the standard thresholds.
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold">Submit Lab Report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
