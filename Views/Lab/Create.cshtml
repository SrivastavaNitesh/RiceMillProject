@model RiceMillProject.Models.LabQualityCheck
@{
    ViewData["Title"] = "Lab Report Entry";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-flask-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">LAB QUALITY TESTING ENTRY</h3>
            <p class="erp-page-subtitle">Record moisture, dust, payia, and damaged grain quality metrics for RST: <span class="badge bg-primary text-white font-monospace">@Model.RSTNumber</span></p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to Lab Queue
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-clipboard-check text-primary me-2"></i> Quality Check Parameters</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <input type="hidden" asp-for="RSTNumber" />
                    
                    <div class="col-md-12">
                        <label asp-for="TestedBy" class="form-label">Lab Technician <span class="req-star">*</span></label>
                        <select asp-for="TestedBy" class="form-select" asp-items="ViewBag.LabTechs" required>
                            <option value="">-- Select Technician --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MoisturePct" class="form-label">Moisture (%) <span class="req-star">*</span></label>
                        <div class="input-group">
                            <input asp-for="MoisturePct" type="number" step="0.01" class="form-control" required />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                        <small class="text-muted">Standard Limit: 14%</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DustPct" class="form-label">Dust / DD (%) <span class="req-star">*</span></label>
                        <div class="input-group">
                            <input asp-for="DustPct" type="number" step="0.01" class="form-control" required />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PayiaPct" class="form-label">Payia (%) <span class="req-star">*</span></label>
                        <div class="input-group">
                            <input asp-for="PayiaPct" type="number" step="0.01" class="form-control" required />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GrainQualityPct" class="form-label">Grain Quality / Damage (%) <span class="req-star">*</span></label>
                        <div class="input-group">
                            <input asp-for="GrainQualityPct" type="number" step="0.01" class="form-control" required />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>

                    <div class="col-12 mt-3">
                        <div class="alert alert-info border border-info-subtle rounded-3 py-2 px-3 mb-0">
                            <i class="bi bi-info-circle me-1"></i> Deductions will be automatically calculated based on standard enterprise quality limits if parameters exceed threshold limits.
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Submit Lab Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
