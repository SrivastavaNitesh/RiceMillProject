@model RiceMillProject.Models.LabEntryViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Lab results · " + Model.RSTNumber; }
<partial name="_Navigation" />
<h2>Lab results <span class="text-primary">@Model.RSTNumber</span></h2>
<p class="text-muted">Choose unloaded categories and items, then enter each item's test results.</p>
@if (Model.AvailableItems.Count == 0)
{
    <div class="alert alert-info">This RST has no recorded unloaded items available for lab testing. Complete item-wise unloading first.</div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to RST list</a>
}
else
{
    <form asp-action="Create" method="post" id="lab-entry-form">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="RSTNumber" type="hidden" /><input asp-for="SubmissionId" type="hidden" />
        <div class="card card-body mb-4">
            <label class="form-label fw-bold" for="category-menu">1. Unloaded categories (multiple selection)</label>
            <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" id="category-menu" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">Select categories</button>
                <div class="dropdown-menu p-3" aria-labelledby="category-menu" style="min-width:280px;max-height:320px;overflow:auto">
                    @foreach (var category in Model.AvailableItems.GroupBy(i => i.CategoryId))
                    {
                        <div class="form-check py-1">
                            <input class="form-check-input lab-category" type="checkbox" name="SelectedCategoryIds" value="@category.Key" id="category-@category.Key" checked="@Model.SelectedCategoryIds.Contains(category.Key)" />
                            <label class="form-check-label" for="category-@category.Key">@category.First().CategoryName</label>
                        </div>
                    }
                </div>
            </div>
            <h5 class="mt-4">2. Unloaded items (multiple selection)</h5>
            <div id="lab-items" class="row g-2"></div>
        </div>
        <h5>3. Item test results</h5>
        <div id="lab-results"></div>
        <label asp-for="Remarks" class="form-label">Remarks (optional)</label>
        <textarea asp-for="Remarks" class="form-control mb-3" maxlength="1000"></textarea>
        <p id="lab-selection-message" class="text-muted" aria-live="polite"></p>
        <button class="btn btn-primary" id="save-lab" type="submit" disabled>Save lab report</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <noscript><p class="alert alert-warning mt-3">Enable JavaScript to select categories, items and enter test results.</p></noscript>
    </form>
    <script id="lab-entry-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(new { items = Model.AvailableItems, selected = Model.SelectedItemIds, results = Model.Results }))</script>
}
@section Scripts { <script src="~/js/lab-entry.js" asp-append-version="true"></script> }
