@model RiceMillProject.Models.LabMappingPage
@using System.Text.Json
@{ ViewData["Title"] = "Item test mapping"; }
<partial name="_Navigation" />
<h2>Item test mapping</h2>
<p class="text-muted">Select an item and choose all its tests together. Unselect a test to remove its active mapping; saved reports remain unchanged.</p>
<div class="row g-4">
    <div class="col-xl-4">
        <form asp-action="Mappings" method="post" id="mapping-form" class="card card-body shadow-sm">
            <h5>@(Model.Form.MappingId == 0 ? "Set item tests" : "Edit item tests")</h5>
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input asp-for="Form.MappingId" type="hidden" />
            <div id="mapping-original-tests">
                @foreach (var testId in Model.Form.OriginalTestIds) { <input type="hidden" name="Form.OriginalTestIds" value="@testId" /> }
            </div>
            <label asp-for="Form.CategoryId" class="form-label">Item category</label>
            <select asp-for="Form.CategoryId" id="mapping-category" class="form-select mb-3" required>
                <option value="">Select category</option>
                @foreach (var category in Model.Items.GroupBy(i => i.CategoryId)) { <option value="@category.Key">@category.First().CategoryName</option> }
            </select>
            <label asp-for="Form.ItemId" class="form-label">Item</label>
            <select asp-for="Form.ItemId" id="mapping-item" class="form-select mb-3" required>
                <option value="">Select item</option>
                @foreach (var item in Model.Items) { <option value="@item.ItemId" data-category="@item.CategoryId">@item.ItemName</option> }
            </select>
            <label class="form-label" for="mapping-tests-toggle">Tests (multiple selection)</label>
            <div class="dropdown mb-3">
                <button id="mapping-tests-toggle" type="button" class="btn btn-outline-primary dropdown-toggle w-100 text-start" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">Select tests</button>
                <div class="dropdown-menu p-3 w-100" style="max-height:320px;overflow-y:auto" aria-labelledby="mapping-tests-toggle">
                    @foreach (var test in Model.Tests)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input mapping-test" type="checkbox" name="Form.SelectedTestIds" value="@test.TestId" id="mapping-test-@test.TestId" checked="@Model.Form.SelectedTestIds.Contains(test.TestId)" />
                            <label class="form-check-label" for="mapping-test-@test.TestId">@test.TestName @test.Unit</label>
                        </div>
                    }
                    @if (Model.Tests.Count == 0) { <span class="text-muted">Add tests in the test master first.</span> }
                </div>
            </div>
            <p id="mapping-selection-summary" class="text-muted small" aria-live="polite"></p>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Save item tests</button><a asp-action="Mappings" class="btn btn-outline-secondary">Clear</a></div>
            <noscript><p class="text-warning mt-2">Enable JavaScript for category/item filtering and loading existing test selections.</p></noscript>
        </form>
    </div>
    <div class="col-xl-8">
        <section class="card lab-mapping-list" aria-labelledby="mapping-list-title">
            <div class="lab-mapping-list-header"><div><h5 id="mapping-list-title">Configured item tests</h5><p class="text-muted mb-0">Tests assigned to each item</p></div><span class="lab-count">@Model.Mappings.Select(m => m.ItemId).Distinct().Count() items</span></div>
            <div class="table-responsive"><table class="table lab-mapping-table">
                <thead><tr><th scope="col">Item / category</th><th scope="col">Assigned tests</th><th scope="col" class="text-end">Manage</th></tr></thead>
                <tbody>
                @if (Model.Mappings.Count == 0) { <tr><td colspan="3" class="text-center py-5 text-muted">No item tests configured yet. Select an item and save its tests.</td></tr> }
                @foreach (var group in Model.Mappings.GroupBy(m => new { m.CategoryId, m.ItemId }))
                {
                    var first = group.First();
                    <tr>
                        <td><strong class="lab-mapping-item-name">@first.ItemName</strong><span class="d-block text-muted small">@first.CategoryName</span><span class="lab-test-count">@group.Count() test(s)</span></td>
                        <td><ul class="lab-mapped-tests">
                            @foreach (var mapping in group)
                            {
                                <li><span>@mapping.TestName</span><form asp-action="RemoveMapping" method="post" onsubmit="return confirm('Remove this test mapping? Saved reports will remain available.');"><input type="hidden" name="id" value="@mapping.MappingId" /><button type="submit" class="lab-remove-test" aria-label="Remove @mapping.TestName from @first.ItemName" title="Remove @mapping.TestName">Remove</button></form></li>
                            }
                        </ul></td>
                        <td class="text-end"><a asp-action="Mappings" asp-route-id="@first.MappingId" class="btn btn-sm btn-outline-primary text-nowrap">Edit tests</a></td>
                    </tr>
                }
                </tbody>
            </table></div>
        </section>
    </div>
</div>
<script id="mapping-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Mappings.Select(m => new { m.CategoryId, m.ItemId, m.TestId })))</script>
@section Scripts { <script src="~/js/lab-mappings.js" asp-append-version="true"></script> }
