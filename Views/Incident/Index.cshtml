@model IEnumerable<RiceMillProject.Models.SecurityIncident>
@{
    ViewData["Title"] = "Security Incident / Exception Register";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <div>
            <h3 class="erp-page-title">SECURITY INCIDENT & EXCEPTION REGISTER</h3>
            <p class="erp-page-subtitle">Log and track gate security exceptions, weight discrepancies, and perimeter incidents</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-plus-lg me-1"></i> Log New Exception
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">Incident No</th>
                    <th>Type</th>
                    <th>Related Entry</th>
                    <th>Severity</th>
                    <th>Description</th>
                    <th>Logged Date & Time</th>
                    <th class="text-end pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-danger font-monospace">@item.IncidentNo</td>
                            <td><span class="badge-erp badge-erp-info">@item.IncidentType</span></td>
                            <td>@(item.RelatedEntryNo ?? "N/A")</td>
                            <td>
                                @if (item.Severity == "Critical")
                                {
                                    <span class="badge-erp badge-erp-danger">Critical</span>
                                }
                                else if (item.Severity == "High")
                                {
                                    <span class="badge-erp badge-erp-warning">High</span>
                                }
                                else
                                {
                                    <span class="badge-erp badge-erp-info">@item.Severity</span>
                                }
                            </td>
                            <td>@item.Description</td>
                            <td>@item.IncidentDateTime.ToString("dd MMM hh:mm tt")</td>
                            <td class="text-end pe-4">
                                @if (item.Status == "Open")
                                {
                                    <span class="badge-erp badge-erp-danger">Open</span>
                                }
                                else
                                {
                                    <span class="badge-erp badge-erp-success">Resolved</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No security incidents logged.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
