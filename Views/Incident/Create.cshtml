@model RiceMillProject.Models.SecurityIncident
@{
    ViewData["Title"] = "Log Security Incident / Exception";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-shield-slash-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">LOG SECURITY INCIDENT / EXCEPTION</h3>
            <p class="erp-page-subtitle">Report gate security exceptions, mismatches, or authorized overrides</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> Security Incident Register</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Gate Location <span class="req-star">*</span></label>
                        <select asp-for="GateId" asp-items="ViewBag.Gates" class="form-select" required>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Incident Type <span class="req-star">*</span></label>
                        <select asp-for="IncidentType" class="form-select" required>
                            <option value="Document Mismatch">Document / Weight Mismatch</option>
                            <option value="Unauthorized Movement">Unauthorized Movement</option>
                            <option value="Vehicle Issue">Vehicle Damage / Driver Dispute</option>
                            <option value="Material Mismatch">Material Quality / Weight Issue</option>
                            <option value="Visitor Issue">Visitor Exception</option>
                            <option value="Other">Other Exception</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Related Entry / Gate Pass No</label>
                        <input asp-for="RelatedEntryNo" class="form-control" placeholder="e.g. INW-1002 / CHAL-55" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Severity Level <span class="req-star">*</span></label>
                        <select asp-for="Severity" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Incident Description <span class="req-star">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe exact issue..." required></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Immediate Action Taken</label>
                        <textarea asp-for="ActionTaken" class="form-control" rows="2" placeholder="e.g. Stopped truck at gate, informed supervisor..."></textarea>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-shield-lock-fill me-1"></i> Log Security Exception
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
