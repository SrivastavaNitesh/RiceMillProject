@model RiceMillProject.Models.GateEntry
@{
    ViewData["Title"] = "Gate Exit Process";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-box-arrow-right"></i>
        </div>
        <div>
            <h3 class="erp-page-title">OUTBOUND GATE EXIT & WEIGHMENT</h3>
            <p class="erp-page-subtitle">Record tare weight (empty vehicle) and calculate final net paddy weight</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to Gate Entries
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-truck text-primary me-2"></i> Phase 2: Outbound Tare Weighment</span>
            </div>
            <div class="erp-card-body">
                <div class="p-3 bg-light rounded border border-light-subtle mb-4">
                    <div class="row g-2">
                        <div class="col-6"><strong>RST Number:</strong> <span class="badge bg-primary font-monospace ms-1">@Model.RSTNumber</span></div>
                        <div class="col-6"><strong>Vehicle:</strong> <span class="fw-bold font-monospace ms-1">@Model.VehicleNumber</span></div>
                        <div class="col-12 mt-2"><strong>Inbound Gross Weight:</strong> <span class="badge bg-success font-monospace ms-1 fs-6">@Model.GrossWeight KG</span></div>
                    </div>
                </div>
                
                <form asp-action="Outbound" method="post" class="row g-3">
                    <input type="hidden" name="rstNumber" value="@Model.RSTNumber" />
                    
                    <div class="col-md-12">
                        <label for="tareWeight" class="form-label text-danger">Tare Weight (Empty Truck in KG) <span class="req-star">*</span></label>
                        <div class="input-group">
                            <input type="number" id="tareWeight" name="tareWeight" step="0.01" class="form-control form-control-lg border-danger font-monospace" placeholder="e.g. 8500" required />
                            <span class="input-group-text bg-danger text-white border-danger">KG</span>
                        </div>
                        <small class="text-muted">Net weight will be automatically calculated as (Gross - Tare - Deductions).</small>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Finalize Exit & Calculate Net Weight
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
