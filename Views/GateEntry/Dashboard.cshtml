@model IEnumerable<RiceMillProject.Models.GateEntry>
@{ ViewData["Title"] = "Weightman Dashboard"; var statusJson = ViewBag.StatusChart as string ?? "{\"pending\":0,\"completed\":0,\"grossOnly\":0}"; var dailyJson = ViewBag.DailyChart as string ?? "[]"; }
<div class="erp-page-header d-flex align-items-center gap-3 mb-4"><div class="erp-page-icon bg-primary text-white rounded p-2"><i class="bi bi-speedometer2 fs-3"></i></div><div><h3 class="erp-page-title fw-bold mb-0">WEIGHTMAN DASHBOARD</h3><p class="erp-page-subtitle text-muted mb-0">Weighment and RST status summary</p></div></div>
@if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger">@ViewBag.ErrorMessage</div> }
<div class="row g-3 mb-4">
 <div class="col-md-4"><div class="card border-0 shadow-sm border-start border-primary border-4 h-100" role="button" onclick="location.href='@Url.Action("Index")'"><div class="card-body d-flex justify-content-between"><div><small class="text-muted fw-bold">TOTAL RST ENTRIES</small><h2 class="text-primary mb-0">@(ViewBag.TotalEntries ?? 0)</h2></div><i class="bi bi-receipt text-primary fs-2"></i></div></div></div>
 <div class="col-md-4"><div class="card border-0 shadow-sm border-start border-warning border-4 h-100" role="button" onclick="location.href='@Url.Action("Index")'"><div class="card-body d-flex justify-content-between"><div><small class="text-muted fw-bold">PENDING TARE</small><h2 class="text-warning mb-0">@(ViewBag.PendingTare ?? 0)</h2></div><i class="bi bi-hourglass-split text-warning fs-2"></i></div></div></div>
 <div class="col-md-4"><div class="card border-0 shadow-sm border-start border-success border-4 h-100" role="button" onclick="location.href='@Url.Action("Index")'"><div class="card-body d-flex justify-content-between"><div><small class="text-muted fw-bold">COMPLETED WEIGHMENTS</small><h2 class="text-success mb-0">@(ViewBag.CompletedEntries ?? 0)</h2></div><i class="bi bi-check-circle text-success fs-2"></i></div></div></div>
</div>
<div class="row g-3"><div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-bold"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Weighment Status</div><div class="card-body"><div id="weightStatusPie" style="height:320px"></div></div></div></div><div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-bold"><i class="bi bi-graph-up text-success me-2"></i>Daily RST Entries</div><div class="card-body"><div id="weightDailyLine" style="height:320px"></div></div></div></div></div>
@section Scripts { <script src="https://code.highcharts.com/highcharts.js"></script><script>
 document.addEventListener('DOMContentLoaded',function(){const s=@Html.Raw(statusJson),d=@Html.Raw(dailyJson);Highcharts.chart('weightStatusPie',{chart:{type:'pie',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},plotOptions:{pie:{innerSize:'55%',dataLabels:{enabled:true,format:'{point.name}: {point.y}',style:{color:'#25324b'}}}},series:[{data:[{name:'Pending Gross',y:Number(s.pending)||0,color:'#f0ad00'},{name:'Completed',y:Number(s.completed)||0,color:'#198754'},{name:'Pending Tare',y:Number(s.grossOnly)||0,color:'#0d6efd'}]}]});Highcharts.chart('weightDailyLine',{chart:{type:'line',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},xAxis:{categories:d.map(x=>x.date)},yAxis:{allowDecimals:false,min:0,title:{text:'RST entries'}},series:[{name:'RST Entries',color:'#0d6efd',data:d.map(x=>Number(x.count)||0)}]});});
</script> }
