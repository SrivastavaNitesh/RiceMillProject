@model List<RiceMillProject.Models.WeighmentSlipModel>
@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><title>RST Weighment Slip</title><style>
*{box-sizing:border-box}body{font-family:Arial,sans-serif;color:#111;margin:0;background:#f2f4f5}.toolbar{max-width:800px;margin:16px auto;display:flex;gap:10px}.toolbar button,.toolbar a{padding:10px 16px;border:1px solid #999;background:white;color:#111;text-decoration:none;cursor:pointer}.slip{width:190mm;max-width:100%;margin:20px auto;padding:24px;background:white;border:1px solid #aaa}.heading{text-align:center;border-bottom:2px solid #111;padding-bottom:12px;margin-bottom:16px}.heading h2{font-size:20px;margin:0 0 8px}.heading h3{font-size:16px;margin:0}.rst{font-size:23px;font-weight:800;text-align:center;padding:12px;border:2px solid #111;margin-bottom:16px}table{width:100%;border-collapse:collapse;margin-bottom:16px}th,td{padding:9px;border:1px solid #aaa;text-align:left;font-size:13px;overflow-wrap:anywhere}th{width:40%;background:#f7f7f7}.weight td{font-size:19px;font-weight:bold}.signatures{display:flex;justify-content:space-between;margin-top:55px;font-size:12px}.signatures span{border-top:1px solid #555;padding-top:7px;min-width:130px;text-align:center}@@media print{@@page{size:A4;margin:10mm}body{background:white}.toolbar{display:none}.slip{margin:0;border:0;padding:0;break-after:page}.slip:last-child{break-after:auto}}
</style></head><body>
<div class="toolbar"><button onclick="window.print()">Print</button><a href="@Url.Action("Report","Gateman")">Back to Report</a></div>
@foreach(var slip in Model){bool final=slip.Stage=="final";<section class="slip"><header class="heading"><h2>ANNAPURNA AGRO INDIA PVT. LTD.</h2><h3>@(final?"FINAL WEIGHMENT SLIP":"FIRST WEIGHMENT SLIP")</h3></header><div class="rst">RST No. @slip.RstNumber</div><table>
<tr><th>Inward Number</th><td>@slip.InwardNo</td></tr>
@if(final){<tr><th>Inward Date &amp; Time</th><td>@slip.InwardAt?.ToString("dd-MMM-yyyy hh:mm tt")</td></tr>}
<tr><th>RST Date &amp; Time</th><td>@slip.WeighedAt?.ToString("dd-MMM-yyyy hh:mm tt")</td></tr><tr><th>Party / Supplier</th><td>@slip.Party</td></tr><tr><th>Vehicle Number</th><td>@slip.Vehicle</td></tr><tr><th>Driver Name</th><td>@slip.Driver</td></tr><tr><th>Driver Mobile</th><td>@slip.DriverMobile</td></tr><tr><th>Item Category</th><td>@slip.Category</td></tr><tr class="weight"><th>Gross Weight (KG)</th><td>@slip.Gross.ToString("N3")</td></tr>
@if(final){<tr class="weight"><th>Tare Weight (KG)</th><td>@slip.Tare?.ToString("N3")</td></tr><tr class="weight"><th>Net Weight (KG)</th><td>@slip.Net?.ToString("N3")</td></tr><tr><th>Unload Date / Time</th><td>@(slip.UnloadAt?.ToString("dd-MMM-yyyy hh:mm tt")??"—")</td></tr><tr><th>Status</th><td>@slip.Status</td></tr>}
<tr><th>Weighment Charge</th><td>₹ @slip.Charge.ToString("N2")</td></tr></table>
@if(final){<table><thead><tr><th>Bag Type</th><th>Bags</th></tr></thead><tbody>@foreach(var bag in slip.Bags){<tr><td>@bag.Key</td><td>@bag.Value</td></tr>}<tr><th>Total Bags</th><td><strong>@slip.Bags.Values.Sum()</strong></td></tr></tbody></table>}
<div class="signatures"><span>Driver Signature</span><span>Weightman Signature</span></div></section>}
<script>window.addEventListener('load',()=>window.print());</script></body></html>
