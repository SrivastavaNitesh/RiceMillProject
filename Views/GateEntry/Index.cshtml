@model IEnumerable<RiceMillProject.Models.GateEntry>
@{
    ViewData["Title"] = "Gate Operations";
}

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
            <i class="bi bi-door-open"></i> Gate Entry (Inbound / Outbound)
        </h4>
        <a asp-action="Create" class="btn btn-light btn-sm fw-bold text-primary">
            <i class="bi bi-box-arrow-in-right"></i> New Inbound Entry
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>RST Number</th>
                    <th>Vehicle</th>
                    <th>Party</th>
                    <th>Driver</th>
                    <th>Gross Wt.</th>
                    <th>Tare Wt.</th>
                    <th>Net Wt.</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.RSTNumber</td>
                        <td>@item.VehicleNumber</td>
                        <td>@item.PartyName</td>
                        <td>@item.DriverName</td>
                        <td><span class="badge bg-secondary">@item.GrossWeight kg</span></td>
                        <td>
                            @if (item.TareWeight.HasValue)
                            {
                                <span class="badge bg-secondary">@item.TareWeight kg</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.NetWeight.HasValue)
                            {
                                <span class="badge bg-success">@item.NetWeight kg</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Entered")
                            {
                                <span class="badge bg-warning text-dark">Inside Mill</span>
                            }
                            else if (item.Status == "Tested")
                            {
                                <span class="badge bg-info text-dark">Quality Checked</span>
                            }
                            else if (item.Status == "Exited")
                            {
                                <span class="badge bg-success">Exited</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@item.Status</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                @if (item.Status == "Entered")
                                {
                                    <a asp-controller="Unload" asp-action="Create" asp-route-rstNumber="@item.RSTNumber" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-truck"></i> Unload
                                    </a>
                                    <a asp-action="Outbound" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-box-arrow-right"></i> Exit
                                    </a>
                                }
                                else if (item.Status != "Exited")
                                {
                                    <a asp-action="Outbound" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-box-arrow-right"></i> Exit
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>Completed</button>
                                }
                                <a asp-action="Print" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-secondary" target="_blank">
                                    <i class="bi bi-printer"></i> Print
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
