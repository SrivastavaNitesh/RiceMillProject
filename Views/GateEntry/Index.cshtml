@model IEnumerable<RiceMillProject.Models.GateEntry>

@{
    ViewData["Title"] = "Gate Operations";
}

<!-- Page Header -->
<div class="erp-page-header">

    <div class="erp-page-title-group">

        <div class="erp-page-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>

        <div>
            <h3 class="erp-page-title">
                GATE OPERATIONS
            </h3>

            <p class="erp-page-subtitle">
                Inbound & outbound truck weight register & movement history
            </p>
        </div>

    </div>

    <button type="button" class="btn-erp-primary border-0" data-bs-toggle="modal" data-bs-target="#weightmanActionModal">

        <i class="bi bi-plus-lg me-1"></i>

        Take Action

    </button>

</div>


<div class="modal fade" id="weightmanActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header bg-primary text-white"><h5 class="modal-title"><i class="bi bi-lightning-charge me-2"></i>Weightman Action</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <div class="modal-body d-grid gap-2">
            <a asp-action="Create" class="btn btn-outline-primary text-start p-3"><i class="bi bi-plus-circle me-2"></i><strong>New RST / Inbound Weighment</strong><small class="d-block text-muted ms-4">Select pending inward and record gross weight</small></a>
            <button type="button" class="btn btn-outline-secondary text-start p-3" data-bs-dismiss="modal"><i class="bi bi-list-check me-2"></i><strong>View RST Action Board</strong><small class="d-block text-muted ms-4">Continue, End or take tare action from the list</small></button>
        </div>
    </div></div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger"
         role="alert">

        @errorMessage

    </div>
}


<div class="erp-table-container">

    <div class="table-responsive">

        <table class="erp-table">

            <thead>

                <tr>

                    <th class="ps-4">
                        RST Number
                    </th>

                    <th>
                        Vehicle
                    </th>

                    <th>
                        Party
                    </th>

                    <th>
                        Driver
                    </th>

                    <th>
                        Gross Wt.
                    </th>

                    <th>
                        Tare Wt.
                    </th>

                    <th>
                        Net Wt.
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="text-center pe-4">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- RST -->
                        <td class="ps-4 fw-bold text-primary">

                            @item.RSTNumber

                        </td>


                        <!-- VEHICLE -->
                        <td>

                            <strong class="text-dark">
                                @item.VehicleNumber
                            </strong>

                        </td>


                        <!-- PARTY -->
                        <td>

                            @item.PartyName

                        </td>


                        <!-- DRIVER -->
                        <td>

                            @item.DriverName

                        </td>


                        <!-- GROSS -->
                        <td>

                            <span class="badge-erp badge-erp-info">

                                @item.GrossWeight kg

                            </span>

                        </td>


                        <!-- TARE -->
                        <td>

                            @if (item.TareWeight.HasValue)
                            {
                                <span class="badge-erp badge-erp-warning">

                                    @item.TareWeight kg

                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </td>


                        <!-- NET -->
                        <td>

                            @if (item.NetWeight.HasValue)
                            {
                                <span class="badge-erp badge-erp-success">

                                    @item.NetWeight kg

                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    -
                                </span>
                            }

                        </td>


                        <!-- STATUS -->
                        <td>

                            @if (item.Status == "Entered")
                            {
                                <span class="badge-erp badge-erp-warning">

                                    Inside Mill

                                </span>
                            }
                            else if (item.Status == "WaitingForSupervisor")
                            {
                                <span class="badge-erp badge-erp-warning">

                                    Supervisor Pending

                                </span>
                            }
                            else if (item.Status == "UnloadingAssigned")
                            {
                                <span class="badge-erp badge-erp-info">

                                    Unloading Assigned

                                </span>
                            }
                            else if (item.Status == "WaitingForTare")
                            {
                                <span class="badge-erp badge-erp-warning">

                                    Waiting For Tare

                                </span>
                            }
                            else if (item.Status == "Tested")
                            {
                                <span class="badge-erp badge-erp-info">

                                    Quality Checked

                                </span>
                            }
                            else if (item.Status == "Exited")
                            {
                                <span class="badge-erp badge-erp-success">

                                    Exited

                                </span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="badge-erp badge-erp-success">

                                    Completed

                                </span>
                            }
                            else
                            {
                                <span class="badge-erp badge-erp-info">

                                    @item.Status

                                </span>
                            }

                        </td>


                        <!-- ACTION -->
                        <td class="text-center pe-4">

                            <div class="btn-group"
                                 role="group">


                                @*
                                    Other developer ka Unload button
                                    preserve kiya gaya hai.

                                    Unloading WaitingForTare par nahi hona chahiye.
                                    WaitingForTare ka matlab Meth unloading
                                    complete kar chuka hai.
                                *@

                                @if (
                                    User.IsSupervisorUser()
                                    &&
                                    (
                                        item.Status == "WaitingForSupervisor"
                                        ||
                                        item.Status == "Entered"
                                    )
                                )
                                {
                                    <a asp-controller="Unload"
                                       asp-action="Assign"
                                       asp-route-rstNumber="@item.RSTNumber"
                                       class="btn btn-sm btn-outline-success fw-bold">

                                        <i class="bi bi-truck me-1"></i>

                                        Unload

                                    </a>
                                }


                                @if (item.Status == "WaitingForTare")
                                {
                                    <a asp-action="Outbound"
                                       asp-route-id="@item.RSTNumber"
                                       class="btn btn-sm btn-outline-danger fw-bold">

                                        <i class="bi bi-speedometer2 me-1"></i>

                                        Take Tare

                                    </a>
                                }
                                else if (
                                    item.Status == "Completed"
                                    ||
                                    item.Status == "Exited"
                                )
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-light border text-muted"
                                            disabled>

                                        Completed

                                    </button>
                                }
                                else if (
                                    item.Status == "UnloadingAssigned"
                                )
                                {
                                    var actionModalId = "rstAction_" + item.RSTNumber.Replace("-", "_");
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#@actionModalId">Action</button>
                                    <div class="modal fade" id="@actionModalId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                                            <div class="modal-header bg-primary text-white"><h5 class="modal-title">RST Action - @item.RSTNumber</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
                                            <form asp-action="WeightmanAction" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <input type="hidden" name="RSTNumber" value="@item.RSTNumber" />
                                                    <label class="form-label fw-semibold">Current Gross Weight (KG)</label>
                                                    <input name="CurrentGrossWeight" type="number" min="0.01" step="0.001" class="form-control" placeholder="Enter Gross KG" required />
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="submit" name="ActionType" value="CONTINUE" class="btn btn-outline-primary fw-bold">Continue</button>
                                                    <button type="submit" name="ActionType" value="END" class="btn btn-outline-success fw-bold">End</button>
                                                </div>
                                            </form>
                                        </div></div>
                                    </div>
                                }
                                else if (
                                    item.Status == "WaitingForSupervisor"
                                    ||
                                    item.Status == "Entered"
                                )
                                {
                                    @if (!User.IsSupervisorUser())
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-light border text-muted"
                                                disabled>

                                            Supervisor Pending

                                        </button>
                                    }
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-light border text-muted"
                                            disabled>

                                        @item.Status

                                    </button>
                                }


                                <!-- PRINT -->
                                <a asp-action="Print"
                                   asp-route-id="@item.RSTNumber"
                                   class="btn btn-sm btn-outline-secondary"
                                   target="_blank"
                                   title="Print RST">

                                    <i class="bi bi-printer"></i>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
