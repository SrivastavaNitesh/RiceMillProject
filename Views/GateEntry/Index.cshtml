@model IEnumerable<RiceMillProject.Models.GateEntry>
@{
    ViewData["Title"] = "Gate Operations";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">GATE OPERATIONS</h3>
            <p class="erp-page-subtitle">Inbound & outbound truck weight register & movement history</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-plus-lg me-1"></i> New Inbound Entry
    </a>
</div>

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">RST Number</th>
                    <th>Vehicle</th>
                    <th>Party</th>
                    <th>Driver</th>
                    <th>Gross Wt.</th>
                    <th>Tare Wt.</th>
                    <th>Net Wt.</th>
                    <th>Status</th>
                    <th class="text-center pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-primary">@item.RSTNumber</td>
                        <td><strong class="text-dark">@item.VehicleNumber</strong></td>
                        <td>@item.PartyName</td>
                        <td>@item.DriverName</td>
                        <td><span class="badge-erp badge-erp-info">@item.GrossWeight kg</span></td>
                        <td>
                            @if (item.TareWeight.HasValue)
                            {
                                <span class="badge-erp badge-erp-warning">@item.TareWeight kg</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.NetWeight.HasValue)
                            {
                                <span class="badge-erp badge-erp-success">@item.NetWeight kg</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Entered")
                            {
                                <span class="badge-erp badge-erp-warning">Inside Mill</span>
                            }
                            else if (item.Status == "Tested")
                            {
                                <span class="badge-erp badge-erp-info">Quality Checked</span>
                            }
                            else if (item.Status == "Exited")
                            {
                                <span class="badge-erp badge-erp-success">Exited</span>
                            }
                            else
                            {
                                <span class="badge-erp badge-erp-info">@item.Status</span>
                            }
                        </td>
                        <td class="text-center pe-4">
                            <div class="btn-group" role="group">
                                @if (item.Status == "Entered")
                                {
                                    <a asp-controller="Unload" asp-action="Create" asp-route-rstNumber="@item.RSTNumber" class="btn btn-sm btn-outline-success fw-bold">
                                        <i class="bi bi-truck me-1"></i> Unload
                                    </a>
                                    <a asp-action="Outbound" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-outline-danger fw-bold">
                                        <i class="bi bi-box-arrow-right me-1"></i> Exit
                                    </a>
                                }
                                else if (item.Status != "Exited")
                                {
                                    <a asp-action="Outbound" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-outline-danger fw-bold">
                                        <i class="bi bi-box-arrow-right me-1"></i> Exit
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light border text-muted" disabled>Completed</button>
                                }
                                <a asp-action="Print" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-outline-secondary" target="_blank">
                                    <i class="bi bi-printer"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
