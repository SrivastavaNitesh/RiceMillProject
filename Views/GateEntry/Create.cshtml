@model RiceMillProject.Models.GateEntry

@{
    ViewData["Title"] = "Weightman Entry & RST Generation";

    // Dono developers ka role check preserve
    bool isWeightman =
        User.IsWeightmanUser()
        || User.HasClaim("PostId", "2");

    bool lockInward =
        ViewBag.LockInward == true;
}

@try
{
    <!-- Page Header -->
    <div class="erp-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

        <div class="erp-page-title-group">

            <div class="erp-page-icon">
                <i class="bi bi-speedometer2"></i>
            </div>

            <div>
                <h3 class="erp-page-title">
                    WEIGHTMAN ENTRY & RST GENERATION
                </h3>

                <p class="erp-page-subtitle">
                    Phase 2: Inbound vehicle gross weighment and backend RST number sequence
                </p>
            </div>

        </div>


        <div class="d-flex align-items-center gap-2">

            <div class="bg-white border rounded px-3 py-2 text-end shadow-sm">

                <small class="text-muted d-block fw-bold"
                       style="font-size:0.75rem;">
                    LIVE SYSTEM DATE & TIME
                </small>

                <span class="fw-bold text-primary"
                      id="headerLiveClock">
                    @DateTime.Now.ToString("dd MMM yyyy - hh:mm tt")
                </span>

            </div>


            <a asp-controller="@(isWeightman ? "Gateman" : "GateEntry")"
               asp-action="@(isWeightman ? "Report" : "Index")"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Register

            </a>

        </div>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="erp-card shadow-sm border-0 mb-4">

                <div class="erp-card-header bg-primary text-white d-flex justify-content-between align-items-center">

                    <span>
                        <i class="bi bi-truck-front-fill me-2"></i>
                        Inbound Weighbridge Form (Gross Weight)
                    </span>

                    <span class="badge bg-white text-primary fw-bold">
                        RST Auto Sequence
                    </span>

                </div>


                <div class="erp-card-body p-4">

                    <form id="weighbridgeForm"
                          asp-action="Create"
                          asp-controller="GateEntry"
                          method="post"
                          class="row g-3"
                          novalidate>

                        @Html.AntiForgeryToken()


                        <!-- =================================================
                             GATE INWARD ENTRY
                             ================================================= -->

                        <div class="col-12 bg-light p-3 rounded border mb-2">

                            <label class="form-label fw-bold text-dark mb-1">

                                <i class="bi bi-link-45deg me-1 text-primary"></i>

                                Gate Inward Entry

                                <span class="text-danger">*</span>

                            </label>


                            @if (lockInward)
                            {
                                <input asp-for="InwardNo"
                                       type="hidden"
                                       id="ddlInwardNo" />

                                <input type="text"
                                       class="form-control bg-light fw-bold"
                                       value="@Model.InwardNo"
                                       readonly />

                                <small class="text-success">

                                    <i class="bi bi-lock-fill me-1"></i>

                                    Selected by Inward ID:
                                    @ViewBag.InwardId

                                </small>
                            }
                            else
                            {
                                <select asp-for="InwardNo"
                                        class="form-select border-primary-subtle"
                                        asp-items="ViewBag.InwardEntries"
                                        id="ddlInwardNo"
                                        required>

                                    <option value="">
                                        -- Select Pending Gate Inward --
                                    </option>

                                </select>
                            }


                            <small class="text-muted">

                                Select an active Inward No from Gateman entry
                                to auto-link vehicle & supplier

                            </small>

                        </div>


                        <!-- =================================================
                             PARTY
                             ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="PartyId"
                                   class="form-label fw-bold text-dark">

                                Select Party / Supplier

                                <span class="text-danger">*</span>

                            </label>


                            @if (lockInward)
                            {
                                <input asp-for="PartyId"
                                       type="hidden"
                                       id="ddlParty" />

                                <input type="text"
                                       class="form-control bg-light"
                                       value="@ViewBag.PartyName"
                                       readonly />
                            }
                            else
                            {
                                <select asp-for="PartyId"
                                        class="form-select border-primary-subtle"
                                        asp-items="ViewBag.Parties"
                                        id="ddlParty"
                                        required>

                                    <option value="">
                                        -- Select Party / Supplier Master --
                                    </option>

                                    <option value="__other__">
                                        + Other / Add New Party
                                    </option>

                                </select>

                                <div id="otherPartyPanel"
                                     class="border rounded-3 p-3 mt-2 bg-light"
                                     style="display:none;">

                                    <div class="row g-2">

                                        <div class="col-md-7">

                                            <label class="form-label small fw-semibold">
                                                Party / Supplier Name
                                            </label>

                                            <input type="text"
                                                   id="txtOtherPartyName"
                                                   class="form-control"
                                                   maxlength="400"
                                                   placeholder="Enter Party / Supplier Name" />

                                        </div>

                                        <div class="col-md-5">

                                            <label class="form-label small fw-semibold">
                                                Mobile No. (Optional)
                                            </label>

                                            <input type="text"
                                                   id="txtOtherPartyMobile"
                                                   class="form-control"
                                                   maxlength="20"
                                                   inputmode="numeric"
                                                   placeholder="Enter Mobile Number" />

                                        </div>

                                    </div>

                                    <div class="mt-2 text-end">

                                        <button type="button"
                                                id="btnAddParty"
                                                class="btn btn-sm btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Party

                                        </button>

                                    </div>

                                </div>
                            }

                        </div>


                        <!-- =================================================
                             VEHICLE
                             ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="VehicleId"
                                   class="form-label fw-bold text-dark">

                                Select Vehicle

                                <span class="text-danger">*</span>

                            </label>


                            @if (lockInward)
                            {
                                <input asp-for="VehicleId"
                                       type="hidden"
                                       id="ddlVehicle" />

                                <input type="text"
                                       class="form-control bg-light"
                                       value="@ViewBag.VehicleNo"
                                       readonly />
                            }
                            else
                            {
                                <select asp-for="VehicleId"
                                        class="form-select border-primary-subtle"
                                        asp-items="ViewBag.Vehicles"
                                        id="ddlVehicle"
                                        required>

                                    <option value="">
                                        -- Select Vehicle --
                                    </option>

                                    <option value="__other__">
                                        + Other / Add New Vehicle
                                    </option>

                                </select>

                                <div id="otherVehiclePanel"
                                     class="border rounded-3 p-3 mt-2 bg-light"
                                     style="display:none;">

                                    <label class="form-label small fw-semibold">
                                        Vehicle Number
                                    </label>

                                    <div class="input-group">

                                        <input type="text"
                                               id="txtOtherVehicleNumber"
                                               class="form-control text-uppercase"
                                               maxlength="50"
                                               placeholder="e.g. UP32AB1234" />

                                        <button type="button"
                                                id="btnAddVehicle"
                                                class="btn btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Vehicle

                                        </button>

                                    </div>

                                </div>
                            }

                        </div>


                        <!-- =================================================
                             DRIVER
                             ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="DriverId"
                                   class="form-label fw-bold text-dark">

                                Select Driver / Mobile No.

                                <span class="text-danger">*</span>

                            </label>


                            @if (lockInward)
                            {
                                <input asp-for="DriverId"
                                       type="hidden"
                                       id="ddlDriver" />

                                <input type="text"
                                       class="form-control bg-light"
                                       value="@ViewBag.DriverName / @ViewBag.DriverMobile"
                                       readonly />
                            }
                            else
                            {
                                <select asp-for="DriverId"
                                        class="form-select border-primary-subtle"
                                        asp-items="ViewBag.Drivers"
                                        id="ddlDriver"
                                        required>

                                    <option value="">
                                        -- Select Driver (Name / Mobile No) --
                                    </option>

                                    <option value="__other__">
                                        + Other / Add New Driver
                                    </option>

                                </select>

                                <div id="otherDriverPanel"
                                     class="border rounded-3 p-3 mt-2 bg-light"
                                     style="display:none;">

                                    <div class="row g-2">

                                        <div class="col-md-7">

                                            <label class="form-label small fw-semibold">
                                                Driver Name
                                            </label>

                                            <input type="text"
                                                   id="txtOtherDriverName"
                                                   class="form-control"
                                                   maxlength="400"
                                                   placeholder="Enter Driver Name" />

                                        </div>

                                        <div class="col-md-5">

                                            <label class="form-label small fw-semibold">
                                                Mobile No. (Optional)
                                            </label>

                                            <input type="text"
                                                   id="txtOtherDriverMobile"
                                                   class="form-control"
                                                   maxlength="20"
                                                   inputmode="numeric"
                                                   placeholder="Enter Mobile Number" />

                                        </div>

                                    </div>

                                    <div class="mt-2 text-end">

                                        <button type="button"
                                                id="btnAddDriver"
                                                class="btn btn-sm btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Driver

                                        </button>

                                    </div>

                                </div>
                            }

                        </div>


                        <div class="col-md-6">
                            <label asp-for="ItemCategoryId" class="form-label fw-bold text-dark">
                                Item Category <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ItemCategoryId" asp-items="ViewBag.ItemCategories" class="form-select" required>
                                <option value="">-- Select Item Category --</option>
                            </select>
                            <span asp-validation-for="ItemCategoryId" class="text-danger"></span>
                        </div>

                        <!-- =================================================
                             GROSS WEIGHT
                             ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="GrossWeight"
                                   class="form-label fw-bold text-dark">

                                Gross Weight (Loaded Truck)

                                <span class="text-danger">*</span>

                            </label>


                            <div class="input-group">

                                <input asp-for="GrossWeight"
                                       type="number"
                                       step="0.01"
                                       id="txtGrossWeight"
                                       class="form-control form-control-lg fw-bold text-primary border-primary-subtle"
                                       placeholder="Enter Gross Weight in KG"
                                       required />


                                <span class="input-group-text bg-primary text-white fw-bold">

                                    KG

                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             WEIGHMENT CHARGE
                             ================================================= -->

                        <div class="col-md-6">

                            <label asp-for="WeighmentCharge"
                                   class="form-label fw-bold text-dark">

                                Weight Charge

                            </label>


                            <div class="input-group">

                                <span class="input-group-text">
                                    ₹
                                </span>


                                <input asp-for="WeighmentCharge"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />

                            </div>

                        </div>


                        <!-- =================================================
                             OTHER DEVELOPER COMPANY / LOCATION LOGIC
                             PRESERVED
                             ================================================= -->
                        @if (!isWeightman)
                        {
                            <div class="col-md-6">

                                <label asp-for="TargetOfficeId"
                                       class="form-label fw-semibold text-dark">

                                    Target Company Location

                                </label>


                                <select asp-for="TargetOfficeId"
                                        class="form-select"
                                        asp-items="ViewBag.Offices"
                                        id="gateOfficeDropdown">

                                    <option value="">
                                        -- Select Target Company --
                                    </option>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="TargetLocationIds"
                                       class="form-label fw-semibold text-dark">

                                    Target Unloading Locations

                                </label>


                                <select asp-for="TargetLocationIds"
                                        class="form-select"
                                        asp-items="ViewBag.Locations"
                                        multiple="multiple"
                                        style="height:100px;">
                                </select>


                                <small class="text-muted d-block mt-1">

                                    Hold Ctrl / Cmd key to select multiple locations

                                </small>

                            </div>
                        }


                        <!-- =================================================
                             ACTIONS
                             ================================================= -->

                        <div class="col-12 pt-3 border-top d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 shadow-sm">

                                <i class="bi bi-check-circle-fill me-1"></i>

                                GENERATE RST & SAVE

                            </button>


                            <a asp-controller="@(isWeightman ? "Gateman" : "GateEntry")"
                               asp-action="@(isWeightman ? "Report" : "Index")"
                               class="btn btn-outline-secondary px-4 py-2">

                                <i class="bi bi-x-circle me-1"></i>

                                CANCEL

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
}
catch (Exception ex)
{
    <div class="alert alert-danger mt-4">

        <h4>
            View Render Error
        </h4>

        <pre>@ex.ToString()</pre>

    </div>
}


<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }


    <script>

        // =========================================================
        // LIVE CLOCK
        // =========================================================

        function updateLiveClocks() {
            const now =
                new Date();


            const timeString =
                now.toLocaleTimeString(
                    'en-US',
                    {
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                    }
                );


            const dateString =
                now.toLocaleDateString(
                    'en-GB',
                    {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric'
                    }
                );


            const headerClock =
                document.getElementById(
                    'headerLiveClock'
                );


            if (headerClock) {
                headerClock.innerText =
                    dateString
                    + ' - '
                    + timeString;
            }
        }


        setInterval(
            updateLiveClocks,
            1000
        );


        updateLiveClocks();


        // =========================================================
        // PAGE LOAD
        // =========================================================

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                // =================================================
                // SUCCESS MESSAGE
                // =================================================

                @if (TempData["SuccessMessage"] != null)
                    {
                        <text>

                                Swal.fire({
                                    title: 'RST Generated!',
                                text: @Html.Raw(
                                                    System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["SuccessMessage"]?.ToString()
                                                    )
                                                    ),
                                icon: 'success',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#0d6efd'
                                    });

                        </text>
                }


                    // =================================================
                    // ERROR MESSAGE
                    // =================================================

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <text>

                                Swal.fire({
                                    title: 'Error!',
                                text: @Html.Raw(
                                                    System.Text.Json.JsonSerializer.Serialize(
                                                    TempData["ErrorMessage"]?.ToString()
                                                    )
                                                    ),
                                icon: 'error',
                                confirmButtonText: 'Close',
                                confirmButtonColor: '#dc3545'
                                    });

                        </text>
                }


                        // =================================================
                        // PARTY -> VEHICLE -> DRIVER
                        // + OTHER / QUICK ADD
                        // =================================================

                        const OTHER_VALUE =
                    '__other__';


                function getAntiForgeryToken() {
                    return document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    )?.value || '';
                }


                function showPanel(
                    panelId,
                    show) {
                    const panel =
                        document.getElementById(
                            panelId
                        );

                    if (panel) {
                        panel.style.display =
                            show
                                ? 'block'
                                : 'none';
                    }
                }


                function appendOtherOption(
                    select,
                    text) {
                    if (!select) {
                        return;
                    }

                    const option =
                        document.createElement(
                            'option'
                        );

                    option.value =
                        OTHER_VALUE;

                    option.textContent =
                        text;

                    select.appendChild(
                        option
                    );
                }


                function insertOrSelectOption(
                    select,
                    value,
                    textValue) {
                    if (!select) {
                        return;
                    }

                    const stringValue =
                        String(
                            value
                        );

                    let option =
                        Array.from(
                            select.options
                        )
                            .find(
                                x =>
                                    x.value ===
                                    stringValue
                            );


                    if (!option) {
                        option =
                            document.createElement(
                                'option'
                            );

                        option.value =
                            stringValue;

                        option.textContent =
                            textValue;


                        const otherOption =
                            Array.from(
                                select.options
                            )
                                .find(
                                    x =>
                                        x.value ===
                                        OTHER_VALUE
                                );


                        if (otherOption) {
                            select.insertBefore(
                                option,
                                otherOption
                            );
                        }
                        else {
                            select.appendChild(
                                option
                            );
                        }
                    }


                    select.value =
                        stringValue;
                }


                function resetVehicleDropdown() {
                    const ddlVehicle =
                        document.getElementById(
                            'ddlVehicle'
                        );

                    if (!ddlVehicle) {
                        return;
                    }

                    ddlVehicle.innerHTML =
                        '<option value="">-- Select Vehicle --</option>';


                    appendOtherOption(
                        ddlVehicle,
                        '+ Other / Add New Vehicle'
                    );


                    showPanel(
                        'otherVehiclePanel',
                        false
                    );
                }


                function resetDriverDropdown() {
                    const ddlDriver =
                        document.getElementById(
                            'ddlDriver'
                        );

                    if (!ddlDriver) {
                        return;
                    }

                    ddlDriver.innerHTML =
                        '<option value="">-- Select Driver (Name / Mobile No) --</option>';


                    appendOtherOption(
                        ddlDriver,
                        '+ Other / Add New Driver'
                    );


                    showPanel(
                        'otherDriverPanel',
                        false
                    );
                }


                function loadDriversByVehicle(
                    partyId,
                    vehicleId,
                    targetDriverId) {
                    resetDriverDropdown();

                    if (
                        !partyId
                        ||
                        partyId === OTHER_VALUE
                        ||
                        !vehicleId
                        ||
                        vehicleId === OTHER_VALUE
                    ) {
                        return;
                    }


                    fetch(
                        '/GateEntry/GetDriversByVehicle'
                        +
                        '?partyId='
                        +
                        encodeURIComponent(
                            partyId
                        )
                        +
                        '&vehicleId='
                        +
                        encodeURIComponent(
                            vehicleId
                        )
                    )
                        .then(response =>
                            response.json()
                        )
                        .then(data => {
                            const ddlDriver =
                                document.getElementById(
                                    'ddlDriver'
                                );


                            if (!ddlDriver) {
                                return;
                            }


                            ddlDriver.innerHTML =
                                '<option value="">-- Select Driver (Name / Mobile No) --</option>';


                            if (
                                data.success
                                &&
                                Array.isArray(
                                    data.drivers
                                )
                            ) {
                                data.drivers.forEach(
                                    function(driver) {
                                        const option =
                                            document.createElement(
                                                'option'
                                            );


                                        option.value =
                                            driver.driverId;


                                        option.textContent =
                                            driver.driverNameMobile;


                                        ddlDriver.appendChild(
                                            option
                                        );
                                    }
                                );
                            }


                            appendOtherOption(
                                ddlDriver,
                                '+ Other / Add New Driver'
                            );


                            if (
                                targetDriverId
                                &&
                                targetDriverId > 0
                            ) {
                                ddlDriver.value =
                                    targetDriverId;
                            }
                        })
                        .catch(error => {
                            console.error(
                                'Driver options error:',
                                error
                            );
                        });
                }


                function loadPartyOptions(
                    partyId,
                    targetVehicleId,
                    targetDriverId) {
                    resetVehicleDropdown();
                    resetDriverDropdown();

                    if (
                        !partyId
                        ||
                        partyId === OTHER_VALUE
                    ) {
                        return;
                    }


                    fetch(
                        '/GateEntry/GetPartyOptions?partyId='
                        +
                        encodeURIComponent(
                            partyId
                        )
                    )
                        .then(response =>
                            response.json()
                        )
                        .then(data => {
                            const ddlVehicle =
                                document.getElementById(
                                    'ddlVehicle'
                                );


                            if (!ddlVehicle) {
                                return;
                            }


                            ddlVehicle.innerHTML =
                                '<option value="">-- Select Vehicle --</option>';


                            if (
                                data.success
                                &&
                                Array.isArray(
                                    data.vehicles
                                )
                            ) {
                                data.vehicles.forEach(
                                    function(vehicle) {
                                        const option =
                                            document.createElement(
                                                'option'
                                            );


                                        option.value =
                                            vehicle.vehicleId;


                                        option.textContent =
                                            vehicle.vehicleNumber;


                                        ddlVehicle.appendChild(
                                            option
                                        );
                                    }
                                );
                            }


                            appendOtherOption(
                                ddlVehicle,
                                '+ Other / Add New Vehicle'
                            );


                            const selectedVehicleId =
                                targetVehicleId
                                ||
                                data.defaultVehicleId;


                            if (
                                selectedVehicleId
                                &&
                                selectedVehicleId > 0
                            ) {
                                ddlVehicle.value =
                                    selectedVehicleId;


                                loadDriversByVehicle(
                                    partyId,
                                    selectedVehicleId,
                                    targetDriverId
                                    ||
                                    data.defaultDriverId
                                );
                            }
                        })
                        .catch(error => {
                            console.error(
                                'Party options error:',
                                error
                            );
                        });
                }


                async function postQuickAdd(
                    url,
                    values) {
                    values.append(
                        '__RequestVerificationToken',
                        getAntiForgeryToken()
                    );


                    const response =
                        await fetch(
                            url,
                            {
                                method: 'POST',
                                headers:
                                {
                                    'Content-Type':
                                        'application/x-www-form-urlencoded; charset=UTF-8'
                                },
                                body:
                                    values.toString()
                            }
                        );


                    return await response.json();
                }


                // =================================================
                // PARTY CHANGE
                // =================================================

                const ddlParty =
                    document.getElementById(
                        'ddlParty'
                    );


                if (ddlParty) {
                    ddlParty.addEventListener(
                        'change',
                        function() {
                            const isOther =
                                this.value ===
                                OTHER_VALUE;


                            showPanel(
                                'otherPartyPanel',
                                isOther
                            );


                            if (isOther) {
                                resetVehicleDropdown();
                                resetDriverDropdown();

                                return;
                            }


                            loadPartyOptions(
                                this.value
                            );
                        }
                    );
                }


                // =================================================
                // VEHICLE CHANGE
                // =================================================

                const ddlVehicle =
                    document.getElementById(
                        'ddlVehicle'
                    );


                if (ddlVehicle) {
                    ddlVehicle.addEventListener(
                        'change',
                        function() {
                            const isOther =
                                this.value ===
                                OTHER_VALUE;


                            showPanel(
                                'otherVehiclePanel',
                                isOther
                            );


                            resetDriverDropdown();


                            if (isOther) {
                                return;
                            }


                            const partyId =
                                ddlParty?.value;


                            loadDriversByVehicle(
                                partyId,
                                this.value
                            );
                        }
                    );
                }


                // =================================================
                // DRIVER CHANGE
                // =================================================

                const ddlDriver =
                    document.getElementById(
                        'ddlDriver'
                    );


                if (ddlDriver) {
                    ddlDriver.addEventListener(
                        'change',
                        function() {
                            showPanel(
                                'otherDriverPanel',
                                this.value ===
                                OTHER_VALUE
                            );
                        }
                    );
                }


                // =================================================
                // ADD PARTY
                // =================================================

                const btnAddParty =
                    document.getElementById(
                        'btnAddParty'
                    );


                if (btnAddParty) {
                    btnAddParty.addEventListener(
                        'click',
                        async function() {
                            const partyName =
                                document.getElementById(
                                    'txtOtherPartyName'
                                )?.value.trim();


                            const mobileNumber =
                                document.getElementById(
                                    'txtOtherPartyMobile'
                                )?.value.trim();


                            if (!partyName) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Party Name Required',
                                    text: 'Please enter Party / Supplier Name.'
                                });

                                return;
                            }


                            this.disabled =
                                true;


                            try {
                                const values =
                                    new URLSearchParams();

                                values.append(
                                    'partyName',
                                    partyName
                                );

                                values.append(
                                    'mobileNumber',
                                    mobileNumber || ''
                                );


                                const result =
                                    await postQuickAdd(
                                        '/GateEntry/QuickAddParty',
                                        values
                                    );


                                if (!result.success) {
                                    throw new Error(
                                        result.message
                                        ||
                                        'Unable to add Party.'
                                    );
                                }


                                insertOrSelectOption(
                                    ddlParty,
                                    result.partyId,
                                    result.partyName
                                    ||
                                    partyName
                                );


                                showPanel(
                                    'otherPartyPanel',
                                    false
                                );


                                document.getElementById(
                                    'txtOtherPartyName'
                                ).value =
                                    '';


                                document.getElementById(
                                    'txtOtherPartyMobile'
                                ).value =
                                    '';


                                loadPartyOptions(
                                    result.partyId
                                );


                                Swal.fire({
                                    icon: 'success',
                                    title: 'Party Added',
                                    timer: 1200,
                                    showConfirmButton: false
                                });
                            }
                            catch (error) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Unable to Add Party',
                                    text: error.message
                                });
                            }
                            finally {
                                this.disabled =
                                    false;
                            }
                        }
                    );
                }


                // =================================================
                // ADD VEHICLE
                // =================================================

                const btnAddVehicle =
                    document.getElementById(
                        'btnAddVehicle'
                    );


                if (btnAddVehicle) {
                    btnAddVehicle.addEventListener(
                        'click',
                        async function() {
                            const partyId =
                                ddlParty?.value;


                            const vehicleNumber =
                                document.getElementById(
                                    'txtOtherVehicleNumber'
                                )?.value
                                    .trim()
                                    .toUpperCase()
                                    .replace(
                                        /\s+/g,
                                        ''
                                    );


                            if (
                                !partyId
                                ||
                                partyId ===
                                OTHER_VALUE
                            ) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Select Party First',
                                    text: 'Please select or add Party before adding Vehicle.'
                                });

                                return;
                            }


                            if (!vehicleNumber) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Vehicle Number Required',
                                    text: 'Please enter Vehicle Number.'
                                });

                                return;
                            }


                            this.disabled =
                                true;


                            try {
                                const values =
                                    new URLSearchParams();

                                values.append(
                                    'partyId',
                                    partyId
                                );

                                values.append(
                                    'vehicleNumber',
                                    vehicleNumber
                                );


                                const result =
                                    await postQuickAdd(
                                        '/GateEntry/QuickAddVehicle',
                                        values
                                    );


                                if (!result.success) {
                                    throw new Error(
                                        result.message
                                        ||
                                        'Unable to add Vehicle.'
                                    );
                                }


                                insertOrSelectOption(
                                    ddlVehicle,
                                    result.vehicleId,
                                    result.vehicleNumber
                                    ||
                                    vehicleNumber
                                );


                                showPanel(
                                    'otherVehiclePanel',
                                    false
                                );


                                document.getElementById(
                                    'txtOtherVehicleNumber'
                                ).value =
                                    '';


                                loadDriversByVehicle(
                                    partyId,
                                    result.vehicleId
                                );


                                Swal.fire({
                                    icon: 'success',
                                    title: 'Vehicle Added',
                                    text: 'Now select an existing Driver or choose Other to add a new Driver.',
                                    timer: 1800,
                                    showConfirmButton: false
                                });
                            }
                            catch (error) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Unable to Add Vehicle',
                                    text: error.message
                                });
                            }
                            finally {
                                this.disabled =
                                    false;
                            }
                        }
                    );
                }


                // =================================================
                // ADD DRIVER
                // =================================================

                const btnAddDriver =
                    document.getElementById(
                        'btnAddDriver'
                    );


                if (btnAddDriver) {
                    btnAddDriver.addEventListener(
                        'click',
                        async function() {
                            const partyId =
                                ddlParty?.value;


                            const vehicleId =
                                ddlVehicle?.value;


                            const driverName =
                                document.getElementById(
                                    'txtOtherDriverName'
                                )?.value.trim();


                            const mobileNumber =
                                document.getElementById(
                                    'txtOtherDriverMobile'
                                )?.value.trim();


                            if (
                                !partyId
                                ||
                                partyId ===
                                OTHER_VALUE
                            ) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Select Party First'
                                });

                                return;
                            }


                            if (
                                !vehicleId
                                ||
                                vehicleId ===
                                OTHER_VALUE
                            ) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Select Vehicle First'
                                });

                                return;
                            }


                            if (!driverName) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Driver Name Required',
                                    text: 'Please enter Driver Name.'
                                });

                                return;
                            }


                            this.disabled =
                                true;


                            try {
                                const values =
                                    new URLSearchParams();

                                values.append(
                                    'partyId',
                                    partyId
                                );

                                values.append(
                                    'vehicleId',
                                    vehicleId
                                );

                                values.append(
                                    'driverName',
                                    driverName
                                );

                                values.append(
                                    'mobileNumber',
                                    mobileNumber || ''
                                );


                                const result =
                                    await postQuickAdd(
                                        '/GateEntry/QuickAddDriver',
                                        values
                                    );


                                if (!result.success) {
                                    throw new Error(
                                        result.message
                                        ||
                                        'Unable to add Driver.'
                                    );
                                }


                                insertOrSelectOption(
                                    ddlDriver,
                                    result.driverId,
                                    result.driverNameMobile
                                    ||
                                    driverName
                                );


                                showPanel(
                                    'otherDriverPanel',
                                    false
                                );


                                document.getElementById(
                                    'txtOtherDriverName'
                                ).value =
                                    '';


                                document.getElementById(
                                    'txtOtherDriverMobile'
                                ).value =
                                    '';


                                Swal.fire({
                                    icon: 'success',
                                    title: 'Driver Added & Linked',
                                    timer: 1400,
                                    showConfirmButton: false
                                });
                            }
                            catch (error) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Unable to Add Driver',
                                    text: error.message
                                });
                            }
                            finally {
                                this.disabled =
                                    false;
                            }
                        }
                    );
                }


                // =================================================
                // INWARD CHANGE
                // =================================================

                const ddlInward =
                    document.getElementById(
                        'ddlInwardNo'
                    );


                if (ddlInward) {
                    ddlInward.addEventListener(
                        'change',
                        function() {
                            const inwardNo =
                                this.value;


                            if (!inwardNo) {
                                return;
                            }


                            fetch(
                                '/GateEntry/GetInwardDetails?inwardNo='
                                + encodeURIComponent(
                                    inwardNo
                                )
                            )
                                .then(response =>
                                    response.json()
                                )
                                .then(data => {
                                    if (
                                        data.success
                                        &&
                                        data.partyId
                                    ) {
                                        if (ddlParty) {
                                            ddlParty.value =
                                                data.partyId;
                                        }


                                        loadPartyOptions(
                                            data.partyId,
                                            data.vehicleId,
                                            data.driverId
                                        );
                                    }
                                })
                                .catch(error => {
                                    console.error(
                                        'Inward details error:',
                                        error
                                    );
                                });
                        }
                    );


                    if (ddlInward.value) {
                        ddlInward.dispatchEvent(
                            new Event(
                                'change'
                            )
                        );
                    }
                }


                // =================================================
                // FORM VALIDATION
                // =================================================

                const form =
                    document.getElementById(
                        'weighbridgeForm'
                    );


                if (form) {
                    form.addEventListener(
                        'submit',
                        function(e) {
                            const party =
                                document.getElementById(
                                    'ddlParty'
                                )?.value;


                            const inwardNo =
                                document.getElementById(
                                    'ddlInwardNo'
                                )?.value;


                            const vehicle =
                                document.getElementById(
                                    'ddlVehicle'
                                )?.value;


                            const driver =
                                document.getElementById(
                                    'ddlDriver'
                                )?.value;


                            const grossWt =
                                parseFloat(
                                    document
                                        .getElementById(
                                            'txtGrossWeight'
                                        )
                                        ?.value
                                    || '0'
                                );


                            let missing = [];


                            if (!inwardNo) {
                                missing.push(
                                    'Gate Inward Entry'
                                );
                            }


                            if (
                                !party
                                ||
                                party === OTHER_VALUE
                            ) {
                                missing.push(
                                    'Party / Supplier Master'
                                );
                            }


                            if (
                                !vehicle
                                ||
                                vehicle === OTHER_VALUE
                            ) {
                                missing.push(
                                    'Vehicle Selection'
                                );
                            }


                            if (
                                !driver
                                ||
                                driver === OTHER_VALUE
                            ) {
                                missing.push(
                                    'Driver / Mobile Number'
                                );
                            }


                            if (
                                !grossWt
                                ||
                                grossWt <= 0
                            ) {
                                missing.push(
                                    'Gross Weight (KG)'
                                );
                            }


                            if (missing.length > 0) {
                                e.preventDefault();


                                Swal.fire({
                                    title: 'Validation Error!',

                                    html:
                                        '<div class="text-start">'
                                        +
                                        '<strong>Kripya sabhi mandatory fields ko fill karein:</strong>'
                                        +
                                        '<ul class="mt-2 text-danger">'
                                        +
                                        missing
                                            .map(
                                                m =>
                                                    '<li>'
                                                    + m
                                                    + '</li>'
                                            )
                                            .join('')
                                        +
                                        '</ul>'
                                        +
                                        '</div>',

                                    icon: 'warning',

                                    confirmButtonText:
                                        'Okay, I will fill them',

                                    confirmButtonColor:
                                        '#0d6efd'
                                });


                                return false;
                            }
                        }
                    );
                }

            }
        );

    </script>
}
