@model RiceMillProject.Models.GateEntry
@using System.Text.Json
@{
    ViewData["Title"] = "Weightman Entry & RST Generation";
    var pending = (List<RiceMillProject.Models.PendingRstInward>)ViewBag.PendingInwards;
}
<div class="erp-page-header">
    <div><h3>WEIGHTMAN ENTRY & RST GENERATION</h3><p>Select a pending inward to record gross weight and generate its RST.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Register</a>
</div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<form asp-action="Create" method="post" id="weighbridgeForm" class="erp-card p-4">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (pending.Count == 0) { <div class="alert alert-info">No pending inward entries requiring RST are available.</div> }
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="InwardNo" class="form-label">Pending Inward Number *</label>
            <select asp-for="InwardNo" id="ddlInwardNo" class="form-select" required>
                <option value="">-- Select Pending Inward --</option>
                @foreach (var inward in pending) { <option value="@inward.InwardNo">@inward.InwardNo (@inward.VehicleNumber)</option> }
            </select>
            <span asp-validation-for="InwardNo" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label for="ddlVehicle" class="form-label">Vehicle Number *</label>
            <select id="ddlVehicle" class="form-select"><option value="">-- Select Vehicle --</option></select>
        </div>
        <div class="col-md-6">
            <label for="ddlDriver" class="form-label">Driver / Mobile Number *</label>
            <select id="ddlDriver" class="form-select"><option value="">-- Select Driver --</option></select>
        </div>
        <div class="col-md-6">
            <label for="inwardParty" class="form-label">Party / Supplier</label>
            <input id="inwardParty" class="form-control" readonly />
        </div>
        <div class="col-12"><p id="inward-link-message" class="text-muted mb-0" aria-live="polite"></p></div>
        <div class="col-md-6">
            <label asp-for="GrossWeight" class="form-label">Gross Weight (KG) *</label>
            <input asp-for="GrossWeight" id="txtGrossWeight" class="form-control" type="number" min="0.01" step="0.01" required />
            <span asp-validation-for="GrossWeight" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="TargetOfficeId" class="form-label">Company Name</label>
            <select asp-for="TargetOfficeId" asp-items="ViewBag.Offices" class="form-select">
                <option value="">-- Select Company --</option>
            </select>
        </div>
        <div class="col-12"><button type="submit" id="generate-rst" class="btn btn-primary" disabled>GENERATE RST &amp; SAVE</button></div>
    </div>
</form>
<script id="pending-inward-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(pending))</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/gate-entry.js" asp-append-version="true"></script>
}