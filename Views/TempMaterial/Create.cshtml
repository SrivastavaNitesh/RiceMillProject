@model RiceMillProject.Models.TempMaterialRegister
@{
    ViewData["Title"] = "Temporary Tools Inward Registration";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-tools"></i>
        </div>
        <div>
            <h3 class="erp-page-title">TEMPORARY MATERIAL INWARD REGISTRATION</h3>
            <p class="erp-page-subtitle">Register returnable tools, machinery, and equipment entering plant premises</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-md-11">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Material / Tool Inward Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Select Gate <span class="req-star">*</span></label>
                        <select asp-for="GateId" asp-items="ViewBag.Gates" class="form-select" required>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Owner / Vendor Name <span class="req-star">*</span></label>
                        <input asp-for="OwnerVendor" class="form-control" placeholder="Person / Service Company Name" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Item Category <span class="req-star">*</span></label>
                        <select asp-for="ItemCategory" class="form-select" required>
                            <option value="Machine">Machine / Heavy Equipment</option>
                            <option value="Tool">Hand Tool / Kit</option>
                            <option value="Electrical">Electrical Component / Motor</option>
                            <option value="Spare">Spare Part</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Item Description <span class="req-star">*</span></label>
                        <input asp-for="ItemDescription" class="form-control" placeholder="Detailed description of tool" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Quantity <span class="req-star">*</span></label>
                        <input asp-for="Quantity" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unit <span class="req-star">*</span></label>
                        <select asp-for="Unit" class="form-select">
                            <option value="Nos">Nos</option>
                            <option value="Set">Set</option>
                            <option value="Box">Box</option>
                            <option value="Kg">Kg</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Serial / Asset No</label>
                        <input asp-for="SerialAssetNo" class="form-control" placeholder="Equipment Tag / Serial No" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Purpose <span class="req-star">*</span></label>
                        <select asp-for="Purpose" class="form-select">
                            <option value="Repair">Repair Work</option>
                            <option value="Service">Routine Servicing</option>
                            <option value="Installation">New Installation</option>
                            <option value="Demo">Trial / Demo</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Target Department <span class="req-star">*</span></label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                        </select>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Register Tool Inward
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
