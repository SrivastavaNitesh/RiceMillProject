@model RiceMillProject.Models.User
@{
    ViewData["Title"] = "Employee Sign In";
    ViewData["PublicPage"] = "login";
    Layout = "_LayoutPublic";
}
<section class="signin-stage" aria-labelledby="signin-title">
    <div class="signin-focus-card">
        <div class="signin-focus-heading">
            <span class="signin-emblem"><span class="agro-logo-mark" role="img" aria-label="Annapurna logo"></span></span>
            <span class="signin-overline">ANNAPURNA EMPLOYEE PORTAL</span>
            <h1 id="signin-title">Welcome back</h1>
            <p>Sign in to your workspace.</p>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert"><div asp-validation-summary="ModelOnly" class="text-danger"></div></div>
        }
        <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div class="signin-field">
                <label asp-for="Username">Username</label>
                <div class="signin-input"><i class="bi bi-person" aria-hidden="true"></i><input asp-for="Username" autocomplete="username" required placeholder="Enter your username" /></div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="signin-field">
                <label asp-for="Password">Password</label>
                <div class="signin-input"><i class="bi bi-lock" aria-hidden="true"></i><input asp-for="Password" type="password" autocomplete="current-password" required placeholder="Enter your password" /><button type="button" data-password-toggle aria-label="Show password" aria-controls="Password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button class="public-button signin-submit" type="submit">Sign in <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
        </form>
        <div class="signin-focus-help"><i class="bi bi-headset" aria-hidden="true"></i><p>Need help signing in?<br /><span>Contact your administrator for account assistance.</span></p></div>
        <div class="signin-focus-trust"><i class="bi bi-shield-check" aria-hidden="true"></i> Secure access for authorized employees</div>
    </div>
    <p class="signin-stage-caption">Cultivating happiness. Growing together.</p>
</section>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
