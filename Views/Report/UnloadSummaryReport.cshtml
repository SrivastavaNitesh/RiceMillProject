@model IEnumerable<RiceMillProject.Models.UnloadTransaction>
@{
    ViewData["Title"] = "Unloading Summary Report";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">UNLOADING SUMMARY REPORT</h3>
            <p class="erp-page-subtitle">Detailed log of truck unloadings, Meth labour assignments, bag counts, and deductions</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn-erp-secondary">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <a asp-action="Index" class="btn-erp-outline">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">RST Number</th>
                    <th>Supervisor</th>
                    <th>Gate Man</th>
                    <th>Meth (Labour Head)</th>
                    <th>Bag Type</th>
                    <th>Total Bags</th>
                    <th>Deduction</th>
                    <th>Unload Time</th>
                    <th class="no-print pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-primary">@item.RSTNumber</td>
                        <td>@item.SupervisorName</td>
                        <td>@item.GateManId</td>
                        <td><strong class="text-dark">@item.MethName</strong></td>
                        <td><span class="badge-erp badge-erp-info">@item.BagTypeName</span></td>
                        <td><span class="badge-erp badge-erp-success">@item.NumberOfBags Bags</span></td>
                        <td>@item.TotalBagDeductionGrams g</td>
                        <td>@(item.UnloadTime?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
                        <td class="no-print pe-4">
                            <a asp-controller="Unload" asp-action="Print" asp-route-id="@item.RSTNumber" class="btn btn-sm btn-outline-success" target="_blank">
                                <i class="bi bi-printer me-1"></i> Slip
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
