@model System.Data.DataTable
@{ViewData["Title"]="Edit Parameters";var bindings=(System.Data.DataTable)ViewBag.Bindings;}
<h2>Edit Parameters</h2><p class="text-muted">Limits start at the original entry time. Change a policy's duration, or assign its Policy ID to another existing role/module binding. Changes apply immediately.</p>
<div asp-validation-summary="All" class="text-danger"></div>
@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
@if(TempData["ErrorMessage"]!=null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}
@foreach(System.Data.DataRow r in Model.Rows){<form asp-action="Policies" method="post" class="card card-body mb-3"><div class="row g-3 align-items-end"><input type="hidden" name="PolicyId" value="@r["PolicyId"]"/><input type="hidden" name="Version" value="@r["EditVersion"]"/><div class="col-md-1"><strong>ID @r["PolicyId"]</strong></div><div class="col-md-3"><label class="form-label">Name</label><input class="form-control" name="PolicyName" value="@r["PolicyName"]" maxlength="100" required/></div><div class="col-md-2"><label class="form-label">Minutes (blank = no time limit)</label><input class="form-control" type="number" name="WindowMinutes" value="@r["WindowMinutes"]" min="1" max="5256000"/></div><div class="col-md-2"><label><input type="checkbox" name="StopAtOutward" value="true" checked="@Convert.ToBoolean(r["StopAtOutward"])"/> Stop at outward</label></div><div class="col-md-2"><label><input type="checkbox" name="IsActive" value="true" checked="@Convert.ToBoolean(r["IsActive"])"/> Active</label></div><div class="col-md-2"><button class="btn btn-primary">Save policy</button></div></div></form>}
<h4 class="mt-4">Role / entry policy assignments</h4>
@foreach(System.Data.DataRow b in bindings.Rows){<form asp-action="BindPolicy" method="post" class="d-flex gap-3 align-items-center mb-2"><input type="hidden" name="module" value="@b["ModuleKey"]"/><input type="hidden" name="postId" value="@b["PostId"]"/><span class="col-md-4">@b["ModuleKey"] — @b["PostName"]</span><label class="form-label mb-0">Policy ID</label><select class="form-select w-auto" name="policyId">@foreach(System.Data.DataRow p in Model.Rows){<option value="@p["PolicyId"]" selected="@(Convert.ToInt32(p["PolicyId"])==Convert.ToInt32(b["PolicyId"]))">@p["PolicyId"] — @p["PolicyName"]</option>}</select><button class="btn btn-outline-primary">Assign</button></form>}
