@model RiceMillProject.Models.RecordEditForm
@{ViewData["Title"]="Edit Gate Inward — "+Model.Access.ReferenceNo;var visible=new[]{"InwardTypeId","PartyId","VehicleNo","DriverName","PurposeRemarks"};string? Value(string name)=>Model.Values.GetValueOrDefault(name);var inward=Model.Fields.First(f=>f.Name=="InwardTypeId");var party=Model.Fields.First(f=>f.Name=="PartyId");}
<div class="erp-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div class="erp-page-title-group"><div class="erp-page-icon"><i class="bi bi-door-open-fill"></i></div><div><h3 class="erp-page-title">GATEMAN INWARD ENTRY</h3><p class="erp-page-subtitle">Edit vehicle entry, supplier party, and inward type</p></div></div><a asp-action="GateInwardReport" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Register</a></div>
<div class="row"><div class="col-12"><div class="erp-card shadow-sm border-0 mb-4"><div class="erp-card-header bg-primary text-white d-flex justify-content-between align-items-center"><span><i class="bi bi-pencil-square me-2"></i>Vehicle Inward Entry Form — @Model.Access.ReferenceNo</span></div><div class="erp-card-body p-4">
<form asp-controller="RecordEdit" asp-action="Edit" method="post" id="record-edit-form" class="row g-3" data-edit-mode="disable" data-edit-expiry="@Model.Access.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm:ss+05:30")">
<input asp-for="ModuleKey" type="hidden"/><input asp-for="RecordId" type="hidden"/><input asp-for="Version" type="hidden"/>
@foreach(var f in Model.Fields.Where(f=>!visible.Contains(f.Name))){<input type="hidden" name="Values[@f.Name]" value="@Value(f.Name)"/>}
<div asp-validation-summary="All" class="text-danger col-12"></div>
@if(!Model.Access.CanEdit){<div class="alert alert-warning col-12">@Model.Access.LockedReason. Changes have not been saved.</div>}
<div class="col-md-6"><label class="form-label fw-bold text-dark"><i class="bi bi-calendar-event me-1 text-primary"></i>Inward Date</label><input class="form-control bg-light fw-bold text-dark" value="@Model.Access.EntryAt.ToString("dd/MM/yyyy")" readonly/></div>
<div class="col-md-6"><label class="form-label fw-bold text-dark"><i class="bi bi-clock me-1 text-primary"></i>Inward Time</label><input class="form-control bg-light fw-bold text-primary" value="@Model.Access.EntryAt.ToString("hh:mm tt")" readonly/></div>
<div class="col-md-6"><label class="form-label fw-bold text-dark">Inward Type <span class="text-danger">*</span></label><div class="d-flex align-items-center gap-3 p-2 bg-light rounded border">@foreach(var option in inward.Options){<div class="form-check me-2"><input class="form-check-input" type="radio" name="Values[InwardTypeId]" id="inward-type-@option.Value" value="@option.Value" checked="@(Value("InwardTypeId")==option.Value)" required/><label class="form-check-label fw-bold text-primary" for="inward-type-@option.Value">@option.Text</label></div>}</div></div>
<div class="col-md-6"><label class="form-label fw-bold text-dark" for="field-PartyId">Party / Supplier <span class="text-danger">*</span></label><select class="form-select border-primary-subtle" name="Values[PartyId]" id="field-PartyId" required><option value="">Select Party</option>@foreach(var option in party.Options){<option value="@option.Value" selected="@(Value("PartyId")==option.Value)">@option.Text</option>}</select></div>
<div class="col-md-6"><label class="form-label fw-bold text-dark" for="field-VehicleNo">Vehicle Number <span class="text-danger">*</span></label><select class="form-select border-primary-subtle" name="Values[VehicleNo]" id="field-VehicleNo" required><option value="">Select Vehicle</option>@foreach(var option in Model.GateVehicles){<option value="@option.Value" selected="@(Value("VehicleNo")==option.Value)">@option.Text</option>}</select></div>
<div class="col-md-6"><label class="form-label fw-bold text-dark" for="field-DriverName">Driver Name <span class="text-danger">*</span></label><select class="form-select" name="Values[DriverName]" id="field-DriverName" required><option value="">Select Driver</option>@foreach(var option in Model.GateDrivers){<option value="@option.Value" selected="@(Value("DriverName")==option.Value)">@option.Text</option>}</select></div>
<div class="col-md-6"><label class="form-label fw-bold text-dark"><i class="bi bi-person-badge me-1 text-primary"></i>Gateman (Added By)</label><input class="form-control bg-light fw-bold text-dark" value="@Model.GateAddedBy" readonly/></div>
<div class="col-12"><label class="form-label fw-semibold text-muted" for="field-PurposeRemarks">Remarks / Material Purpose (Optional)</label><input type="text" class="form-control" name="Values[PurposeRemarks]" id="field-PurposeRemarks" value="@Value("PurposeRemarks")" maxlength="250" placeholder="Remarks"/></div>
<div class="col-12"><label asp-for="Reason" class="form-label fw-semibold">Reason for edit <span class="text-danger">*</span></label><textarea asp-for="Reason" class="form-control" maxlength="500" required></textarea></div>
<div class="col-12 pt-3 border-top d-flex gap-2"><button type="submit" class="btn btn-primary px-4 py-2 shadow-sm edit-window-action" disabled="@(!Model.Access.CanEdit)"><i class="bi bi-check-circle-fill me-1"></i>SAVE CHANGES</button><button type="reset" class="btn btn-outline-secondary px-4 py-2"><i class="bi bi-arrow-counterclockwise me-1"></i>RESET</button><a asp-action="GateInwardReport" class="btn btn-outline-secondary px-4 py-2">Cancel</a><span class="edit-window-expired text-danger" hidden>Edit time expired.</span></div>
</form></div></div></div></div>
<style>
#record-edit-form .select2-container .select2-selection--single{height:39px;border:1px solid #dee2e6}#record-edit-form .select2-selection__rendered{line-height:37px;padding-left:12px}#record-edit-form .select2-selection__arrow{height:37px}
</style>
@section Scripts{<script src="~/js/gateman-linked-selection.js" asp-append-version="true" defer></script><script>
(()=>{if(!window.jQuery||!jQuery.fn.select2)return;const fields=jQuery('#field-PartyId,#field-VehicleNo,#field-DriverName');fields.select2({width:'100%',allowClear:true,minimumResultsForSearch:0,placeholder:'Select',dropdownParent:jQuery('#record-edit-form').closest('.erp-card')});document.getElementById('record-edit-form').addEventListener('reset',()=>setTimeout(()=>fields.trigger('change.select2'),0));})();
</script>}
