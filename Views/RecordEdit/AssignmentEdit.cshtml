@model RiceMillProject.Models.RecordEditForm
@{ Layout="_LayoutSupervisor"; ViewData["Title"]="Edit Unloading Assignment"; var locations=Model.Fields.Single(f=>f.Name=="LocationId"); var meth=Model.Fields.Single(f=>f.Name=="MethId"); }
<div class="erp-page-header"><div class="erp-page-title-group"><div class="erp-page-icon"><i class="bi bi-person-plus-fill"></i></div><div><h3 class="erp-page-title">ASSIGN METH / UNLOADING CONTRACTOR</h3><p class="erp-page-subtitle">Update unloading locations and labor team for this RST</p></div></div><a asp-controller="Unload" asp-action="AssignmentRegister" class="btn-erp-outline">Back to Assignment Register</a></div>
<div class="row justify-content-center"><div class="col-lg-6 col-md-8"><div class="erp-card"><div class="erp-card-header" style="background:#f8fafc;color:#214b47"><span><i class="bi bi-person-check text-primary me-2"></i>Unloading Assignment Details</span></div><div class="erp-card-body">
<form asp-action="Edit" method="post" id="record-edit-form" class="row g-3" data-edit-expiry="@Model.Access.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm:ss+05:30")">
<input asp-for="ModuleKey" type="hidden"/><input asp-for="RecordId" type="hidden"/><input asp-for="Version" type="hidden"/>
<div asp-validation-summary="All" class="text-danger"></div>
@if(!Model.Access.CanEdit){<div class="alert alert-warning">@Model.Access.LockedReason</div>}
<div class="col-12"><label class="form-label">RST Number</label><input class="form-control bg-light font-monospace fw-bold" value="@Model.Access.ReferenceNo" readonly/></div>
<div class="col-12"><label class="form-label" for="assignment-location-summary">Unloading Location <span class="req-star">*</span></label><details id="assignment-locations" class="position-relative"><summary id="assignment-location-summary" class="form-select">Select unloading locations</summary><div class="border rounded bg-white p-2 shadow-sm position-absolute w-100" style="z-index:10;max-height:240px;overflow:auto">@foreach(var option in locations.Options){<label class="d-flex align-items-center gap-2 p-2"><input type="checkbox" class="form-check-input m-0" name="SelectedLocationIds" value="@option.Value" checked="@(Model.SelectedLocationIds.Contains(int.Parse(option.Value)))"/><span>@option.Text</span></label>}</div></details><span asp-validation-for="SelectedLocationIds" class="text-danger"></span><small class="text-muted">Select one or more locations where this vehicle will be unloaded.</small></div>
<div class="col-12"><label for="assignment-meth" class="form-label">Assign to Meth (Labor Head) <span class="req-star">*</span></label><select id="assignment-meth" class="form-select" name="Values[MethId]" required><option value="">-- Select Meth --</option>@foreach(var option in meth.Options){<option value="@option.Value" selected="@(Model.Values.GetValueOrDefault("MethId")==option.Value)">@option.Text</option>}</select></div>
<div class="col-12"><label asp-for="Reason" class="form-label">Reason for correction</label><textarea asp-for="Reason" class="form-control" required maxlength="500"></textarea></div>
<div class="col-12 d-flex justify-content-between border-top pt-3 mt-4"><a asp-controller="Unload" asp-action="AssignmentRegister" class="btn-erp-secondary">Cancel</a><button type="submit" class="btn-erp-primary edit-window-action" disabled="@(!Model.Access.CanEdit)">Save Assignment</button><span class="edit-window-expired text-danger" hidden>Edit time expired.</span></div>
</form></div></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>
(()=>{const dropdown=document.getElementById('assignment-locations'),summary=dropdown.querySelector('summary'),options=[...dropdown.querySelectorAll('input')],error=document.querySelector('[data-valmsg-for="SelectedLocationIds"]');
function update(){const selected=options.filter(o=>o.checked);summary.textContent=selected.length?selected.map(o=>o.nextElementSibling.textContent.trim()).join(', '):'Select unloading locations';if(selected.length)error.textContent='';}
dropdown.addEventListener('change',update);dropdown.closest('form').addEventListener('submit',e=>{if(!options.some(o=>o.checked)){e.preventDefault();error.textContent='Please select at least one unloading location.';dropdown.open=true;summary.focus();}});document.addEventListener('click',e=>{if(!dropdown.contains(e.target))dropdown.open=false;});dropdown.addEventListener('keydown',e=>{if(e.key==='Escape'){dropdown.open=false;summary.focus();}});update();})();
</script>}
