@model OrderReturnDetails
@{ ViewData["Title"]="Return Details"; var locations=(List<LookupOption>)ViewBag.Locations;var vehicles=(List<LookupOption>)ViewBag.Vehicles;var bags=(List<LookupOption>)ViewBag.BagTypes;var workers=(List<LookupOption>)ViewBag.Workers;var canOps=User.IsAdminUser()||User.IsMethUser()||User.IsSupervisorUser(); }
<style>
.rd{padding:24px;max-width:1600px;margin:auto;color:#263d45}.rd-head{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:25px 28px;border:1px solid #d8e7e5;border-radius:19px;background:linear-gradient(135deg,#fff,#f2faf9 70%,#e2f4f1);box-shadow:0 12px 34px rgba(18,72,67,.09)}.rd-head:after{content:"";position:absolute;right:-60px;top:-95px;width:250px;height:250px;border:42px solid rgba(13,139,128,.07);border-radius:50%}.rd-back{display:inline-flex;align-items:center;gap:6px;margin-bottom:9px;color:#087b72;font-size:11px;font-weight:800;text-decoration:none}.rd-head h2{margin:0;color:#153943;font-size:25px;font-weight:800}.rd-meta{display:flex;flex-wrap:wrap;gap:7px;margin-top:9px}.rd-meta span{padding:5px 9px;border:1px solid #d3e5e2;border-radius:7px;background:#fff;color:#657a82;font-size:11px}.rd-state{position:relative;z-index:1;min-width:165px;padding:13px 15px;border:1px solid #c7e4df;border-radius:13px;background:#fff}.rd-state small{display:block;color:#7d8c91;font-size:9px;font-weight:800;letter-spacing:.08em}.rd-state strong{display:block;margin-top:4px;color:#087b72;font-size:15px}.rd-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:17px 0}.rd-kpi,.rd-card{background:#fff;border:1px solid #deebe9;border-radius:15px;box-shadow:0 6px 20px rgba(8,67,61,.055)}.rd-kpi{position:relative;padding:18px 18px 17px;border-top:3px solid #26a89c;color:#71838a;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.035em}.rd-kpi b{display:block;margin-top:7px;font-size:26px;color:#173d44}.rd-card{margin-top:14px;padding:19px}.rd-card h5{margin:0 0 15px;color:#193d45;font-size:15px;font-weight:800}.rd-form{display:flex;gap:10px;flex-wrap:wrap;align-items:end}.rd-form>div{min-width:160px;flex:1}.rd-form label{display:block;margin-bottom:6px;color:#465d65;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.rd-form input,.rd-form select,.rd-form textarea{width:100%;min-height:42px;padding:9px 11px;border:1px solid #cbd9d7;border-radius:9px;background:#fbfdfd}.rd-form input:focus,.rd-form select:focus{border-color:#23a79b;box-shadow:0 0 0 3px rgba(35,167,155,.11);outline:0;background:#fff}.rd-btn{min-height:42px;border:0;background:linear-gradient(135deg,#087b72,#13a095);color:#fff;border-radius:9px;padding:10px 15px;font-weight:800}.rd-btn.red{background:linear-gradient(135deg,#b93645,#db4a58)}.rd-table{width:100%;border-collapse:separate;border-spacing:0}.rd-table th{background:linear-gradient(180deg,#edf8f6,#e2f1ef);color:#315b58;padding:12px;border-bottom:2px solid #80c9c1;font-size:10px;text-transform:uppercase;letter-spacing:.055em}.rd-table td{padding:12px;border-bottom:1px solid #edf1f1;font-size:12px;vertical-align:middle}.rd-table tbody tr:nth-child(even){background:#fafcfc}.worker-row{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;margin-top:8px}@@media(max-width:900px){.rd-grid{grid-template-columns:repeat(2,1fr)}.rd-head{align-items:flex-start;flex-direction:column}.rd-state{width:100%}}@@media(max-width:520px){.rd{padding:15px}.rd-grid{grid-template-columns:1fr 1fr}.rd-head{padding:21px}.worker-row{grid-template-columns:1fr}}
</style>
<div class="rd">
 <div class="rd-head"><div><a asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> Return Register</a><h2>@Model.ReturnNumber <span class="text-muted">/</span> @Model.RSTNumber</h2><div class="rd-meta"><span><i class="bi bi-building me-1"></i>@Model.PartyName</span><span><i class="bi bi-truck me-1"></i>@Model.VehicleNumber</span><span><i class="bi bi-geo-alt me-1"></i>@Model.SourceLocationName</span></div></div><div class="rd-state"><small>CURRENT CASE STATUS</small><strong>@Model.Status</strong></div></div>
 @if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger mt-3">@error</div>} @if(TempData["SuccessMessage"] is string success){<div class="alert alert-success mt-3">@success</div>}
 <div class="rd-grid"><div class="rd-kpi">Requested Bags<b>@Model.RequestedBags</b></div><div class="rd-kpi">Approved Bags<b>@Model.ApprovedBags</b></div><div class="rd-kpi">Dispatched Bags<b>@Model.DispatchedBags</b></div><div class="rd-kpi">Remaining Bags<b>@Model.RemainingBags</b></div></div>
 <section class="rd-card"><h5>Return Reason &amp; Quality Decision</h5><p>@Model.ReturnReason</p><span class="badge bg-info text-dark">@Model.Status</span> <span class="text-muted">@Model.QualityRemarks</span>
 @if((User.IsAdminUser()||User.IsLabUser())&&Model.Status=="PendingQuality"){<form asp-action="Decide" method="post" class="rd-form mt-3">@Html.AntiForgeryToken()<input type="hidden" name="OrderReturnId" value="@Model.OrderReturnId"/><div><label>Decision</label><select name="Decision" required><option value="Approved">Approve Return</option><option value="Rejected">Reject Return</option></select></div><div><label>Approved Bags</label><input name="ApprovedBags" type="number" min="1" max="@Model.RequestedBags" /></div><div><label>Quality Remarks</label><input name="Remarks" maxlength="1000" /></div><button class="rd-btn">Save Decision</button></form>}
 </section>
 @if(canOps&&(Model.Status=="Approved"||Model.Status=="PartiallyProcessed")&&Model.RemainingBags>0){<section class="rd-card"><h5>Create Partial / Final Dispatch</h5><form asp-action="CreateDispatch" method="post" class="rd-form">@Html.AntiForgeryToken()<input type="hidden" name="OrderReturnId" value="@Model.OrderReturnId"/><div><label>Dispatch Bags</label><input name="DispatchBags" type="number" min="1" max="@Model.RemainingBags" required/></div><div><label>Return Vehicle (optional now)</label><select name="VehicleId"><option value="">Assign later</option>@foreach(var x in vehicles){<option value="@x.Id">@x.Name</option>}</select></div><div><label>Remarks</label><input name="Remarks"/></div><button class="rd-btn">Create Dispatch</button></form></section>}
 @if(canOps&&(Model.Status=="Approved"||Model.Status=="PartiallyProcessed")){<section class="rd-card"><h5>Record Paid Handling Movement</h5><form asp-action="SaveMovement" method="post" id="movementForm">@Html.AntiForgeryToken()<input type="hidden" name="OrderReturnId" value="@Model.OrderReturnId"/><div class="rd-form"><div><label>Movement</label><select name="MovementType" required><option value="ReturnTruckLoading">Load on Return Truck</option><option value="InternalShiftLoading">Internal Shift - Loading</option><option value="InternalShiftUnloading">Internal Shift - Unloading</option></select></div><div><label>Dispatch</label><select name="DispatchId"><option value="">Not linked</option>@foreach(var x in Model.Dispatches.Where(x=>x.Status=="HandlingPending")){<option value="@x.DispatchId">@x.DispatchNumber (@x.DispatchBags)</option>}</select></div><div><label>From Location</label><select name="FromLocationId"><option value="">Select</option>@foreach(var x in locations){<option value="@x.Id">@x.Name</option>}</select></div><div><label>To Location</label><select name="ToLocationId"><option value="">Select</option>@foreach(var x in locations){<option value="@x.Id">@x.Name</option>}</select></div><div><label>Bag Type</label><select name="BagTypeId" required>@foreach(var x in bags){<option value="@x.Id">@x.Name</option>}</select></div><div><label>Bags</label><input name="Bags" type="number" min="1" required/></div></div><div id="workers"></div><button type="button" class="btn btn-outline-secondary mt-2" onclick="addWorker()">+ Add Worker</button> <button class="rd-btn mt-2">Save Movement</button></form></section>}
 <section class="rd-card"><h5>Dispatch &amp; Gate Flow</h5><div class="table-responsive"><table class="rd-table"><thead><tr><th>Dispatch</th><th>Bags</th><th>Vehicle</th><th>Weight</th><th>Status</th><th>Next Action</th></tr></thead><tbody>@foreach(var x in Model.Dispatches){<tr><td>@x.DispatchNumber</td><td>@x.DispatchBags</td><td>@x.VehicleNumber</td><td>@(x.NetWeight?.ToString("0.###")??"-")</td><td>@x.Status</td><td>@if((User.IsAdminUser()||User.IsWeightmanUser())&&x.Status=="ReadyForWeighment"){<form asp-action="SaveWeight" method="post" class="rd-form">@Html.AntiForgeryToken()<input type="hidden" name="DispatchId" value="@x.DispatchId"/><input type="hidden" name="orderReturnId" value="@Model.OrderReturnId"/><input name="GrossWeight" type="number" step=".001" placeholder="Gross" required/><input name="TareWeight" type="number" step=".001" placeholder="Tare" required/><select name="VehicleId" required><option value="">Vehicle</option>@foreach(var v in vehicles){<option value="@v.Id" selected="@(x.VehicleId==v.Id)">@v.Name</option>}</select><button class="rd-btn">Save Weight</button></form>}else if((User.IsAdminUser()||User.IsGatemanUser())&&x.Status=="ReadyForGateOut"){<form asp-action="CompleteOutward" method="post">@Html.AntiForgeryToken()<input type="hidden" name="dispatchId" value="@x.DispatchId"/><input type="hidden" name="orderReturnId" value="@Model.OrderReturnId"/><button class="rd-btn red">Gate Outward</button></form>}else{<span>-</span>}</td></tr>}</tbody></table></div></section>
 <section class="rd-card"><h5>Worker Payment Movements</h5><table class="rd-table"><thead><tr><th>Movement</th><th>Route</th><th>Bag Type</th><th>Bags</th><th>Payable</th><th>Date</th></tr></thead><tbody>@foreach(var x in Model.Movements){<tr><td>@x.MovementType</td><td>@x.FromLocation → @x.ToLocation</td><td>@x.BagType</td><td>@x.Bags</td><td>₹@x.Amount.ToString("0.00")</td><td>@x.MovementAt.ToString("dd MMM yyyy, hh:mm tt")</td></tr>}</tbody></table></section>
</div>
<script>
const workerOptions=`<option value="">Select worker</option>@Html.Raw(string.Join("",workers.Select(x=>$"<option value='{x.Id}'>{System.Net.WebUtility.HtmlEncode(x.Name)}</option>")))`;let wi=0;
function addWorker(){const row=document.createElement('div');row.className='worker-row';row.innerHTML=`<select name="Workers[${wi}].WorkerId" required>${workerOptions}</select><input name="Workers[${wi}].BagsHandled" type="number" min="1" placeholder="Bags" required/><input name="Workers[${wi}].PerBagRate" type="number" min="0" step=".01" placeholder="Rate / bag" required/><button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()">×</button>`;document.getElementById('workers').appendChild(row);wi++;}addWorker();
document.getElementById('movementForm')?.addEventListener('submit',()=>document.querySelectorAll('#workers .worker-row').forEach((row,index)=>row.querySelectorAll('select,input').forEach(input=>input.name=input.name.replace(/Workers\[\d+\]/,`Workers[${index}]`))));
</script>
