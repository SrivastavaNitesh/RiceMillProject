@model OrderReturnPage
@{
    ViewData["Title"] = "Order Returns";
    var canCreate = User.IsAdminUser() || User.IsMethUser() || User.IsSupervisorUser();
    var returnedCount = Model.EligibleRsts.Count(x => x.OrderReturnId > 0);
    var eligibleCount = Model.EligibleRsts.Count(x => x.CanCreateReturn);
}
<style>
.or-wrap{padding:24px;max-width:1600px;margin:auto;color:#172b35}.or-hero{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:25px 28px;border:1px solid #d9e8e6;border-radius:18px;background:linear-gradient(135deg,#fff,#f4fbfa 68%,#e2f5f2);box-shadow:0 12px 32px rgba(20,70,66,.08)}.or-title{display:flex;align-items:center;gap:16px}.or-title-icon{display:grid;place-items:center;width:54px;height:54px;border-radius:15px;background:linear-gradient(145deg,#0b7168,#16a296);color:#fff;font-size:23px}.or-eyebrow{display:block;margin-bottom:4px;color:#0b8177;font-size:10px;font-weight:800;letter-spacing:.13em}.or-hero h1{margin:0;color:#153943;font-size:26px;font-weight:800}.or-hero p{margin:5px 0 0;color:#607780;font-size:13px}.or-summary{display:flex;gap:10px}.or-summary div{min-width:105px;padding:11px 13px;border:1px solid #d2e8e4;border-radius:12px;background:#fff}.or-summary strong{display:block;color:#087b72;font-size:20px}.or-summary span{color:#74868d;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.or-card{margin-top:18px;overflow:hidden;border:1px solid #dfe9e8;border-radius:16px;background:#fff;box-shadow:0 8px 25px rgba(20,55,60,.06)}.or-card-head{display:flex;justify-content:space-between;align-items:center;padding:18px 21px;border-bottom:1px solid #e5eceb}.or-card-head h4{margin:0;color:#183b43;font-size:16px;font-weight:800}.or-card-head p{margin:4px 0 0;color:#76868d;font-size:11px}.or-count{padding:6px 10px;border-radius:999px;background:#e8f6f4;color:#08786f;font-size:11px;font-weight:800}.or-table{width:100%;border-collapse:separate;border-spacing:0}.or-table th{padding:13px 15px;border-bottom:2px solid #80c9c1;background:linear-gradient(180deg,#edf8f6,#e2f1ef);color:#315b58;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap}.or-table td{padding:14px 15px;border-bottom:1px solid #edf1f1;color:#31474f;font-size:13px;vertical-align:middle}.or-table tbody tr:nth-child(even){background:#fafcfc}.or-table tbody tr:hover{background:#f0f9f7}.or-ref{color:#087b72;font-weight:800}.or-sub{display:block;margin-top:3px;color:#849299;font-size:11px}.or-number{font-weight:800;color:#243b44}.or-stage,.or-state{display:inline-flex;padding:6px 10px;border-radius:999px;font-size:10px;font-weight:800}.or-stage{border:1px solid #d7e3e1;background:#f6f9f9;color:#52676e}.or-state.returned{border:1px solid #bfe3dd;background:#e9f7f4;color:#08786f}.or-state.open{border:1px solid #f1d59c;background:#fff8e7;color:#946200}.or-link,.or-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:8px 12px;border-radius:9px;font-size:11px;font-weight:800;text-decoration:none}.or-link{border:1px solid #bee1dc;background:#fff;color:#087d74}.or-link:hover{background:#087d74;color:#fff}.or-btn{border:0;background:linear-gradient(135deg,#087b72,#12a094);color:#fff}.or-disabled{display:block;max-width:190px;color:#89979c;font-size:10px;line-height:1.35}.or-empty{text-align:center;padding:52px!important;color:#89979c!important}.or-modal-note{padding:11px 13px;border-radius:10px;background:#eff8f6;color:#315b58;font-size:12px}.or-modal .form-label{font-size:11px;font-weight:800;color:#415860;text-transform:uppercase}.or-modal .form-control,.or-modal .form-select{min-height:44px;border-color:#cfdddb;border-radius:10px}@@media(max-width:850px){.or-hero{align-items:flex-start;flex-direction:column}.or-summary{width:100%}.or-summary div{flex:1;min-width:0}}@@media(max-width:600px){.or-wrap{padding:14px}.or-title-icon{display:none}.or-hero h1{font-size:22px}}
</style>
<style>
.or-wrap{font-family:'Plus Jakarta Sans','Inter',system-ui,-apple-system,'Segoe UI',sans-serif}.or-heading{display:flex;align-items:center;gap:16px;text-align:left;padding:23px 25px;border:1px solid #dce9e7;border-radius:15px;background:#fff;box-shadow:0 8px 24px rgba(20,70,66,.06)}
.or-heading-icon{display:grid;place-items:center;flex:0 0 50px;width:50px;height:50px;margin:0;border:1px solid #cce7e2;border-radius:13px;background:#eaf7f4;color:#087d74;font-size:22px}
.or-heading h1{margin:2px 0 0;color:#173a43;font-size:24px;font-weight:750;letter-spacing:-.02em}.or-heading p{max-width:none;margin:6px 0 0;color:#647980;font-size:13px;line-height:1.55}.or-heading .or-eyebrow{font-size:11px;letter-spacing:.08em}
.or-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}.or-metric{display:flex;align-items:center;gap:13px;padding:17px 18px;border:1px solid #deebe9;border-radius:14px;background:#fff;box-shadow:0 6px 20px rgba(20,55,60,.045)}
.or-metric-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:11px;background:#edf8f6;color:#087d74;font-size:18px}.or-metric strong{display:block;color:#193b43;font-size:22px;line-height:1;font-weight:750}.or-metric span{display:block;margin-top:6px;color:#647980;font-size:12px;font-weight:650;letter-spacing:0}
.or-card-head{padding:19px 22px;background:#fbfdfd}.or-report-title{display:flex;align-items:center;gap:12px}.or-report-title>i{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#e7f5f2;color:#087d74;font-size:17px}.or-card-head h4{font-size:17px;font-weight:750}.or-card-head p{font-size:12px;line-height:1.5}.or-count{font-size:12px}
.or-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 20px;border-bottom:1px solid #e8efee;background:#fff}.or-search{position:relative;max-width:360px;flex:1}.or-search i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#8a9a9f}.or-search input,.or-toolbar select{height:40px;border:1px solid #d4e1df;border-radius:9px;background:#fbfdfd;color:#344d55;font-size:12px;outline:0}.or-search input{width:100%;padding:8px 12px 8px 37px}.or-toolbar select{min-width:175px;padding:8px 12px}.or-search input:focus,.or-toolbar select:focus{border-color:#31a99e;box-shadow:0 0 0 3px rgba(49,169,158,.1);background:#fff}
.or-table th{padding:14px 16px;background:#edf7f5;color:#294e4a;border-bottom-color:#79c4bc;font-size:12px;font-weight:700;text-transform:none;letter-spacing:0}.or-table td{height:68px;padding:14px 16px;font-size:13px}.or-ref,.or-number{font-weight:700}.or-sub{font-size:12px}.or-stage,.or-state{font-size:11px;font-weight:700}.or-link,.or-btn{font-size:12px;font-weight:700}.or-disabled{max-width:210px;font-size:11px;line-height:1.45}.or-result-empty{display:none;text-align:center;padding:30px;color:#84949a;font-size:13px}
@@media(max-width:700px){.or-metrics{grid-template-columns:1fr}.or-toolbar{align-items:stretch;flex-direction:column}.or-search{max-width:none}.or-toolbar select{width:100%}}
</style>
<style>
.or-wrap{max-width:1540px;padding:22px}.crm-workspace{overflow:hidden;border:1px solid #d8e4e7;border-radius:14px;background:#fff;box-shadow:0 10px 32px rgba(31,55,68,.08)}
.crm-header{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:20px 24px;border-top:4px solid #0b8d83;border-bottom:1px solid #dfe8ea;background:linear-gradient(110deg,#fff 0%,#f7fbfb 65%,#edf8f6 100%)}.crm-title{display:flex;align-items:center;gap:14px}.crm-title-icon{display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;border-radius:10px;background:#0b8d83;color:#fff;font-size:19px;box-shadow:0 5px 14px rgba(11,141,131,.22)}.crm-breadcrumb{display:block;margin-bottom:3px;color:#6b7f87;font-size:11px;font-weight:600}.crm-title h1{margin:0;color:#18343d;font-size:22px;font-weight:750}.crm-title p{margin:4px 0 0;color:#70838a;font-size:12px}.crm-stats{display:flex;align-items:stretch;border:1px solid #d5e5e3;border-radius:10px;background:#fff}.crm-stat{min-width:112px;padding:10px 14px;border-right:1px solid #e3eceb}.crm-stat:last-child{border-right:0}.crm-stat span{display:block;color:#74878e;font-size:10px;font-weight:650}.crm-stat strong{display:block;margin-top:3px;color:#173a43;font-size:19px;font-weight:750}.crm-stat.available strong{color:#078477}
.crm-workspace .or-card{margin:0;border:0;border-radius:0;box-shadow:none}.crm-workspace .or-card-head{padding:16px 22px;background:#fff}.crm-workspace .or-report-title>i{width:35px;height:35px;border:1px solid #cae5e1;background:#eff8f7}.crm-workspace .or-card-head h4{font-size:15px}.crm-workspace .or-card-head p{font-size:11px}.crm-workspace .or-toolbar{padding:12px 22px;background:#f7f9fa}.crm-workspace .or-search{max-width:430px}.crm-workspace .or-search input,.crm-workspace .or-toolbar select{background:#fff}
.crm-workspace .or-table{min-width:1180px;table-layout:auto}.crm-workspace .or-table th{padding:12px 15px;background:#f1f5f6;color:#4b626a;border-bottom:1px solid #cedcdf;font-size:11px}.crm-workspace .or-table td{height:62px;padding:12px 15px;border-bottom-color:#e6edef;font-size:12px}.crm-workspace .or-table th:nth-child(1){width:125px}.crm-workspace .or-table th:nth-child(2){min-width:250px}.crm-workspace .or-table th:nth-child(3),.crm-workspace .or-table th:nth-child(4){width:105px;text-align:center}.crm-workspace .or-table th:nth-child(5){min-width:170px}.crm-workspace .or-table th:nth-child(6){min-width:135px}.crm-workspace .or-table th:nth-child(7){min-width:145px}.crm-workspace .or-table th:nth-child(8){min-width:155px}.crm-workspace .or-table td:nth-child(3),.crm-workspace .or-table td:nth-child(4){text-align:center}.crm-workspace .or-table tbody tr:nth-child(even){background:#fbfcfd}.crm-workspace .or-table tbody tr:hover{background:#f2f8f7}.crm-workspace .or-sub{font-size:11px}.crm-workspace .or-stage,.crm-workspace .or-state{white-space:nowrap}.crm-workspace .or-btn,.crm-workspace .or-link{white-space:nowrap;border-radius:7px;box-shadow:none}
.or-modal .modal-content{overflow:hidden;border:1px solid #d7e3e5!important;border-radius:14px!important}.or-modal .modal-header{padding:18px 21px;border-top:4px solid #0b8d83;border-bottom:1px solid #dfe8ea;background:#f8fbfb}.or-modal-title{display:flex;align-items:center;gap:12px}.or-modal-title>i{display:grid;place-items:center;width:38px;height:38px;border-radius:9px;background:#e5f4f1;color:#087d74;font-size:17px}.or-modal-title h5{margin:0;color:#173740;font-size:17px;font-weight:750}.or-modal-title small{display:block;margin-top:3px;font-size:11px}.or-modal .modal-body{padding:22px}.or-modal .modal-footer{padding:14px 21px;border-top:1px solid #e2eaec;background:#f8fafb}.or-modal-note{border:1px solid #cfe5e1;background:#f1f9f7}.or-modal .form-label{font-size:12px;font-weight:650;text-transform:none;letter-spacing:0}.or-modal .form-control,.or-modal .form-select{font-size:13px;border-radius:7px}.or-modal .btn-light{border:1px solid #d4dfe2;background:#fff;font-size:12px;font-weight:650}
@@media(max-width:850px){.crm-header{align-items:flex-start;flex-direction:column}.crm-stats{width:100%}.crm-stat{flex:1;min-width:0}.or-wrap{padding:14px}}
</style>
<div class="or-wrap">
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger mt-3">@error</div> }
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success mt-3">@success</div> }
    <div class="crm-workspace">
    <header class="crm-header">
        <div class="crm-title"><span class="crm-title-icon"><i class="bi bi-arrow-return-left"></i></span><div><span class="crm-breadcrumb">Operations / Inventory / Order Return</span><h1>Order Return Register</h1><p>RST-wise return eligibility, bag quantity aur workflow status</p></div></div>
        <div class="crm-stats"><div class="crm-stat"><span>Generated RST</span><strong>@Model.EligibleRsts.Count</strong></div><div class="crm-stat"><span>Returns Recorded</span><strong>@returnedCount</strong></div><div class="crm-stat available"><span>Action Available</span><strong>@eligibleCount</strong></div></div>
    </header>
    <section class="or-card">
        <div class="or-card-head"><div class="or-report-title"><i class="bi bi-clipboard-data"></i><div><h4>RST-wise Return Register</h4><p>Lab workflow start hone ke baad Return action automatically close ho jayega.</p></div></div><span class="or-count"><i class="bi bi-list-ul me-1"></i>@Model.EligibleRsts.Count records</span></div>
        <div class="or-toolbar"><div class="or-search"><i class="bi bi-search"></i><input type="search" id="returnSearch" placeholder="Search RST, party or vehicle..." /></div><select id="returnFilter"><option value="all">All Return Status</option><option value="available">Action Available</option><option value="recorded">Return Recorded</option><option value="closed">Action Closed</option></select></div>
        <div class="table-responsive"><table class="or-table"><thead><tr><th>RST</th><th>Party / Vehicle</th><th>Total Bags</th><th>Return Bags</th><th>Workflow Stage</th><th>Return Status</th><th>Updated</th><th>Action</th></tr></thead><tbody>
        @if (Model.EligibleRsts.Count == 0) { <tr><td colspan="8" class="or-empty"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No generated RST is available for this company.</td></tr> }
        @foreach (var x in Model.EligibleRsts)
        {
            <tr class="js-report-row" data-state="@(x.OrderReturnId > 0 ? "recorded" : x.CanCreateReturn ? "available" : "closed")">
                <td><span class="or-ref">@x.RSTNumber</span>@if(!string.IsNullOrWhiteSpace(x.ReturnNumber)){<small class="or-sub">@x.ReturnNumber</small>}</td>
                <td><span class="or-number">@x.PartyName</span><small class="or-sub">@x.VehicleNumber</small></td>
                <td><span class="or-number">@x.AvailableBags.ToString("N0")</span></td>
                <td><span class="or-number">@x.ReturnBags.ToString("N0")</span></td>
                <td><span class="or-stage">@x.StageName</span></td>
                <td>@if(x.OrderReturnId>0){<span class="or-state returned">@x.ReturnStatus</span>}else{<span class="or-state open">Not Recorded</span>}</td>
                <td>@(x.LastUpdatedAt == DateTime.MinValue ? "-" : x.LastUpdatedAt.ToString("dd MMM yyyy, hh:mm tt"))</td>
                <td>
                    @if (x.OrderReturnId > 0) { <a class="or-link" asp-action="Details" asp-route-id="@x.OrderReturnId">View Return <i class="bi bi-arrow-right"></i></a> }
                    else if (canCreate && x.CanCreateReturn) { <button type="button" class="or-btn js-return" data-bs-toggle="modal" data-bs-target="#returnModal" data-unload="@x.UnloadId" data-rst="@x.RSTNumber" data-bags="@x.AvailableBags"><i class="bi bi-box-arrow-left"></i> Create Return</button> }
                    else { <span class="or-disabled">@x.ActionMessage</span> }
                </td>
            </tr>
        }
        </tbody></table><div class="or-result-empty" id="returnNoResult"><i class="bi bi-search d-block fs-4 mb-2"></i>No matching RST record found.</div></div>
    </section>
    </div>
</div>
@if (canCreate)
{
<div class="modal fade or-modal" id="returnModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 shadow"><div class="modal-header"><div class="or-modal-title"><i class="bi bi-box-arrow-left"></i><div><h5>Create Order Return</h5><small class="text-muted">Record damaged or rejected bags before Lab processing starts.</small></div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="modal-body"><input type="hidden" name="UnloadId" id="returnUnloadId"/><div class="or-modal-note mb-3"><i class="bi bi-info-circle me-2"></i><strong id="returnRst"></strong> &middot; Total recorded bags: <strong id="returnAvailable"></strong></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Return Bags</label><input class="form-control" name="RequestedBags" id="returnBags" type="number" min="1" placeholder="Enter bag count" required/></div><div class="col-md-4"><label class="form-label">Current Location</label><select class="form-select" name="SourceLocationId"><option value="">Select location</option>@foreach(var location in Model.Locations){<option value="@location.Id">@location.Name</option>}</select></div><div class="col-md-4"><label class="form-label">Return Reason</label><input class="form-control" name="Reason" maxlength="500" placeholder="Damage / quality reason" required/></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Cancel</button><button class="or-btn" type="submit"><i class="bi bi-check2-circle"></i> Save Return Request</button></div></form></div></div></div>
<script>
document.querySelectorAll('.js-return').forEach(button=>button.addEventListener('click',()=>{const bags=Number(button.dataset.bags)||0;document.getElementById('returnUnloadId').value=button.dataset.unload;document.getElementById('returnRst').textContent='RST '+button.dataset.rst;document.getElementById('returnAvailable').textContent=bags.toLocaleString('en-IN');const input=document.getElementById('returnBags');input.max=bags;input.value='';}));
</script>
}
<script>
(()=>{const search=document.getElementById('returnSearch'),filter=document.getElementById('returnFilter'),rows=[...document.querySelectorAll('.js-report-row')],empty=document.getElementById('returnNoResult');const apply=()=>{const term=(search.value||'').trim().toLowerCase(),state=filter.value;let visible=0;rows.forEach(row=>{const show=(!term||row.textContent.toLowerCase().includes(term))&&(state==='all'||row.dataset.state===state);row.style.display=show?'':'none';if(show)visible++;});empty.style.display=rows.length&&visible===0?'block':'none';};search.addEventListener('input',apply);filter.addEventListener('change',apply);})();
</script>
