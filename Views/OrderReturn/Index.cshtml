@model OrderReturnPage
@{
    ViewData["Title"] = "Order Returns";
    Layout = User.IsMethUser() ? "_LayoutMeth" : User.IsSupervisorUser() ? "_LayoutSupervisor" : User.IsLabUser() ? "_LayoutLab" : User.IsWeightmanUser() ? "_LayoutWeighbridge" : User.IsGatemanUser() ? "_LayoutGateman" : "_LayoutAdmin";
    var canCreate = User.IsAdminUser() || User.IsMethUser() || User.IsSupervisorUser();
    var activeCases = Model.Returns.Count(x => x.Status != "Completed" && x.Status != "Rejected");
}
<style>
.or-wrap{padding:24px;max-width:1600px;margin:auto;color:#172b35}.or-hero{position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px 30px;border:1px solid #d9e8e6;border-radius:20px;background:linear-gradient(135deg,#fff 0%,#f4fbfa 68%,#e2f5f2 100%);box-shadow:0 14px 36px rgba(20,70,66,.09)}.or-hero:after{content:"";position:absolute;right:-55px;top:-100px;width:280px;height:280px;border:45px solid rgba(13,139,128,.07);border-radius:50%}.or-title{position:relative;z-index:1;display:flex;align-items:center;gap:17px}.or-title-icon{display:grid;place-items:center;width:58px;height:58px;border-radius:16px;background:linear-gradient(145deg,#0b7168,#16a296);color:#fff;font-size:25px;box-shadow:0 10px 24px rgba(11,113,104,.22)}.or-eyebrow{display:block;margin-bottom:5px;color:#0b8177;font-size:10px;font-weight:800;letter-spacing:.14em}.or-hero h1{margin:0;color:#153943;font-size:28px;font-weight:800;letter-spacing:-.02em}.or-hero p{margin:6px 0 0;color:#607780;font-size:13px}.or-summary{position:relative;z-index:1;display:flex;gap:10px}.or-summary div{min-width:112px;padding:12px 14px;border:1px solid #d2e8e4;border-radius:13px;background:rgba(255,255,255,.82)}.or-summary strong{display:block;color:#087b72;font-size:21px}.or-summary span{color:#74868d;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}.or-card{margin-top:18px;padding:0;overflow:hidden;border:1px solid #dfe9e8;border-radius:17px;background:#fff;box-shadow:0 8px 28px rgba(20,55,60,.06)}.or-card-head{display:flex;justify-content:space-between;align-items:center;padding:18px 21px;border-bottom:1px solid #e5eceb}.or-card-head h4{margin:0;color:#183b43;font-size:16px;font-weight:800}.or-card-head p{margin:4px 0 0;color:#76868d;font-size:11px}.or-count{padding:6px 10px;border-radius:999px;background:#e8f6f4;color:#08786f;font-size:11px;font-weight:800}.or-card-body{padding:20px}.or-form{display:grid;grid-template-columns:2.2fr .8fr 1fr 1.7fr auto;gap:13px;align-items:end}.or-form label{display:block;margin-bottom:6px;color:#415860;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.035em}.or-form input,.or-form select{width:100%;min-height:44px;padding:10px 12px;border:1px solid #cfdddb;border-radius:10px;background:#fbfdfd;color:#243c44;outline:none}.or-form input:focus,.or-form select:focus{border-color:#28a99e;box-shadow:0 0 0 3px rgba(40,169,158,.12);background:#fff}.or-btn{min-height:44px;border:0;border-radius:10px;padding:10px 18px;background:linear-gradient(135deg,#087b72,#12a094);color:#fff;font-weight:800;box-shadow:0 8px 18px rgba(8,123,114,.2)}.or-table{width:100%;border-collapse:separate;border-spacing:0}.or-table th{padding:13px 15px;border-bottom:2px solid #80c9c1;background:linear-gradient(180deg,#edf8f6,#e2f1ef);color:#315b58;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.065em;white-space:nowrap}.or-table td{padding:14px 15px;border-bottom:1px solid #edf1f1;color:#31474f;font-size:13px;vertical-align:middle}.or-table tbody tr:nth-child(even){background:#fafcfc}.or-table tbody tr:hover{background:#f0f9f7}.or-ref{color:#087b72;font-weight:800}.or-ref small,.or-party small{display:block;margin-top:3px;color:#849299;font-weight:500}.or-number{font-weight:800;color:#243b44}.or-badge{display:inline-flex;padding:6px 10px;border:1px solid #c6e4df;border-radius:999px;background:#eaf7f5;color:#08786f;font-size:10px;font-weight:800}.or-link{display:inline-flex;align-items:center;gap:6px;padding:7px 11px;border:1px solid #bee1dc;border-radius:8px;color:#087d74;font-size:11px;font-weight:800;text-decoration:none}.or-link:hover{background:#087d74;color:#fff}.or-empty{text-align:center;padding:52px!important;color:#89979c!important}@@media(max-width:1100px){.or-form{grid-template-columns:repeat(2,1fr)}.or-btn{width:100%}}@@media(max-width:700px){.or-wrap{padding:15px}.or-hero{align-items:flex-start;flex-direction:column;padding:22px}.or-summary{width:100%}.or-summary div{flex:1;min-width:0}.or-form{grid-template-columns:1fr}.or-title-icon{display:none}.or-hero h1{font-size:23px}}
</style>
<div class="or-wrap">
    <section class="or-hero">
        <div class="or-title"><span class="or-title-icon"><i class="bi bi-arrow-return-left"></i></span><div><small class="or-eyebrow">INVENTORY &amp; QUALITY OPERATIONS</small><h1>Order Return Control Center</h1><p>Quality return, labour handling, dispatch, weighment and gate outward management</p></div></div>
        <div class="or-summary"><div><strong>@Model.Returns.Count</strong><span>Total Requests</span></div><div><strong>@activeCases</strong><span>Active Cases</span></div></div>
    </section>
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger mt-3">@error</div> }
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success mt-3">@success</div> }
    @if (canCreate)
    {
        <section class="or-card">
            <div class="or-card-head"><div><h4><i class="bi bi-plus-circle me-2 text-success"></i>Create Return Request</h4><p>Select a completed RST and record the quantity proposed for quality return.</p></div></div>
            <div class="or-card-body"><form asp-action="Create" method="post" class="or-form">@Html.AntiForgeryToken()
                <div><label>RST / Vehicle / Party</label><select name="UnloadId" required><option value="">Select completed unloading</option>@foreach (var x in Model.EligibleRsts) { <option value="@x.UnloadId" selected="@((int?)ViewBag.SelectedUnloadId == x.UnloadId)">@x.RSTNumber | @x.VehicleNumber | @x.PartyName (@x.AvailableBags bags)</option> }</select></div>
                <div><label>Return Bags</label><input name="RequestedBags" type="number" min="1" placeholder="0" required /></div>
                <div><label>Current Location</label><select name="SourceLocationId"><option value="">Select location</option>@foreach (var x in Model.Locations) { <option value="@x.Id">@x.Name</option> }</select></div>
                <div><label>Return Reason</label><input name="Reason" maxlength="500" required placeholder="Enter quality or damage reason" /></div>
                <button class="or-btn"><i class="bi bi-check2-circle me-1"></i> Create Request</button>
            </form></div>
        </section>
    }
    <section class="or-card">
        <div class="or-card-head"><div><h4><i class="bi bi-journal-check me-2 text-success"></i>Order Return Register</h4><p>Track approval, pending quantity and dispatch progress company-wise.</p></div><span class="or-count">@Model.Returns.Count records</span></div>
        <div class="table-responsive"><table class="or-table"><thead><tr><th>Return / RST</th><th>Party &amp; Vehicle</th><th>Requested</th><th>Approved</th><th>Dispatched</th><th>Remaining</th><th>Status</th><th>Action</th></tr></thead><tbody>
        @if (Model.Returns.Count == 0) { <tr><td colspan="8" class="or-empty"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No order return request is recorded.</td></tr> }
        @foreach (var x in Model.Returns) { <tr><td><span class="or-ref">@x.ReturnNumber</span><small>@x.RSTNumber</small></td><td class="or-party"><span class="or-number">@x.PartyName</span><small>@x.VehicleNumber</small></td><td><span class="or-number">@x.RequestedBags</span></td><td><span class="or-number">@x.ApprovedBags</span></td><td><span class="or-number">@x.DispatchedBags</span></td><td><span class="or-number">@x.RemainingBags</span></td><td><span class="or-badge">@x.Status</span></td><td><a class="or-link" asp-action="Details" asp-route-id="@x.OrderReturnId">Open Case <i class="bi bi-arrow-right"></i></a></td></tr> }
        </tbody></table></div>
    </section>
</div>
