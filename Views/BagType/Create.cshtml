@model RiceMillProject.Models.BagType
@{
    ViewData["Title"] = "Add Bag Type";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Add New Bag Type</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="BagTypeName" class="form-label fw-bold">Bag Type Name</label>
                        <input asp-for="BagTypeName" class="form-control" required placeholder="e.g. Plastic, Old Jute" />
                        <span asp-validation-for="BagTypeName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DeductionWeightGrams" class="form-label fw-bold">Deduction Weight (Grams)</label>
                        <input asp-for="DeductionWeightGrams" type="number" class="form-control" required />
                        <span asp-validation-for="DeductionWeightGrams" class="text-danger"></span>
                    </div>
                    
                    <input type="hidden" asp-for="IsActive" value="true" />

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <button type="submit" class="btn btn-dark">Save Bag Type</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
