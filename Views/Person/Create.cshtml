@model RiceMillProject.Models.Person
@{
    ViewData["Title"] = "Add New Person / Registration";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">ADD PERSON / REGISTER</h3>
            <p class="erp-page-subtitle">Register employees, labour workers, meths, drivers, and parties</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-md-10">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-person-lines-fill text-primary me-2"></i> Registration Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="col-md-6">
                        <label asp-for="PersonType" class="form-label">Person Role / Type <span class="req-star">*</span></label>
                        <select asp-for="PersonType" asp-items="ViewBag.Post" class="form-select" id="personTypeSelect" required>
                        </select>
                        <span asp-validation-for="PersonType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6" style="display:none;" id="Methdiv">
                        <label asp-for="MethdesignatationId" class="form-label">Select Meth (Labour Head) <span class="req-star">*</span></label>
                        <select asp-for="MethdesignatationId" asp-items="ViewBag.Meth" class="form-select" id="MethSelect">
                        </select>
                        <span asp-validation-for="MethdesignatationId" class="text-danger small"></span>
                    </div>

                    <!-- Party Type Category Selection (Direct Party vs Center) -->
                    <div class="col-12" id="partyCategorySection" style="display:none;">
                        <div class="p-3 border rounded bg-light">
                            <div class="erp-form-section-title mt-0">
                                <i class="bi bi-diagram-3 me-2"></i> Party Category Type
                            </div>
                            <div class="d-flex gap-4 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PartyCategory" id="partyDirect" value="1" checked>
                                    <label class="form-check-label fw-bold" for="partyDirect">Direct Party</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PartyCategory" id="partyCenter" value="2">
                                    <label class="form-check-label fw-bold" for="partyCenter">Center Party</label>
                                </div>
                            </div>

                            <!-- Center Specific Fields -->
                            <div class="row g-3" id="centerFields" style="display:none;">
                                <div class="col-md-6">
                                    <label class="form-label">Firm Name</label>
                                    <input asp-for="FirmName" class="form-control" placeholder="Enter Firm Name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Firm Designation</label>
                                    <input asp-for="FirmDesignation" class="form-control" placeholder="e.g. Incharge, Representative" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PersonName" class="form-label">Person / Contact Name <span class="req-star">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="PersonName" class="form-control" required placeholder="Enter full name..." />
                        </div>
                        <span asp-validation-for="PersonName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MobileNumber" class="form-label">Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-phone"></i></span>
                            <input asp-for="MobileNumber" class="form-control" placeholder="10 Digit Mobile..." maxlength="10" />
                        </div>
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12" id="employeeDetailsSection" style="display: none;">
                        <div class="erp-form-section-title">
                            <i class="bi bi-briefcase me-2"></i> Employee Professional Details
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Office Branch</label>
                                <select name="OfficeId" class="form-select" asp-items="ViewBag.Offices">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Department</label>
                                <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Address" class="form-label">Address / Location</label>
                                <input asp-for="Address" class="form-control" placeholder="Work Location..." />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Person Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            function toggleFields() {
                $("#Methdiv").css('display','none');
                $("#partyCategorySection").css('display', 'none');

                var selectedText = $('#personTypeSelect option:selected').text().toLowerCase();
                var val = $('#personTypeSelect').val();

                if (selectedText.includes('party') || selectedText.includes('kisan') || selectedText.includes('center')) {
                    $("#partyCategorySection").fadeIn();
                }

                if (selectedText.includes('worker')) {
                    $("#Methdiv").fadeIn();
                }

                var employeeRoles = ["1", "2", "3", "4", "5", "6"];
                if (employeeRoles.includes(val)) {
                    $('#employeeDetailsSection').fadeIn();
                } else {
                    $('#employeeDetailsSection').fadeOut();
                }
            }

            $('input[name="PartyCategory"]').change(function () {
                if ($(this).val() == "2") {
                    $('#centerFields').slideDown();
                } else {
                    $('#centerFields').slideUp();
                }
            });

            $('#personTypeSelect').change(toggleFields);
            toggleFields();
        });
    </script>
}
