@model IEnumerable<RiceMillProject.Models.Person>
@{
    ViewData["Title"] = "Person Management";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-lines-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">EMPLOYEE & STAFF REGISTER</h3>
            <p class="erp-page-subtitle">Manage internal employees, supervisors, drivers, and worker profiles</p>
        </div>
    </div>
    <a asp-action="Employee" class="btn-erp-primary">
        <i class="bi bi-plus-circle me-1"></i> Add New Person
    </a>
</div>

<div class="erp-card">
    <div class="erp-card-header">
        <span><i class="bi bi-list-ul text-primary me-2"></i> Employee & Staff Registry</span>
        <span class="badge badge-erp bg-secondary">Total: @Model.Count() Records</span>
    </div>
    <div class="erp-card-body p-0">
        <div class="erp-table-container">
            <table class="table erp-table align-middle" id="employeeTable">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>NAME</th>
                        <th>MOBILE NUMBER</th>
                        <th>PERSON TYPE</th>
                        <th>STATUS</th>
                        <th class="text-center" style="width: 140px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace">#@item.PersonId</td>
                            <td class="fw-bold text-dark">@item.PersonName</td>
                            <td>@(string.IsNullOrEmpty(item.MobileNumber) ? "-" : item.MobileNumber)</td>
                            <td><span class="badge badge-erp bg-info text-dark">@item.PersonType</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-erp bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-erp bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.PersonId" class="btn-erp-outline btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Registration Successful!',
                    text: '@TempData["SuccessMessage"]',
                    icon: 'success',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#0d6efd'
                });
                </text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Error!',
                    text: '@TempData["ErrorMessage"]',
                    icon: 'error',
                    confirmButtonText: 'Close',
                    confirmButtonColor: '#dc3545'
                });
                </text>
            }

            if ($('#employeeTable').length && $.fn.DataTable) {
                $('#employeeTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    order: [[0, 'desc']]
                });
            }
        });
    </script>
}
