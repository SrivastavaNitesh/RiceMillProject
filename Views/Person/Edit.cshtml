@model RiceMillProject.Models.Person
@{
    ViewData["Title"] = "Edit Person";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">EDIT PERSON / ENTITY</h3>
            <p class="erp-page-subtitle">Update contact information, entity role, and operational status</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-pencil-square text-primary me-2"></i> Edit Entity Profile</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Edit" method="post" class="row g-3">
                    <input type="hidden" asp-for="PersonId" />

                    <div class="col-md-12">
                        <label asp-for="PersonName" class="form-label">Full Name <span class="req-star">*</span></label>
                        <input asp-for="PersonName" class="form-control" required />
                        <span asp-validation-for="PersonName" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="MobileNumber" class="form-label">Mobile Number</label>
                        <input asp-for="MobileNumber" class="form-control" />
                        <span asp-validation-for="MobileNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="PersonType" class="form-label">Person Type <span class="req-star">*</span></label>
                        <select asp-for="PersonType" class="form-select">
                            <option value="">-- Select Type --</option>
                            <option value="Kisan">Kisan (Farmer)</option>
                            <option value="Government Office">Government Office</option>
                            <option value="Driver">Driver</option>
                            <option value="Employee">Employee</option>
                            <option value="Supervisor">Supervisor</option>
                            <option value="Meth">Meth (Head Worker)</option>
                            <option value="Worker">Worker</option>
                        </select>
                        <span asp-validation-for="PersonType" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="flexCheckDefault">
                            <label class="form-check-label fw-semibold" for="flexCheckDefault">
                                Active Status
                            </label>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Update Person
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
