@model IEnumerable<RiceMillProject.Models.Person>
@{
    ViewData["Title"] = "Person Management";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">PERSON MANAGEMENT</h3>
            <p class="erp-page-subtitle">Master directory of employees, labour workers, meths, drivers, and parties</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New Person
    </a>
</div>

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Name</th>
                    <th>Mobile</th>
                    <th>Role / Type</th>
                    <th>Status</th>
                    <th class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 text-muted font-monospace">#@item.PersonId</td>
                        <td><strong class="text-dark">@item.PersonName</strong></td>
                        <td>@item.MobileNumber</td>
                        <td><span class="badge-erp badge-erp-info">@item.PersonType</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge-erp badge-erp-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-erp badge-erp-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Edit" asp-route-id="@item.PersonId" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.PersonId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this record?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
