@model RiceMillProject.Models.Person
@{
    ViewData["Title"] = "Add New Person / Registration";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">REGISTER NEW PERSON / STAFF</h3>
            <p class="erp-page-subtitle">Add new employee, supervisor, labor head (Meth), driver or farmer record</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Registration Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Employee" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="col-md-6">
                        <label asp-for="OfficeId" class="form-label">Company <span class="req-star">*</span></label>
                        <select asp-for="OfficeId" class="form-select" asp-items="ViewBag.Offices" id="companySelect" required>
                            <option value="0">Select Company</option>
                        </select>
                        <span asp-validation-for="OfficeId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PersonType" class="form-label">Employee Role <span class="req-star">*</span></label>
                        <select asp-for="PersonType" asp-items="ViewBag.Post" class="form-select" id="personTypeSelect" required></select>
                        <span asp-validation-for="PersonType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-none" id="gateAssignmentSection">
                        <label asp-for="GateId" class="form-label">Gate Name <span class="req-star">*</span></label>
                        <select asp-for="GateId" class="form-select" id="gateSelect">
                            <option value="">Select Gate</option>
                        </select>
                        <span asp-validation-for="GateId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-none" id="methAssignmentSection">
                        <label asp-for="MethdesignatationId" class="form-label">Meth <span class="req-star">*</span></label>
                        <select asp-for="MethdesignatationId" class="form-select" id="methSelect">
                            <option value="">Select Meth</option>
                        </select>
                        <span asp-validation-for="MethdesignatationId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PersonName" class="form-label">Full Name <span class="req-star">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-primary"><i class="bi bi-person"></i></span>
                            <input asp-for="PersonName" class="form-control" required placeholder="Enter full name..." />
                        </div>
                        <span asp-validation-for="PersonName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MobileNumber" class="form-label">Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-primary"><i class="bi bi-phone"></i></span>
                            <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile number" maxlength="10"/>
                        </div>
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Error!',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString())),
                    icon: 'error',
                    confirmButtonText: 'Close',
                    confirmButtonColor: '#dc3545'
                });
                </text>
            }

            const selectedGateId = '@(Model.GateId?.ToString() ?? "")';
            const selectedMethId = '@(Model.MethdesignatationId.GetValueOrDefault() > 0 ? Model.MethdesignatationId.ToString() : "")';

            function fillDropdown(url, target, placeholder, selectedValue) {
                const $target = $(target).empty().append($('<option>', { value: '', text: placeholder }));
                const companyId = $('#companySelect').val();
                if (!companyId) return;
                $.getJSON(url, { officeId: companyId }, function(items) {
                    items.forEach(item => $target.append($('<option>', { value: item.value, text: item.text })));
                    if (selectedValue) $target.val(selectedValue);
                });
            }

            function toggleRoleAssignment(useSavedValue) {
                const roleId = $('#personTypeSelect').val();
                const isGateman = roleId === '1';
                const isWorker = roleId === '7';
                $('#gateAssignmentSection').toggleClass('d-none', !isGateman);
                $('#methAssignmentSection').toggleClass('d-none', !isWorker);
                $('#gateSelect').prop('required', isGateman);
                $('#methSelect').prop('required', isWorker);
                if (isGateman) fillDropdown('@Url.Action("GetGatesByCompany", "Person")', '#gateSelect', 'Select Gate', useSavedValue ? selectedGateId : '');
                else $('#gateSelect').val('');
                if (isWorker) fillDropdown('@Url.Action("GetMethByCompany", "Person")', '#methSelect', 'Select Meth', useSavedValue ? selectedMethId : '');
                else $('#methSelect').val('');
            }

            $('#personTypeSelect').change(() => toggleRoleAssignment(false));
            $('#companySelect').change(() => toggleRoleAssignment(false));
            toggleRoleAssignment(true);
        });
    </script>
}
