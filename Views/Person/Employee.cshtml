@model RiceMillProject.Models.Person
@using RiceMillProject.Models
@{
    ViewData["Title"] = "Add New Person / Registration";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">REGISTER NEW PERSON / STAFF</h3>
            <p class="erp-page-subtitle">Add new employee, supervisor, labor head (Meth), driver or farmer record</p>
        </div>
    </div>
    <a asp-action="EmployeeList"  class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Registration Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Employee" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="col-md-6">
                        <label asp-for="OfficeId" class="form-label">Company <span class="req-star">*</span></label>
                        <select asp-for="OfficeId" class="form-select" asp-items="ViewBag.Offices" id="companySelect" required>
                            <option value="0">Select Company</option>
                        </select>
                        <span asp-validation-for="OfficeId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PersonType" class="form-label">Employee Role <span class="req-star">*</span></label>
                        <select asp-for="PersonType" asp-items="ViewBag.Post" class="form-select" id="personTypeSelect" required></select>
                        <span asp-validation-for="PersonType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-none" id="gateAssignmentSection">
                        <label asp-for="GateId" class="form-label">Gate Name <span class="req-star">*</span></label>
                        <select asp-for="GateId" class="form-select" id="gateSelect">
                            <option value="">Select Gate</option>
                        </select>
                        <span asp-validation-for="GateId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-none" id="methAssignmentSection">
                        <label asp-for="MethdesignatationId" class="form-label">Meth <span class="req-star">*</span></label>
                        <select asp-for="MethdesignatationId" class="form-select" id="methSelect">
                            <option value="">Select Meth</option>
                        </select>
                        <span asp-validation-for="MethdesignatationId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PersonName" class="form-label">Full Name <span class="req-star">*</span></label>
                        <input asp-for="PersonId" type="hidden" id="selectedPersonId" />
                        <input asp-for="PersonName" type="hidden" id="selectedPersonName" />
                        <select id="personNameLookup" class="form-select" required>
                            <option value="">Search or type full name...</option>
                            @foreach (var existingPerson in (ViewBag.ExistingPersons as IEnumerable<Person> ?? Enumerable.Empty<Person>()))
                            {
                                <option value="@existingPerson.PersonId"
                                        data-name="@existingPerson.PersonName"
                                        data-mobile="@existingPerson.MobileNumber"
                                        data-address="@existingPerson.Address"
                                        selected="@(Model.PersonId == existingPerson.PersonId ? "selected" : null)">
                                    @existingPerson.PersonName @(string.IsNullOrWhiteSpace(existingPerson.MobileNumber) ? "" : $"/ {existingPerson.MobileNumber}")
                                </option>
                            }
                        </select>
                        <div class="form-text">Existing person select karein ya naya full name type karke save karein.</div>
                        <span asp-validation-for="PersonName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MobileNumber" class="form-label">Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-primary"><i class="bi bi-phone"></i></span>
                            <input asp-for="MobileNumber" class="form-control" placeholder="10-digit Indian mobile number" maxlength="10" inputmode="numeric" pattern="[6-9][0-9]{9}" />
                        </div>
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-none" id="shareCompanySection">
                        <div class="form-check border rounded-3 p-3 ps-5 bg-light">
                            <input asp-for="ShareCompany" class="form-check-input" />
                            <label asp-for="ShareCompany" class="form-check-label fw-semibold">
                                Existing person ko is company ke saath share karein
                            </label>
                            <div class="form-text">
                                Is option ko tab check karein jab same mobile number wala person pehle se kisi doosri company mein registered ho.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Error!',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString())),
                    icon: 'error',
                    confirmButtonText: 'Close',
                    confirmButtonColor: '#dc3545'
                });
                </text>
            }

            const selectedGateId = '@(Model.GateId?.ToString() ?? "")';
            const selectedMethId = '@(Model.MethdesignatationId.GetValueOrDefault() > 0 ? Model.MethdesignatationId.ToString() : "")';
            const companySelect = document.getElementById('companySelect');
            const shareCompanySection = document.getElementById('shareCompanySection');
            const shareCompanyCheckbox = document.getElementById('ShareCompany');
            const personNameLookup = document.getElementById('personNameLookup');
            const selectedPersonId = document.getElementById('selectedPersonId');
            const selectedPersonName = document.getElementById('selectedPersonName');
            const mobileInput = document.getElementById('MobileNumber');
            const addressInput = document.getElementById('Address');

            if (personNameLookup && $.fn.select2) {
                $(personNameLookup).select2({
                    width: '100%',
                    placeholder: 'Search or type full name',
                    minimumResultsForSearch: 0,
                    tags: true,
                    createTag: params => {
                        const term = (params.term || '').trim();
                        if (term.length < 2) return null;
                        const exists = Array.from(personNameLookup.options).some(option =>
                            (option.dataset.name || '').trim().toLocaleLowerCase() === term.toLocaleLowerCase());
                        return exists ? null : { id: `__new__:${term}`, text: term, newTag: true };
                    },
                    templateResult: data => {
                        if (!data.id || data.newTag || String(data.id).startsWith('__new__:')) return data.text;
                        const option = data.element;
                        const name = option?.dataset.name || data.text;
                        const mobile = option?.dataset.mobile || '';
                        return $(`<div><strong></strong><small class="d-block text-muted"></small></div>`)
                            .find('strong').text(name).end()
                            .find('small').text(mobile ? `Mobile: ${mobile}` : 'Mobile not available').end();
                    }
                });
                personNameLookup.dataset.searchReady = 'true';

                $(personNameLookup).on('select2:select', event => {
                    const data = event.params.data;
                    const isNew = data.newTag || String(data.id).startsWith('__new__:');
                    const option = data.element;
                    selectedPersonId.value = isNew ? '0' : String(data.id);
                    selectedPersonName.value = isNew ? data.text.trim() : (option?.dataset.name || data.text).trim();
                    if (!isNew) {
                        if (mobileInput) mobileInput.value = option?.dataset.mobile || '';
                        if (addressInput) addressInput.value = option?.dataset.address || '';
                        if (shareCompanyCheckbox) shareCompanyCheckbox.checked = true;
                    } else if ($('#personTypeSelect').val() !== '8') {
                        if (shareCompanyCheckbox) shareCompanyCheckbox.checked = false;
                    }
                });

                $(personNameLookup).on('select2:clear', () => {
                    selectedPersonId.value = '0';
                    selectedPersonName.value = '';
                });

                if (selectedPersonId.value && selectedPersonId.value !== '0') {
                    $(personNameLookup).val(selectedPersonId.value).trigger('change.select2');
                } else if (selectedPersonName.value) {
                    const option = new Option(selectedPersonName.value, `__new__:${selectedPersonName.value}`, true, true);
                    personNameLookup.add(option);
                    $(personNameLookup).trigger('change.select2');
                }
            }

            if (companySelect && $.fn.select2) {
                if ($(companySelect).hasClass('select2-hidden-accessible')) $(companySelect).select2('destroy');
                $(companySelect).select2({
                    width: '100%',
                    placeholder: 'Search or type new company',
                    minimumResultsForSearch: 0,
                    tags: true,
                    createTag: params => {
                        const term = (params.term || '').trim();
                        if (!term) return null;
                        const exists = Array.from(companySelect.options).some(option =>
                            option.text.trim().toLocaleLowerCase() === term.toLocaleLowerCase());
                        return exists ? null : { id: `__new__:${term}`, text: term, newTag: true };
                    }
                });
                companySelect.dataset.searchReady = 'true';

                $(companySelect).on('select2:select', async event => {
                    const data = event.params.data;
                    if (!(data.newTag || String(data.id).startsWith('__new__:'))) return;
                    const companyName = data.text.trim();
                    const temporaryOption = data.element;
                    const confirmation = await Swal.fire({
                        icon: 'question',
                        title: 'Add New Company?',
                        html: `<div class="text-start"><strong>${$('<div>').text(companyName).html()}</strong> list mein nahi hai.<label class="form-label mt-3">Company Location</label><input id="quickCompanyLocation" class="swal2-input m-0 w-100" maxlength="250" placeholder="Enter company location" /></div>`,
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Add Company',
                        cancelButtonText: 'No',
                        confirmButtonColor: '#07877c',
                        preConfirm: () => {
                            const location = document.getElementById('quickCompanyLocation')?.value.trim();
                            if (!location) {
                                Swal.showValidationMessage('Company location is required.');
                                return false;
                            }
                            return location;
                        }
                    });
                    if (!confirmation.isConfirmed) {
                        temporaryOption?.remove();
                        companySelect.value = '';
                        $(companySelect).trigger('change.select2');
                        return;
                    }

                    try {
                        const values = new URLSearchParams({
                            companyName,
                            location: confirmation.value,
                            __RequestVerificationToken: document.querySelector('form input[name="__RequestVerificationToken"]')?.value || ''
                        });
                        const response = await fetch('@Url.Action("QuickAddCompany", "Person")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                            body: values.toString()
                        });
                        const result = await response.json();
                        if (!response.ok || !result.success) throw new Error(result.message || 'Company could not be saved.');
                        temporaryOption?.remove();
                        const option = new Option(result.officeName, result.officeId, true, true);
                        companySelect.add(option);
                        companySelect.value = String(result.officeId);
                        $(companySelect).trigger('change');
                        await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: result.existing ? 'Existing company selected' : 'Company added successfully', showConfirmButton: false, timer: 2200 });
                    } catch (error) {
                        temporaryOption?.remove();
                        companySelect.value = '';
                        $(companySelect).trigger('change.select2');
                        await Swal.fire({ icon: 'error', title: 'Company could not be added', text: error.message });
                    }
                });
            }

            function fillDropdown(url, target, placeholder, selectedValue) {
                const $target = $(target).empty().append($('<option>', { value: '', text: placeholder }));
                const companyId = $('#companySelect').val();
                if (!companyId) return;
                $.getJSON(url, { officeId: companyId }, function(items) {
                    items.forEach(item => $target.append($('<option>', { value: item.value, text: item.text })));
                    if (selectedValue) $target.val(selectedValue);
                });
            }

            function toggleRoleAssignment(useSavedValue) {
                const roleId = $('#personTypeSelect').val();
                const isGateman = roleId === '1';
                const isWorker = roleId === '7';
                const isParty = roleId === '8';
                shareCompanySection?.classList.toggle('d-none', !isParty);
                if (!isParty && shareCompanyCheckbox) shareCompanyCheckbox.checked = false;
                $('#gateAssignmentSection').toggleClass('d-none', !isGateman);
                $('#methAssignmentSection').toggleClass('d-none', !isWorker);
                $('#gateSelect').prop('required', isGateman);
                $('#methSelect').prop('required', isWorker);
                if (isGateman) fillDropdown('@Url.Action("GetGatesByCompany", "Person")', '#gateSelect', 'Select Gate', useSavedValue ? selectedGateId : '');
                else $('#gateSelect').val('');
                if (isWorker) fillDropdown('@Url.Action("GetMethByCompany", "Person")', '#methSelect', 'Select Meth', useSavedValue ? selectedMethId : '');
                else $('#methSelect').val('');
            }

            $('#personTypeSelect').change(() => toggleRoleAssignment(false));
            $('#companySelect').change(() => toggleRoleAssignment(false));
            toggleRoleAssignment(true);
        });
    </script>
}
