@model RiceMillProject.Models.Person
@{
    ViewData["Title"] = "Add New Person / Registration";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">REGISTER NEW PERSON / STAFF</h3>
            <p class="erp-page-subtitle">Add new employee, supervisor, labor head (Meth), driver or farmer record</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Registration Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Employee" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="col-md-6">
                        <label asp-for="PersonType" class="form-label">Employee / Person Role <span class="req-star">*</span></label>
                        <select asp-for="PersonType" asp-items="ViewBag.Post" class="form-select" id="personTypeSelect" required>
                        </select>
                        <span asp-validation-for="PersonType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PersonName" class="form-label">Full Name <span class="req-star">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-primary"><i class="bi bi-person"></i></span>
                            <input asp-for="PersonName" class="form-control" required placeholder="Enter full name..." />
                        </div>
                        <span asp-validation-for="PersonName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MobileNumber" class="form-label">Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-primary"><i class="bi bi-phone"></i></span>
                            <input asp-for="MobileNumber" class="form-control" placeholder="10-digit mobile number" maxlength="10"/>
                        </div>
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12" id="employeeDetailsSection" style="display: none;">
                        <h6 class="text-primary border-bottom pb-2 mt-2 mb-3 fw-bold"><i class="bi bi-building me-1"></i> Employee Office Assignment</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">Office Branch <span class="req-star">*</span></label>
                                <select name="OfficeId" class="form-select" asp-items="ViewBag.Offices">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Error!',
                    text: '@TempData["ErrorMessage"]',
                    icon: 'error',
                    confirmButtonText: 'Close',
                    confirmButtonColor: '#dc3545'
                });
                </text>
            }

            function toggleFields() {
                var val = $('#personTypeSelect').val();
                var employeeRoles = ["4", "3", "1","2", "5", "6", "Gateman", "Weightman"];

                if (employeeRoles.includes(val)) {
                    $('#employeeDetailsSection').fadeIn();
                } else {
                    $('#employeeDetailsSection').fadeOut();
                }
            }

            $('#personTypeSelect').change(toggleFields);
            toggleFields(); // Init on load
        });
    </script>
}
