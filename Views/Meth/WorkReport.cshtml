@model List<RiceMillProject.Models.UnloadTransaction>
@{ViewData["Title"]="Meth Work Report";}
<div class="erp-page-header mb-4"><h3 class="erp-page-title">Meth Work Report</h3><a asp-action="Index" class="btn btn-outline-secondary">Dashboard</a></div>
<div class="erp-card mb-4"><div class="erp-card-body p-3"><form method="get" class="row g-3 align-items-end"><div class="col-md-2"><label class="form-label" for="status">Work status</label><select name="status" id="status" class="form-select"><option value="all" selected="@(ViewBag.Status=="all")">All assigned RST</option><option value="pending" selected="@(ViewBag.Status=="pending")">Pending</option><option value="completed" selected="@(ViewBag.Status=="completed")">Completed</option></select></div><div class="col-md-2"><label class="form-label" for="from">From date</label><input type="date" class="form-control" id="from" name="from" value="@ViewBag.From"/></div><div class="col-md-2"><label class="form-label" for="to">To date</label><input type="date" class="form-control" id="to" name="to" value="@ViewBag.To"/></div><div class="col-md-4"><label class="form-label" for="search">RST / Vehicle / Party</label><input class="form-control" id="search" name="search" value="@ViewBag.Search" maxlength="200"/></div><div class="col-md-2"><button class="btn btn-primary">Apply</button><a asp-action="WorkReport" class="btn btn-outline-secondary ms-1">Reset</a></div></form></div></div>
<div class="erp-card"><partial name="_MethWorkTable" model="Model"/></div>
