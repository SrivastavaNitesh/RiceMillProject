@model MethWorkReport
@{ ViewData["Title"]="Meth Work Report"; }
<style>
.mr-page{padding:22px}.mr-head{display:flex;justify-content:space-between;align-items:center;padding:22px 25px;border:1px solid #d9e8e5;border-radius:18px;background:linear-gradient(135deg,#fff,#eff9f7);box-shadow:0 9px 28px rgba(20,69,63,.07)}.mr-head h2{margin:0;color:#173d44;font-size:24px;font-weight:800}.mr-head p{margin:5px 0 0;color:#72848a;font-size:12px}.mr-card{margin-top:17px;overflow:hidden;border:1px solid #dfeae8;border-radius:15px;background:#fff;box-shadow:0 6px 20px rgba(20,69,63,.05)}.mr-filter{display:grid;grid-template-columns:1fr 1fr 1fr 2fr auto auto;gap:11px;align-items:end;padding:18px}.mr-filter label{display:block;margin-bottom:5px;color:#51666d;font-size:10px;font-weight:800;text-transform:uppercase}.mr-filter input,.mr-filter select{width:100%;min-height:42px;padding:9px 11px;border:1px solid #cfdddb;border-radius:9px;background:#fbfdfd}.mr-btn{min-height:42px;padding:9px 16px;border:0;border-radius:9px;background:#087e74;color:#fff;font-weight:800}.mr-reset{display:inline-flex;align-items:center;min-height:42px;padding:9px 14px;border:1px solid #cadbd8;border-radius:9px;color:#536a70;text-decoration:none}.mr-table{width:100%;border-collapse:separate;border-spacing:0}.mr-table th{padding:13px;background:linear-gradient(180deg,#edf8f6,#e2f1ef);border-bottom:2px solid #7bc5bd;color:#315b58;font-size:10px;text-transform:uppercase;letter-spacing:.05em}.mr-table td{padding:13px;border-bottom:1px solid #ebf0ef;color:#334b52;font-size:12px}.mr-table tbody tr:nth-child(even){background:#fafcfc}.mr-status{display:inline-flex;padding:5px 9px;border-radius:999px;background:#e8f6f3;color:#087a70;font-size:10px;font-weight:800}.mr-action{color:#087c73;font-weight:800;text-decoration:none}@@media(max-width:1050px){.mr-filter{grid-template-columns:repeat(2,1fr)}}@@media(max-width:600px){.mr-page{padding:14px}.mr-filter{grid-template-columns:1fr}.mr-head{align-items:flex-start;flex-direction:column}}
</style>
<div class="mr-page">
 <section class="mr-head"><div><h2><i class="bi bi-file-earmark-bar-graph me-2 text-success"></i>Meth Work Report</h2><p>Assigned, pending and completed worker handling records in one report.</p></div><span class="badge bg-success-subtle text-success">@Model.Rows.Count records</span></section>
 <section class="mr-card"><form method="get" class="mr-filter"><div><label>Status</label><select name="status"><option value="All" selected="@(Model.Status=="All")">All Records</option><option value="Pending" selected="@(Model.Status=="Pending")">Pending Action</option><option value="Completed" selected="@(Model.Status=="Completed")">Completed</option></select></div><div><label>From Date</label><input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")"/></div><div><label>To Date</label><input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")"/></div><div><label>Search RST / Vehicle / Party</label><input name="search" value="@Model.Search" placeholder="Type to search..."/></div><button class="mr-btn"><i class="bi bi-funnel me-1"></i>Apply</button><a asp-action="Report" class="mr-reset">Reset</a></form>
 <div class="table-responsive"><table class="mr-table"><thead><tr><th>RST</th><th>Vehicle</th><th>Party</th><th>Material</th><th>Location</th><th>Supervisor</th><th>Bags</th><th>Status</th><th>Action</th></tr></thead><tbody>
 @if(!Model.Rows.Any()){<tr><td colspan="9" class="text-center text-muted py-5">No work record matches the selected filters.</td></tr>}
 @foreach(var x in Model.Rows){var pending=x.Status=="Assigned"&&!x.IsWorkerWorkCompleted;<tr><td class="fw-bold text-success">@x.RSTNumber</td><td>@x.VehicleNumber</td><td>@x.PartyName</td><td>@x.ItemName</td><td>@x.LocationName</td><td>@x.SupervisorName</td><td>@(x.NumberOfBags??0)</td><td><span class="mr-status">@(pending?"Pending Action":"Completed")</span></td><td>@if(pending){<a class="mr-action" asp-action="ExecuteUnload" asp-route-id="@x.UnloadId">Take Action <i class="bi bi-arrow-right"></i></a>}else{<span class="text-muted">Recorded</span>}</td></tr>}
 </tbody></table></div></section>
</div>
