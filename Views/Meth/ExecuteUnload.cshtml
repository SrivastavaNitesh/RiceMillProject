@model RiceMillProject.Models.UnloadTransaction
@{
    ViewData["Title"] = "Execute Unload";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-premium-blue">
                <h5 class="mb-0">Execute Unload & Generate Slip</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-secondary border-0 shadow-sm rounded-3 mb-4">
                    <strong>RST Number:</strong> <span class="text-primary fw-bold">@Model.RSTNumber</span> | 
                    <strong>Supervisor:</strong> @Model.SupervisorName
                </div>

                <form asp-action="ExecuteUnload" method="post">
                    <input type="hidden" asp-for="UnloadId" />
                    <input type="hidden" asp-for="RSTNumber" />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <fieldset class="border rounded p-3 mb-3">
                        <legend class="float-none w-auto px-2 fs-6 fw-bold">Items actually unloaded (select multiple)</legend>
                        <p class="text-muted">Only these items and categories will be available to the lab for this RST.</p>
                        @if (ViewBag.UnloadItems is List<RiceMillProject.Models.LabItemOption> unloadItems)
                        {
                            @foreach (var category in unloadItems.GroupBy(i => i.CategoryId))
                            {
                                <div class="fw-bold mt-2">@category.First().CategoryName</div>
                                @foreach (var item in category)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="SelectedItemIds" value="@item.ItemId" id="unload-item-@item.ItemId" checked="@Model.SelectedItemIds.Contains(item.ItemId)" />
                                        <label class="form-check-label" for="unload-item-@item.ItemId">@item.ItemName</label>
                                    </div>
                                }
                            }
                            @if (unloadItems.Count == 0) { <p class="text-warning">Create item categories and items before submitting unloading.</p> }
                        }
                        <span asp-validation-for="SelectedItemIds" class="text-danger"></span>
                    </fieldset>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Actual Unloaded Location</label>
                            <select name="ActualLocationId" class="form-select" asp-items="ViewBag.Locations" required>
                                <option value="">-- Select Location --</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="GateManId" class="form-label fw-bold">Gate Man (Witness)</label>
                            <select asp-for="GateManId" class="form-select" asp-items="ViewBag.GateMen" required>
                                <option value="">-- Select Gate Man --</option>
                            </select>
                            <span asp-validation-for="GateManId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BagTypeId" class="form-label fw-bold">Bag Type</label>
                            <select asp-for="BagTypeId" class="form-select" asp-items="ViewBag.BagTypes" required>
                                <option value="">-- Select Bag Type --</option>
                            </select>
                            <span asp-validation-for="BagTypeId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumberOfBags" class="form-label fw-bold">Number of Bags Unloaded</label>
                            <input asp-for="NumberOfBags" type="number" class="form-control" required />
                            <span asp-validation-for="NumberOfBags" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row border-top pt-3 mt-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-primary">Assign Workers (Palledari)</label>
                            <div class="border rounded p-2 bg-light" style="max-height: 150px; overflow-y: auto;">
                                @if (ViewBag.Workers != null)
                                {
                                    foreach (var worker in ViewBag.Workers)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedWorkers" value="@worker.PersonId" id="worker_@worker.PersonId" checked="@(ViewBag.SelectedWorkers is int[] selectedWorkers && selectedWorkers.Contains((int)worker.PersonId))">
                                            <label class="form-check-label" for="worker_@worker.PersonId">
                                                @worker.PersonName
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-primary">Shift</label>
                            <select name="Shift" class="form-select" required>
                                <option value="Day" selected="@(ViewBag.SelectedShift as string != "Night")">Day Shift (10 per worker)</option>
                                <option value="Night" selected="@(ViewBag.SelectedShift as string == "Night")">Night Shift (15 per worker)</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-premium-blue fw-bold">Submit Unload Slip</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
