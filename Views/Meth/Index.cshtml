@{
    ViewData["Title"] = "Meth Dashboard";
    var pendingUnloads = ViewBag.PendingUnloads as List<RiceMillProject.Models.UnloadTransaction>;
    var completedUnloads = ViewBag.CompletedUnloads as List<RiceMillProject.Models.UnloadTransaction>;
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-badge-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">METH (LABOUR HEAD) DASHBOARD</h3>
            <p class="erp-page-subtitle">Assigned unloading trucks, bag recording, and labour slip generation</p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Pending Unloads (Assigned to Meth) -->
    <div class="col-md-6 mb-4">
        <div class="erp-card h-100 mb-0">
            <div class="erp-card-header">
                <span><i class="bi bi-clock-history text-primary me-2"></i> Assigned Trucks (Pending Unload)</span>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th class="ps-4">RST Number</th>
                                <th>Supervisor</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(pendingUnloads != null && pendingUnloads.Any())
                            {
                                foreach(var unload in pendingUnloads)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@unload.RSTNumber</td>
                                        <td>@unload.SupervisorName</td>
                                        <td class="text-center pe-4">
                                            <a asp-action="ExecuteUnload" asp-route-id="@unload.UnloadId" class="btn-erp-primary btn-sm">
                                                <i class="bi bi-play-circle me-1"></i> Execute Unload
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No pending unloads</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Completed Unloads -->
    <div class="col-md-6 mb-4">
        <div class="erp-card h-100 mb-0">
            <div class="erp-card-header">
                <span><i class="bi bi-check-circle text-success me-2"></i> Completed Unloads</span>
            </div>
            <div class="erp-card-body p-0">
                <div class="table-responsive">
                    <table class="erp-table">
                        <thead>
                            <tr>
                                <th class="ps-4">RST Number</th>
                                <th>Bags</th>
                                <th>Status</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(completedUnloads != null && completedUnloads.Any())
                            {
                                foreach(var unload in completedUnloads)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@unload.RSTNumber</td>
                                        <td><span class="badge-erp badge-erp-info">@unload.NumberOfBags Bags</span></td>
                                        <td>
                                            @if(unload.Status == "Verified")
                                            {
                                                <span class="badge-erp badge-erp-success">Verified</span>
                                            }
                                            else
                                            {
                                                <span class="badge-erp badge-erp-warning">Pending Verify</span>
                                            }
                                        </td>
                                        <td class="text-center pe-4">
                                            <a asp-action="PrintSlip" asp-route-id="@unload.UnloadId" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-printer me-1"></i> Print Slip
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No completed unloads</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
