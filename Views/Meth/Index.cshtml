@{
    ViewData["Title"] = "Meth Dashboard";

    var pending =
        ViewBag.PendingUnloads
        as List<RiceMillProject.Models.UnloadTransaction>
        ?? new();

    var completed =
        ViewBag.CompletedUnloads
        as List<RiceMillProject.Models.UnloadTransaction>
        ?? new();
}

<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-people-fill"></i>
        </div>

        <div>
            <h3 class="erp-page-title">
                METH DASHBOARD
            </h3>

            <p class="erp-page-subtitle">
                Your assigned unloading work
            </p>
        </div>
    </div>
</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
    </div>
}


<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="erp-card mb-0">
            <div class="erp-card-body">
                <small class="text-muted">
                    Pending Work
                </small>

                <h2 class="fw-bold text-primary mb-0">
                    @pending.Count
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="erp-card mb-0">
            <div class="erp-card-body">
                <small class="text-muted">
                    Completed Work
                </small>

                <h2 class="fw-bold text-success mb-0">
                    @completed.Count
                </h2>
            </div>
        </div>
    </div>

</div>


<div class="erp-card">

    <div class="erp-card-header">
        <span>
            <i class="bi bi-truck me-2 text-primary"></i>
            Assigned RST
        </span>
    </div>

    <div class="erp-card-body p-0">

        <div class="table-responsive">

            <table class="erp-table">

                <thead>
                    <tr>
                        <th>RST Number</th>
                        <th>Vehicle</th>
                        <th>Party</th>
                        <th>Material</th>
                        <th>Location</th>
                        <th>Supervisor</th>
                        <th>Status</th>
                        <th class="text-center">
                            Action
                        </th>
                    </tr>
                </thead>

                <tbody>

                @if (pending.Any())
                {
                    foreach (var item in pending)
                    {
                        <tr>

                            <td class="fw-bold text-primary">
                                @item.RSTNumber
                            </td>

                            <td>
                                @item.VehicleNumber
                            </td>

                            <td>
                                @item.PartyName
                            </td>

                            <td>
                                @item.ItemName
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.LocationName
                                </span>
                            </td>

                            <td>
                                @item.SupervisorName
                            </td>

                            <td>
                                <span class="badge bg-warning text-dark">
                                    Assigned
                                </span>
                            </td>

                            <td class="text-center">

                                <a asp-controller="Meth"
                                   asp-action="ExecuteUnload"
                                   asp-route-id="@item.UnloadId"
                                   class="btn-erp-primary">

                                    <i class="bi bi-play-circle me-1"></i>

                                    Take Action

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="text-center py-5 text-muted">

                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                            No unloading work assigned.

                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>