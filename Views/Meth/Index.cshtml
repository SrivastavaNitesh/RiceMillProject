@model List<RiceMillProject.Models.UnloadTransaction>
@{ViewData["Title"]="Meth Dashboard";var access=ViewBag.MethAccess as List<RiceMillProject.Models.RecordEditRow>??new();var saved=access.Select(a=>a.RecordId).ToHashSet();var pending=Model.Count(a=>!saved.Contains(a.UnloadId.ToString()));var completed=Model.Count-pending;}
<link rel="stylesheet" href="~/css/supervisor-report.css" asp-append-version="true"/>
<div class="erp-page-header mb-4"><h3 class="erp-page-title">Meth Dashboard</h3></div>
@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
@if(TempData["ErrorMessage"]!=null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}
<div class="row g-4 mb-4">
<div class="col-md-4"><a class="sr-card" asp-action="WorkReport" asp-route-status="pending"><div class="sr-card-top"><span class="sr-icon"><i class="bi bi-hourglass-split"></i></span></div><h4>Pending Work</h4><div class="sr-metrics"><strong>@pending</strong></div><div class="sr-card-footer">Open report <i class="bi bi-arrow-right"></i></div></a></div>
<div class="col-md-4"><a class="sr-card" asp-action="WorkReport" asp-route-status="completed"><div class="sr-card-top"><span class="sr-icon"><i class="bi bi-check2-circle"></i></span></div><h4>Completed Work</h4><div class="sr-metrics"><strong>@completed</strong></div><div class="sr-card-footer">Open report <i class="bi bi-arrow-right"></i></div></a></div>
<div class="col-md-4"><a class="sr-card" asp-action="WorkReport" asp-route-status="all"><div class="sr-card-top"><span class="sr-icon"><i class="bi bi-truck"></i></span></div><h4>All Assigned RST</h4><div class="sr-metrics"><strong>@Model.Count</strong></div><div class="sr-card-footer">Open report <i class="bi bi-arrow-right"></i></div></a></div>
</div>
<div class="erp-card"><div class="erp-card-header">Assigned RST</div><partial name="_MethWorkTable" model="Model"/></div>
