@model List<RiceMillProject.Models.UnloadTransaction>
@{var access=ViewBag.MethAccess as List<RiceMillProject.Models.RecordEditRow>??new();var categories=ViewBag.CategoryNames as Dictionary<int,string>??new();bool report=ViewContext.RouteData.Values["action"]?.ToString()=="WorkReport";}
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>RST Number</th><th>Vehicle</th><th>Party</th><th>Item Category</th><th>Location</th><th>Supervisor</th><th>Assigned time</th><th>Work status</th><th>Action</th></tr></thead><tbody>
@foreach(var row in Model){var saved=access.FirstOrDefault(a=>a.RecordId==row.UnloadId.ToString());<tr><td class="fw-bold text-primary">@row.RSTNumber</td><td>@row.VehicleNumber</td><td>@row.PartyName</td><td>@categories.GetValueOrDefault(row.UnloadId,"—")</td><td>@row.LocationName</td><td>@row.SupervisorName</td><td>@row.UnloadTime?.ToString("dd MMM yyyy HH:mm")</td><td><span class="badge @(saved!=null?"bg-success":"bg-warning text-dark")">@(saved!=null?"Completed":"Pending")</span></td><td><div class="d-flex gap-2 flex-wrap">
@if(saved!=null){
@if(saved.CanEdit){<span data-edit-expiry="@saved.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm:ss+05:30")"><a class="btn btn-sm btn-outline-primary edit-window-action" asp-action="ExecuteUnload" asp-route-id="@row.UnloadId" asp-route-edit="true">Edit</a></span>}
<a class="btn btn-sm btn-outline-info" asp-action="ExecuteUnload" asp-route-id="@row.UnloadId" asp-route-viewOnly="true">View</a>
}else{<a class="btn btn-sm btn-primary" asp-action="ExecuteUnload" asp-route-id="@row.UnloadId">Take Action</a>@if(report){<button class="btn btn-sm btn-outline-secondary" disabled title="Work details have not been entered">View</button>}}
</div></td></tr>}
@if(Model.Count==0){<tr><td colspan="9" class="text-center text-muted py-4">No work found for these filters.</td></tr>}
</tbody></table></div>
