@model RiceMillProject.Models.PaddyRecordPage
@{Layout="_LayoutSupervisor";ViewData["Title"]=Model.CategoryName+" Record";var f=Model.Filter;var itemIds=f.SelectedItemIds.ToHashSet();var locationIds=f.SelectedLocationIds.ToHashSet();var bagTypeIds=f.SelectedBagTypeIds.ToHashSet();}

<div class="paddy-record" id="paddy-record-page" data-print-title="@Model.PrintTitle" data-print-supervisor="@Model.SupervisorName" data-print-date="@(f.FromDate==f.ToDate?f.ToDate?.ToString("dd-MM-yy"):$"{f.FromDate:dd-MM-yy} to {f.ToDate:dd-MM-yy}")">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3"><div><h3 class="fw-bold mb-1">@ViewData["Title"]</h3><p class="text-muted mb-0">@Model.OfficeName · @Model.SupervisorName</p></div><button type="button" class="btn btn-outline-primary paddy-controls" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print report</button></div>
<form method="get" asp-action="@Model.ReportAction" id="paddy-filters" class="paddy-controls card border-0 shadow-sm mb-3"><div class="card-body"><div class="row g-3 align-items-end"><input type="hidden" name="ColumnsChosen" value="true"/><input type="hidden" name="BagTypesChosen" value="true"/>
<div class="col-md-2"><label for="FromDate" class="form-label">From Date</label><input class="form-control" id="FromDate" name="FromDate" type="date" value="@f.FromDate?.ToString("yyyy-MM-dd")" required/></div><div class="col-md-2"><label for="ToDate" class="form-label">To Date</label><input class="form-control" id="ToDate" name="ToDate" type="date" value="@f.ToDate?.ToString("yyyy-MM-dd")" required/></div>
<div class="col-md-2"><label class="form-label" for="paddy-item-summary">@Model.CategoryName items</label><details class="paddy-picker" id="paddy-item-picker"><summary id="paddy-item-summary" class="form-select">@itemIds.Count / @Model.Items.Count items selected</summary><div class="paddy-picker-panel"><input class="form-control form-control-sm mb-2" type="search" data-picker-search="item" aria-label="Search @Model.CategoryName items" placeholder="Search @Model.CategoryName items"/><div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-sm btn-outline-primary" data-pick="item" data-checked="true">Select all</button><button type="button" class="btn btn-sm btn-outline-secondary" data-pick="item" data-checked="false">Clear</button></div>@foreach(var item in Model.Items){<label class="paddy-option" data-option="item"><input type="checkbox" name="SelectedItemIds" value="@item.Id" data-paddy-item checked="@itemIds.Contains(item.Id)"/><span>@item.Name</span></label>}@if(Model.Items.Count==0){<p class="text-muted small mb-0">No @Model.CategoryName items configured.</p>}</div></details></div>
<div class="col-md-2"><label class="form-label" for="paddy-location-summary">Locations</label><details class="paddy-picker" id="paddy-location-picker"><summary id="paddy-location-summary" class="form-select">@locationIds.Count / @Model.Locations.Count locations selected</summary><div class="paddy-picker-panel"><input class="form-control form-control-sm mb-2" type="search" data-picker-search="location" aria-label="Search locations" placeholder="Search locations"/><div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-sm btn-outline-primary" data-pick="location" data-checked="true">Select all</button><button type="button" class="btn btn-sm btn-outline-secondary" data-pick="location" data-checked="false">Clear</button></div>@foreach(var location in Model.Locations){<label class="paddy-option" data-option="location"><input type="checkbox" name="SelectedLocationIds" value="@location.Id" data-paddy-location checked="@locationIds.Contains(location.Id)"/><span>@location.Name</span></label>}</div></details></div>
<div class="col-md-2"><label class="form-label" for="paddy-bagtype-summary">Bag types</label><details class="paddy-picker" id="paddy-bagtype-picker"><summary id="paddy-bagtype-summary" class="form-select">@bagTypeIds.Count / @Model.BagTypes.Count bag types selected</summary><div class="paddy-picker-panel"><input class="form-control form-control-sm mb-2" type="search" data-picker-search="bagtype" aria-label="Search bag types" placeholder="Search bag types"/><div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-sm btn-outline-primary" data-pick="bagtype" data-checked="true">Select all</button><button type="button" class="btn btn-sm btn-outline-secondary" data-pick="bagtype" data-checked="false">Clear</button></div>@foreach(var item in Model.BagTypes){<label class="paddy-option" data-option="bagtype"><input type="checkbox" name="SelectedBagTypeIds" value="@item.Id" data-paddy-bagtype checked="@bagTypeIds.Contains(item.Id)"/><span>@item.Name</span></label>}@if(Model.BagTypes.Count==0){<p class="text-muted small mb-0">No bag types configured.</p>}</div></details></div>
<div class="col-md-2 d-flex gap-2"><button class="btn btn-primary" type="submit">Apply dates</button><a asp-action="@Model.ReportAction" class="btn btn-outline-secondary">Reset</a></div>
</div><div class="mt-3 pt-3 border-top"><div class="d-flex flex-wrap align-items-center gap-2 mb-2"><span class="badge text-bg-light">Mandatory: Vehicle Number, Party Name, RST Number</span><button type="button" class="btn btn-sm btn-outline-secondary" data-all-optional="true">Select all extra columns</button><button type="button" class="btn btn-sm btn-outline-secondary" data-all-optional="false">Clear extra columns</button></div><div class="d-flex flex-wrap gap-3">
@foreach(var column in PaddyRecordFilter.OptionalColumns){<label class="form-check-label"><input type="checkbox" class="form-check-input me-1" name="@column.Key" value="true" data-paddy-optional="@column.Key" checked="@f.IsColumnVisible(column.Key)"/>@column.Label</label><input type="hidden" name="@column.Key" value="false"/>}
</div><small class="text-muted d-block mt-2">Each selected location has bag-type subcolumns. Paddy item columns are separate, after RST. All columns scroll horizontally.</small></div></div></form>
@if(!Model.HasPaddyCategory){<div class="alert alert-warning">No @Model.CategoryName category was found. Configure that item category to use this report.</div>}
<div class="paddy-report-heading"><div><strong>@Model.CategoryName.ToUpperInvariant() RECORD</strong><span>@Model.SupervisorName</span></div><span>@f.FromDate?.ToString("dd-MM-yyyy") to @f.ToDate?.ToString("dd-MM-yyyy")</span></div>
<p class="small text-muted my-2 paddy-controls">Location columns show bag-type counts. Separate item columns show variety totals across actual unloading locations. Column choices do not filter records or change their totals.</p>
<div class="paddy-scroll"><table class="paddy-table" id="paddy-table"><caption class="visually-hidden">Vehicle and party, location-wise bag types, total bags and weight, RST, separate @Model.CategoryName items, Meth and actual unloading location.</caption><thead><tr>
<th class="vehicle-column" rowspan="2" scope="col" data-mandatory="vehicle">Vehicle Number</th><th class="party-column" rowspan="2" scope="col" data-mandatory="party">Party Name</th>
@foreach(var location in Model.Locations){<th scope="colgroup" colspan="@Math.Max(1,bagTypeIds.Count)" data-location-group="@location.Id" hidden="@(!locationIds.Contains(location.Id)||bagTypeIds.Count==0)">@location.Name</th>}
<th rowspan="2" scope="col" data-optional="ShowTotalBags" hidden="@(!f.ShowTotalBags)">Total Bags</th><th rowspan="2" scope="col" data-optional="ShowWeight" hidden="@(!f.ShowWeight)">Weight (KG)</th><th rowspan="2" scope="col" data-mandatory="rst">RST Number</th>
@foreach(var item in Model.Items){<th rowspan="2" scope="col" data-item="@item.Id" hidden="@(!itemIds.Contains(item.Id))">@item.Name</th>}
<th rowspan="2" scope="col" data-optional="ShowMeth" hidden="@(!f.ShowMeth)">Meth Name</th><th rowspan="2" scope="col" data-optional="ShowLocations" hidden="@(!f.ShowLocations)">Actual Unloading Location</th>
</tr><tr>@foreach(var column in Model.Columns){<th scope="col" data-location="@column.LocationId" data-bagtype="@column.BagTypeId" hidden="@(!locationIds.Contains(column.LocationId)||!bagTypeIds.Contains(column.BagTypeId))">@column.BagTypeName</th>}</tr></thead><tbody>
@foreach(var row in Model.Rows){<tr><td class="vehicle-column" data-mandatory="vehicle">@row.VehicleNumber</td><td class="party-column" data-mandatory="party">@row.PartyName @if(row.PendingDetails){<small class="d-block text-muted">Field details pending</small>}</td>
@foreach(var column in Model.Columns){var bags=row.LocationBagsAt(column.LocationId,column.BagTypeId);<td class="qty" data-location="@column.LocationId" data-bagtype="@column.BagTypeId" hidden="@(!locationIds.Contains(column.LocationId)||!bagTypeIds.Contains(column.BagTypeId))">@(bags>0?bags.ToString("N0"):"—")</td>}
<td class="qty fw-bold" data-optional="ShowTotalBags" hidden="@(!f.ShowTotalBags)">@row.TotalBags</td><td class="qty" data-optional="ShowWeight" hidden="@(!f.ShowWeight)">@(row.NetWeightKg?.ToString("N2")??"Pending")</td><td class="fw-bold" data-mandatory="rst">@row.RSTNumber</td>
@foreach(var item in Model.Items){var bags=row.ItemTotal(item.Id);<td class="qty" data-item="@item.Id" hidden="@(!itemIds.Contains(item.Id))">@(bags>0?bags.ToString("N0"):"—")</td>}
<td data-optional="ShowMeth" hidden="@(!f.ShowMeth)">@row.MethName</td><td data-optional="ShowLocations" hidden="@(!f.ShowLocations)">@foreach(var location in row.ActualLocations.OrderBy(l=>l.Value)){<span class="paddy-location-name" data-summary-location="@location.Key">@location.Value</span>}@if(row.ActualLocations.Count==0){<span>—</span>}</td></tr>}
@if(Model.Rows.Count==0){<tr><td id="paddy-empty" colspan="@Model.VisibleColumnCount" class="text-center text-muted p-4">No assigned @Model.CategoryName records found for these dates.</td></tr>}
</tbody><tfoot><tr><th data-mandatory="vehicle">TOTAL</th><td data-mandatory="party">@Model.Rows.Count RSTs</td>
@foreach(var column in Model.Columns){<td class="qty" data-location="@column.LocationId" data-bagtype="@column.BagTypeId" hidden="@(!locationIds.Contains(column.LocationId)||!bagTypeIds.Contains(column.BagTypeId))">@Model.Rows.Sum(r=>r.LocationBagsAt(column.LocationId,column.BagTypeId)).ToString("N0")</td>}
<td class="qty" data-optional="ShowTotalBags" hidden="@(!f.ShowTotalBags)">@Model.Rows.Sum(r=>r.TotalBags).ToString("N0")</td><td class="qty" data-optional="ShowWeight" hidden="@(!f.ShowWeight)">@Model.Rows.Sum(r=>r.NetWeightKg??0).ToString("N2")@(Model.Rows.Any(r=>!r.NetWeightKg.HasValue)?" *":"")</td><td data-mandatory="rst"></td>
@foreach(var item in Model.Items){<td class="qty" data-item="@item.Id" hidden="@(!itemIds.Contains(item.Id))">@Model.Rows.Sum(r=>r.ItemTotal(item.Id)).ToString("N0")</td>}
<td data-optional="ShowMeth" hidden="@(!f.ShowMeth)"></td><td data-optional="ShowLocations" hidden="@(!f.ShowLocations)"></td></tr></tfoot></table></div>
@if(Model.Rows.Any(r=>!r.NetWeightKg.HasValue)){<p class="small text-muted mt-2" data-optional="ShowWeight" hidden="@(!f.ShowWeight)">* Weight total includes recorded net weights only; pending weighments are excluded.</p>}
</div>
<style>
.paddy-record{color:#17324d}.paddy-report-heading{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 18px;border:1px solid #adc9c4;background:#eff8f6;border-radius:10px 10px 0 0}.paddy-report-heading>div{display:flex;gap:22px;flex-wrap:wrap}.paddy-scroll{max-height:70vh;overflow:auto;border:1px solid #b9c8cc;background:#fff}.paddy-table{border-collapse:separate;border-spacing:0;font-size:.8rem;width:max-content;min-width:100%}.paddy-table th,.paddy-table td{min-width:100px;padding:10px 9px;border-right:1px solid #cad5d8;border-bottom:1px solid #cad5d8;vertical-align:middle}.paddy-table thead th{text-align:center;color:#214b47;background:#e2efec;white-space:nowrap}.paddy-table thead tr:nth-child(2) th{background:#f1f7f5}.paddy-table .qty{text-align:right;font-variant-numeric:tabular-nums}.paddy-table tbody tr:nth-child(even) td{background:#f8fbfa}.paddy-table tbody tr:hover td{background:#eef6fb}.paddy-table tfoot td,.paddy-table tfoot th{font-weight:750;background:#eaf4ef}.paddy-table .vehicle-column{min-width:128px}.paddy-table .party-column{min-width:210px;max-width:260px;white-space:normal}.paddy-picker{position:relative}.paddy-picker-panel{position:absolute;z-index:30;min-width:100%;width:310px;max-width:85vw;max-height:330px;overflow:auto;background:white;border:1px solid #cbd5e1;padding:12px;border-radius:9px;box-shadow:0 12px 30px #17203324}.paddy-option{display:flex;align-items:center;gap:9px;padding:8px;cursor:pointer}.paddy-option:hover{background:#f0f8f6}.paddy-location-name{display:inline-block;margin:2px 4px 2px 0;padding:2px 5px;border-radius:4px;background:#edf4f7}.paddy-record [hidden]{display:none!important}.paddy-print-document{display:none}
@@media print{
 @@page{size:A4 landscape;margin:0}
 html,body{margin:0!important;padding:0!important;width:auto!important;height:auto!important;background:#fff!important;color:#000!important}
 body:has(#paddy-print-document)>:not(#paddy-print-document){display:none!important}
 #paddy-print-document{display:block!important;margin:0!important;padding:0!important;color:#000!important;background:#fff!important;font-family:Arial,"Nirmala UI",sans-serif!important}
 .paddy-print-sheet{width:297mm;height:210mm;box-sizing:border-box;padding:7mm;break-after:page;page-break-after:always;overflow:hidden;background:#fff!important}
 .paddy-print-sheet:last-child{break-after:auto;page-break-after:auto}
 .paddy-print-grid{width:100%;height:190mm;border-collapse:collapse;table-layout:fixed;border:0.55mm solid #000!important;font-family:Arial,"Nirmala UI",sans-serif!important;font-size:9pt!important;line-height:1!important;color:#000!important}
 .paddy-print-grid *{color:#000!important;background:#fff!important;box-shadow:none!important;text-shadow:none!important;border-radius:0!important}
 .paddy-print-grid th,.paddy-print-grid td{border:0.35mm solid #000!important;padding:0.1mm 0.5mm;box-sizing:border-box;vertical-align:middle;overflow-wrap:anywhere}
 .paddy-print-grid thead th{text-align:center;font-size:9pt!important;font-weight:700!important;white-space:normal!important;height:7mm}
 .paddy-print-grid thead .print-title-row th{height:9mm;border-bottom:0.5mm solid #000!important}
 .paddy-print-title{display:grid;grid-template-columns:1.25fr 1fr 1.25fr;align-items:center;gap:4mm;font-size:12pt!important;text-align:left;line-height:1.15}
 .paddy-print-title>strong:nth-child(2){text-align:center}.paddy-print-title .print-date{text-align:right;font-size:10pt!important}
 .paddy-print-grid tbody tr{height:7mm;break-inside:avoid;page-break-inside:avoid}
 .paddy-print-grid .print-item-header{font-size:8pt!important;overflow-wrap:normal!important;word-break:normal!important;padding:0.1mm 0.2mm!important}
 .paddy-print-grid .print-serial{text-align:center;padding-left:0.2mm;padding-right:0.2mm;font-size:8.5pt!important}
 .paddy-print-grid .print-qty{text-align:right;font-variant-numeric:tabular-nums}
 .paddy-print-grid .print-total-row>*{font-weight:700!important;border-top:0.5mm solid #000!important;border-bottom:0.5mm solid #000!important}
 .paddy-print-footer{height:4mm;box-sizing:border-box;text-align:right;padding-top:0.5mm;font:8pt Arial,sans-serif!important;color:#000!important}
}
</style>
@section Scripts{<script src="~/js/paddy-record.js" asp-append-version="true"></script>}
