@model RiceMillProject.Models.UnloadTransaction
@{
    ViewData["Title"] = "Verify Unload Slip";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Verify Meth's Unload Slip</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
                    <div class="row">
                        <div class="col-md-6 mb-2"><strong>RST Number:</strong> <span class="text-dark">@Model.RSTNumber</span></div>
                        <div class="col-md-6 mb-2"><strong>Meth Assigned:</strong> <span class="text-dark">@Model.MethName</span></div>
                        <div class="col-md-6 mb-2"><strong>Bag Type:</strong> <span class="text-dark">@Model.BagTypeName</span></div>
                        <div class="col-md-6 mb-2"><strong>Total Bags:</strong> <span class="text-dark">@Model.NumberOfBags</span></div>
                        <div class="col-md-6 mb-2"><strong>Unloaded At:</strong> <span class="text-dark">@Model.UnloadTime?.ToString("dd/MMM/yyyy HH:mm")</span></div>
                        <div class="col-md-6 mb-2"><strong>Gate Man (Verifier):</strong> <span class="text-dark">@Model.GateManId</span></div>
                    </div>
                </div>

                <form asp-action="Verify" method="post">
                    <input type="hidden" asp-for="UnloadId" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-danger">Bag Deductions (If any weight shortage found in Grams)</label>
                        <div class="input-group">
                            <input type="number" step="0.01" class="form-control border-danger" name="TotalBagDeductionGrams" value="0.00" required />
                            <span class="input-group-text bg-danger text-white border-danger">Grams</span>
                        </div>
                        <small class="text-muted">Enter 0 if all bags are perfect.</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold">
                            <i class="bi bi-check-circle me-2"></i> Approve & Verify Slip
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
