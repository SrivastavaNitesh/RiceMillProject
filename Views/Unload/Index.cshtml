@using System.Linq
@model List<RiceMillProject.Models.UnloadTransaction>
@{
    ViewData["Title"] = "RST Assignment Board";
    var pendingAssignments = ViewBag.PendingAssignments as List<RiceMillProject.Models.GateEntry>;
    var pendingCount = pendingAssignments?.Count ?? 0;
}

<style>
    .unload-board { --ub-primary:#087f78; --ub-dark:#075e59; --ub-ink:#16324a; --ub-muted:#64748b; --ub-border:#dbe7e6; --ub-soft:#f2f8f7; }
    .ub-hero { position:relative; overflow:hidden; padding:26px 30px; border:1px solid #cfe2df; border-radius:18px; background:linear-gradient(135deg,#fff 0%,#f1faf8 100%); box-shadow:0 12px 30px rgba(15,76,72,.08); }
    .ub-hero::after { content:""; position:absolute; width:190px; height:190px; right:-65px; top:-95px; border-radius:50%; background:rgba(8,127,120,.08); }
    .ub-hero-content { position:relative; z-index:1; }
    .ub-hero-icon { width:54px; height:54px; display:inline-flex; align-items:center; justify-content:center; flex:0 0 54px; border-radius:15px; color:#fff; background:linear-gradient(145deg,var(--ub-primary),#16a394); box-shadow:0 8px 18px rgba(8,127,120,.2); font-size:1.45rem; }
    .ub-eyebrow { color:var(--ub-primary); font-size:.72rem; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
    .ub-title { margin:3px 0 4px; color:var(--ub-ink); font-size:clamp(1.35rem,2.2vw,1.9rem); font-weight:800; letter-spacing:-.025em; }
    .ub-subtitle { margin:0; color:var(--ub-muted); font-size:.92rem; }
    .ub-count { min-width:145px; padding:12px 16px; border:1px solid #b9dcd7; border-radius:14px; background:rgba(255,255,255,.82); text-align:center; }
    .ub-count strong { display:block; color:var(--ub-dark); font-size:1.5rem; line-height:1; }
    .ub-count span { color:var(--ub-muted); font-size:.7rem; font-weight:750; text-transform:uppercase; }
    .ub-panel { margin-top:20px; border:1px solid var(--ub-border); border-radius:18px; background:#fff; box-shadow:0 8px 24px rgba(15,46,62,.06); }
    .ub-panel-head { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:18px 22px; border-bottom:1px solid var(--ub-border); }
    .ub-panel-title { margin:0; color:var(--ub-ink); font-size:1rem; font-weight:800; }
    .ub-panel-note { margin-top:3px; color:var(--ub-muted); font-size:.78rem; }
    .ub-search { position:relative; width:min(100%,310px); }
    .ub-search i { position:absolute; left:13px; top:50%; color:#78908e; transform:translateY(-50%); }
    .ub-search input { width:100%; height:42px; padding:0 14px 0 38px; border:1px solid #cddcda; border-radius:11px; outline:none; color:var(--ub-ink); background:#fbfdfd; }
    .ub-search input:focus { border-color:var(--ub-primary); box-shadow:0 0 0 3px rgba(8,127,120,.1); }
    .ub-ticket-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(310px,1fr)); gap:16px; padding:20px; }
    .ub-ticket { overflow:hidden; position:relative; border:1px solid var(--ub-border); border-radius:15px; background:#fff; box-shadow:0 4px 14px rgba(15,46,62,.05); transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease; }
    .ub-ticket:hover { transform:translateY(-3px); border-color:#9bcac5; box-shadow:0 12px 25px rgba(8,127,120,.12); }
    .ub-ticket-head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:14px 16px; border-bottom:1px dashed #c7dcd9; background:var(--ub-soft); }
    .ub-label { display:block; margin-bottom:3px; color:var(--ub-muted); font-size:.65rem; font-weight:750; text-transform:uppercase; }
    .ub-rst { color:var(--ub-dark); font-size:1.08rem; font-weight:850; letter-spacing:.02em; }
    .ub-status { padding:5px 9px; border:1px solid #f0cf87; border-radius:999px; color:#8a5a00; background:#fff8e8; font-size:.68rem; font-weight:800; white-space:nowrap; }
    .ub-ticket-body { padding:16px; }
    .ub-party { margin-bottom:14px; color:var(--ub-ink); font-size:.96rem; font-weight:750; }
    .ub-meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .ub-meta { min-width:0; padding:11px 12px; border:1px solid #e3eceb; border-radius:11px; background:#fcfefe; }
    .ub-value { display:block; overflow:hidden; color:var(--ub-ink); font-size:.87rem; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
    .ub-ticket-action { padding:0 16px 16px; }
    .ub-assign { display:flex; align-items:center; justify-content:center; gap:8px; width:100%; min-height:43px; border-radius:11px; color:#fff; background:linear-gradient(135deg,var(--ub-primary),#0b998e); font-size:.83rem; font-weight:800; text-decoration:none; box-shadow:0 7px 15px rgba(8,127,120,.16); }
    .ub-assign:hover { color:#fff; background:var(--ub-dark); }
    .ub-empty { padding:62px 20px; text-align:center; }
    .ub-empty-icon { width:64px; height:64px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:13px; border-radius:18px; color:var(--ub-primary); background:var(--ub-soft); font-size:1.7rem; }
    .ub-empty h4 { margin-bottom:5px; color:var(--ub-ink); font-size:1rem; font-weight:800; }
    .ub-empty p { margin:0; color:var(--ub-muted); font-size:.82rem; }
    @@media (max-width:767.98px) {
        .ub-hero { padding:20px; }
        .ub-count { width:100%; margin-top:16px; text-align:left; }
        .ub-panel-head { align-items:stretch; flex-direction:column; }
        .ub-search { width:100%; }
        .ub-ticket-grid { grid-template-columns:1fr; padding:14px; }
    }
</style>

<main class="unload-board">
    <section class="ub-hero">
        <div class="ub-hero-content d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="ub-hero-icon"><i class="bi bi-box-arrow-in-down"></i></div>
                <div>
                    <div class="ub-eyebrow">Unloading Operations</div>
                    <h1 class="ub-title">RST Assignment Board</h1>
                    <p class="ub-subtitle">Pending vehicle ko location aur Meth assign karke unloading workflow start karein.</p>
                </div>
            </div>
            <div class="ub-count"><strong>@pendingCount</strong><span>Pending Tickets</span></div>
        </div>
    </section>

    <section class="ub-panel mb-4">
        <header class="ub-panel-head">
            <div>
                <h2 class="ub-panel-title"><i class="bi bi-ticket-perforated me-2 text-success"></i>Available RST E-Tickets</h2>
                <div class="ub-panel-note">Latest weighment ke baad assignment ke liye ready vehicles.</div>
            </div>
            @if (pendingCount > 0)
            {
                <div class="ub-search">
                    <i class="bi bi-search"></i>
                    <input type="search" id="ticketSearch" placeholder="Search RST, party or vehicle..." autocomplete="off" />
                </div>
            }
        </header>

        @if (pendingAssignments != null && pendingAssignments.Any())
        {
            <div class="ub-ticket-grid" id="ticketGrid">
                @foreach (var entry in pendingAssignments)
                {
                    <article class="ub-ticket" data-ticket-search="@entry.RSTNumber @entry.PartyName @entry.VehicleNumber">
                        <div class="ub-ticket-head">
                            <div>
                                <span class="ub-label">RST Number</span>
                                <div class="ub-rst"><i class="bi bi-upc-scan me-1"></i>@entry.RSTNumber</div>
                            </div>
                            <span class="ub-status"><i class="bi bi-clock-history me-1"></i>Awaiting Assignment</span>
                        </div>
                        <div class="ub-ticket-body">
                            <span class="ub-label">Party / Supplier</span>
                            <div class="ub-party">@(string.IsNullOrWhiteSpace(entry.PartyName) ? "—" : entry.PartyName)</div>
                            <div class="ub-meta-grid">
                                <div class="ub-meta">
                                    <span class="ub-label"><i class="bi bi-truck me-1"></i>Vehicle</span>
                                    <span class="ub-value" title="@entry.VehicleNumber">@(string.IsNullOrWhiteSpace(entry.VehicleNumber) ? "—" : entry.VehicleNumber)</span>
                                </div>
                                <div class="ub-meta">
                                    <span class="ub-label"><i class="bi bi-speedometer2 me-1"></i>Gross Weight</span>
                                    <span class="ub-value">@entry.GrossWeight.ToString("N2") KG</span>
                                </div>
                            </div>
                        </div>
                        <div class="ub-ticket-action">
                            <a asp-action="Assign" asp-route-rstNumber="@entry.RSTNumber" class="ub-assign">
                                <i class="bi bi-geo-alt"></i> Assign Location &amp; Meth <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
            <div id="ticketNoResults" class="ub-empty d-none">
                <div class="ub-empty-icon"><i class="bi bi-search"></i></div>
                <h4>No matching ticket found</h4>
                <p>RST number, party ya vehicle number dobara check karein.</p>
            </div>
        }
        else
        {
            <div class="ub-empty">
                <div class="ub-empty-icon"><i class="bi bi-check2-circle"></i></div>
                <h4>No pending RST assignment</h4>
                <p>Weighbridge se naya RST ready hote hi ticket yahan automatically show hoga.</p>
            </div>
        }
    </section>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const search = document.getElementById('ticketSearch');
        const tickets = Array.from(document.querySelectorAll('#ticketGrid .ub-ticket'));
        const noResults = document.getElementById('ticketNoResults');
        if (!search) return;
        search.addEventListener('input', function () {
            const term = this.value.trim().toLowerCase();
            let visible = 0;
            tickets.forEach(function (ticket) {
                const matches = !term || (ticket.dataset.ticketSearch || '').toLowerCase().includes(term);
                ticket.classList.toggle('d-none', !matches);
                if (matches) visible++;
            });
            if (noResults) noResults.classList.toggle('d-none', visible > 0);
        });
    });
</script>
