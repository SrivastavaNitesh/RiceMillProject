@using System.Linq
@model List<RiceMillProject.Models.UnloadTransaction>
@{
    ViewData["Title"] = "Supervisor Unloading Board";
    var pendingAssignments = ViewBag.PendingAssignments as List<RiceMillProject.Models.GateEntry>;
    var pendingVerifications = ViewBag.PendingVerifications as List<RiceMillProject.Models.UnloadTransaction>;
}

<style>
    .ticket-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 18px;
    }
    .ticket-box {
        background: #ffffff;
        border: 2px dashed #0d6efd;
        border-radius: 14px;
        padding: 16px;
        position: relative;
        transition: all 0.25s ease;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }
    .ticket-box:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(13, 110, 253, 0.2);
        border-style: solid;
    }
    .ticket-notch-left, .ticket-notch-right {
        width: 16px;
        height: 16px;
        background-color: #f8f9fa;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        margin-top: -8px;
    }
    .ticket-notch-left { left: -9px; border-right: 2px solid #0d6efd; }
    .ticket-notch-right { right: -9px; border-left: 2px solid #0d6efd; }
    .ticket-header {
        background: #0d6efd;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
    }
</style>

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-ticket-perforated-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">SUPERVISOR UNLOADING BOARD</h3>
            <p class="erp-page-subtitle">Interactive RST ticket claim, Meth labour assignment, and unloading slip verification</p>
        </div>
    </div>
</div>

<!-- Cinema-Seat Ticket Box Grid for Pending Assignments -->
<div class="erp-card mb-4">
    <div class="erp-card-header">
        <span><i class="bi bi-film text-primary me-2"></i> Available RST Ticket Cards</span>
        <span class="badge-erp badge-erp-info">@(pendingAssignments?.Count ?? 0) Unassigned</span>
    </div>
    <div class="erp-card-body bg-light">
        @if (pendingAssignments != null && pendingAssignments.Any())
        {
            <div class="ticket-grid">
                @foreach (var entry in pendingAssignments)
                {
                    <div class="ticket-box">
                        <div class="ticket-notch-left"></div>
                        <div class="ticket-notch-right"></div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="ticket-header">
                                <i class="bi bi-ticket-detailed me-1"></i> @entry.RSTNumber
                            </div>
                            <span class="badge-erp badge-erp-warning"><i class="bi bi-clock me-1"></i> Pending</span>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 10px;">Vehicle Number</small>
                            <div class="fw-bold fs-5 text-dark"><i class="bi bi-truck text-primary me-2"></i> @entry.VehicleNumber</div>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 10px;">Gross Weight</small>
                            <div class="fw-bold text-success" style="font-size: 14px;"><i class="bi bi-speedometer2 me-1"></i> @entry.GrossWeight KG</div>
                        </div>

                        <div class="border-top pt-3">
                            <a asp-action="Assign" asp-route-rstNumber="@entry.RSTNumber" class="btn-erp-primary w-100 justify-content-center">
                                <i class="bi bi-person-plus me-1"></i> Claim & Assign Meth
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-ticket-stub display-4 mb-2 text-secondary opacity-50"></i>
                <div class="fw-bold">No pending RST Tickets available for assignment right now.</div>
                <small>New ticket boxes appear automatically when trucks pass Dharam Kanta weighbridge.</small>
            </div>
        }
    </div>
</div>

<!-- Active & Unloaded Transactions Register -->
<div class="erp-card">
    <div class="erp-card-header">
        <span><i class="bi bi-check2-circle text-success me-2"></i> Active & Unloaded Register (Paddy Variety & Multi-Supervisor Log)</span>
        <span class="badge-erp badge-erp-success">@(Model != null ? Model.Count : 0) Unloading Entries</span>
    </div>
    <div class="erp-card-body p-0">
        <div class="table-responsive">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th class="ps-4">RST Number</th>
                        <th>Paddy Variety (Item)</th>
                        <th>Assigned Supervisor</th>
                        <th>Meth (Labour Head)</th>
                        <th>Bags Unloaded</th>
                        <th>Status</th>
                        <th class="text-center pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var unload in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    @unload.RSTNumber
                                    <div class="small text-muted"><a asp-action="Assign" asp-route-rstNumber="@unload.RSTNumber" class="text-decoration-none small">+ Add Variety</a></div>
                                </td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1"><i class="bi bi-box-seam me-1"></i> @(string.IsNullOrEmpty(unload.ItemName) ? "Mansuri Paddy" : unload.ItemName)</span></td>
                                <td><strong class="text-dark"><i class="bi bi-person-badge me-1 text-secondary"></i> @(string.IsNullOrEmpty(unload.SupervisorName) ? "Rajesh Kumar Sharma" : unload.SupervisorName)</strong></td>
                                <td><strong class="text-dark">@(string.IsNullOrEmpty(unload.MethName) ? "Meth Ramu Yadav" : unload.MethName)</strong></td>
                                <td><span class="badge-erp badge-erp-info">@(unload.NumberOfBags ?? 0) Bags</span></td>
                                <td><span class="badge-erp badge-erp-warning">@unload.Status</span></td>
                                <td class="text-center pe-4">
                                    <a asp-action="Verify" asp-route-id="@unload.UnloadId" class="btn btn-sm btn-outline-success fw-bold">
                                        <i class="bi bi-shield-check me-1"></i> Verify & Deductions
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No unloading entries registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
