@using System.Data
@model DataTable
@{ViewData["Title"]="Palledari Report";var rows=Model.AsEnumerable().ToList();}
<div class="erp-page-header"><div class="erp-page-title-group"><div class="erp-page-icon"><i class="bi bi-cash-stack"></i></div><div><h3 class="erp-page-title">Palledari Report</h3><p class="erp-page-subtitle">RST-wise saved Supervisor Meth entries, bags and palledari charges</p></div></div><button type="button" class="btn-erp-outline report-action" onclick="window.print()">Print</button></div>
<div class="erp-card mb-3 report-action"><div class="erp-card-body"><form method="get" class="row g-3 align-items-end"><div class="col-md-3"><label for="fromDate" class="form-label">From Date</label><input type="date" id="fromDate" name="fromDate" value="@ViewBag.FromDate" class="form-control"/></div><div class="col-md-3"><label for="toDate" class="form-label">To Date</label><input type="date" id="toDate" name="toDate" value="@ViewBag.ToDate" class="form-control"/></div><div class="col-md-3"><label for="search" class="form-label">RST / Meth / Item / Location</label><input id="search" name="search" value="@ViewBag.Search" maxlength="200" class="form-control"/></div><div class="col-md-3"><button class="btn btn-primary">Apply Filter</button><a asp-action="PalledariReport" class="btn btn-outline-secondary ms-2">Clear</a></div></form></div></div>
<p class="small text-muted">Bags and charges are grouped by RST assignment, bag type, work type and saved rate. Item and location names describe the assignment. Saved Supervisor Meth charges are shown; older worker entries are used only when no Supervisor Meth entry exists.</p>
<div class="erp-card"><div class="table-responsive"><table class="table table-striped table-hover align-middle mb-0"><thead style="background:#dfeeea;color:#214b47"><tr><th>RST Number</th><th>Item Category Name</th><th>Item Name</th><th>Location Name</th><th>Meth Name</th><th>Supervisor Name</th><th>Bag Type</th><th>Work Type</th><th class="text-end">Bags Count</th><th class="text-end">Palledari Rate / Bag</th><th class="text-end">Total Palledari</th></tr></thead><tbody>
@foreach(var row in rows){<tr><td class="fw-bold text-primary">@row["RSTNumber"]</td><td>@row["CategoryNames"]</td><td>@row["ItemNames"]</td><td>@row["LocationNames"]</td><td>@row["MethName"]</td><td>@row["SupervisorName"]</td><td>@row["BagTypeName"]</td><td>@row["WorkType"]</td><td class="text-end">@row["BagCount"]</td><td class="text-end">@(Convert.ToDecimal(row["PerBagCharge"]).ToString("N2"))</td><td class="text-end">@(row.IsNull("TotalPalledari")?"—":Convert.ToDecimal(row["TotalPalledari"]).ToString("N2"))</td></tr>}
@if(rows.Count==0){<tr><td colspan="11" class="text-center text-muted p-4">No saved Meth work found for these filters.</td></tr>}
</tbody><tfoot><tr class="fw-bold"><td colspan="8">Total</td><td class="text-end">@rows.Sum(r=>Convert.ToInt64(r["BagCount"]))</td><td></td><td class="text-end">@rows.Sum(r=>r.IsNull("TotalPalledari")?0m:Convert.ToDecimal(r["TotalPalledari"])).ToString("N2")</td></tr></tfoot></table></div></div>
<style>@@media print{@@page{size:A3 landscape;margin:8mm}.report-action{display:none!important}.table-responsive{overflow:visible!important}thead{display:table-header-group}}</style>
