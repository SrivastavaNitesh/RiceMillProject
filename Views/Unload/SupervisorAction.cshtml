@model RiceMillProject.Models.SupervisorUnloadActionViewModel

@{
    var vm = Model
        ?? new RiceMillProject.Models.SupervisorUnloadActionViewModel();

    int labourTotalBags = vm.MethTotalBags;
}

<style>
    .sup-form-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 5px 0 35px 0;
    }

    .sup-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        margin-bottom: 18px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .06);
    }

    .sup-top-line {
        height: 7px;
        background: linear-gradient(90deg, #1e3c72, #2a5298);
    }

    .sup-main-header {
        padding: 22px 24px;
    }

    .sup-main-title {
        margin: 0;
        color: #173b6c;
        font-size: 25px;
        font-weight: 750;
    }

    .sup-subtitle {
        color: #64748b;
        font-size: 13px;
        margin-top: 6px;
    }

    .sup-section-title {
        padding: 14px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        color: #173b6c;
        font-weight: 750;
        font-size: 16px;
    }

    .sup-section-body {
        padding: 20px;
    }

    .sup-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 5px;
    }

    .sup-readonly {
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #dbe3ec;
        background: #f8fafc;
        border-radius: 8px;
        font-weight: 650;
        color: #1f2937;
    }

    .sup-rst {
        color: #1769e0;
        font-weight: 800;
    }

    .form-control,
    .form-select {
        min-height: 43px;
        border-radius: 8px;
        border: 1px solid #cfd8e3;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .10);
    }

    .stack-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .stack-table th {
        padding: 11px;
        background: #f8fafc;
        color: #475569;
        text-align: center;
        font-size: 12px;
        border-bottom: 1px solid #e2e8f0;
    }

    .stack-table td {
        padding: 12px;
    }

    .stack-table input {
        text-align: center;
        font-weight: 700;
    }

    .summary-box {
        min-height: 82px;
        background: #f8fafc;
        border: 1px solid #dbe3ec;
        border-radius: 10px;
        padding: 13px 15px;
    }

    .summary-label {
        color: #64748b;
        font-size: 12px;
    }

    .summary-value {
        margin-top: 3px;
        color: #173b6c;
        font-size: 23px;
        font-weight: 800;
    }

    .material-table th {
        background: #f8fafc;
        color: #475569;
        font-size: 12px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .material-table td {
        vertical-align: middle;
    }

    .required {
        color: #dc2626;
    }

    .total-status {
        margin-top: 15px;
        padding: 11px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 650;
    }

    .total-status-warning {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
    }

    .total-status-success {
        background: #ecfdf3;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .master-message {
        margin-bottom: 15px;
        padding: 10px 13px;
        border-radius: 8px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1d4ed8;
        font-size: 13px;
    }

    .master-error {
        background: #fef2f2;
        border-color: #fecaca;
        color: #b91c1c;
    }

    @@media (max-width: 767px) {
        .sup-main-header,
        .sup-section-body {
            padding: 15px;
        }

        .sup-main-title {
            font-size: 21px;
        }

        .stack-table {
            min-width: 650px;
        }
    }
</style>


<div class="sup-form-page">

    <!-- =====================================================
         GOOGLE FORM STYLE HEADER
         ===================================================== -->

    <div class="sup-card">

        <div class="sup-top-line"></div>

        <div class="sup-main-header">

            <h2 class="sup-main-title">
                Purchase Entry Form
            </h2>

            <div class="sup-subtitle">
                Supervisor unloading, Stack / Haudi and material bag entry
            </div>

        </div>

    </div>


    <!-- =====================================================
         MESSAGES
         ===================================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

        </div>
    }


    <!-- =====================================================
         FORM
         ===================================================== -->

    <form asp-controller="Unload"
          asp-action="SupervisorAction"
          method="post"
          id="supervisorActionForm">

        @Html.AntiForgeryToken()


        <input type="hidden"
               name="UnloadId"
               value="@vm.UnloadId" />

        <input type="hidden"
               name="RSTNumber"
               value="@vm.RSTNumber" />

        <input type="hidden"
               name="MethTotalBags"
               id="labourTotalHidden"
               value="@labourTotalBags" />


        <!-- =================================================
             RST DETAILS
             ================================================= -->

        <div class="sup-card">

            <div class="sup-section-title">

                <i class="bi bi-receipt me-2"></i>

                RST / Assignment Details

            </div>


            <div class="sup-section-body">

                <div class="row g-3">

                    <!-- RST -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            RST Number
                        </label>

                        <div class="sup-readonly sup-rst">

                            @(string.IsNullOrWhiteSpace(vm.RSTNumber)
                                ? "-"
                                : vm.RSTNumber)

                        </div>

                    </div>


                    <!-- TRUCK -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Truck Number
                        </label>

                        <div class="sup-readonly">

                            @(string.IsNullOrWhiteSpace(vm.VehicleNumber)
                                ? "-"
                                : vm.VehicleNumber)

                        </div>

                    </div>


                    <!-- PARTY -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Party Name
                        </label>

                        <div class="sup-readonly">

                            @(string.IsNullOrWhiteSpace(vm.PartyName)
                                ? "-"
                                : vm.PartyName)

                        </div>

                    </div>


                    <!-- COMPANY -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Company
                        </label>

                        <div class="sup-readonly">

                            @(string.IsNullOrWhiteSpace(vm.CompanyName)
                                ? "-"
                                : vm.CompanyName)

                        </div>

                    </div>


                    <!-- MATERIAL -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Material
                        </label>

                        <div class="sup-readonly">

                            @(string.IsNullOrWhiteSpace(vm.ItemName)
                                ? "-"
                                : vm.ItemName)

                        </div>

                    </div>


                    <!-- DATE -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Entry Date
                        </label>

                        <div class="sup-readonly">

                            @DateTime.Today.ToString("dd-MM-yyyy")

                        </div>

                    </div>


                    <!-- SUPERVISOR -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Supervisor
                        </label>

                        <div class="sup-readonly">

                            @(User?.Identity?.Name ?? "-")

                        </div>

                    </div>


                    <!-- METH -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Meth
                        </label>

                        <div class="sup-readonly">

                            @(string.IsNullOrWhiteSpace(vm.MethName)
                                ? "-"
                                : vm.MethName)

                        </div>

                    </div>


                    <!-- LOCATION -->

                    <div class="col-lg-4 col-md-6">

                        <label class="sup-label">
                            Location
                        </label>

                        <div class="sup-readonly">

                            @(string.IsNullOrWhiteSpace(vm.LocationName)
                                ? "-"
                                : vm.LocationName)

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             STACK / HAUDI
             Original Google Form Section
             ================================================= -->

        <div class="sup-card">

            <div class="sup-section-title">

                <i class="bi bi-boxes me-2"></i>

                Stack / Haudi Details

            </div>


            <div class="sup-section-body">

                <div class="table-responsive">

                    <table class="stack-table">

                        <thead>

                            <tr>

                                <th>
                                    Stack (PP)
                                </th>

                                <th>
                                    Stack (Jute)
                                </th>

                                <th>
                                    Haudi (PP)
                                </th>

                                <th>
                                    Haudi (Jute)
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>

                                    <input type="number"
                                           name="StackPP"
                                           id="stackPP"
                                           class="form-control stack-value"
                                           min="0"
                                           step="1"
                                           placeholder="0"
                                           value="@(vm.StackPP > 0 ? vm.StackPP.ToString() : "")" />

                                </td>


                                <td>

                                    <input type="number"
                                           name="StackJute"
                                           id="stackJute"
                                           class="form-control stack-value"
                                           min="0"
                                           step="1"
                                           placeholder="0"
                                           value="@(vm.StackJute > 0 ? vm.StackJute.ToString() : "")" />

                                </td>


                                <td>

                                    <input type="number"
                                           name="HaudiPP"
                                           id="haudiPP"
                                           class="form-control stack-value"
                                           min="0"
                                           step="1"
                                           placeholder="0"
                                           value="@(vm.HaudiPP > 0 ? vm.HaudiPP.ToString() : "")" />

                                </td>


                                <td>

                                    <input type="number"
                                           name="HaudiJute"
                                           id="haudiJute"
                                           class="form-control stack-value"
                                           min="0"
                                           step="1"
                                           placeholder="0"
                                           value="@(vm.HaudiJute > 0 ? vm.HaudiJute.ToString() : "")" />

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- TOTAL SUMMARY -->

                <div class="row g-3 mt-2">

                    <div class="col-md-4">

                        <div class="summary-box">

                            <div class="summary-label">
                                Labour Total Bags
                            </div>

                            <div class="summary-value"
                                 id="labourTotalDisplay">

                                @labourTotalBags

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="summary-box">

                            <div class="summary-label">
                                Stack / Haudi Total
                            </div>

                            <div class="summary-value"
                                 id="stackTotalDisplay">

                                0

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="summary-box">

                            <div class="summary-label">
                                Material Total
                            </div>

                            <div class="summary-value"
                                 id="materialTotalDisplay">

                                0

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             MATERIAL TYPE / ITEMS
             ================================================= -->

        <div class="sup-card">

            <div class="sup-section-title
                        d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap
                        gap-2">

                <span>

                    <i class="bi bi-list-check me-2"></i>

                    Material Type / Variety Details

                </span>


                <button type="button"
                        id="addMaterialRow"
                        class="btn btn-sm btn-outline-primary">

                    <i class="bi bi-plus-circle me-1"></i>

                    Add Item

                </button>

            </div>


            <div class="sup-section-body">

                <!-- AJAX MASTER LOAD STATUS -->

                <div id="masterLoadMessage"
                     class="master-message">

                    <span class="spinner-border spinner-border-sm me-2"></span>

                    Loading Category and Bag Type masters...

                </div>


                <div class="table-responsive">

                    <table class="table
                                  table-bordered
                                  material-table
                                  mb-0">

                        <thead>

                            <tr>

                                <th style="min-width:190px;">

                                    Material Type / Category

                                    <span class="required">*</span>

                                </th>


                                <th style="min-width:220px;">

                                    Item / Variety

                                    <span class="required">*</span>

                                </th>


                                <th style="min-width:180px;">

                                    Bag Type

                                    <span class="required">*</span>

                                </th>


                                <th style="min-width:130px;">

                                    No. of Bags

                                    <span class="required">*</span>

                                </th>


                                <th style="width:70px;"
                                    class="text-center">

                                    Remove

                                </th>

                            </tr>

                        </thead>


                        <tbody id="materialRows">

                            <tr class="material-row">

                                <!-- CATEGORY -->

                                <td>

                                    <select name="CategoryRows[0].CategoryId"
                                            class="form-select category-select">

                                        <option value="">
                                            -- Select Category --
                                        </option>

                                    </select>

                                </td>


                                <!-- ITEM -->

                                <td>

                                    <select name="CategoryRows[0].ItemId"
                                            class="form-select item-select"
                                            disabled>

                                        <option value="">
                                            -- Select Item --
                                        </option>

                                    </select>

                                </td>


                                <!-- BAG TYPE -->

                                <td>

                                    <select name="CategoryRows[0].BagTypeId"
                                            class="form-select bag-type-select">

                                        <option value="">
                                            -- Select Bag Type --
                                        </option>

                                    </select>

                                </td>


                                <!-- COUNT -->

                                <td>

                                    <input type="number"
                                           name="CategoryRows[0].BagCount"
                                           class="form-control bag-count-input"
                                           min="1"
                                           step="1"
                                           placeholder="Bags" />

                                </td>


                                <!-- REMOVE -->

                                <td class="text-center">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger remove-material-row"
                                            disabled>

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <div id="totalStatus"
                     class="total-status total-status-warning">

                    Enter Stack / Haudi and Material bag details.

                </div>

            </div>

        </div>


        <!-- =================================================
             BUTTONS
             ================================================= -->

        <div class="sup-card">

            <div class="sup-section-body">

                <div class="d-flex
                            justify-content-between
                            align-items-center
                            flex-wrap
                            gap-2">

                    <a asp-controller="Unload"
                       asp-action="MethWorkRegister"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>

                        Back

                    </a>


                    <button type="submit"
                            id="saveRecordButton"
                            class="btn btn-primary px-4"
                            disabled>

                        <i class="bi bi-check-circle me-1"></i>

                        Save Record

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>


<script>
    document.addEventListener(
        "DOMContentLoaded",
        function ()
        {
            "use strict";


            // =====================================================
            // DOM
            // =====================================================

            const form =
                document.getElementById(
                    "supervisorActionForm"
                );


            const rowsContainer =
                document.getElementById(
                    "materialRows"
                );


            const addButton =
                document.getElementById(
                    "addMaterialRow"
                );


            const saveButton =
                document.getElementById(
                    "saveRecordButton"
                );


            const statusBox =
                document.getElementById(
                    "totalStatus"
                );


            const masterMessage =
                document.getElementById(
                    "masterLoadMessage"
                );


            const labourTotal =
                parseInt(
                    document.getElementById(
                        "labourTotalHidden"
                    ).value
                ) || 0;


            // =====================================================
            // MASTER ARRAYS
            // NO VIEWDATA / VIEWBAG USED
            // =====================================================

            let categoryMaster = [];

            let bagTypeMaster = [];


            // =====================================================
            // URLS
            // =====================================================

            const categoryUrl =
                '@Url.Action("GetItemCategories", "Unload")';


            const bagTypeUrl =
                '@Url.Action("GetBagTypes", "Unload")';


            const itemsUrl =
                '@Url.Action("GetItemsByCategory", "Unload")';


            // =====================================================
            // MASTER LOAD
            // =====================================================

            async function loadMasters()
            {
                try
                {
                    const responses =
                        await Promise.all(
                            [
                                fetch(categoryUrl),
                                fetch(bagTypeUrl)
                            ]
                        );


                    if (
                        !responses[0].ok
                        ||
                        !responses[1].ok
                    )
                    {
                        throw new Error(
                            "Master API request failed."
                        );
                    }


                    const categoryResponse =
                        await responses[0].json();


                    const bagResponse =
                        await responses[1].json();


                    categoryMaster =
                        categoryResponse.success
                        &&
                        Array.isArray(
                            categoryResponse.categories
                        )
                            ? categoryResponse.categories
                            : [];


                    bagTypeMaster =
                        bagResponse.success
                        &&
                        Array.isArray(
                            bagResponse.bagTypes
                        )
                            ? bagResponse.bagTypes
                            : [];


                    refreshMasterDropdowns();


                    if (
                        categoryMaster.length > 0
                        &&
                        bagTypeMaster.length > 0
                    )
                    {
                        masterMessage.className =
                            "master-message";


                        masterMessage.innerHTML =
                            '<i class="bi bi-check-circle-fill me-1"></i>'
                            +
                            'Category and Bag Type masters loaded successfully.';
                    }
                    else
                    {
                        masterMessage.className =
                            "master-message master-error";


                        masterMessage.innerHTML =
                            '<i class="bi bi-exclamation-triangle-fill me-1"></i>'
                            +
                            'Category or Bag Type master contains no active records.';
                    }
                }
                catch (error)
                {
                    console.error(
                        error
                    );


                    masterMessage.className =
                        "master-message master-error";


                    masterMessage.innerHTML =
                        '<i class="bi bi-exclamation-triangle-fill me-1"></i>'
                        +
                        'Unable to load Category / Bag Type masters.';


                    categoryMaster = [];

                    bagTypeMaster = [];
                }


                validateForm();
            }


            // =====================================================
            // FILL MASTER DROPDOWNS
            // =====================================================

            function refreshMasterDropdowns()
            {
                rowsContainer
                    .querySelectorAll(
                        ".material-row"
                    )
                    .forEach(
                        function (row)
                        {
                            fillCategoryDropdown(
                                row.querySelector(
                                    ".category-select"
                                )
                            );


                            fillBagTypeDropdown(
                                row.querySelector(
                                    ".bag-type-select"
                                )
                            );
                        }
                    );
            }


            function fillCategoryDropdown(
                select
            )
            {
                const existingValue =
                    select.value;


                select.innerHTML =
                    '<option value="">-- Select Category --</option>';


                categoryMaster.forEach(
                    function (category)
                    {
                        const option =
                            document.createElement(
                                "option"
                            );


                        option.value =
                            category.categoryId;


                        option.textContent =
                            category.categoryName;


                        select.appendChild(
                            option
                        );
                    }
                );


                if (existingValue)
                {
                    select.value =
                        existingValue;
                }
            }


            function fillBagTypeDropdown(
                select
            )
            {
                const existingValue =
                    select.value;


                select.innerHTML =
                    '<option value="">-- Select Bag Type --</option>';


                bagTypeMaster.forEach(
                    function (bag)
                    {
                        const option =
                            document.createElement(
                                "option"
                            );


                        option.value =
                            bag.bagTypeId;


                        option.textContent =
                            bag.bagTypeName;


                        select.appendChild(
                            option
                        );
                    }
                );


                if (existingValue)
                {
                    select.value =
                        existingValue;
                }
            }


            // =====================================================
            // LOAD ITEM BY CATEGORY
            // =====================================================

            async function loadItems(
                row,
                categoryId
            )
            {
                const itemSelect =
                    row.querySelector(
                        ".item-select"
                    );


                itemSelect.innerHTML =
                    '<option value="">-- Select Item --</option>';


                itemSelect.disabled =
                    true;


                if (!categoryId)
                {
                    validateForm();

                    return;
                }


                try
                {
                    const response =
                        await fetch(
                            itemsUrl
                            +
                            "?categoryId="
                            +
                            encodeURIComponent(
                                categoryId
                            )
                        );


                    if (!response.ok)
                    {
                        throw new Error(
                            "Item API failed."
                        );
                    }


                    const result =
                        await response.json();


                    if (
                        result.success
                        &&
                        Array.isArray(
                            result.items
                        )
                    )
                    {
                        result.items.forEach(
                            function (item)
                            {
                                const option =
                                    document.createElement(
                                        "option"
                                    );


                                option.value =
                                    item.itemId;


                                option.textContent =
                                    item.itemName;


                                itemSelect.appendChild(
                                    option
                                );
                            }
                        );


                        itemSelect.disabled =
                            false;
                    }
                }
                catch (error)
                {
                    console.error(
                        error
                    );
                }


                validateForm();
            }


            // =====================================================
            // INTEGER ONLY
            // =====================================================

            document.addEventListener(
                "input",
                function (event)
                {
                    if (
                        event.target.classList.contains(
                            "stack-value"
                        )
                        ||
                        event.target.classList.contains(
                            "bag-count-input"
                        )
                    )
                    {
                        event.target.value =
                            event.target.value
                                .replace(
                                    /[^0-9]/g,
                                    ""
                                );


                        validateForm();
                    }
                }
            );


            // =====================================================
            // CATEGORY / OTHER CHANGE
            // =====================================================

            rowsContainer.addEventListener(
                "change",
                function (event)
                {
                    if (
                        event.target.classList.contains(
                            "category-select"
                        )
                    )
                    {
                        const row =
                            event.target.closest(
                                ".material-row"
                            );


                        loadItems(
                            row,
                            event.target.value
                        );


                        return;
                    }


                    validateForm();
                }
            );


            // =====================================================
            // ADD ROW
            // =====================================================

            addButton.addEventListener(
                "click",
                function ()
                {
                    const firstRow =
                        rowsContainer.querySelector(
                            ".material-row"
                        );


                    if (!firstRow)
                    {
                        return;
                    }


                    const row =
                        firstRow.cloneNode(
                            true
                        );


                    row.querySelector(
                        ".category-select"
                    ).value =
                        "";


                    fillCategoryDropdown(
                        row.querySelector(
                            ".category-select"
                        )
                    );


                    fillBagTypeDropdown(
                        row.querySelector(
                            ".bag-type-select"
                        )
                    );


                    const itemSelect =
                        row.querySelector(
                            ".item-select"
                        );


                    itemSelect.innerHTML =
                        '<option value="">-- Select Item --</option>';


                    itemSelect.disabled =
                        true;


                    row.querySelector(
                        ".bag-count-input"
                    ).value =
                        "";


                    rowsContainer.appendChild(
                        row
                    );


                    reIndexRows();

                    updateRemoveButtons();

                    validateForm();
                }
            );


            // =====================================================
            // REMOVE ROW
            // =====================================================

            rowsContainer.addEventListener(
                "click",
                function (event)
                {
                    const button =
                        event.target.closest(
                            ".remove-material-row"
                        );


                    if (!button)
                    {
                        return;
                    }


                    const rows =
                        rowsContainer.querySelectorAll(
                            ".material-row"
                        );


                    if (rows.length <= 1)
                    {
                        return;
                    }


                    button
                        .closest(
                            ".material-row"
                        )
                        .remove();


                    reIndexRows();

                    updateRemoveButtons();

                    validateForm();
                }
            );


            // =====================================================
            // REINDEX
            // =====================================================

            function reIndexRows()
            {
                rowsContainer
                    .querySelectorAll(
                        ".material-row"
                    )
                    .forEach(
                        function (
                            row,
                            index
                        )
                        {
                            row.querySelector(
                                ".category-select"
                            ).name =
                                "CategoryRows["
                                +
                                index
                                +
                                "].CategoryId";


                            row.querySelector(
                                ".item-select"
                            ).name =
                                "CategoryRows["
                                +
                                index
                                +
                                "].ItemId";


                            row.querySelector(
                                ".bag-type-select"
                            ).name =
                                "CategoryRows["
                                +
                                index
                                +
                                "].BagTypeId";


                            row.querySelector(
                                ".bag-count-input"
                            ).name =
                                "CategoryRows["
                                +
                                index
                                +
                                "].BagCount";
                        }
                    );
            }


            // =====================================================
            // REMOVE BUTTON
            // =====================================================

            function updateRemoveButtons()
            {
                const rows =
                    rowsContainer.querySelectorAll(
                        ".material-row"
                    );


                rows.forEach(
                    function (row)
                    {
                        row.querySelector(
                            ".remove-material-row"
                        ).disabled =
                            rows.length === 1;
                    }
                );
            }


            // =====================================================
            // STACK TOTAL
            // =====================================================

            function getNumber(
                id
            )
            {
                const el =
                    document.getElementById(
                        id
                    );


                if (!el)
                {
                    return 0;
                }


                return parseInt(
                    el.value
                ) || 0;
            }


            function calculateStackTotal()
            {
                const total =
                    getNumber("stackPP")
                    +
                    getNumber("stackJute")
                    +
                    getNumber("haudiPP")
                    +
                    getNumber("haudiJute");


                document.getElementById(
                    "stackTotalDisplay"
                ).textContent =
                    total;


                return total;
            }


            // =====================================================
            // MATERIAL TOTAL
            // =====================================================

            function calculateMaterialTotal()
            {
                let total = 0;


                rowsContainer
                    .querySelectorAll(
                        ".bag-count-input"
                    )
                    .forEach(
                        function (input)
                        {
                            total +=
                                parseInt(
                                    input.value
                                ) || 0;
                        }
                    );


                document.getElementById(
                    "materialTotalDisplay"
                ).textContent =
                    total;


                return total;
            }


            // =====================================================
            // ROW VALIDATION
            // =====================================================

            function rowsComplete()
            {
                const rows =
                    rowsContainer.querySelectorAll(
                        ".material-row"
                    );


                if (rows.length === 0)
                {
                    return false;
                }


                for (
                    let index = 0;
                    index < rows.length;
                    index++
                )
                {
                    const row =
                        rows[index];


                    const categoryId =
                        row.querySelector(
                            ".category-select"
                        ).value;


                    const itemId =
                        row.querySelector(
                            ".item-select"
                        ).value;


                    const bagTypeId =
                        row.querySelector(
                            ".bag-type-select"
                        ).value;


                    const count =
                        parseInt(
                            row.querySelector(
                                ".bag-count-input"
                            ).value
                        ) || 0;


                    if (
                        !categoryId
                        ||
                        !itemId
                        ||
                        !bagTypeId
                        ||
                        count <= 0
                    )
                    {
                        return false;
                    }
                }


                return true;
            }


            // =====================================================
            // FINAL PAGE VALIDATION
            // =====================================================

            function validateForm()
{
    const stackTotal =
        calculateStackTotal();

    const materialTotal =
        calculateMaterialTotal();

    const mastersReady =
        categoryMaster.length > 0
        &&
        bagTypeMaster.length > 0;

    const valid =
        stackTotal > 0
        &&
        stackTotal === materialTotal
        &&
        rowsComplete()
        &&
        mastersReady;


    if (valid)
    {
        statusBox.className =
            "total-status total-status-success";

        statusBox.innerHTML =
            '<i class="bi bi-check-circle-fill me-1"></i>'
            +
            "Stack / Haudi Total and Material Total matched: "
            +
            stackTotal;

        saveButton.disabled =
            false;
    }
    else
    {
        statusBox.className =
            "total-status total-status-warning";

        statusBox.innerHTML =
            "Stack / Haudi Total: "
            +
            stackTotal
            +
            " | Material Total: "
            +
            materialTotal;

        saveButton.disabled =
            true;
    }
}


            // =====================================================
            // SUBMIT
            // =====================================================

            form.addEventListener(
                "submit",
                function (event)
                {
                    reIndexRows();

                    validateForm();


                    if (saveButton.disabled)
                    {
                        event.preventDefault();


                        alert(
                            "Please complete all details and make sure all bag totals match."
                        );


                        return;
                    }


                    saveButton.disabled =
                        true;


                    saveButton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2"></span>'
                        +
                        "Saving...";
                }
            );


            // =====================================================
            // INITIAL
            // =====================================================

            reIndexRows();

            updateRemoveButtons();

            validateForm();

            loadMasters();
        }
    );
</script>