@model RiceMillProject.Models.SupervisorLocationReport
<div class="erp-card mb-4"><div class="erp-card-body p-3"><form method="get" class="row g-3 align-items-end">
@if(ViewContext.RouteData.Values["action"]?.ToString()=="LocationCategories"){<input type="hidden" name="locationId" value="@Model.LocationId"/>}
<div class="col-md-2"><label class="form-label" for="fromDate">From date</label><input class="form-control" type="date" id="fromDate" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" required/></div><div class="col-md-2"><label class="form-label" for="toDate">To date</label><input class="form-control" type="date" id="toDate" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" required/></div><div class="col-md-2"><label class="form-label" for="status">Completion</label><select class="form-select" id="status" name="status"><option value="">All</option><option value="Pending" selected="@(Model.Status=="Pending")">Pending</option><option value="Completed" selected="@(Model.Status=="Completed")">Completed</option></select></div><div class="col-md-4"><label class="form-label" for="search">RST / Vehicle / Party / Meth</label><input class="form-control" name="search" id="search" value="@Model.Search" maxlength="200"/></div><div class="col-md-2"><button class="btn btn-primary">Apply</button><a asp-action="LocationReport" class="btn btn-outline-secondary ms-1">Reset</a></div></form></div></div>
