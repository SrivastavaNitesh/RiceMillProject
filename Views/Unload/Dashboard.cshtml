@{ ViewData["Title"] = "Supervisor Dashboard"; Layout = "_LayoutSupervisor"; var chart = ViewBag.WorkStatusChart as string ?? "[0,0,0,0,0]"; var categories = ViewBag.CategoryChart as string ?? "[]"; var trend = ViewBag.DailyTrend as string ?? "[]"; }
<div class="erp-page-header mb-4"><div class="erp-page-title-group"><div class="erp-page-icon bg-success-subtle text-success"><i class="bi bi-speedometer2"></i></div><div><h3 class="erp-page-title">RICE MILL SUPERVISOR DASHBOARD</h3><p class="erp-page-subtitle">Unloading, weighing and labour operations overview</p></div></div><span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Live Operations</span></div>
@if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger">@ViewBag.ErrorMessage</div> }
<div class="row g-3 mb-4">
 <div class="col-lg-3 col-md-6"><div class="erp-card p-3 border-start border-warning border-4"><small class="text-muted fw-bold">PENDING ASSIGNMENT</small><h2 class="text-warning mb-0">@(ViewBag.PendingAssignments ?? 0)</h2><small class="text-muted">Requires action</small></div></div>
 <div class="col-lg-3 col-md-6"><div class="erp-card p-3 border-start border-primary border-4"><small class="text-muted fw-bold">WORKER DETAILS PENDING</small><h2 class="text-primary mb-0">@(ViewBag.WorkerPending ?? 0)</h2><small class="text-muted">Labour entry required</small></div></div>
 <div class="col-lg-3 col-md-6"><div class="erp-card p-3 border-start border-info border-4"><small class="text-muted fw-bold">FIELD DETAILS PENDING</small><h2 class="text-info mb-0">@(ViewBag.FieldPending ?? 0)</h2><small class="text-muted">Location/material entry</small></div></div>
 <div class="col-lg-3 col-md-6"><div class="erp-card p-3 border-start border-success border-4"><small class="text-muted fw-bold">TODAY COMPLETED</small><h2 class="text-success mb-0">@(ViewBag.CompletedUnloading ?? 0)</h2><small class="text-muted">Unloading completed</small></div></div>
</div>
<div class="row g-3"><div class="col-lg-6"><div class="erp-card"><div class="erp-card-header"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Supervisor Work Status</div><div class="erp-card-body p-3"><div id="supervisorDashboardChart" style="height:300px"></div></div></div></div><div class="col-lg-6"><div class="erp-card"><div class="erp-card-header"><i class="bi bi-graph-up text-success me-2"></i>Last 7 Days Unloading Trend</div><div class="erp-card-body p-3"><div id="supervisorTrendChart" style="height:300px"></div></div></div></div></div>
<div class="row g-3 mt-1"><div class="col-lg-6"><div class="erp-card"><div class="erp-card-header"><i class="bi bi-pie-chart-fill text-success me-2"></i>Today's Bags by Category</div><div class="erp-card-body p-3"><div id="supervisorCategoryChart" style="height:280px"></div></div></div></div></div>
<div class="erp-card mt-4"><div class="erp-card-header d-flex justify-content-between"><span><i class="bi bi-exclamation-circle text-warning me-2"></i>Requires Your Attention</span><a asp-action="MethWorkRegister" class="small">View All</a></div><div class="erp-card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>RST Number</th><th>Vehicle</th><th>Meth</th><th>Worker Status</th><th>Field Status</th><th>Pending Action</th><th></th></tr></thead><tbody>@if (ViewBag.AttentionItems is IEnumerable<RiceMillProject.Models.UnloadTransaction> attention && attention.Any()) { foreach (var item in attention) { <tr><td class="fw-bold text-primary">@item.RSTNumber</td><td>@item.VehicleNumber</td><td>@item.MethName</td><td>@(item.IsWorkerWorkCompleted ? "Completed" : "Pending")</td><td>@(item.IsSupervisorActionCompleted ? "Completed" : "Pending")</td><td>@(!item.IsWorkerWorkCompleted && !item.IsSupervisorActionCompleted ? "Worker + Field Details" : (!item.IsWorkerWorkCompleted ? "Worker Details" : "Field Details"))</td><td><a asp-action="SupervisorAction" asp-route-id="@item.UnloadId" class="btn btn-sm btn-outline-primary">Take Action</a></td></tr> } } else { <tr><td colspan="7" class="text-center text-muted py-4">No pending supervisor action.</td></tr> }</tbody></table></div></div></div>
@section Scripts { <script src="https://code.highcharts.com/highcharts.js"></script><script>document.addEventListener('DOMContentLoaded',function(){Highcharts.chart('supervisorDashboardChart',{chart:{type:'column',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},xAxis:{categories:['Pending Assignment','Both Pending','Worker Pending','Field Pending','Worker + Field Complete']},yAxis:{allowDecimals:false,min:0,title:{text:'RST Count'}},plotOptions:{column:{dataLabels:{enabled:true}}},series:[{name:'RSTs',color:'#087f83',data:@Html.Raw(chart)}]});const t=@Html.Raw(trend);Highcharts.chart('supervisorTrendChart',{chart:{type:'spline',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},xAxis:{categories:t.map(x=>x.date)},yAxis:{allowDecimals:false,min:0,title:{text:'Completed RST'}},series:[{name:'Completed RST',color:'#087f83',data:t.map(x=>Number(x.count)||0)}]});const b=@Html.Raw(categories);if(!b.length||b.every(x=>!x.y)){document.getElementById('supervisorCategoryChart').innerHTML='<div class="text-center text-muted py-5">No bag data available for today.</div>';}else{Highcharts.chart('supervisorCategoryChart',{chart:{type:'pie',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},plotOptions:{pie:{innerSize:'65%',dataLabels:{enabled:true,format:'{point.name}: {point.y}'}}},series:[{name:'Bags',data:b}]});}});</script> }
