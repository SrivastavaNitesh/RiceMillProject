@using System.Text.Json
@model RiceMillProject.Models.SupervisorDashboard
@{
    ViewData["Title"] = "Supervisor Dashboard";
    Layout = "_LayoutSupervisor";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var statusData = JsonSerializer.Serialize(Model.Statuses.Select(item => new { name = item.Name, y = item.Value }), jsonOptions);
    var trendData = JsonSerializer.Serialize(Model.DailyTrend, jsonOptions);
    var locationData = JsonSerializer.Serialize(Model.LocationDetails, jsonOptions);
    var workerData = JsonSerializer.Serialize(Model.WorkerDetails, jsonOptions);
}

<style>
    .supervisor-hero{position:relative;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:25px 28px;margin-bottom:20px;overflow:hidden;border:1px solid rgba(255,255,255,.16);border-radius:20px;background:linear-gradient(120deg,#123f3b 0%,#087f75 58%,#23a99c 100%);color:#fff;box-shadow:0 16px 38px rgba(8,99,91,.22)}
    .supervisor-hero:after{content:"";position:absolute;right:-70px;top:-100px;width:290px;height:290px;border:45px solid rgba(255,255,255,.06);border-radius:50%;pointer-events:none}.hero-profile{position:relative;z-index:1;display:flex;align-items:center;gap:17px}.hero-avatar{display:inline-flex;align-items:center;justify-content:center;width:58px;height:58px;flex:0 0 58px;border:1px solid rgba(255,255,255,.32);border-radius:16px;background:rgba(255,255,255,.14);color:#fff;font-size:1.55rem;box-shadow:inset 0 1px 0 rgba(255,255,255,.18)}
    .hero-eyebrow{display:inline-flex!important;align-items:center;gap:7px;margin-bottom:6px;padding:4px 9px;border-radius:999px;background:rgba(255,255,255,.11);font-size:.67rem!important;font-weight:800!important;letter-spacing:.09em!important;text-transform:uppercase;color:#d5f5f0!important}.supervisor-hero h2{margin:0 0 9px;color:#fff!important;font-size:1.65rem;font-weight:800;letter-spacing:-.02em}.hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.hero-meta span{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border:1px solid rgba(255,255,255,.16);border-radius:8px;background:rgba(5,54,50,.18);color:#effffb;font-size:.76rem}.hero-status{position:relative;z-index:1;min-width:195px;padding:14px 16px;border:1px solid rgba(255,255,255,.25);border-radius:14px;background:rgba(255,255,255,.12);backdrop-filter:blur(6px)}.hero-live{display:flex;align-items:center;gap:9px;color:#fff;font-weight:750;white-space:nowrap}.hero-live:before{content:"";width:9px;height:9px;border-radius:50%;background:#78f0a9;box-shadow:0 0 0 5px rgba(120,240,169,.16)}.hero-status small{display:block;margin-top:6px;color:#cceee9;font-size:.69rem}
    .supervisor-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:13px;margin-bottom:20px}.supervisor-kpi{position:relative;overflow:hidden;min-height:118px;padding:17px;border:1px solid #dce7e5;border-radius:14px;background:#fff;box-shadow:0 6px 20px rgba(18,63,59,.06)}.supervisor-kpi:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--accent)}.supervisor-kpi .kpi-icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:10px;background:var(--soft);color:var(--accent);font-size:1rem}.supervisor-kpi strong{display:block;margin-top:9px;color:#102a43;font-size:1.6rem;line-height:1}.supervisor-kpi span{display:block;margin-top:6px;color:#60758a;font-size:.72rem;font-weight:750;text-transform:uppercase;letter-spacing:.04em}
    .supervisor-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px;margin-bottom:16px}.dash-panel{grid-column:span 4;border:1px solid #dce7e5;border-radius:15px;background:#fff;box-shadow:0 6px 22px rgba(18,63,59,.06);overflow:hidden}.dash-panel.wide{grid-column:span 8}.dash-panel.half{grid-column:span 6}.panel-heading{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #e7efed}.panel-heading strong{color:#143b38;font-size:.94rem}.panel-heading small{color:#78908d}.chart-box{height:315px;padding:8px}
    .live-work-card{border:1px solid #dce7e5;border-radius:15px;background:#fff;box-shadow:0 6px 22px rgba(18,63,59,.06);overflow:hidden}.live-table thead th{padding:13px 14px;background:linear-gradient(180deg,#eef7f5,#dfefeb);color:#214b47;border-bottom:2px solid #68b8ae;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}.live-table tbody td{padding:13px 14px;vertical-align:middle;border-bottom:1px solid #e9efee;font-size:.82rem}.live-table tbody tr:nth-child(even){background:#f8fbfa}.live-table tbody tr:hover{background:#edf8f6}.stage-pill{display:inline-flex;padding:5px 9px;border-radius:999px;background:#e9f5f3;color:#08756d;font-size:.7rem;font-weight:750}.stage-pill.completed{background:#e8f8ee;color:#23834a}.rst-main{font-weight:800;color:#0a7d74}.rst-main small{display:block;margin-top:2px;color:#718096;font-weight:500}
    .empty-chart{display:flex;align-items:center;justify-content:center;height:100%;color:#849895;font-size:.85rem}
    @@media(max-width:1399px){.supervisor-kpis{grid-template-columns:repeat(3,1fr)}}@@media(max-width:991px){.dash-panel,.dash-panel.wide,.dash-panel.half{grid-column:span 12}}@@media(max-width:767px){.supervisor-kpis{grid-template-columns:repeat(2,1fr)}.supervisor-hero{align-items:stretch;flex-direction:column}.hero-status{min-width:0}.hero-profile{align-items:flex-start}}@@media(max-width:480px){.supervisor-kpis{grid-template-columns:1fr}.hero-avatar{display:none}}
</style>

<section class="supervisor-hero">
    <div class="hero-profile">
        <span class="hero-avatar"><i class="bi bi-person-gear"></i></span>
        <div>
            <small class="hero-eyebrow"><i class="bi bi-grid-1x2-fill"></i> Supervisor Operations Center</small>
            <h2>@Model.SupervisorName</h2>
            <div class="hero-meta">
                <span><i class="bi bi-building"></i> @Model.CompanyName</span>
                <span><i class="bi bi-truck"></i> Unloading & Labour Workflow</span>
            </div>
        </div>
    </div>
    <div class="hero-status"><span class="hero-live">Live Supervisor Data</span><small>Company-scoped operational dashboard</small></div>
</section>

@if (ViewBag.ErrorMessage != null){<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage</div>}

<section class="supervisor-kpis">
    <div class="supervisor-kpi" style="--accent:#e59b13;--soft:#fff5dc"><span class="kpi-icon"><i class="bi bi-inbox"></i></span><strong>@Model.PendingAssignments</strong><span>Pending Assignment</span></div>
    <div class="supervisor-kpi" style="--accent:#e05a42;--soft:#ffebe7"><span class="kpi-icon"><i class="bi bi-people"></i></span><strong>@Model.WorkerPending</strong><span>Worker Details Pending</span></div>
    <div class="supervisor-kpi" style="--accent:#4a72d8;--soft:#eaf0ff"><span class="kpi-icon"><i class="bi bi-card-checklist"></i></span><strong>@Model.FieldPending</strong><span>Field Details Pending</span></div>
    <div class="supervisor-kpi" style="--accent:#1b9a5a;--soft:#e5f7ed"><span class="kpi-icon"><i class="bi bi-check2-circle"></i></span><strong>@Model.TodayCompleted</strong><span>Today Completed</span></div>
    <div class="supervisor-kpi" style="--accent:#087f75;--soft:#ddf4f1"><span class="kpi-icon"><i class="bi bi-truck"></i></span><strong>@Model.TotalAssigned</strong><span>Total Assigned RST</span></div>
    <div class="supervisor-kpi" style="--accent:#8058c9;--soft:#f0eaff"><span class="kpi-icon"><i class="bi bi-box-seam"></i></span><strong>@Model.TotalRecordedBags.ToString("N0")</strong><span>Recorded Bags</span></div>
</section>

<section class="supervisor-grid">
    <article class="dash-panel"><div class="panel-heading"><strong><i class="bi bi-pie-chart me-2 text-success"></i>Work Status</strong><small>Assigned RSTs</small></div><div id="statusChart" class="chart-box"></div></article>
    <article class="dash-panel wide"><div class="panel-heading"><strong><i class="bi bi-graph-up-arrow me-2 text-primary"></i>7-Day Completion & Bags Trend</strong><small>Daily recorded work</small></div><div id="trendChart" class="chart-box"></div></article>
    <article class="dash-panel half"><div class="panel-heading"><strong><i class="bi bi-geo-alt me-2 text-danger"></i>Location Material Drill-down</strong><small>Location → Category → Item → Bag Type</small></div><div id="locationChart" class="chart-box"></div></article>
    <article class="dash-panel half"><div class="panel-heading"><strong><i class="bi bi-boxes me-2 text-warning"></i>Bag Material Drill-down</strong><small>Bag Type → Category → Item</small></div><div id="bagTypeChart" class="chart-box"></div></article>
    <article class="dash-panel wide"><div class="panel-heading"><strong><i class="bi bi-person-workspace me-2 text-info"></i>Worker Work Drill-down</strong><small>Worker → Work Type → Bag Type</small></div><div id="workerChart" class="chart-box"></div></article>
</section>

<section class="live-work-card">
    <div class="panel-heading"><div><strong><i class="bi bi-broadcast-pin me-2 text-success"></i>Live RST Work Register</strong><small class="d-block mt-1">Latest supervisor assignments aur current action stage</small></div><a asp-action="MethWorkRegister" class="btn btn-sm btn-outline-success">View Full Register</a></div>
    <div class="table-responsive"><table class="live-table w-100 no-datatable"><thead><tr><th>RST / Vehicle</th><th>Party</th><th>Meth</th><th>Location</th><th>Recorded Bags</th><th>Current Stage</th><th>Last Activity</th><th></th></tr></thead><tbody>
    @if(Model.LiveWork.Count == 0){<tr><td colspan="8" class="text-center text-muted py-5">No supervisor work is currently assigned.</td></tr>}
    else foreach(var item in Model.LiveWork){<tr><td><span class="rst-main">@item.RSTNumber<small>@item.VehicleNumber</small></span></td><td>@item.PartyName</td><td>@item.MethName</td><td>@item.LocationName</td><td><strong>@item.Bags.ToString("N0")</strong></td><td><span class="stage-pill @(item.CurrentStage == "Completed" ? "completed" : "")">@item.CurrentStage</span></td><td>@(item.LastActivity?.ToString("dd MMM, hh:mm tt") ?? "-")</td><td><a asp-action="SupervisorAction" asp-route-id="@item.UnloadId" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}
    </tbody></table></div>
</section>

@section Scripts{
<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/drilldown.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const colors=['#087f75','#4a72d8','#e59b13','#8058c9','#e05a42','#1b9a5a'];
    Highcharts.setOptions({colors:colors,lang:{thousandsSep:','}});
    const empty=(id,text)=>document.getElementById(id).innerHTML='<div class="empty-chart"><i class="bi bi-bar-chart me-2"></i>'+text+'</div>';
    const status=@Html.Raw(statusData), trend=@Html.Raw(trendData), locationRows=@Html.Raw(locationData), workerRows=@Html.Raw(workerData);
    if(status.some(x=>x.y>0)) Highcharts.chart('statusChart',{chart:{type:'pie',backgroundColor:'transparent'},title:{text:null},credits:{enabled:false},tooltip:{pointFormat:'<b>{point.y}</b> RST'},plotOptions:{pie:{innerSize:'62%',borderWidth:3,borderColor:'#fff',dataLabels:{enabled:true,format:'{point.name}<br><b>{point.y}</b>',style:{fontSize:'10px',textOutline:'none'}}}},series:[{name:'RST',data:status}]}); else empty('statusChart','No assigned RST status available');
    Highcharts.chart('trendChart',{chart:{backgroundColor:'transparent'},title:{text:null},credits:{enabled:false},xAxis:{categories:trend.map(x=>x.dateLabel),lineColor:'#d8e4e2'},yAxis:[{min:0,allowDecimals:false,title:{text:'Completed RST'}},{min:0,title:{text:'Recorded Bags'},opposite:true}],tooltip:{shared:true},plotOptions:{series:{marker:{enabled:true}}},series:[{type:'column',name:'Completed RST',data:trend.map(x=>x.completed),color:'#4a72d8',borderRadius:5},{type:'spline',name:'Recorded Bags',data:trend.map(x=>x.bags),yAxis:1,color:'#087f75',lineWidth:3}]});
    const sum=rows=>rows.reduce((total,row)=>total+Number(row.bags||0),0), unique=(rows,key)=>[...new Set(rows.map(row=>row[key]))];
    const drillStyle={breadcrumbs:{position:{align:'left'},buttonTheme:{fill:'#eaf7f5',stroke:'#a7dcd5',style:{color:'#08756d'}}}};
    const plot={series:{borderRadius:6,dataLabels:{enabled:true,format:'{point.y:,.0f}',style:{textOutline:'none',fontWeight:'700'}}},pie:{innerSize:'52%',dataLabels:{enabled:true,format:'{point.name}<br><b>{point.y:,.0f}</b>',style:{textOutline:'none'}}}};
    const locationGroups=unique(locationRows,'locationId').map(id=>{const rows=locationRows.filter(x=>x.locationId===id);return{id:`loc-${id}`,name:rows[0]?.locationName||'Location',rows,bags:sum(rows)}});
    const locationCategories=locationGroups.flatMap(parent=>unique(parent.rows,'categoryId').map(id=>{const rows=parent.rows.filter(x=>x.categoryId===id);return{id:`${parent.id}-cat-${id}`,parentId:parent.id,name:rows[0]?.categoryName||'Category',rows,bags:sum(rows)}}));
    const locationItems=locationCategories.flatMap(parent=>unique(parent.rows,'itemId').map(id=>{const rows=parent.rows.filter(x=>x.itemId===id);return{id:`${parent.id}-item-${id}`,parentId:parent.id,name:rows[0]?.itemName||'Item',rows,bags:sum(rows)}}));
    if(locationRows.length) Highcharts.chart('locationChart',{chart:{type:'column',backgroundColor:'transparent'},title:{text:null},subtitle:{text:'Har bar clickable hai'},credits:{enabled:false},xAxis:{type:'category'},yAxis:{min:0,title:{text:'Recorded Bags'}},legend:{enabled:false},plotOptions:plot,series:[{name:'Locations',colorByPoint:true,data:locationGroups.map(x=>({name:x.name,y:x.bags,drilldown:x.id}))}],drilldown:{...drillStyle,series:[...locationGroups.map(x=>({id:x.id,name:`${x.name} - Categories`,type:'bar',data:locationCategories.filter(y=>y.parentId===x.id).map(y=>({name:y.name,y:y.bags,drilldown:y.id}))})),...locationCategories.map(x=>({id:x.id,name:`${x.name} - Items`,type:'bar',data:locationItems.filter(y=>y.parentId===x.id).map(y=>({name:y.name,y:y.bags,drilldown:y.id}))})),...locationItems.map(x=>({id:x.id,name:`${x.name} - Bag Types`,type:'pie',data:unique(x.rows,'bagTypeId').map(id=>{const rows=x.rows.filter(y=>y.bagTypeId===id);return{name:rows[0]?.bagTypeName||'Bag Type',y:sum(rows)}})}))]}}); else empty('locationChart','No location detail data available');
    const bagGroups=unique(locationRows,'bagTypeId').map(id=>{const rows=locationRows.filter(x=>x.bagTypeId===id);return{id:`bag-${id}`,name:rows[0]?.bagTypeName||'Bag Type',rows,bags:sum(rows)}});
    const bagCategories=bagGroups.flatMap(parent=>unique(parent.rows,'categoryId').map(id=>{const rows=parent.rows.filter(x=>x.categoryId===id);return{id:`${parent.id}-cat-${id}`,parentId:parent.id,name:rows[0]?.categoryName||'Category',rows,bags:sum(rows)}}));
    if(locationRows.length) Highcharts.chart('bagTypeChart',{chart:{type:'column',backgroundColor:'transparent'},title:{text:null},subtitle:{text:'Bag type par click karein'},credits:{enabled:false},xAxis:{type:'category'},yAxis:{min:0,title:{text:'Recorded Bags'}},legend:{enabled:false},plotOptions:plot,series:[{name:'Bag Types',colorByPoint:true,data:bagGroups.map(x=>({name:x.name,y:x.bags,drilldown:x.id}))}],drilldown:{...drillStyle,series:[...bagGroups.map(x=>({id:x.id,name:`${x.name} - Categories`,type:'bar',data:bagCategories.filter(y=>y.parentId===x.id).map(y=>({name:y.name,y:y.bags,drilldown:y.id}))})),...bagCategories.map(x=>({id:x.id,name:`${x.name} - Items`,type:'pie',data:unique(x.rows,'itemId').map(id=>{const rows=x.rows.filter(y=>y.itemId===id);return{name:rows[0]?.itemName||'Item',y:sum(rows)}})}))]}}); else empty('bagTypeChart','No bag detail data available');
    const workerGroups=unique(workerRows,'workerId').map(id=>{const rows=workerRows.filter(x=>x.workerId===id);return{id:`worker-${id}`,name:rows[0]?.workerName||'Worker',rows,bags:sum(rows)}});
    const workTypes=workerGroups.flatMap(parent=>unique(parent.rows,'workType').map((name,index)=>{const rows=parent.rows.filter(x=>x.workType===name);return{id:`${parent.id}-work-${index}`,parentId:parent.id,name:name||'Work Type',rows,bags:sum(rows)}}));
    if(workerRows.length) Highcharts.chart('workerChart',{chart:{type:'bar',backgroundColor:'transparent'},title:{text:null},subtitle:{text:'Worker bar par click karke work aur bag type dekhein'},credits:{enabled:false},xAxis:{type:'category'},yAxis:{min:0,title:{text:'Handled Bags'}},legend:{enabled:false},plotOptions:plot,series:[{name:'Workers',color:'#087f75',data:workerGroups.map(x=>({name:x.name,y:x.bags,drilldown:x.id}))}],drilldown:{...drillStyle,series:[...workerGroups.map(x=>({id:x.id,name:`${x.name} - Work Types`,type:'column',data:workTypes.filter(y=>y.parentId===x.id).map(y=>({name:y.name,y:y.bags,drilldown:y.id}))})),...workTypes.map(x=>({id:x.id,name:`${x.name} - Bag Types`,type:'pie',data:unique(x.rows,'bagTypeId').map(id=>{const rows=x.rows.filter(y=>y.bagTypeId===id);return{name:rows[0]?.bagTypeName||'Bag Type',y:sum(rows)}})}))]}}); else empty('workerChart','No worker detail data available');
});
</script>}
