@using System.Data
@model RiceMillProject.Models.SupervisorLocationReport
@{var location=Model.Locations.AsEnumerable().First(l=>l.Field<int>("LocationId")==Model.LocationId);var rows=Model.Materials.AsEnumerable().Where(r=>r.Field<int?>("LocationId")==Model.LocationId).ToList();var categories=rows.GroupBy(r=>r.Field<int>("CategoryId")).OrderBy(g=>g.First()["CategoryName"]).ToList();var selected=categories.FirstOrDefault(c=>c.Key==Model.CategoryId);ViewData["Title"]=location["LocationName"]+" — Item Categories";}
<link rel="stylesheet" href="~/css/supervisor-report.css" asp-append-version="true"/>
<div class="erp-page-header mb-4"><div><a asp-action="LocationReport" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-search="@Model.Search" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> All locations</a><h3 class="erp-page-title mt-2">@location["LocationName"]</h3><p class="text-muted mb-0">Select an item category to see its item totals below.</p></div></div>
<partial name="_LocationFilters" model="Model"/>
<div class="row g-4 mb-4">
@foreach(var category in categories){var items=category.ToList();<div class="col-sm-6 col-xl-4"><a class="sr-card @(category.Key==Model.CategoryId?"sr-selected":"")" asp-action="LocationCategories" asp-route-locationId="@Model.LocationId" asp-route-categoryId="@category.Key" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-fragment="item-summary"><div class="sr-card-top"><span class="sr-icon"><i class="bi bi-box-seam"></i></span><span class="sr-count">@category.Select(r=>r.Field<int>("ItemId")).Distinct().Count() items</span></div><h4>@category.First()["CategoryName"]</h4><div class="sr-metrics"><div><span>Total bags</span><strong>@items.Sum(r=>Convert.ToDecimal(r["BagCount"])).ToString("N0")</strong></div><div><span>Total weight (KG)</span><strong>@Model.WeightText(items)</strong></div></div><div class="sr-card-footer">View item report <i class="bi bi-arrow-down-right"></i></div></a></div>}
@if(categories.Count==0){<div class="col-12"><div class="alert alert-info">No saved item details at this location for these filters.</div></div>}
</div>
<partial name="_LocationWeightNote" model="Model"/>
@if(selected!=null){<div class="erp-card mt-4" id="item-summary"><div class="erp-card-header d-flex justify-content-between"><span>@selected.First()["CategoryName"] — Item Summary</span><button class="btn btn-sm btn-outline-secondary" onclick="window.print()">Print</button></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Item name</th><th class="text-end">Total weight (KG)</th><th class="text-end">Total bags</th></tr></thead><tbody>@foreach(var item in selected.GroupBy(r=>r.Field<int>("ItemId")).OrderBy(g=>g.First()["ItemName"])){<tr><td>@item.First()["ItemName"]</td><td class="text-end">@Model.WeightText(item.ToList())</td><td class="text-end">@item.Sum(r=>Convert.ToDecimal(r["BagCount"])).ToString("N0")</td></tr>}</tbody><tfoot><tr class="fw-bold"><td>Total</td><td class="text-end">@Model.WeightText(selected.ToList())</td><td class="text-end">@selected.Sum(r=>Convert.ToDecimal(r["BagCount"])).ToString("N0")</td></tr></tfoot></table></div></div>}
