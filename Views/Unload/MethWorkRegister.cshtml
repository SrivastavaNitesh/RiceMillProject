@model IEnumerable<RiceMillProject.Models.UnloadTransaction>

@{
    ViewData["Title"] = "Labour Mates (Meth)";
}

<div class="container-fluid px-0">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center
                flex-wrap
                gap-3">

                <div>

                    <h4 class="mb-1 fw-bold text-primary">

                        <i class="bi bi-person-badge me-2"></i>

                        Labour Mates (Meth)

                    </h4>

                    <div class="text-muted small">

                        Supervisor labour work entry and unloading register

                    </div>

                </div>


                <div class="badge
                    bg-primary-subtle
                    text-primary
                    fs-6
                    px-3
                    py-2">

                    Total RST:
                    @(Model?.Count() ?? 0)

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SUCCESS MESSAGE
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert
            alert-success
            alert-dismissible
            fade
            show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         ERROR MESSAGE
         ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert
            alert-danger
            alert-dismissible
            fade
            show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show"><i class="bi bi-exclamation-circle me-2"></i>@TempData["WarningMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- =========================================================
         REGISTER TABLE
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table
                    table-hover
                    align-middle
                    mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                RST / Inward Number
                            </th>

                            <th>
                                Vehicle
                            </th>

                            <th>
                                Party
                            </th>

                            <th>
                                Material
                            </th>

                            <th>
                                Meth
                            </th>

                            <th>
                                Location
                            </th>

                            <th class="text-center">
                                Total Bags
                            </th>

                            <th class="text-center">
                                Work Status
                            </th>

                            <th class="text-center pe-4">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                /*
                                 * Status = Unloaded
                                 * means worker-wise labour work
                                 * has already been entered.
                                 */

                                bool workEntered = item.IsWorkerWorkCompleted;


                                /*
                                 * Final Supervisor form
                                 * already submitted or not.
                                 */

                                bool supervisorCompleted = item.IsSupervisorActionCompleted;
                                bool overallCompleted = workEntered && supervisorCompleted;


                                <tr>

                                    <!-- =====================================
                                         RST NUMBER
                                         ===================================== -->

                                    <td class="ps-4">

                                        <div class="fw-bold text-primary">

                                            @item.RSTNumber
                                            <span class="d-block small text-secondary fw-normal">Inward: @(string.IsNullOrWhiteSpace(item.InwardNo) ? "-" : item.InwardNo)</span>

                                        </div>

                                    </td>


                                    <!-- =====================================
                                         VEHICLE
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.VehicleNumber
                                        )
                                            ? "-"
                                            : item.VehicleNumber)

                                    </td>


                                    <!-- =====================================
                                         PARTY
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.PartyName
                                        )
                                            ? "-"
                                            : item.PartyName)

                                    </td>


                                    <!-- =====================================
                                         MATERIAL
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.ItemName
                                        )
                                            ? "-"
                                            : item.ItemName)

                                    </td>


                                    <!-- =====================================
                                         METH
                                         ===================================== -->

                                    <td>

                                        <div class="fw-semibold">

                                            @(string.IsNullOrWhiteSpace(
                                                item.MethName
                                            )
                                                ? "-"
                                                : item.MethName)

                                        </div>

                                    </td>


                                    <!-- =====================================
                                         LOCATION
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.LocationName
                                        )
                                            ? "-"
                                            : item.LocationName)

                                    </td>


                                    <!-- =====================================
                                         TOTAL BAGS
                                         ===================================== -->

                                    <td class="text-center">

                                        @if (workEntered)
                                        {
                                            <span class="badge
                                                bg-success-subtle
                                                text-success
                                                px-3
                                                py-2">

                                                @(item.NumberOfBags ?? 0)

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                -

                                            </span>
                                        }

                                    </td>


                                    <!-- =====================================
                                         WORK STATUS
                                         ===================================== -->

                                    <td class="text-center">

                                        @if (overallCompleted)
                                        {
                                            <span class="badge
                                                bg-success
                                                px-3
                                                py-2">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Completed

                                            </span>
                                        }
                                        else if (workEntered && supervisorCompleted)
                                        {
                                            <span class="badge
                                                bg-info-subtle
                                                text-info-emphasis
                                                px-3
                                                py-2">

                                                <i class="bi bi-clipboard-check me-1"></i>

                                                Worker Entered / Field Completed

                                            </span>
                                        }
                                        else if (supervisorCompleted)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">Field Entered / Worker Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                bg-warning-subtle
                                                text-warning-emphasis
                                                px-3
                                                py-2">

                                                <i class="bi bi-pencil-square me-1"></i>

                                                Work Entry Pending

                                            </span>
                                        }

                                    </td>


                                    <!-- =====================================
                                         ACTION
                                         ===================================== -->

                                    <td class="text-center pe-4">

                                        @if (supervisorCompleted)
                                        {
                                            <!-- FINAL COMPLETED -->

                                            <button type="button"
                                                    class="btn
                                                btn-sm
                                                btn-success"
                                                    disabled>

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Completed

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-primary fw-semibold"
                                                    data-bs-toggle="modal" data-bs-target="#actionModal-@item.UnloadId">
                                                <i class="bi bi-list-check me-1"></i> Choose Action
                                            </button>
                                            <div class="modal fade" id="actionModal-@item.UnloadId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">RST: @item.RSTNumber</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="d-grid gap-3">
                                                                @if (workEntered)
                                                                { <button class="btn btn-outline-success text-start p-3" disabled><i class="bi bi-check-circle me-2"></i>Worker Details <span class="float-end">Completed</span></button> }
                                                                else
                                                                { <a class="btn btn-outline-warning text-start p-3" asp-controller="Unload" asp-action="SupervisorMethWork" asp-route-id="@item.UnloadId"><i class="bi bi-people me-2"></i>Worker Details <span class="float-end">Pending</span></a> }
                                                                @if (supervisorCompleted)
                                                                { <button class="btn btn-outline-success text-start p-3" disabled><i class="bi bi-check-circle me-2"></i>Field Details <span class="float-end">Completed</span></button> }
                                                                else
                                                                { <a class="btn btn-outline-primary text-start p-3" asp-controller="Unload" asp-action="SupervisorAction" asp-route-id="@item.UnloadId"><i class="bi bi-clipboard-check me-2"></i>Field Details <span class="float-end">Pending</span></a> }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <!-- =============================================
                                 EMPTY STATE
                                 ============================================= -->

                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox
                                        fs-1
                                        text-muted">
                                    </i>

                                    <div class="mt-2 fw-semibold text-muted">

                                        No Meth assignments found.

                                    </div>

                                    <div class="small text-muted mt-1">

                                        Assigned RST will appear here.

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
