@model IEnumerable<RiceMillProject.Models.UnloadTransaction>

@{
    ViewData["Title"] = "Labour Mates (Meth)";
}

<div class="container-fluid px-0">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center
                flex-wrap
                gap-3">

                <div>

                    <h4 class="mb-1 fw-bold text-primary">

                        <i class="bi bi-person-badge me-2"></i>

                        Labour Mates (Meth)

                    </h4>

                    <div class="text-muted small">

                        Supervisor labour work entry and unloading register

                    </div>

                </div>


                <div class="badge
                    bg-primary-subtle
                    text-primary
                    fs-6
                    px-3
                    py-2">

                    Total RST:
                    @(Model?.Count() ?? 0)

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SUCCESS MESSAGE
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert
            alert-success
            alert-dismissible
            fade
            show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         ERROR MESSAGE
         ========================================================= -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert
            alert-danger
            alert-dismissible
            fade
            show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         REGISTER TABLE
         ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table
                    table-hover
                    align-middle
                    mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                RST Number
                            </th>

                            <th>
                                Vehicle
                            </th>

                            <th>
                                Party
                            </th>

                            <th>
                                Material
                            </th>

                            <th>
                                Meth
                            </th>

                            <th>
                                Location
                            </th>

                            <th class="text-center">
                                Total Bags
                            </th>

                            <th class="text-center">
                                Work Status
                            </th>

                            <th class="text-center pe-4">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                /*
                                 * Status = Unloaded
                                 * means worker-wise labour work
                                 * has already been entered.
                                 */

                                bool workEntered =
                                    string.Equals(
                                        item.Status,
                                        "Unloaded",
                                        StringComparison.OrdinalIgnoreCase
                                    );


                                /*
                                 * Final Supervisor form
                                 * already submitted or not.
                                 */

                                bool supervisorCompleted =
                                    item.IsSupervisorActionCompleted;


                                <tr>

                                    <!-- =====================================
                                         RST NUMBER
                                         ===================================== -->

                                    <td class="ps-4">

                                        <div class="fw-bold text-primary">

                                            @item.RSTNumber

                                        </div>

                                    </td>


                                    <!-- =====================================
                                         VEHICLE
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.VehicleNumber
                                        )
                                            ? "-"
                                            : item.VehicleNumber)

                                    </td>


                                    <!-- =====================================
                                         PARTY
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.PartyName
                                        )
                                            ? "-"
                                            : item.PartyName)

                                    </td>


                                    <!-- =====================================
                                         MATERIAL
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.ItemName
                                        )
                                            ? "-"
                                            : item.ItemName)

                                    </td>


                                    <!-- =====================================
                                         METH
                                         ===================================== -->

                                    <td>

                                        <div class="fw-semibold">

                                            @(string.IsNullOrWhiteSpace(
                                                item.MethName
                                            )
                                                ? "-"
                                                : item.MethName)

                                        </div>

                                    </td>


                                    <!-- =====================================
                                         LOCATION
                                         ===================================== -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                            item.LocationName
                                        )
                                            ? "-"
                                            : item.LocationName)

                                    </td>


                                    <!-- =====================================
                                         TOTAL BAGS
                                         ===================================== -->

                                    <td class="text-center">

                                        @if (workEntered)
                                        {
                                            <span class="badge
                                                bg-success-subtle
                                                text-success
                                                px-3
                                                py-2">

                                                @(item.NumberOfBags ?? 0)

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                -

                                            </span>
                                        }

                                    </td>


                                    <!-- =====================================
                                         WORK STATUS
                                         ===================================== -->

                                    <td class="text-center">

                                        @if (supervisorCompleted)
                                        {
                                            <span class="badge
                                                bg-success
                                                px-3
                                                py-2">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Completed

                                            </span>
                                        }
                                        else if (workEntered)
                                        {
                                            <span class="badge
                                                bg-info-subtle
                                                text-info-emphasis
                                                px-3
                                                py-2">

                                                <i class="bi bi-clipboard-check me-1"></i>

                                                Work Entered

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                bg-warning-subtle
                                                text-warning-emphasis
                                                px-3
                                                py-2">

                                                <i class="bi bi-pencil-square me-1"></i>

                                                Work Entry Pending

                                            </span>
                                        }

                                    </td>


                                    <!-- =====================================
                                         ACTION
                                         ===================================== -->

                                    <td class="text-center pe-4">

                                        @if (supervisorCompleted)
                                        {
                                            <!-- FINAL COMPLETED -->

                                            <button type="button"
                                                    class="btn
                                                btn-sm
                                                btn-success"
                                                    disabled>

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Completed

                                            </button>
                                        }
                                        else if (workEntered)
                                        {
                                            <!--
                                                Worker labour entry done.
                                                Now Supervisor final
                                                unloading form.
                                            -->

                                            <a asp-controller="Unload"
                                               asp-action="SupervisorAction"
                                               asp-route-id="@item.UnloadId"
                                               class="btn
                                                btn-sm
                                                btn-primary
                                                fw-semibold">

                                                <i class="bi bi-clipboard-check me-1"></i>

                                                Take Action

                                            </a>
                                        }
                                        else
                                        {
                                            <!--
                                                Supervisor will enter
                                                Meth/worker work details
                                                on behalf of Meth.
                                            -->

                                            <a asp-controller="Unload"
                                               asp-action="SupervisorMethWork"
                                               asp-route-id="@item.UnloadId"
                                               class="btn
                                                btn-sm
                                                btn-warning
                                                fw-semibold">

                                                <i class="bi bi-pencil-square me-1"></i>

                                                Enter Work Details

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <!-- =============================================
                                 EMPTY STATE
                                 ============================================= -->

                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox
                                        fs-1
                                        text-muted">
                                    </i>

                                    <div class="mt-2 fw-semibold text-muted">

                                        No Meth assignments found.

                                    </div>

                                    <div class="small text-muted mt-1">

                                        Assigned RST will appear here.

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>