@model RiceMillProject.Models.UnloadTransaction
@{
    ViewData["Title"] = "Supervisor Unloading";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-premium-blue text-white">
                <h5 class="mb-0">Truck Unloading & Worker Assignment (RST: @Model.RSTNumber)</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="RSTNumber" />
                    
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="OfficeId" class="form-label fw-bold">Select Company</label>
                            <select asp-for="OfficeId" class="form-select" asp-items="ViewBag.Offices" required id="officeDropdown">
                                <option value="">-- Company --</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="SelectedLocationIds" class="form-label fw-bold">Locations</label>
                            <select asp-for="SelectedLocationIds" class="form-select" multiple="multiple" id="locationsDropdown" required style="height: 100px;">
                                <!-- Populated via AJAX -->
                            </select>
                            <small class="text-muted">Hold Ctrl to select multiple</small>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="SupervisorId" class="form-label fw-bold">Supervisor</label>
                            <select asp-for="SupervisorId" class="form-select" asp-items="ViewBag.Supervisors" required>
                                <option value="">-- Supervisor --</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="GateManId" class="form-label fw-bold">Gate Man</label>
                            <select asp-for="GateManId" class="form-select" asp-items="ViewBag.GateMen" required>
                                <option value="">-- Gate Man --</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="MethId" class="form-label fw-bold">Meth (Head Worker)</label>
                            <select asp-for="MethId" class="form-select" asp-items="ViewBag.Meths" required>
                                <option value="">-- Select Meth --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="BagTypeId" class="form-label fw-bold">Bag Type</label>
                            <select asp-for="BagTypeId" class="form-select" asp-items="ViewBag.BagTypes" required>
                                <option value="">-- Select Bag --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="NumberOfBags" class="form-label fw-bold">Number Of Bags</label>
                            <input asp-for="NumberOfBags" type="number" class="form-control" required />
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="text-success fw-bold">Palledari (Worker Allocation)</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Select Shift</label>
                            <select name="Shift" class="form-select">
                                <option value="Day">Day Shift (Rs 10/worker)</option>
                                <option value="Night">Night Shift (Rs 15/worker)</option>
                            </select>
                        </div>
                        <div class="col-md-12 mt-3">
                            <label class="form-label fw-bold">Select Workers for Unloading</label>
                            <div class="row">
                                @foreach (var worker in ViewBag.Workers)
                                {
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedWorkers" value="@worker.PersonId" id="worker_@worker.PersonId">
                                            <label class="form-check-label" for="worker_@worker.PersonId">
                                                @worker.PersonName
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="GateEntry" asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-premium-blue fw-bold px-4"><i class="bi bi-save me-2"></i> Save Unloading</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('#officeDropdown').change(function () {
                var officeId = $(this).val();
                var locationSelect = $('#locationsDropdown');
                locationSelect.empty();
                
                if (officeId) {
                    $.getJSON('/Office/GetLocations', { officeId: officeId }, function (data) {
                        $.each(data, function (index, item) {
                            locationSelect.append($('<option/>', {
                                value: item.locationId,
                                text: item.locationName
                            }));
                        });
                    });
                }
            });
        });
    </script>
}
