@model RiceMillProject.Models.UnloadTransaction

@{
    ViewData["Title"] = "Assign Meth";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <div>
            <h3 class="erp-page-title">
                ASSIGN METH / UNLOADING CONTRACTOR
            </h3>

            <p class="erp-page-subtitle">
                Assign unloading location and labor team (Meth) for RST vehicle unloading
            </p>
        </div>
    </div>

    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Unload Queue
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">

        <div class="erp-card">

            <div class="erp-card-header">
                <span>
                    <i class="bi bi-person-check text-primary me-2"></i>
                    Unloading Assignment Details
                </span>
            </div>

            <div class="erp-card-body">

                <form asp-action="Assign"
                      asp-controller="Unload"
                      method="post"
                      class="row g-3">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <!-- RST Number Hidden -->
                    <input type="hidden"
                           asp-for="RSTNumber" />

                    <!-- Supervisor Hidden -->
                    <input type="hidden"
                           asp-for="SupervisorId" />

                    <!-- Item Hidden -->
                    <input type="hidden"
                           asp-for="ItemId" />

                    <!-- RST Number -->
                    <div class="col-md-12">

                        <label class="form-label">
                            RST Number
                        </label>

                        <input type="text"
                               class="form-control bg-light font-monospace fw-bold"
                               value="@Model.RSTNumber"
                               readonly />

                    </div>

                    <!-- Unloading Location -->
                    <div class="col-md-12">

                        <label class="form-label">

                            Unloading Location

                            <span class="req-star">
                                *
                            </span>

                        </label>

                        <div class="dropdown" id="locationChoices">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="locationDropdownButton">
                                Select unloading locations
                            </button>
                            <div class="dropdown-menu w-100 p-2" style="max-height:220px;overflow-y:auto;">
                            @foreach (var location in (ViewBag.Locations as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>()))
                            {
                                <label class="dropdown-item-text d-flex align-items-center gap-2 py-2">
                                    <input class="form-check-input location-choice" type="checkbox" name="SelectedLocationIds" value="@location.Value" checked="@(location.Selected ? "checked" : null)" />
                                    <span>@location.Text</span>
                                </label>
                            }
                            </div>
                        </div>
                        <input type="hidden" asp-for="LocationId" id="primaryLocationId" />
                        <span asp-validation-for="SelectedLocationIds" class="text-danger"></span>

                        <small class="text-muted">
                            Select the location where this vehicle will be unloaded.
                        </small>

                    </div>

                    <!-- Meth -->
                    <div class="col-md-12">

                        <label asp-for="MethId"
                               class="form-label">

                            Assign to Meth (Labor Head)

                            <span class="req-star">
                                *
                            </span>

                        </label>

                        <select asp-for="MethId"
                                class="form-select"
                                asp-items="ViewBag.Meths"
                                required>

                            <option value="">
                                -- Select Meth --
                            </option>

                        </select>

                        <span asp-validation-for="MethId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Buttons -->
                    <div class="col-12
                                d-flex
                                justify-content-between
                                border-top
                                pt-3
                                mt-4">

                        <a asp-action="Index"
                           class="btn-erp-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn-erp-primary">

                            <i class="bi bi-file-earmark-check me-1"></i>
                            Accept RST & Assign Meth

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.querySelectorAll('#locationChoices .location-choice').forEach(function (box) {
            box.addEventListener('change', function () {
                const selected = Array.from(document.querySelectorAll('#locationChoices .location-choice:checked'));
                document.getElementById('primaryLocationId').value = selected.length ? selected[0].value : '';
                document.getElementById('locationDropdownButton').textContent = selected.length
                    ? selected.map(function (x) { return x.parentElement.innerText.trim(); }).join(', ')
                    : 'Select unloading locations';
            });
        });
    </script>
}
