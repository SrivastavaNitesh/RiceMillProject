@model RiceMillProject.Models.UnloadTransaction

@{
    ViewData["Title"] = "Assign Meth";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <div>
            <h3 class="erp-page-title">
                ASSIGN METH / UNLOADING CONTRACTOR
            </h3>

            <p class="erp-page-subtitle">
                Assign unloading location and labor team (Meth) for RST vehicle unloading
            </p>
        </div>
    </div>

    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Unload Queue
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">

        <div class="erp-card">

            <div class="erp-card-header">
                <span>
                    <i class="bi bi-person-check text-primary me-2"></i>
                    Unloading Assignment Details
                </span>
            </div>

            <div class="erp-card-body">

                <form asp-action="Assign"
                      asp-controller="Unload"
                      method="post"
                      class="row g-3">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <!-- RST Number Hidden -->
                    <input type="hidden"
                           asp-for="RSTNumber" />

                    <!-- Supervisor Hidden -->
                    <input type="hidden"
                           asp-for="SupervisorId" />

                    <!-- Item Hidden -->
                    <input type="hidden"
                           asp-for="ItemId" />

                    <!-- RST Number -->
                    <div class="col-md-12">

                        <label class="form-label">
                            RST Number
                        </label>

                        <input type="text"
                               class="form-control bg-light font-monospace fw-bold"
                               value="@Model.RSTNumber"
                               readonly />

                    </div>

                    <!-- Unloading Location -->
                    <div class="col-md-12">

                        @if (ViewBag.AssignmentLocationWarning is string locationWarning)
                        {
                            <div class="alert alert-warning" role="alert">@locationWarning</div>
                        }

                        <label for="unloadingLocationSummary"
                               class="form-label">

                            Unloading Location

                            <span class="req-star">
                                *
                            </span>

                        </label>

                        <details id="unloadingLocations" class="position-relative">
                            <summary id="unloadingLocationSummary" class="form-select" aria-label="Unloading locations">
                                Select unloading locations
                            </summary>
                            <div class="border rounded bg-white p-2 shadow-sm position-absolute w-100"
                                 style="z-index: 10; max-height: 240px; overflow: auto;">
                                @foreach (var location in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Locations)
                                {
                                    <label class="d-flex align-items-center gap-2 p-2">
                                        <input type="checkbox" class="form-check-input m-0" name="SelectedLocationIds"
                                               value="@location.Value" checked="@location.Selected" />
                                        <span>@location.Text</span>
                                    </label>
                                }
                            </div>
                        </details>

                        <span asp-validation-for="SelectedLocationIds"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Select one or more locations where this vehicle will be unloaded.
                        </small>

                    </div>

                    <!-- Meth -->
                    <div class="col-md-12">

                        <label asp-for="MethId"
                               class="form-label">

                            Assign to Meth (Labor Head)

                            <span class="req-star">
                                *
                            </span>

                        </label>

                        <select asp-for="MethId"
                                class="form-select"
                                asp-items="ViewBag.Meths"
                                required>

                            <option value="">
                                -- Select Meth --
                            </option>

                        </select>

                        <span asp-validation-for="MethId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Buttons -->
                    <div class="col-12
                                d-flex
                                justify-content-between
                                border-top
                                pt-3
                                mt-4">

                        <a asp-action="Index"
                           class="btn-erp-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Cancel

                        </a>

                        <button type="submit"
                                class="btn-erp-primary">

                            <i class="bi bi-file-earmark-check me-1"></i>
                            Accept RST & Assign Meth

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
    <script>
        (() => {
            @if (ViewBag.AssignmentFailed == true)
            {
                <text>Swal.fire({ icon: 'error', title: 'Some error occurred', text: 'Assignment was not saved. Please check the details below and try again.' });</text>
            }
            const dropdown = document.getElementById('unloadingLocations');
            const summary = dropdown.querySelector('summary');
            const options = [...dropdown.querySelectorAll('input[type="checkbox"]')];
            const error = document.querySelector('[data-valmsg-for="SelectedLocationIds"]');
            function updateLabel() {
                const selected = options.filter(option => option.checked);
                summary.textContent = selected.length
                    ? selected.map(option => option.nextElementSibling.textContent.trim()).join(', ')
                    : 'Select unloading locations';
                if (selected.length) error.textContent = '';
            }
            dropdown.addEventListener('change', updateLabel);
            dropdown.closest('form').addEventListener('submit', event => {
                if (!options.some(option => option.checked)) {
                    event.preventDefault();
                    error.textContent = 'Please select at least one unloading location.';
                    Swal.fire({ icon: 'error', title: 'Some error occurred', text: error.textContent });
                    dropdown.open = true;
                    summary.focus();
                }
            });
            document.addEventListener('click', event => {
                if (!dropdown.contains(event.target)) dropdown.open = false;
            });
            dropdown.addEventListener('keydown', event => {
                if (event.key === 'Escape') { dropdown.open = false; summary.focus(); }
            });
            updateLabel();
        })();
    </script>
}
