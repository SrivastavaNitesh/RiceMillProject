@model RiceMillProject.Models.DashboardMaterialPage
@{bool palledari=ViewData["Palledari"] as bool? ?? false;string action=palledari?"Palledari":"Stock";ViewData["Title"]=palledari?"Palledari Details":"Stock Details";var dateFrom=Model.FromDate.ToString("yyyy-MM-dd");var dateTo=Model.ToDate.ToString("yyyy-MM-dd");}
<div class="container-fluid py-3">
<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4"><div><a asp-action="Index" asp-route-fromDate="@dateFrom" asp-route-toDate="@dateTo" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Dashboard</a><h3 class="fw-bold mt-2 mb-1">@ViewData["Title"] · @Model.CategoryName</h3><p class="text-muted mb-0">@(palledari?$"{Model.FromDate:dd MMM yyyy} – {Model.ToDate:dd MMM yyyy}":$"Stock as of {Model.ToDate:dd MMM yyyy}")</p></div><div class="d-flex gap-2"><a asp-action="@action" asp-route-categoryId="@Model.CategoryId" asp-route-fromDate="@dateFrom" asp-route-toDate="@dateTo" class="btn btn-outline-secondary">All items in category</a><button type="button" class="btn btn-outline-primary report-print" onclick="window.print()">Print</button></div></div>
<form method="get" class="card border-0 shadow-sm mb-4 report-controls"><div class="card-body d-flex flex-wrap gap-3 align-items-end"><input type="hidden" name="categoryId" value="@Model.CategoryId"/><input type="hidden" name="itemId" value="@Model.ItemId"/><div><label for="fromDate" class="form-label">From Date</label><input class="form-control" id="fromDate" type="date" name="fromDate" value="@dateFrom"/></div><div><label for="toDate" class="form-label">To Date</label><input class="form-control" id="toDate" type="date" name="toDate" value="@dateTo"/></div><fieldset class="border-0 m-0 p-0"><legend class="form-label fs-6 mb-2">View</legend><div class="d-flex gap-3"><label class="form-check-label"><input class="form-check-input me-1" type="radio" name="mode" value="item" checked="@(Model.Mode=="item")" onchange="this.form.requestSubmit()"/>Item-wise</label><label class="form-check-label"><input class="form-check-input me-1" type="radio" name="mode" value="rst" checked="@(Model.Mode=="rst")" onchange="this.form.requestSubmit()"/>RST-wise</label></div></fieldset><button class="btn btn-primary">Apply</button></div></form>
@if(palledari){<div class="alert border mb-3" style="background:#f5f1ff;color:#5b21b6"><strong>Total Palledari: ₹@Model.TotalPalledari.ToString("N2")</strong><span class="ms-3">@Model.Charges.Sum(l=>l.Bags).ToString("N0.####") bags handled</span></div>}
else{<div class="alert border mb-3" style="background:#f0faf7;color:#0f766e"><strong>@Model.Stock.Sum(l=>l.Bags).ToString("N0.####") bags in stock</strong><span class="ms-3">@((Model.Stock.Sum(l=>l.WeightKg??0)/1000m).ToString("N3")) MT @(Model.Stock.Any(l=>!l.WeightKg.HasValue)?"(partial; some weights pending)":"")</span></div>}
@if(Model.Notices.Count>0){<div class="alert alert-warning">@foreach(var notice in Model.Notices.Distinct()){<div>@notice</div>}</div>}
@if(Model.Mode=="item"){
<div class="row g-3 mb-4">
@if(palledari){foreach(var group in Model.Charges.GroupBy(l=>new{l.CategoryId,l.ItemId,l.ItemName})){<div class="col-xl-3 col-md-6"><a class="item-drill-card" asp-action="@action" asp-route-categoryId="@group.Key.CategoryId" asp-route-itemId="@group.Key.ItemId" asp-route-mode="rst" asp-route-fromDate="@dateFrom" asp-route-toDate="@dateTo"><strong>@group.Key.ItemName</strong><span class="fs-4 fw-bold">₹@group.Sum(l=>l.Amount).ToString("N2")</span><small>@group.Sum(l=>l.Bags).ToString("N0.####") bags · View RST-wise <i class="bi bi-arrow-right"></i></small></a></div>}}
else{foreach(var group in Model.Stock.GroupBy(l=>new{l.CategoryId,l.ItemId,l.ItemName})){<div class="col-xl-3 col-md-6"><a class="item-drill-card" asp-action="@action" asp-route-categoryId="@group.Key.CategoryId" asp-route-itemId="@group.Key.ItemId" asp-route-mode="rst" asp-route-fromDate="@dateFrom" asp-route-toDate="@dateTo"><strong>@group.Key.ItemName</strong><span class="fs-4 fw-bold">@((group.Sum(l=>l.WeightKg??0)/1000m).ToString("N3")) MT</span><small>@group.Sum(l=>l.Bags).ToString("N0.####") bags · View RST-wise <i class="bi bi-arrow-right"></i></small></a></div>}}
</div>}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr>@if(Model.Mode=="rst"){<th>RST Number</th>}<th>Category</th><th>Item</th><th>Bag Type</th>@if(palledari){<th>Work</th><th class="text-end">Bags Handled</th><th class="text-end">Rate / Bag</th><th class="text-end">Palledari</th>}else{<th class="text-end">Received Bags</th><th class="text-end">Outward / Return Bags</th><th class="text-end">Stock Bags</th><th class="text-end">Stock Weight (MT)</th>}</tr></thead><tbody>
@if(palledari){
foreach(var group in Model.Charges.GroupBy(l=>Model.Mode=="item"?$"{l.CategoryId}:{l.ItemId}":l.RSTNumber)){
<tr>@if(Model.Mode=="rst"){<td class="fw-bold text-primary">@group.First().RSTNumber</td>}<td>@string.Join(", ",group.Select(l=>l.CategoryName).Distinct())</td><td>@string.Join(", ",group.Select(l=>l.ItemName).Distinct()) @if(group.Any(l=>l.Allocated)){<span title="Amount apportioned by matching material bag counts">*</span>}</td><td>@string.Join(", ",group.Select(l=>l.BagTypeName).Distinct())</td><td>@string.Join(", ",group.Select(l=>l.WorkType).Distinct())</td><td class="text-end">@group.Sum(l=>l.Bags).ToString("N0.####")</td><td class="text-end">@string.Join(", ",group.Select(l=>l.Rate).Distinct().Order().Select(r=>r.ToString("N2")))</td><td class="text-end fw-bold">₹@group.Sum(l=>l.Amount).ToString("N2")</td></tr>}
if(Model.Charges.Count==0){<tr><td colspan="@(Model.Mode=="rst"?8:7)" class="text-center text-muted py-5">No Palledari entries for these filters.</td></tr>}}
else{
foreach(var group in Model.Stock.GroupBy(l=>Model.Mode=="item"?$"{l.CategoryId}:{l.ItemId}":l.RSTNumber)){
<tr>@if(Model.Mode=="rst"){<td class="fw-bold text-primary">@group.First().RSTNumber</td>}<td>@string.Join(", ",group.Select(l=>l.CategoryName).Distinct())</td><td>@string.Join(", ",group.Select(l=>l.ItemName).Distinct())</td><td>@string.Join(", ",group.Select(l=>l.BagTypeName).Distinct())</td><td class="text-end">@group.Sum(l=>l.Direction*l.ReceivedBags).ToString("N0.####")</td><td class="text-end">@group.Sum(l=>l.OutwardBags).ToString("N0.####")</td><td class="text-end fw-bold">@group.Sum(l=>l.Bags).ToString("N0.####")</td><td class="text-end">@((group.Sum(l=>l.WeightKg??0)/1000m).ToString("N3"))@(group.Any(l=>l.Estimated)?" *":"")@(group.Any(l=>!l.WeightKg.HasValue)?" (partial / pending)":"")</td></tr>}
if(Model.Stock.Count==0){<tr><td colspan="@(Model.Mode=="rst"?8:7)" class="text-center text-muted py-5">No recorded stock for this category.</td></tr>}}
</tbody></table></div></div>
<p class="small text-muted mt-3">@(palledari?"* Where one unloading has multiple items, saved Palledari is apportioned by matching bag-type counts. Category, item and RST totals reconcile to the saved charges.":"Stock is recorded inward less outward and completed gate-out returns through To Date. * Item/return weights are apportioned when individual weights are unavailable; pending weights are excluded from the displayed MT.")</p>
</div><style>.item-drill-card{display:flex;flex-direction:column;gap:8px;padding:18px;border:1px solid #dce8e7;border-left:4px solid #0f766e;border-radius:12px;color:#17324d;background:#fff;text-decoration:none;height:100%;box-shadow:0 3px 14px rgba(15,23,42,.06)}.item-drill-card:hover,.item-drill-card:focus-visible{background:#f0faf7;outline:2px solid #0f766e;outline-offset:2px}th{white-space:nowrap}@@media print{.report-controls,.report-print{display:none!important}.table-responsive{overflow:visible!important}thead{display:table-header-group}}</style>
