@model RiceMillProject.Models.DashboardStats
@{
    ViewData["Title"] = "Operations Dashboard";
    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
}

<div class="container-fluid py-2">
    <!-- PAGE HEADER -->
    <div class="erp-page-header d-flex justify-content-between align-items-center mb-4 p-3 rounded-3 shadow-sm" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white;">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i>Rice Mill Operations Dashboard</h3>
            <p class="mb-0 opacity-75 small">Welcome back, <strong>@(User.Identity?.Name ?? "User")</strong> | Assigned Role: <span class="badge bg-light text-primary fw-bold">@userRole</span></p>
        </div>
        <div class="text-end">
            <div class="d-flex align-items-center bg-white px-3 py-2 rounded-pill shadow-sm text-dark fw-bold small">
                <i class="bi bi-calendar-event me-2 text-primary fs-6"></i>
                <span class="text-dark">@DateTime.Now.ToString("dd MMM yyyy")</span>
                <span class="mx-2 text-muted">|</span>
                <i class="bi bi-clock me-1 text-primary"></i>
                <span class="text-dark">@DateTime.Now.ToString("hh:mm tt")</span>
            </div>
        </div>
    </div>

    <!-- MAIN KPI STAT CARDS FOR ALL USERS / ADMIN -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Gate Entries -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden" style="border-left: 5px solid #2563eb !important; background: #ffffff;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase text-muted fw-bold small">Total Gate Vehicles</span>
                        <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-truck fs-4"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-extrabold mb-1 text-dark">@Model.TotalEntered</h2>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
                        <span class="small text-muted">Gate Inward / Outward</span>
                        <a asp-controller="Gateman" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 small">View Log <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Pending Unload -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden" style="border-left: 5px solid #16a34a !important; background: #ffffff;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase text-muted fw-bold small">Pending Unloading</span>
                        <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-extrabold mb-1 text-dark">@Model.PendingUnload</h2>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
                        <span class="small text-muted">Godown & Silos</span>
                        <a asp-controller="Unload" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill py-0 px-2 small">Go to Unload <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Pending Lab Check -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden" style="border-left: 5px solid #d97706 !important; background: #ffffff;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase text-muted fw-bold small">Pending Lab Tests</span>
                        <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-droplet-half fs-4"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-extrabold mb-1 text-dark">@Model.PendingLab</h2>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
                        <span class="small text-muted">Moisture & Quality</span>
                        <a asp-controller="Lab" asp-action="Index" class="btn btn-sm btn-outline-warning text-dark rounded-pill py-0 px-2 small">Open Lab <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Pending Settlement -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden" style="border-left: 5px solid #0f172a !important; background: #ffffff;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase text-muted fw-bold small">Pending Billing</span>
                        <div class="rounded-circle p-2 bg-dark bg-opacity-10 text-dark">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-extrabold mb-1 text-dark">@Model.PendingSettlement</h2>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
                        <span class="small text-muted">Farmer Payment Slips</span>
                        <a asp-controller="Settlement" asp-action="Index" class="btn btn-sm btn-outline-dark rounded-pill py-0 px-2 small">View Billing <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK OPERATIONS NAVIGATION GRID -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-fill text-primary me-2"></i>Operational Action Center</h5>
            <span class="badge bg-secondary">Rice Mill ERP v2.0</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <!-- Gateman Gate Inward -->
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Gateman" asp-action="Index" class="text-decoration-none">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-center bg-light-hover transition-all">
                            <div class="p-3 rounded-circle bg-primary text-white me-3">
                                <i class="bi bi-door-open fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Gate Inward / Outward</h6>
                                <p class="small text-muted mb-0">Record vehicle entry, gate tokens & RST slips</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Weighbridge RST -->
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="DhermKata" asp-action="Index" class="text-decoration-none">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-center bg-light-hover transition-all">
                            <div class="p-3 rounded-circle bg-info text-white me-3">
                                <i class="bi bi-speedometer fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Weighbridge RST Operations</h6>
                                <p class="small text-muted mb-0">Gross weight, Tare weight & Net Paddy calculations</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Supervisor Unloading -->
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Unload" asp-action="Index" class="text-decoration-none">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-center bg-light-hover transition-all">
                            <div class="p-3 rounded-circle bg-success text-white me-3">
                                <i class="bi bi-truck-flatbed fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Supervisor Unloading</h6>
                                <p class="small text-muted mb-0">Godown allocation, bag count & Meth labor assignment</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Lab Quality Check -->
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Lab" asp-action="Index" class="text-decoration-none">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-center bg-light-hover transition-all">
                            <div class="p-3 rounded-circle bg-warning text-dark me-3">
                                <i class="bi bi-eyedropper fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Lab Quality Check</h6>
                                <p class="small text-muted mb-0">Moisture %, Dust %, Grain quality & deductions</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Visitor Register -->
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Visitor" asp-action="Index" class="text-decoration-none">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-center bg-light-hover transition-all">
                            <div class="p-3 rounded-circle bg-purple text-white style-purple me-3">
                                <i class="bi bi-person-badge fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Visitor Register & Passes</h6>
                                <p class="small text-muted mb-0">Guest passes, FCI inspections & vendor logs</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Accounts & Billing -->
                <div class="col-md-4 col-sm-6">
                    <a asp-controller="Settlement" asp-action="Index" class="text-decoration-none">
                        <div class="p-3 border rounded-3 h-100 d-flex align-items-center bg-light-hover transition-all">
                            <div class="p-3 rounded-circle bg-dark text-white me-3">
                                <i class="bi bi-cash-stack fs-3"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Accounts & Billing</h6>
                                <p class="small text-muted mb-0">Purchase vouchers, farmer settlements & reports</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-light-hover {
        background-color: #f8fafc;
        transition: all 0.25s ease-in-out;
    }
    .bg-light-hover:hover {
        background-color: #ffffff !important;
        border-color: #2563eb !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
        transform: translateY(-2px);
    }
    .style-purple {
        background-color: #8b5cf6 !important;
    }
</style>
