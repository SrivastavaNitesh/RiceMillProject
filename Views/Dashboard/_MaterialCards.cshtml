@model RiceMillProject.Models.DashboardMaterialPage
<div class="mb-3"><div class="d-flex justify-content-between flex-wrap gap-2 mb-2"><h5 class="fw-bold mb-0">Stock &amp; Palledari</h5><small class="text-muted">Stock as of @Model.ToDate.ToString("dd MMM yyyy") · Palledari @Model.FromDate.ToString("dd MMM") – @Model.ToDate.ToString("dd MMM yyyy")</small></div>
<div class="row g-3">
@foreach(var category in Model.Categories.Where(c=>c.CategoryId>0)){
<div class="col-xxl-3 col-xl-4 col-md-6"><a class="material-card stock-card" asp-action="Stock" asp-route-categoryId="@category.CategoryId" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"><span class="material-eyebrow"><i class="bi bi-box-seam me-2"></i>@category.CategoryName</span><strong>@((category.WeightKg/1000m).ToString("N3")) <small>MT</small></strong><span>@category.Bags.ToString("N0.####") total bags</span>@if(category.PendingWeights>0){<small class="text-warning-emphasis">@category.PendingWeights weight entries pending; MT is partial</small>}<small class="material-card-link">View item-wise stock <i class="bi bi-arrow-right"></i></small></a></div>
}
<div class="col-xxl-3 col-xl-4 col-md-6"><button type="button" class="material-card palledari-card text-start w-100" id="toggle-palledari-categories" aria-expanded="false" aria-controls="palledari-category-cards"><span class="material-eyebrow"><i class="bi bi-cash-stack me-2"></i>Total Palledari</span><strong>₹@Model.TotalPalledari.ToString("N2")</strong><span>Selected period</span><small class="material-card-link">Show / hide categories <i class="bi bi-chevron-down"></i></small></button></div>
</div>
<div id="palledari-category-cards" hidden class="mt-3 p-3 rounded-4 border bg-light"><div class="d-flex align-items-center justify-content-between mb-3"><h6 class="fw-bold mb-0">Category-wise Palledari</h6><a asp-action="Palledari" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")">View all items</a></div><div class="row g-3">@foreach(var category in Model.Categories){<div class="col-xl-3 col-md-6"><a class="material-card palledari-card" asp-action="Palledari" asp-route-categoryId="@category.CategoryId" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"><span class="material-eyebrow">@category.CategoryName</span><strong>₹@category.Palledari.ToString("N2")</strong><small class="material-card-link">View item-wise Palledari <i class="bi bi-arrow-right"></i></small></a></div>}</div></div>
<p class="text-muted small mt-2 mb-0">Stock uses recorded inward less outward and gate-out returns. Item weights are apportioned from RST net weight where individual weights are unavailable.</p></div>
<style>.material-card{--accent:#0f766e;display:flex;flex-direction:column;gap:7px;min-height:154px;height:100%;padding:20px;border:1px solid #dce8e7;border-left:5px solid var(--accent);border-radius:14px;background:linear-gradient(120deg,#fff,#f0faf7);color:#17324d;text-decoration:none;box-shadow:0 3px 14px rgba(15,23,42,.06);transition:transform .15s,box-shadow .15s}.material-card:hover,.material-card:focus-visible{color:#17324d;transform:translateY(-2px);box-shadow:0 8px 22px rgba(15,23,42,.12);outline:2px solid var(--accent);outline-offset:2px}.material-card strong{font-size:1.65rem;font-weight:800;line-height:1.2}.material-card strong small{font-size:.85rem}.material-eyebrow{font-size:.78rem;font-weight:750;text-transform:uppercase;letter-spacing:.04em;color:var(--accent)}.material-card-link{margin-top:auto;color:var(--accent);font-weight:600}.palledari-card{--accent:#7c3aed;background:linear-gradient(120deg,#fff,#f5f1ff)}[hidden]{display:none!important}</style>
<script>(()=>{const button=document.getElementById('toggle-palledari-categories'),panel=document.getElementById('palledari-category-cards');button?.addEventListener('click',()=>{panel.hidden=!panel.hidden;button.setAttribute('aria-expanded',String(!panel.hidden));});})();</script>
