@model RiceMillProject.Models.DatabaseSchemaMap
@using System.Text
@using System.Text.RegularExpressions
@{ViewData["Title"]="Database Mapping";string Id(string n)=>"t_"+Regex.Replace(n,"[^A-Za-z0-9_]","_");var g=new StringBuilder("flowchart LR\n");foreach(var t in Model.Tables){var c=t.Columns.Take(7).Select(c=>(c.IsPrimaryKey?"PK ":"")+c.Name+": "+c.DataType);g.AppendLine($"{Id(t.Name)}[\"<b>{t.Name}</b><br/>Rows: {t.RowCount}<br/>{string.Join("<br/>",c)}{(t.Columns.Count>7?$"<br/>+{t.Columns.Count-7} more":"")}\"]");}foreach(var r in Model.Relationships)g.AppendLine($"{Id(r.FromTable)}{(r.IsEnforced?" -->|FK| ":" -.->|inferred| ")}{Id(r.ToTable)}");}
<div class="erp-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div class="erp-page-title-group"><div class="erp-page-icon"><i class="bi bi-diagram-3"></i></div><div><h3 class="erp-page-title">DATABASE TABLE MAPPING</h3><p class="erp-page-subtitle">@Model.Tables.Count tables · @Model.Relationships.Count relationships</p></div></div><div class="d-flex gap-2"><button class="btn btn-outline-secondary" id="out">−</button><button class="btn btn-outline-secondary" id="reset">100%</button><button class="btn btn-outline-secondary" id="in">+</button></div></div>
<div class="alert alert-info py-2 small"><b>Solid:</b> actual foreign key &nbsp; <b>Dashed:</b> inferred relationship (documentation only)</div><div class="erp-card"><div class="erp-card-body p-2 overflow-auto" style="min-height:650px;max-height:75vh"><div id="dbGraph" class="mermaid" style="transform-origin:top left">@g.ToString()</div></div></div>
<script type="module">import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';mermaid.initialize({startOnLoad:true,securityLevel:'loose',theme:'base',flowchart:{htmlLabels:true,curve:'basis'}});let s=1,d=document.getElementById('dbGraph'),r=document.getElementById('reset');function z(){d.style.transform=`scale(${s})`;r.textContent=Math.round(s*100)+'%'}document.getElementById('in').onclick=()=>{s=Math.min(2,s+.1);z()};document.getElementById('out').onclick=()=>{s=Math.max(.4,s-.1);z()};r.onclick=()=>{s=1;z()};</script>
