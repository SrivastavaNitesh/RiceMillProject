@model IEnumerable<RiceMillProject.Models.Post>
@{
    ViewData["Title"] = "Post Management";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-briefcase-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">POST & DESIGNATIONS</h3>
            <p class="erp-page-subtitle">Master list of employee designations, job positions, and roles</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New Post
    </a>
</div>

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">Post ID</th>
                    <th>Post Name</th>
                    <th>Status</th>
                    <th class="text-center pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 text-muted font-monospace">#@item.PostId</td>
                        <td><strong class="text-dark">@item.PostName</strong></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge-erp badge-erp-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-erp badge-erp-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Edit" asp-route-id="@item.PostId" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.PostId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post designation?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
