@model IEnumerable<RiceMillProject.Models.VisitorRegister>
@{
    ViewData["Title"] = "Visitor Register & Passes";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-card-heading"></i>
        </div>
        <div>
            <h3 class="erp-page-title">Visitor Register & Passes</h3>
            <p class="erp-page-subtitle">Track security passes, visitor inward log, and exit timestamps</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-person-plus"></i> Register New Visitor
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="erp-table-container">
    <div class="table-responsive">
        <table class="erp-table">
            <thead>
                <tr>
                    <th class="ps-4">Pass / Visitor No</th>
                    <th>Visitor Name</th>
                    <th>Mobile</th>
                    <th>Organization</th>
                    <th>Purpose</th>
                    <th>To Meet</th>
                    <th>Entry Time</th>
                    <th>Pass Status</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <strong class="text-primary d-block">@item.VisitorPassNo</strong>
                                <small class="text-muted">@item.VisitorNo</small>
                            </td>
                            <td><strong class="text-dark">@item.VisitorName</strong></td>
                            <td>@item.MobileNo</td>
                            <td>@(item.CompanyOrg ?? "N/A")</td>
                            <td><span class="badge-erp badge-erp-info">@item.PurposeOfVisit</span></td>
                            <td>@item.PersonToMeetName</td>
                            <td>@item.VisitDateTime.ToString("dd MMM yyyy hh:mm tt")</td>
                            <td>
                                @if (item.PassStatus == "Active")
                                {
                                    <span class="badge-erp badge-erp-success"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> Inside Yard</span>
                                }
                                else
                                {
                                    <span class="badge-erp badge-erp-danger">Exited (@item.ExitDateTime?.ToString("hh:mm tt"))</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (item.PassStatus == "Active")
                                {
                                    <form asp-action="Exit" method="post" class="d-inline">
                                        <input type="hidden" name="visitorNo" value="@item.VisitorNo" />
                                        <button type="submit" class="btn-erp-danger btn-sm"><i class="bi bi-box-arrow-right"></i> Mark Exit</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-check-all"></i> Closed</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No visitor records logged today. Click 'Register New Visitor' to create.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

