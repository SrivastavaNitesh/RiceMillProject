@{
    ViewData["Title"] = "Home";
    ViewData["PublicPage"] = "home";
    Layout = "_LayoutPublic";
}
<section class="public-hero">
    <div class="public-hero-inner"><div class="public-hero-copy">
        <span class="public-eyebrow">CULTIVATING HAPPINESS. EVERY DAY.</span>
        <h1>Good Grain.<br />Great Teamwork.<br /><em>One Workspace.</em></h1>
        <p>A single workspace for the people who keep our mill moving.<br class="desktop-break" /> From the first gate entry to the final bill, bring clarity to every stage of the day.</p>
        <div class="public-actions"><a class="public-button" asp-controller="Account" asp-action="Login"><i class="bi bi-person-fill"></i> Sign in to your workspace <span>&rarr;</span></a><a class="public-explore" href="https://youtu.be/DvbCTHGoxSc?si=6NT8ia6WkL2zKthp" target="_blank" rel="noopener noreferrer" aria-label="Watch video on YouTube (opens in a new tab)"><span aria-hidden="true">&#9654;</span> Watch Video</a></div>
    </div><div class="farm-note"><i class="bi bi-flower2" aria-hidden="true"></i><div><strong>From Farm to Factory</strong><span>Care in every grain.<br />Confidence in every step.</span></div></div></div>
</section>
<div class="public-content">
    <section class="public-benefits" aria-label="Workspace benefits">
        <div><i class="bi bi-people-fill"></i><span><strong>People First</strong><small>Connected teams</small></span></div>
        <div><i class="bi bi-building"></i><span><strong>One Workspace</strong><small>Daily mill operations</small></span></div>
        <div><i class="bi bi-journal-text"></i><span><strong>Clear Records</strong><small>Organized information</small></span></div>
        <div><i class="bi bi-shield-check"></i><span><strong>Role-based</strong><small>Authorized access</small></span></div>
    </section>
    <section class="public-feature-cards" id="operations" aria-label="Explore our operations">
        <article class="public-feature workforce"><div><i class="bi bi-people-fill"></i><h2>Smart<br /><em>Workforce Access</em></h2><p>Empower every team with the tools, information and access they need for their role.</p><a asp-controller="Account" asp-action="Login" aria-label="Sign in for workforce access">&rarr;</a></div></article>
        <article class="public-feature mill"><div><i class="bi bi-buildings"></i><h2>Connected<br /><em>Mill Operations</em></h2><p>Keep gate entries, weighment and unloading records together in one workspace.</p><a asp-controller="Account" asp-action="Login" aria-label="Sign in for mill operations">&rarr;</a></div></article>
        <article class="public-feature rice" id="quality"><div><i class="bi bi-flower2"></i><h2>Trusted<br /><em>Rice Quality</em></h2><p>Support quality checks with organized laboratory tests, observations and reports.</p><a asp-controller="Account" asp-action="Login" aria-label="Sign in for quality checks">&rarr;</a></div></article>
    </section>
    <section class="public-get-started" id="accounts">
        <div><span class="public-eyebrow">LESS FRICTION. MORE FOCUS.</span><h2>Everything your team<br />needs to <em>get started.</em></h2><p>Use your assigned username and password.<br />Access the tools and records available to your role.</p></div>
        <div class="public-values"><div><i class="bi bi-flower2"></i><strong>Quality First</strong><span>Care at every step</span></div><div><i class="bi bi-people-fill"></i><strong>People Powered</strong><span>Every team matters</span></div><div><i class="bi bi-receipt"></i><strong>Clear Accounts</strong><span>Billing &amp; settlements</span></div></div>
        <div class="public-commitment" id="about"><h2>Rooted in agriculture.<br />Built for tomorrow.</h2><p>Growing together, every day.</p></div>
    </section>

</div>
