@{
    ViewData["Title"] = "Welcome";
         Layout = "_Layout";
}

<style>
    .hero-container {
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        margin-top: 1rem;
        position: relative;
    }
    
    .carousel-item {
        height: 500px;
        background-color: #0f2027;
    }
    
    .carousel-item img {
        object-fit: cover;
        height: 100%;
        width: 100%;
        opacity: 0.6;
    }
    
    .carousel-caption {
        bottom: 30%;
        z-index: 10;
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -1px;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
    }
    
    .hero-subtitle {
        text-shadow: 1px 1px 5px rgba(0,0,0,0.8);
    }
    
    .feature-icon-box {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 2.5rem;
        margin: 0 auto 1.5rem;
        background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
        color: #1e3c72;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }
    
    .feature-icon-box:hover {
        transform: translateY(-5px);
        color: #ffc107;
        background: #1e3c72;
    }
</style>

<div class="container-fluid p-0">
    <div class="hero-container">
        <!-- Carousel -->
        <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active" data-bs-interval="4000">
                    <img src="~/images/banner1.jpg" class="d-block w-100" alt="Rice Mill Facility">
                    <div class="carousel-caption d-none d-md-block">
                        <h1 class="hero-title text-warning">Sri Balaji Rice Mill</h1>
                        <p class="lead fw-bold hero-subtitle fs-3">Next Generation Enterprise Resource Planning</p>
                    </div>
                </div>
                <div class="carousel-item" data-bs-interval="4000">
                    <img src="~/images/banner2.jpg" class="d-block w-100" alt="Paddy Fields">
                    <div class="carousel-caption d-none d-md-block">
                        <h1 class="hero-title text-white">From Farm to Factory</h1>
                        <p class="lead fw-bold hero-subtitle fs-3 text-warning">Seamlessly integrating agricultural supply chains.</p>
                    </div>
                </div>
                <div class="carousel-item" data-bs-interval="4000">
                    <img src="~/images/banner3.jpg" class="d-block w-100" alt="Logistics">
                    <div class="carousel-caption d-none d-md-block">
                        <h1 class="hero-title text-white">Smart Logistics</h1>
                        <p class="lead fw-bold hero-subtitle fs-3">Real-time truck tracking and unloading management.</p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <!-- Login Overlay Action -->
        <div class="position-absolute top-50 start-50 translate-middle text-center" style="z-index: 20; margin-top: 100px;">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow-lg rounded-pill" style="background: #2a5298; border: 2px solid white; font-size: 1.2rem;">
                <i class="bi bi-box-arrow-in-right me-2"></i> Secure Login to Portal
            </a>
            @* @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-warning btn-lg px-5 py-3 fw-bold shadow-lg rounded-pill" style="font-size: 1.2rem;">
                    <i class="bi bi-speedometer2 me-2"></i> Go to Dashboard
                </a>
            }
            else
            {
                
            } *@
        </div>
    </div>
    
    <div class="row mt-5 pt-3 text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="feature-icon-box">
                <i class="bi bi-shield-check"></i>
            </div>
            <h5 class="fw-bold text-dark">Secure & Authorized</h5>
            <p class="text-muted small px-4">Strict role-based access control ensuring data privacy across all operational departments.</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-icon-box">
                <i class="bi bi-lightning-charge"></i>
            </div>
            <h5 class="fw-bold text-dark">Real-Time Sync</h5>
            <p class="text-muted small px-4">Instant updates from Gate Operations to Lab Quality Checks and Final Billing.</p>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-icon-box">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <h5 class="fw-bold text-dark">Smart Analytics</h5>
            <p class="text-muted small px-4">Dynamic dashboards and automated tracking for inventory, labor, and logistics.</p>
        </div>
    </div>
</div>
