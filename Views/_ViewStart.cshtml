@{
    Layout = "_Layout";
    if (User.Identity?.IsAuthenticated == true)
    {
        if (User.IsAdminUser()) { Layout = "_LayoutAdmin"; }
        else if (User.IsGatemanUser()) { Layout = "_LayoutGateman"; }
        else if (User.IsWeightmanUser()) { Layout = "_LayoutWeighbridge"; }
        else if (User.IsSupervisorUser()) { Layout = "_LayoutSupervisor"; }
        else if (User.IsLabUser()) { Layout = "_LayoutLab"; }
        else if (User.IsMethUser()) { Layout = "_LayoutMeth"; }
        else
        {
            // Match Home's fallback for existing cookies with only PostId.
            Layout = User.FindFirst("PostId")?.Value switch
            {
                "1" => "_LayoutGateman",
                "2" => "_LayoutWeighbridge",
                "3" => "_LayoutSupervisor",
                "4" => "_LayoutAdmin",
                "5" => "_LayoutLab",
                "6" => "_LayoutMeth",
                _ => User.FindFirst("LayoutName")?.Value switch
                {
                    "_LayoutAdmin" => "_LayoutAdmin",
                    "_LayoutGateman" => "_LayoutGateman",
                    "_LayoutWeighbridge" => "_LayoutWeighbridge",
                    "_LayoutSupervisor" => "_LayoutSupervisor",
                    "_LayoutLab" => "_LayoutLab",
                    "_LayoutMeth" => "_LayoutMeth",
                    _ => "_Layout"
                }
            };
        }
    }
}
