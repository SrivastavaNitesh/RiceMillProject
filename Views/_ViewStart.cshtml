@{
    Layout = "_Layout";
    if (User.Identity?.IsAuthenticated == true)
    {
        if (User.IsAdminUser())
        {
            var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
            var workRole = Context.Session.GetString("AdminWorkRole") ?? string.Empty;
            Layout = controller switch
            {
                "GateEntry" => "_LayoutWeighbridge",
                "Unload" => "_LayoutSupervisor",
                "Meth" => "_LayoutMeth",
                "Lab" => "_LayoutLab",
                "OrderReturn" when workRole == "Gateman" => "_LayoutGateman",
                "OrderReturn" when workRole == "Weightman" => "_LayoutWeighbridge",
                "OrderReturn" when workRole == "Supervisor" => "_LayoutSupervisor",
                "OrderReturn" when workRole == "Worker" => "_LayoutMeth",
                "Gateman" when workRole == "Weightman" => "_LayoutWeighbridge",
                "Gateman" => "_LayoutGateman",
                _ => "_LayoutAdmin"
            };
        }
        else if (User.IsGatemanUser()) { Layout = "_LayoutGateman"; }
        else if (User.IsWeightmanUser()) { Layout = "_LayoutWeighbridge"; }
        else if (User.IsSupervisorUser()) { Layout = "_LayoutSupervisor"; }
        else if (User.IsLabUser()) { Layout = "_LayoutLab"; }
        else if (User.IsMethUser()) { Layout = "_LayoutMeth"; }
        else
        {
            // Match Home's fallback for existing cookies with only PostId.
            Layout = User.FindFirst("PostId")?.Value switch
            {
                "1" => "_LayoutGateman",
                "2" => "_LayoutWeighbridge",
                "3" => "_LayoutSupervisor",
                "4" => "_LayoutAdmin",
                "5" => "_LayoutLab",
                "6" => "_LayoutMeth",
                _ => User.FindFirst("LayoutName")?.Value switch
                {
                    "_LayoutAdmin" => "_LayoutAdmin",
                    "_LayoutGateman" => "_LayoutGateman",
                    "_LayoutWeighbridge" => "_LayoutWeighbridge",
                    "_LayoutSupervisor" => "_LayoutSupervisor",
                    "_LayoutLab" => "_LayoutLab",
                    "_LayoutMeth" => "_LayoutMeth",
                    _ => "_Layout"
                }
            };
        }
    }
}
