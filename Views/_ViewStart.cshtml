@{
    var layoutClaim = User.FindFirst("LayoutName")?.Value;
    var isAdmin = User.IsAdminUser();
    var isGateman = User.IsGatemanUser();
    var isWeightman = User.IsWeightmanUser();
    var isLab = User.IsLabUser();
    var isSupervisor = User.IsSupervisorUser();
    var isMeth = User.IsMethUser();
    if (isGateman)
    {
        Layout = "_LayoutGateman";
    }
    else if (isLab)
    {
        Layout = "_LayoutLab";
    }
    else if (isSupervisor)
    {
        Layout = "_LayoutSupervisor";
    }else if (isMeth)
{
    Layout = "_LayoutMeth";
}
    else if (!string.IsNullOrEmpty(layoutClaim) && layoutClaim != "_LayoutDefault" && layoutClaim != "_Layout")
    {
        Layout = layoutClaim;
    }
    else
    {
        Layout = "_LayoutAdmin";
    }
}

