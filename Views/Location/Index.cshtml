@model IEnumerable<RiceMillProject.Models.LocationMaster>
@{
    ViewData["Title"] = "Location Master";
    var locations = (Model ?? Enumerable.Empty<RiceMillProject.Models.LocationMaster>())
        .OrderBy(item => item.CompanyName).ThenBy(item => item.SubCompanyName).ThenBy(item => item.LocationName).ToList();
    var companyGroups = locations.GroupBy(item => new { item.CompanyId, Name = item.CompanyName ?? "Unassigned Company" }).ToList();
    var subCompanyCount = locations.Select(item => item.SubCompanyId).Where(id => id > 0).Distinct().Count();
    var totalCapacity = locations.Sum(item => item.Capacity);
}

<div class="erp-page-header location-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon"><i class="bi bi-diagram-3"></i></div>
        <div>
            <h3 class="erp-page-title">Company Location Structure</h3>
            <p class="erp-page-subtitle">Main company, subcompany aur storage location ki clear hierarchy</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary"><i class="bi bi-plus-lg"></i> Add New Location</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="location-summary-grid">
    <div class="location-summary-card"><span class="summary-icon company"><i class="bi bi-building"></i></span><div><small>Main Companies</small><strong>@companyGroups.Count</strong></div></div>
    <div class="location-summary-card"><span class="summary-icon subcompany"><i class="bi bi-diagram-2"></i></span><div><small>Subcompanies</small><strong>@subCompanyCount</strong></div></div>
    <div class="location-summary-card"><span class="summary-icon location"><i class="bi bi-geo-alt"></i></span><div><small>Active Locations</small><strong>@locations.Count(item => item.IsActive)</strong></div></div>
    <div class="location-summary-card"><span class="summary-icon capacity"><i class="bi bi-box-seam"></i></span><div><small>Configured Capacity</small><strong>@totalCapacity.ToString("N2") MT</strong></div></div>
</div>

<div class="erp-table-container erp-report-shell">
    <div class="erp-report-heading">
        <div><span class="erp-report-eyebrow">Location Mapping Report</span><h5>Company → Subcompany → Location</h5></div>
        <div class="erp-report-heading-actions">
            <form asp-action="Index" method="get" class="subcompany-filter-form">
                <label for="subCompanyId"><i class="bi bi-funnel"></i> Subcompany</label>
                <select id="subCompanyId" name="subCompanyId" asp-items="ViewBag.SubCompanyFilter" class="form-select" onchange="this.form.submit()">
                    <option value="">All Subcompanies</option>
                </select>
                @if (ViewBag.SelectedSubCompanyId != null)
                {
                    <a asp-action="Index" class="filter-reset" title="Clear filter"><i class="bi bi-x-lg"></i></a>
                }
            </form>
            <span class="erp-report-count"><i class="bi bi-pin-map"></i> @locations.Count locations</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="erp-table erp-report-table erp-grouped-table no-datatable">
            <thead><tr><th>Main Company</th><th>Subcompany</th><th>Location Code</th><th>Location Name</th><th>Type</th><th class="text-end">Capacity</th><th>Address / Area</th><th>Status</th><th class="text-center">Action</th></tr></thead>
            <tbody>
            @if (locations.Count > 0)
            {
                foreach (var companyGroup in companyGroups)
                {
                    var companyRowPrinted = false;
                    var subCompanyGroups = companyGroup.GroupBy(item => new { item.SubCompanyId, Name = item.SubCompanyId > 0 ? item.SubCompanyName ?? "Subcompany" : "Direct Main Company" }).ToList();
                    foreach (var subCompanyGroup in subCompanyGroups)
                    {
                        var subCompanyRowPrinted = false;
                        var groupRowIndex = 0;
                        foreach (var item in subCompanyGroup)
                        {
                            <tr class="@(groupRowIndex == 0 ? "subcompany-start" : string.Empty)">
                                @if (!companyRowPrinted)
                                {
                                    <td rowspan="@companyGroup.Count()" class="company-group-cell">
                                        <div class="group-identity"><span class="group-icon"><i class="bi bi-building-fill"></i></span><div><strong>@companyGroup.Key.Name</strong><small>@subCompanyGroups.Count subcompanies</small></div></div>
                                    </td>
                                    companyRowPrinted = true;
                                }
                                @if (!subCompanyRowPrinted)
                                {
                                    <td rowspan="@subCompanyGroup.Count()" class="subcompany-group-cell"><strong>@subCompanyGroup.Key.Name</strong><small>@subCompanyGroup.Count() location@(subCompanyGroup.Count() == 1 ? "" : "s")</small></td>
                                    subCompanyRowPrinted = true;
                                }
                                <td><span class="location-code">@item.LocationCode</span></td>
                                <td><div class="location-name-cell"><i class="bi bi-geo-alt-fill"></i><strong>@item.LocationName</strong></div></td>
                                <td><span class="badge-erp badge-erp-info">@item.LocationType</span></td>
                                <td class="text-end capacity-cell"><strong>@item.Capacity.ToString("N2")</strong><small>@item.CapacityUnit</small></td>
                                <td class="address-cell">@(string.IsNullOrWhiteSpace(item.Address) ? "Not specified" : item.Address)</td>
                                <td><span class="badge-erp @(item.IsActive ? "badge-erp-success" : "badge-erp-danger")"><i class="bi @(item.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i> @(item.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="text-center action-cell">
                                    <a asp-action="Edit" asp-route-id="@item.LocationId" class="btn-erp-outline btn-sm" title="Edit location"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.LocationId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this location?');"><button type="submit" class="btn-erp-danger btn-sm" title="Deactivate location"><i class="bi bi-trash3"></i></button></form>
                                </td>
                            </tr>
                            groupRowIndex++;
                        }
                    }
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center py-5 text-muted"><i class="bi bi-geo-alt fs-3 d-block mb-2"></i>No locations configured yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
