@model RiceMillProject.Models.BillingPage
@using System.Text.Json
@{ViewData["Title"]="Generate bill";var source=Model.Calculation.Source;}
<partial name="_Messages" />
<div class="bill-page-heading"><div><h2>Generate bill</h2><p class="text-muted">Set item rates, review deductions and reconcile weights before saving.</p></div><a asp-action="Details" asp-route-rstNumber="@source.Header.RSTNumber" class="btn btn-outline-secondary">Back to details</a></div>
<partial name="_RstHeader" model="Model.Calculation" />
<partial name="_Items" model="Model.Calculation" />
<form method="post" asp-action="Generate" id="billing-form">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Form.RSTNumber" type="hidden" /><input asp-for="Form.SubmissionId" type="hidden" /><input asp-for="Form.SourceVersion" type="hidden" />
<partial name="_Checks" model="Model.Calculation.Issues" />
@if(ViewBag.PreviewReady==true){<p class="text-success" role="status">गणना सही है। कुल राशि देखकर बिल सेव करें।</p>}
<section class="bill-form-section">
<div class="bill-section-title"><h4>Item rates and deductions</h4></div>
<p class="small text-muted"><strong>*</strong> बोरी के अनुपात से निकाला गया अनुमानित वजन। बिना * वाला वजन दर्ज वास्तविक वजन या एक आइटम का अंतिम नेट वजन है।</p>
<p class="small text-muted">किलो/क्विंटल दर बोरियों का वजन घटाने के बाद लगती है। बोरी की दर बोरी संख्या पर लगती है। लैब कटौती राशि में होगी।</p>
<div class="table-responsive"><table class="table table-bordered bill-rate-table"><thead><tr><th>Item</th><th>Bags</th><th>Weight kg</th><th>Rate</th><th>Rate per</th><th>Billable kg</th><th>Base amount</th><th>Lab deduction</th><th>Item payable</th></tr></thead><tbody>
@for(var i=0;i<Model.Form.Items.Count;i++){
var item=Model.Calculation.Items.FirstOrDefault(x=>x.ItemId==Model.Form.Items[i].ItemId);if(item==null){continue;}
<tr data-item-id="@item.ItemId"><td><strong>@item.ItemName</strong><small class="d-block text-muted">@item.CategoryName</small><input asp-for="Form.Items[i].ItemId" type="hidden" /></td><td>@item.Bags</td>
<td><span class="allocated-weight">@item.GrossKg.ToString("N3")@(item.IsEstimatedWeight ? " *" : "")</span></td>
<td><input asp-for="Form.Items[i].Rate" type="text" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" required maxlength="11" class="form-control item-rate" aria-label="Rate for @item.ItemName" /></td>
<td><select asp-for="Form.Items[i].RateBasis" class="form-select rate-basis" aria-label="Rate basis for @item.ItemName"><option value="Quintal">Quintal</option><option value="Kg">Kg</option><option value="Bag">Bag</option></select></td>
<td class="item-payable-kg">@item.PayableKg.ToString("N3")@(item.IsEstimatedWeight ? " *" : "")</td><td class="item-base">@item.BaseAmount.ToString("N2")</td><td class="item-deduction">@item.LabDeductionAmount.ToString("N2")</td><td class="item-amount fw-bold">@item.Amount.ToString("N2")</td></tr>
}
</tbody></table></div>
<div id="weight-reconciliation" class="small mt-3" role="status"></div>
</section>
<section class="bill-form-section">
<h4>Unloading locations</h4><p class="text-muted small">कौन-सा आइटम किस स्थान पर उतरा, यह सुपरवाइजर के रिकॉर्ड से लिया गया है। बोरियाँ दोबारा बाँटने की जरूरत नहीं है।</p>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Item / bag type</th><th>Location</th><th>Bags</th></tr></thead><tbody>
@foreach(var lot in source.Lots){
var loc=source.Locations.FirstOrDefault(l=>l.UnloadId==lot.UnloadId && l.LocationId==lot.LocationId);
<tr><td>@lot.ItemName / @lot.BagTypeName</td><td>@(loc?.LocationName ?? "स्थान दर्ज नहीं")</td><td>@lot.BagCount</td></tr>
}
</tbody></table></div>
</section>
<section class="bill-form-section"><h4>Meth worker record</h4><p class="text-muted small">मेठ की दर्ज बोरियाँ संदर्भ के लिए हैं। बिल में नीचे भरी कुल पल्लेदारी राशि एक बार जुड़ेगी।</p>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Worker</th><th>Work / bag</th><th>Bags</th></tr></thead><tbody>
@for(var i=0;i<Model.Form.Workers.Count;i++){
var w=source.Workers.FirstOrDefault(x=>x.AllocationId==Model.Form.Workers[i].AllocationId);if(w==null){continue;}
<tr><td>@w.WorkerName<input asp-for="Form.Workers[i].AllocationId" type="hidden" /><input asp-for="Form.Workers[i].Rate" type="hidden" /></td><td>@w.WorkType / @w.BagTypeName</td><td>@w.BagCount</td></tr>
}
</tbody></table></div></section>
<div class="row g-4"><div class="col-lg-7"><section class="card card-body"><label asp-for="Form.Notes" class="form-label">टिप्पणी</label><textarea asp-for="Form.Notes" class="form-control" maxlength="1000"></textarea><label asp-for="Form.GstPercent" class="form-label mt-3">GST (%)</label><input asp-for="Form.GstPercent" type="number" min="0" max="100" step="0.01" class="form-control" id="gst-percent" required /><p class="small text-muted mt-2 mb-0">लैब कटौती के बाद आइटम राशि + पल्लेदारी पर दर्ज GST प्रतिशत लगेगा।</p><label asp-for="Form.PalledariAmount" class="form-label mt-3">कुल पल्लेदारी (₹)</label><input asp-for="Form.PalledariAmount" type="number" min="0" max="999999999.99" step="0.01" class="form-control" id="palledari-amount" required /><p class="small text-muted mt-2">पूरे RST की पल्लेदारी भरें। कोई शुल्क नहीं है तो 0 रखें।</p></section></div>
<div class="col-lg-5"><section class="bill-form-section bill-totals"><dl><div><dt>Item base amount</dt><dd id="total-items">@Model.Calculation.ItemAmount.ToString("N2")</dd></div><div><dt>Lab deduction</dt><dd id="total-deduction">@Model.Calculation.LabDeduction.ToString("N2")</dd></div><div><dt>कुल पल्लेदारी</dt><dd id="total-workers">@Model.Calculation.WorkerAmount.ToString("N2")</dd></div><div><dt>Subtotal</dt><dd id="total-subtotal">@Model.Calculation.Subtotal.ToString("N2")</dd></div><div><dt>GST</dt><dd id="total-gst">@Model.Calculation.GstAmount.ToString("N2")</dd></div><div class="bill-grand-total"><dt>Total INR</dt><dd id="total-amount">@Model.Calculation.Total.ToString("N2")</dd></div></dl><div class="d-flex gap-2 flex-wrap"><button type="submit" name="intent" value="preview" class="btn btn-outline-primary">Verify calculation</button><button type="submit" name="intent" value="save" class="btn btn-primary">Save bill</button></div><small class="text-muted mt-3">सेव होने पर बिल का विवरण और गणना सुरक्षित रहेंगी।</small></section></div></div>
</form>
<script type="application/json" id="billing-source">@Html.Raw(JsonSerializer.Serialize(source))</script>
<script type="application/json" id="billing-weights">@Html.Raw(JsonSerializer.Serialize(Model.Calculation.Items.Select(i=>new {i.ItemId,i.GrossKg,i.PayableKg,i.IsEstimatedWeight})))</script>
@section Scripts {<script src="~/js/billing.js" asp-append-version="true"></script>}
