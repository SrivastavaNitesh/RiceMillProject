@model RiceMillProject.Models.DepartmentMaster
@{
    ViewData["Title"] = "Add New Department";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-diagram-3-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">ADD NEW DEPARTMENT</h3>
            <p class="erp-page-subtitle">Define department details and assign to office branch</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Department Information</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Department Code <span class="req-star">*</span></label>
                        <input asp-for="DepartmentCode" class="form-control" placeholder="e.g. DEP-PRD" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Department Name <span class="req-star">*</span></label>
                        <input asp-for="DepartmentName" class="form-control" placeholder="e.g. Production & Milling" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Assigned Office Branch <span class="req-star">*</span></label>
                        <select asp-for="OfficeId" asp-items="ViewBag.Offices" class="form-select">
                        </select>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
