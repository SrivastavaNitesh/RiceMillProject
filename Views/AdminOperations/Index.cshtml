@model RiceMillProject.Models.AdminOperationViewModel
@{ ViewData["Title"] = "Assign and Manage"; Layout = "_LayoutAdmin"; }
<div class="erp-page-header mb-4"><div class="erp-page-title-group"><div class="erp-page-icon bg-primary-subtle text-primary"><i class="bi bi-person-workspace"></i></div><div><h3 class="erp-page-title">ASSIGN AND MANAGE</h3><p class="erp-page-subtitle">Admin ke liye complete inward se unloading tak ka ordered workflow</p></div></div></div>

<div class="erp-card mb-4"><div class="erp-card-header"><i class="bi bi-list-ol me-2"></i>Work Process — Follow in this order</div><div class="erp-card-body p-4">
    <div class="row g-3">
        <div class="col-md-6 col-xl-3"><a asp-action="Index" asp-route-role="Gateman" class="text-decoration-none"><div class="border rounded-3 p-3 h-100"><span class="badge bg-primary mb-2">Step 1</span><h5 class="text-dark">Gate Inward Entry</h5><p class="text-muted small mb-2">Vehicle, supplier aur inward details record karein.</p><span class="fw-semibold">Select Gateman <i class="bi bi-arrow-right"></i></span></div></a></div>
        <div class="col-md-6 col-xl-3"><a asp-action="Index" asp-route-role="Weightman" class="text-decoration-none"><div class="border rounded-3 p-3 h-100"><span class="badge bg-info mb-2">Step 2</span><h5 class="text-dark">RST & Weighment</h5><p class="text-muted small mb-2">Gross weight lekar RST generate/manage karein.</p><span class="fw-semibold">Select Weightman <i class="bi bi-arrow-right"></i></span></div></a></div>
        <div class="col-md-6 col-xl-3"><a asp-action="Index" asp-route-role="Supervisor" class="text-decoration-none"><div class="border rounded-3 p-3 h-100"><span class="badge bg-warning text-dark mb-2">Step 3</span><h5 class="text-dark">Assign & Field Details</h5><p class="text-muted small mb-2">Meth, location, material aur bags assign karein.</p><span class="fw-semibold">Select Supervisor <i class="bi bi-arrow-right"></i></span></div></a></div>
        <div class="col-md-6 col-xl-3"><a asp-action="Index" asp-route-role="Worker" class="text-decoration-none"><div class="border rounded-3 p-3 h-100"><span class="badge bg-success mb-2">Step 4</span><h5 class="text-dark">Worker / Meth Entry</h5><p class="text-muted small mb-2">Worker-wise bag work aur labour details complete karein.</p><span class="fw-semibold">Select Worker / Meth <i class="bi bi-arrow-right"></i></span></div></a></div>
    </div>
</div></div>

<div class="erp-card"><div class="erp-card-header"><i class="bi bi-person-check me-2"></i>Step @(Model.Role == "Gateman" ? "1" : Model.Role == "Weightman" ? "2" : Model.Role == "Supervisor" ? "3" : "4") — Select @Model.Role Operator</div><div class="erp-card-body p-4">
<form asp-action="Index" method="get" class="row g-3 mb-4"><div class="col-md-6"><label class="form-label fw-semibold">Workflow role</label><select asp-for="Role" class="form-select" onchange="this.form.submit()"><option value="Gateman">Gateman</option><option value="Weightman">Weightman</option><option value="Supervisor">Supervisor</option><option value="Worker">Worker / Meth</option></select></div></form>
<form asp-action="Select" method="post" class="row g-3 align-items-end"><input asp-for="Role" type="hidden"/><div class="col-md-8"><label asp-for="UserId" class="form-label fw-semibold">Select @Model.Role employee</label><select asp-for="UserId" asp-items="Model.Operators" class="form-select"><option value="">-- Select operator --</option></select><span asp-validation-for="UserId" class="text-danger"></span></div><div class="col-md-4"><button class="btn btn-primary w-100"><i class="bi bi-play-fill me-1"></i> Start @Model.Role Work</button></div></form>
<div class="alert alert-info mt-4 mb-0"><i class="bi bi-shield-check me-2"></i>Admin login active rahega; selected employee ke context mein existing workflow open hoga aur sequence validations same rahengi.</div>
</div></div>
