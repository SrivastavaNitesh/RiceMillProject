@model IEnumerable<RiceMillProject.Models.GateMaster>
@{
    ViewData["Title"] = "Gate Master Management";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">GATE MASTER CONFIGURATION</h3>
            <p class="erp-page-subtitle">Configure plant entry/exit gates, access control, and department mappings</p>
        </div>
    </div>
    <a asp-action="Create" class="btn-erp-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New Gate
    </a>
</div>

<div class="erp-card">
    <div class="erp-card-header">
        <span><i class="bi bi-list-ul text-primary me-2"></i> Configured Gate Locations</span>
        <span class="badge badge-erp bg-secondary">Total: @(Model?.Count() ?? 0) Gates</span>
    </div>
    <div class="erp-card-body p-0">
        <div class="erp-table-container">
            <table class="table erp-table align-middle" id="gateMasterTable">
                <thead>
                    <tr>
                        <th style="width: 100px;">GATE CODE</th>
                        <th>GATE NAME</th>
                        <th>GATE TYPE</th>
                        <th>LOCATION / AREA</th>
                        <th>DEPARTMENT</th>
                        <th>INWARD</th>
                        <th>OUTWARD</th>
                        <th>STATUS</th>
                        <th class="text-center" style="width: 100px;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold font-monospace text-primary">@item.GateCode</td>
                                <td class="fw-bold text-dark">@item.GateName</td>
                                <td><span class="badge badge-erp bg-info text-dark">@item.GateType</span></td>
                                <td>@(item.LocationArea ?? "N/A")</td>
                                <td>@(item.DepartmentName ?? "All")</td>
                                <td>
                                    @if (item.InwardAllowed)
                                    {
                                        <span class="badge badge-erp bg-success"><i class="bi bi-check-lg me-1"></i> Allowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-erp bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (item.OutwardAllowed)
                                    {
                                        <span class="badge badge-erp bg-success"><i class="bi bi-check-lg me-1"></i> Allowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-erp bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-erp bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-erp bg-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@item.GateId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this gate?');">
                                        <button type="submit" class="btn-erp-outline btn-sm text-danger border-danger" title="Deactivate">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#gateMasterTable').length && $.fn.DataTable) {
                $('#gateMasterTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    order: [[0, 'asc']]
                });
            }
        });
    </script>
}
