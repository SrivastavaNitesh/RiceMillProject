@model IEnumerable<RiceMillProject.Models.GateMaster>
@{
    ViewData["Title"] = "Gate Master Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0"><i class="bi bi-door-open-fill me-2 text-primary"></i> Gate Master Configuration</h3>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow"><i class="bi bi-plus-lg me-1"></i> Add New Gate</a>
</div>

<div class="card shadow border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary">
                    <tr>
                        <th class="ps-4">Gate Code</th>
                        <th>Gate Name</th>
                        <th>Gate Type</th>
                        <th>Location / Area</th>
                        <th>Department</th>
                        <th>Inward</th>
                        <th>Outward</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.GateCode</td>
                                <td><strong class="text-dark">@item.GateName</strong></td>
                                <td><span class="badge bg-info text-dark">@item.GateType</span></td>
                                <td>@(item.LocationArea ?? "N/A")</td>
                                <td>@(item.DepartmentName ?? "All")</td>
                                <td>
                                    @if (item.InwardAllowed)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg"></i> Allowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (item.OutwardAllowed)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg"></i> Allowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="Delete" asp-route-id="@item.GateId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this gate?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No gates configured yet. Click 'Add New Gate' to setup.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
