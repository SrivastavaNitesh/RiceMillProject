@model RiceMillProject.Models.GateMaster
@{
    ViewData["Title"] = "Add New Gate";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">ADD NEW GATE CONTROL</h3>
            <p class="erp-page-subtitle">Configure company gate, location area, and entry/exit permissions</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Gate Configuration Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Company Name <span class="req-star">*</span></label>
                        <select asp-for="OfficeId" asp-items="ViewBag.Offices" class="form-select" required>
                            <option value="">Select Company</option>
                        </select>
                        <span asp-validation-for="OfficeId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Gate Name <span class="req-star">*</span></label>
                        <input asp-for="GateName" class="form-control" placeholder="e.g. Main Gate 1" required />
                        <span asp-validation-for="GateName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gate Type <span class="req-star">*</span></label>
                        <select asp-for="GateType" class="form-select">
                            <option value="Main Gate">Main Gate</option>
                            <option value="Dispatch Gate">Dispatch Gate</option>
                            <option value="Staff Gate">Staff Gate</option>
                            <option value="Gate-1">Gate-1</option>
                            <option value="Gate-2">Gate-2</option>
                        </select>
                        <span asp-validation-for="GateType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Location / Area</label>
                        <input asp-for="LocationArea" class="form-control" placeholder="e.g. East Mill Entrance" />
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="InwardAllowed" id="chkInward">
                            <label class="form-check-label fw-semibold" for="chkInward">Inward Allowed</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="OutwardAllowed" id="chkOutward">
                            <label class="form-check-label fw-semibold" for="chkOutward">Outward Allowed</label>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Gate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
