@model RiceMillProject.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-truck-front-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">EDIT VEHICLE REGISTER</h3>
            <p class="erp-page-subtitle">Update vehicle registration number and active status</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-pencil-square text-primary me-2"></i> Edit Vehicle Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Edit" method="post" class="row g-3">
                    <input type="hidden" asp-for="VehicleId" />

                    <div class="col-md-12">
                        <label asp-for="VehicleNumber" class="form-label">Vehicle Registration Number <span class="req-star">*</span></label>
                        <input asp-for="VehicleNumber" class="form-control text-uppercase font-monospace" required />
                        <span asp-validation-for="VehicleNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="flexCheckDefault">
                            <label class="form-check-label fw-semibold" for="flexCheckDefault">
                                Active Status
                            </label>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Update Vehicle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
