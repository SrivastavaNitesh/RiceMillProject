@model RiceMillProject.Models.Vehicle
@{
    ViewData["Title"] = "Add New Vehicle";
}

<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-truck-front-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">ADD NEW VEHICLE</h3>
            <p class="erp-page-subtitle">Register new vehicle number plate and assign default party/driver</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-erp-outline">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="erp-card">
            <div class="erp-card-header">
                <span><i class="bi bi-truck text-primary me-2"></i> Vehicle Registration Details</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="col-md-12">
                        <label asp-for="VehicleNumber" class="form-label">Vehicle Number Plate <span class="req-star">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-123"></i></span>
                            <input asp-for="VehicleNumber" class="form-control text-uppercase" required placeholder="e.g. UP32 AB 1234" />
                        </div>
                        <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="erp-form-section-title">
                            <i class="bi bi-link-45deg me-2"></i> Vehicle Mapping Links (Party & Driver)
                        </div>
                        <div class="alert alert-info py-2 border-0 small mb-3">
                            <i class="bi bi-info-circle-fill me-2"></i> Select the default Party and Driver for this vehicle. You can change this later during gate entry.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PartyId" class="form-label">Party / Supplier <span class="text-danger">*</span></label>
                                <select asp-for="PartyId" class="form-select" asp-items="ViewBag.Parties" required>
                                    <option value="">-- Select Party / Supplier --</option>
                                </select>
                                <span asp-validation-for="PartyId" class="text-danger small"></span>
                                <small class="text-muted"><a asp-controller="Person" asp-action="Create" target="_blank">Add New Party <i class="bi bi-box-arrow-up-right"></i></a></small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DriverId" class="form-label">Default Driver <span class="text-danger">*</span></label>
                                <select asp-for="DriverId" class="form-select" asp-items="ViewBag.Drivers" required>
                                    <option value="">-- Select Existing Driver --</option>
                                </select>
                                <span asp-validation-for="DriverId" class="text-danger small"></span>
                                <small class="text-muted"><a asp-controller="Person" asp-action="Create" target="_blank">Add New Driver <i class="bi bi-box-arrow-up-right"></i></a></small>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn-erp-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn-erp-primary">
                            <i class="bi bi-check-circle me-1"></i> Register Vehicle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
