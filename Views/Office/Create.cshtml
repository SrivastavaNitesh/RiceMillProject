@model RiceMillProject.Models.Office
@{
    ViewData["Title"] = "Add Office";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Add New Office</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="OfficeName" class="form-label fw-bold">Office Name</label>
                        <input asp-for="OfficeName" class="form-control" required />
                        <span asp-validation-for="OfficeName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-bold">Locations</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Godown A, Godown B, Main Plant..." required />
                        </div>
                        <small class="text-muted">Enter multiple locations separated by commas.</small>
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    
                    <!-- Hidden field since IsActive is default true for new -->
                    <input type="hidden" asp-for="IsActive" value="true" />

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <button type="submit" class="btn btn-primary">Save Office</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
