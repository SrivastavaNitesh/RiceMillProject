@model IEnumerable<RiceMillProject.Models.InwardHeader>
@{
    var reportEntries = Model ?? Enumerable.Empty<RiceMillProject.Models.InwardHeader>();
    var bagTypes = reportEntries.SelectMany(e => e.SupervisorBags.Keys).Distinct().OrderBy(n => n).ToList();
    ViewData["Title"] = "Gate Inward Register";
    bool isWeightman = User.IsWeightmanUser() || (User.IsAdminUser() && Context.Session.GetString(RiceMillProject.Models.AdminWorkContext.RoleKey) == "Weightman");
}

@if (isWeightman)
{
    <form id="gatemanWeightmanActionForm" asp-controller="GateEntry" asp-action="WeightmanAction" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RSTNumber" id="gatemanActionRst" />
        <input type="hidden" name="CurrentGrossWeight" id="gatemanActionGross" />
        <input type="hidden" name="ActionType" id="gatemanActionType" />
    </form>
}

<style>
@@media print {
 @@page { size: A3 landscape; margin: 8mm; }
 .report-action, .erp-toolbar, .erp-report-card:has(form), .dataTables_length, .dataTables_filter, .dataTables_info, .dataTables_paginate { display:none!important; }
 .table-responsive { overflow:visible!important; }
 .erp-table { font-size:8pt; }
 thead { display:table-header-group; }
}
    /* Professional ERP Report Styling */
    .erp-report-card {
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    }
    .erp-report-header {
        background-color: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        padding: 1rem 1.25rem;
    }
    .erp-table {
        font-size: 0.825rem;
        color: #374151;
        margin-bottom: 0;
    }
    .erp-table thead th {
        background: linear-gradient(135deg, #123f46, #087f83) !important;
        color: #ffffff !important;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        border: 0 !important;
        padding: 0.75rem 0.8rem;
        white-space: nowrap;
        vertical-align: middle;
    }
    .erp-table thead th:first-child { border-radius: 8px 0 0 0; }
    .erp-table thead th:last-child { border-radius: 0 8px 0 0; }
    .erp-table tbody td {
        padding: 0.5rem 0.75rem;
        vertical-align: middle;
        border-bottom: 1px solid #e5edf0;
    }
    .erp-table tbody tr:nth-child(even) { background-color: #f7fbfb; }
    .erp-table tbody tr:nth-child(odd) { background-color: #ffffff; }
    .rst-action-cell { min-width: 135px; text-align: center; vertical-align: middle !important; }
    .rst-action-dropdown { position: relative; display: inline-block; }
    .rst-action-btn { min-width: 106px; height: 36px; border: 1px solid #087f83; color: #087f83; background: #fff; border-radius: 7px; font-weight: 600; }
    .rst-action-btn:hover, .rst-action-btn:focus { background: #087f83; color: #fff; }
    .rst-action-menu { min-width: 215px; padding: .35rem; border: 1px solid #d7e4e5; border-radius: 9px; box-shadow: 0 8px 24px rgba(15,45,55,.16); }
    .rst-action-item { display: block; padding: .45rem .6rem; border-radius: 6px; text-decoration: none; white-space: nowrap; }
    .rst-action-item:hover { background: #f1f7f7; }
    .rst-action-item small { display: block; color: #6c757d; font-size: .7rem; margin-left: 1.65rem; }
    .erp-table tbody tr:hover {
        background-color: #f1f5f9;
    }
    .erp-badge {
        font-size: 0.725rem;
        font-weight: 600;
        padding: 0.25em 0.5em;
        border-radius: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }
    .erp-toolbar .btn {
        font-size: 0.825rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    /* DataTables Overrides */
    .dataTables_wrapper .dataTables_length select {
        font-size: 0.825rem;
        padding: 0.25rem 2rem 0.25rem 0.5rem;
    }
    .dataTables_wrapper .dataTables_filter input {
        font-size: 0.825rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 0.25rem;
    }
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        font-size: 0.825rem;
        padding-top: 0.75rem;
    }
</style>

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-1" style="letter-spacing:-0.5px;">Gate Inward Register</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size:0.85rem;">
                <li class="breadcrumb-item">
                    @if (isWeightman)
                    {
                        <a asp-controller="GateEntry" asp-action="Dashboard" class="text-decoration-none text-muted">Dashboard</a>
                    }
                    else
                    {
                        <a asp-controller="Gateman" asp-action="Dashboard" class="text-decoration-none text-muted">Dashboard</a>
                    }
                </li>
                <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Inward Report</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2 erp-toolbar">
        <button onclick="window.print()" class="btn btn-light border shadow-sm text-dark">
            <i class="bi bi-printer"></i> Print
        </button>
        <button class="btn btn-success shadow-sm" onclick="exportTableToCSV('Gate_Inward_Register.csv')">
            <i class="bi bi-file-earmark-excel"></i> Export CSV
        </button>
        @if (!isWeightman)
        {
            <a asp-action="Index" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg"></i> New Entry
            </a>
        }
    </div>
</div>

<div class="card border-0 erp-report-card mb-3">
    <div class="card-body py-3">
        <form asp-controller="Gateman" asp-action="Report" method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3"><label class="form-label fw-semibold mb-1">From date</label><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" /></div>
            <div class="col-sm-4 col-md-3"><label class="form-label fw-semibold mb-1">To date</label><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" /></div>
            <div class="col-sm-4 col-md-auto"><button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply Filter</button><a asp-action="Report" class="btn btn-outline-secondary ms-2">Clear</a></div>
        </form>
    </div>
</div>

<div class="card border-0 erp-report-card">
    <div class="card-body p-3">
        <div class="table-responsive" style="overflow: auto; max-width: 100%;">
            <table class="table erp-table table-bordered table-striped w-100" id="erpReportTable">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">S.N.</th>
                        <th>Inward No</th>

                        <th>Date & Time</th>
                        <th>Party / Supplier</th><th>Party Mobile Number</th>
                        <th>Vehicle No</th>
                        <th>Driver Info</th>
                        <th>Item Category Name</th>
                        <th>RST Number</th>
                        <th>Gross Weight</th><th>Tare Weight</th><th>Net Weight</th>
 @foreach(var bagType in bagTypes) { <th>@bagType Bags</th> }<th>Total Bags</th>

                        <th>Status</th>
                        @if (!isWeightman) { <th class="text-center report-action">Action</th> }
                       @*  <th>Added By</th> *@
                        @if (isWeightman) { <th class="text-center report-action">Action</th> }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int sn = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center text-muted fw-medium">@(sn++)</td>
                                <td class="fw-bold text-primary">@item.InwardNo</td>

                                <td>
                                    <span class="d-block fw-semibold text-dark">@item.InwardDate.ToString("dd-MMM-yyyy")</span>
                                    <span class="text-muted" style="font-size:0.75rem;">@item.InwardTime</span>
                                </td>
                                <td class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(item.PartyName) ? "-" : item.PartyName)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.PartyMobile) ? "-" : item.PartyMobile)</td>
 <td><span class="badge bg-light text-dark border border-secondary text-uppercase" style="font-size:0.75rem;">@item.VehicleNo</span></td>
                                <td>
                                    <span class="d-block fw-medium">@item.DriverName</span>
                                    <span class="text-muted" style="font-size:0.75rem;">@(string.IsNullOrWhiteSpace(item.DriverMobile) ? "-" : item.DriverMobile)</span>
                                </td>
<td>@(string.IsNullOrWhiteSpace(item.ItemCategoryName) ? "-" : item.ItemCategoryName)</td>
                                <td class="fw-bold text-primary font-monospace">@(string.IsNullOrWhiteSpace(item.RSTNumber) ? "-" : item.RSTNumber)</td>
                                <td class="fw-semibold">@(item.RSTGrossWeight.HasValue ? item.RSTGrossWeight.Value.ToString("0.###") + " KG" : "-")</td>
<td>@(item.RSTTareWeight.HasValue ? item.RSTTareWeight.Value.ToString("0.###") + " KG" : "-")</td>
<td>@(item.RSTNetWeight.HasValue ? item.RSTNetWeight.Value.ToString("0.###") + " KG" : "-")</td>
@foreach(var bagType in bagTypes) { <td>@item.SupervisorBags.GetValueOrDefault(bagType)</td> }
<td>@item.SupervisorBags.Values.Sum()</td>
                                <td>
                                    @if (item.RSTRequired)
                                    {
                                        if (item.IsRSTGenerated)
                                        {
                                            <span class="erp-badge bg-success-subtle text-success border border-success-subtle">RST Generated</span>
                                        }
                                        else
                                        {
                                            <span class="erp-badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pending Weighment</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="erp-badge bg-info-subtle text-info-emphasis border border-info-subtle">Direct Entry</span>
                                    }
                                </td>
                                @if (!isWeightman)
                                {
                                    <td class="text-center report-action"><a asp-controller="Gateman" asp-action="Print" asp-route-id="@item.InwardId" class="btn btn-sm btn-outline-secondary" target="_blank"><i class="bi bi-printer me-1"></i>Print</a></td>
                                }
                                @* <td class="text-muted">@item.GateManName</td> *@
                                @if (isWeightman)
                                {
                                    <td class="text-nowrap rst-action-cell report-action">
                                        @if (item.RSTRequired && !item.IsRSTGenerated)
                                        {
                                            <a asp-controller="GateEntry" asp-action="Create" asp-route-inwardId="@item.InwardId" class="btn btn-sm btn-primary fw-semibold">
                                                <i class="bi bi-speedometer2 me-1"></i> Take Gross Weight
                                            </a>
                                        }
                                        else if (isWeightman && item.RSTRequired && (item.RstStatus == "UnloadingAssigned" || item.RstStatus == "Unloaded" || item.RstStatus == "WaitingForTare") && !string.IsNullOrWhiteSpace(item.RSTNumber))
                                        {
                                            <div class="dropdown rst-action-dropdown">
                                                <button class="btn rst-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Action</button>
                                                <div class="dropdown-menu dropdown-menu-end rst-action-menu">
                                                    <a class="rst-action-item rst-new-action text-success" href="@Url.Action("Create", "GateEntry", new { inwardId = item.InwardId })"><i class="bi bi-plus-circle me-2"></i><strong>New RST</strong><small>Create another RST</small></a>
                                                    <a class="rst-action-item rst-end-action text-danger" href="@Url.Action("Outbound", "GateEntry", new { id = item.RSTNumber })"><i class="bi bi-x-circle me-2"></i><strong>End RST</strong><small>Close RST entry</small></a>
                                                </div>
                                            </div>
                                        }
                                        else if (item.RSTRequired)
                                        {
                                            <span class="erp-badge bg-info-subtle text-info-emphasis border border-info-subtle">@((item.RstStatusName ?? item.StatusName ?? "Pending").Replace("Gadi In", "Vehicle Inward"))</span>
                                        }
                                        else { <span class="erp-badge bg-secondary-subtle text-secondary">@((item.StatusName ?? "Pending").Replace("Gadi In", "Vehicle Inward"))</span> }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-3"><div class="card-body">
<h5>Supervisor Bag Totals</h5>
@foreach(var bagType in bagTypes) {
 <span class="d-inline-block me-4"><strong>@bagType:</strong> @reportEntries.Sum(e => e.SupervisorBags.GetValueOrDefault(bagType))</span>
}
<strong>Total Bags: @reportEntries.Sum(e => e.SupervisorBags.Values.Sum())</strong>
</div></div>
@section Scripts {
    <script>
        function submitGatemanWeightAction(rstNumber, actionType, inputId) {
            const gross = document.getElementById(inputId)?.value;
            if (!gross || Number(gross) <= 0) { alert('Enter a valid current gross weight.'); return; }
            document.getElementById('gatemanActionRst').value = rstNumber;
            document.getElementById('gatemanActionGross').value = gross;
            document.getElementById('gatemanActionType').value = actionType;
            document.getElementById('gatemanWeightmanActionForm').submit();
        }
    </script>
    <script>
        $(document).ready(function () {
            if ($('#erpReportTable').length && $.fn.DataTable) {
                $('#erpReportTable').DataTable({
                    responsive: false,
                    pageLength: 25,
                    lengthMenu: [[15, 25, 50, 100, -1], [15, 25, 50, 100, "All"]],
                    order: [[0, 'desc']],
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records..."
                    },
                    dom: "<'row mb-2'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 d-flex justify-content-end'f>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row mt-2'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7 d-flex justify-content-end'p>>"
                });
            }
        });

        let reportPrintLength;
        window.addEventListener('beforeprint', function () {
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#erpReportTable')) {
                const table = $('#erpReportTable').DataTable();
                reportPrintLength = table.page.len();
                table.page.len(-1).draw(false);
            }
        });
        window.addEventListener('afterprint', function () {
            if (reportPrintLength !== undefined) $('#erpReportTable').DataTable().page.len(reportPrintLength).draw(false);
        });
        // Simple CSV Export Function
        function exportTableToCSV(filename) {
            var csv = [];
            var rows = document.querySelectorAll("#erpReportTable tr");

            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td:not(.report-action), th:not(.report-action)");

                for (var j = 0; j < cols.length; j++)
                    row.push('"' + cols[j].innerText.replace(/"/g, '""') + '"');

                csv.push(row.join(","));
            }

            var csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
            var downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
