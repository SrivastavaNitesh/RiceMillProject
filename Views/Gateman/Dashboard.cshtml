@model IEnumerable<RiceMillProject.Models.InwardHeader>
@{
    ViewData["Title"] = "Gateman Dashboard";
    Layout = "_LayoutGateman";
    var statusJson = ViewBag.StatusChart as string ?? "{\"pending\":0,\"generated\":0,\"withoutRst\":0}";
    var dailyJson = ViewBag.DailyChart as string ?? "[]";
}
<div class="erp-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div class="erp-page-title-group"><div class="erp-page-icon bg-primary text-white rounded p-2"><i class="bi bi-speedometer2 fs-3"></i></div><div><h3 class="erp-page-title fw-bold text-dark mb-0">GATEMAN DASHBOARD</h3></div></div>
</div>
@if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger shadow-sm mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.ErrorMessage</div> }
<div class="row g-3 mb-4">
    <div class="col-xl-4 col-md-6"><div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-primary border-4" role="button" onclick="location.href='@Url.Action("Report", "Gateman")'"><div class="card-body p-3 d-flex align-items-center justify-content-between"><div><span class="text-uppercase text-muted fw-bold d-block" style="font-size:.75rem">TODAY'S INWARD ENTRIES</span><h2 class="fw-bold text-primary mb-0 mt-1">@(ViewBag.TodayCount ?? 0)</h2></div><div class="bg-primary-subtle text-primary rounded-circle p-3"><i class="bi bi-truck fs-3"></i></div></div></div></div>
    <div class="col-xl-4 col-md-6"><div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-warning border-4" role="button" onclick="location.href='@Url.Action("Report", "Gateman")'"><div class="card-body p-3 d-flex align-items-center justify-content-between"><div><span class="text-uppercase text-muted fw-bold d-block" style="font-size:.75rem">PENDING WEIGHMENT (WITH RST)</span><h2 class="fw-bold text-warning mb-0 mt-1">@(ViewBag.PendingRstCount ?? 0)</h2></div><div class="bg-warning-subtle text-warning rounded-circle p-3"><i class="bi bi-hourglass-split fs-3"></i></div></div></div></div>
    <div class="col-xl-4 col-md-6"><div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-success border-4" role="button" onclick="location.href='@Url.Action("Report", "Gateman")'"><div class="card-body p-3 d-flex align-items-center justify-content-between"><div><span class="text-uppercase text-muted fw-bold d-block" style="font-size:.75rem">MY TOTAL INWARD ENTRIES</span><h2 class="fw-bold text-success mb-0 mt-1">@(ViewBag.MyEntriesCount ?? 0)</h2></div><div class="bg-success-subtle text-success rounded-circle p-3"><i class="bi bi-person-badge fs-3"></i></div></div></div></div>
</div>
<div class="row g-3"><div class="col-lg-5"><div class="card border-0 shadow-sm rounded-3 h-100"><div class="card-header bg-white fw-bold"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Inward Status Distribution</div><div class="card-body"><div id="gatemanStatusPie" style="height:320px"></div></div></div></div><div class="col-lg-7"><div class="card border-0 shadow-sm rounded-3 h-100"><div class="card-header bg-white fw-bold"><i class="bi bi-graph-up text-success me-2"></i>Daily Inward Entries</div><div class="card-body"><div id="gatemanDailyLine" style="height:320px"></div></div></div></div></div>
@section Scripts { <script src="https://code.highcharts.com/highcharts.js"></script><script>
document.addEventListener('DOMContentLoaded',function(){const status=@Html.Raw(statusJson);const daily=@Html.Raw(dailyJson);
Highcharts.chart('gatemanStatusPie',{chart:{type:'pie',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},tooltip:{pointFormat:'<b>{point.y}</b> entries ({point.percentage:.1f}%)'},plotOptions:{pie:{innerSize:'55%',dataLabels:{enabled:true,style:{color:'#25324b'},format:'{point.name}: {point.y}'}}},series:[{name:'Entries',data:[{name:'Pending Weighment',y:Number(status.pending)||0,color:'#f0ad00'},{name:'RST Generated',y:Number(status.generated)||0,color:'#198754'},{name:'Without RST',y:Number(status.withoutRst)||0,color:'#0d6efd'}]}]});
Highcharts.chart('gatemanDailyLine',{chart:{type:'line',backgroundColor:'#fff'},title:{text:null},credits:{enabled:false},xAxis:{categories:daily.map(x=>x.date),title:{text:'Date',style:{color:'#25324b'}},labels:{style:{color:'#25324b'}}},yAxis:{allowDecimals:false,min:0,title:{text:'Inward entries',style:{color:'#25324b'}},labels:{style:{color:'#25324b'}}},tooltip:{valueSuffix:' entries'},series:[{name:'Inward Entries',color:'#0d6efd',data:daily.map(x=>Number(x.count)||0)}]});});
</script> }
