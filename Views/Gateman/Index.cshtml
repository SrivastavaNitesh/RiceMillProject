@model IEnumerable<RiceMillProject.Models.InwardHeader>
@{
    ViewData["Title"] = "Gateman Inward Entry";
    Layout = "_LayoutGateman";
    var newInward = ViewBag.NewInward as RiceMillProject.Models.InwardHeader ?? new RiceMillProject.Models.InwardHeader();
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

@try
{
<!-- Page Header -->
<div class="erp-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">GATEMAN INWARD ENTRY</h3>
            <p class="erp-page-subtitle">Register vehicle entry, supplier party, and inward type</p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="bg-white border rounded px-3 py-2 text-end shadow-sm">
            <small class="text-muted d-block fw-bold" style="font-size: 0.75rem;">LIVE SYSTEM DATE & TIME</small>
            <span class="fw-bold text-primary" id="headerLiveClock">@DateTime.Now.ToString("dd MMM yyyy - hh:mm tt")</span>
        </div>
    </div>
</div>

<div class="row">
    <!-- GATE ENTRY FORM (FULL WIDTH) -->
    <div class="col-12">
        <div class="erp-card shadow-sm border-0 mb-4">
            <div class="erp-card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pencil-square me-2"></i> Vehicle Inward Entry Form</span>
            </div>
            <div class="erp-card-body p-4">
                <form id="gatemanForm" asp-action="CreateGateEntry" method="post" class="row g-3" novalidate>
                    
                    <!-- Live Date & Time (Readonly / Non-editable) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-calendar-event me-1 text-primary"></i> Inward Date (Realtime)
                        </label>
                        <input type="text" class="form-control bg-light fw-bold text-dark" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-clock me-1 text-primary"></i> Inward Time (Realtime)
                        </label>
                        <input type="text" class="form-control bg-light fw-bold text-primary" id="formLiveClock" value="@DateTime.Now.ToString("hh:mm tt")" disabled readonly />
                    </div>

                    <!-- Inward Type Selection (Radio Buttons - Unchecked by Default) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Inward Type <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded border">
                            <div class="form-check me-2">
                                <input class="form-check-input" type="radio" name="InwardTypeId" id="inwardWithRST" value="1" required />
                                <label class="form-check-label fw-bold text-primary" for="inwardWithRST">
                                    <i class="bi bi-card-checklist me-1"></i> With RST
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="InwardTypeId" id="inwardWithoutRST" value="2" required />
                                <label class="form-check-label fw-bold text-secondary" for="inwardWithoutRST">
                                    <i class="bi bi-box-seam me-1"></i> Without RST
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Party / Supplier Person Dropdown -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Party / Supplier <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                        <select name="PartyId" id="txtPartyName" class="form-select border-primary-subtle" asp-items="@(ViewBag.Parties as SelectList)" required>
                            <option value="">Select Party / Supplier</option>
                        </select>
                        </div>
                        <input type="hidden" name="PartyName" id="selectedPartyName" />
                    </div>

                    <!-- Vehicle Number Dropdown -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Vehicle Number <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                        <select name="VehicleNo" id="txtVehicleNo" class="form-select border-primary-subtle" required>
                            <option value="">Select Vehicle</option>
                            @if(ViewBag.Vehicles != null)
                            {
                                foreach(var item in (IEnumerable<SelectListItem>)ViewBag.Vehicles)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        </div>
                    </div>

                    <!-- Driver Name -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Driver Name <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                        <select name="DriverName" id="txtDriverName" class="form-select" required>
                            <option value="">Select Driver</option>
                            @if(ViewBag.Drivers != null)
                            {
                                foreach(var item in (IEnumerable<SelectListItem>)ViewBag.Drivers)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        </div>
                    </div>
                    <input type="hidden" name="DriverMobile" id="txtDriverMobile" />

                    <!-- Added By (Gateman Selector for Admin / Readonly for Gateman) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-person-badge me-1 text-primary"></i> Gateman (Added By) <span class="text-danger">*</span>
                        </label>
                        @if (isAdmin)
                        {
                            <select name="CreatedBy" id="ddlGateman" asp-items="@(ViewBag.Gatemen as SelectList)" class="form-select border-primary-subtle" required>
                                <option value="">Select Gateman User</option>
                            </select>
                        }
                        else
                        {
                            <input type="text" class="form-control bg-light fw-bold text-dark" value="@(User?.Identity?.Name ?? "Gateman") (Logged In Gateman)" disabled readonly />
                            <input type="hidden" name="CreatedBy" value="@newInward.CreatedBy" />
                        }
                    </div>

                    <!-- Remarks (Optional) -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted">Remarks / Material Purpose (Optional)</label>
                        <input type="text" name="PurposeRemarks" class="form-control" placeholder="Remarks" />
                    </div>

                    <!-- Form Action Buttons -->
                    <div class="col-12 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> SAVE ENTRY
                        </button>
                        <button type="reset" class="btn btn-outline-secondary px-4 py-2">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> RESET
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


}
catch (Exception ex)
{
    <div class="alert alert-danger mt-4">
        <h4>View Render Error</h4>
        <pre>@ex.ToString()</pre>
    </div>
}

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .input-group > .select2-container { flex: 1 1 auto; width: 1% !important; }
    .select2-container .select2-selection--single { height: 39px; border: 1px solid #dee2e6; }
    .select2-container .select2-selection--single .select2-selection__rendered { line-height: 37px; padding-left: 12px; }
    .select2-container .select2-selection--single .select2-selection__arrow { height: 37px; }
    .select2-container--open { z-index: 1060; }
</style>

<script>
    function updateLiveClocks() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
        const dateString = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        
        const headerClock = document.getElementById('headerLiveClock');
        if (headerClock) {
            headerClock.innerText = dateString + ' - ' + timeString;
        }
        const formClock = document.getElementById('formLiveClock');
        if (formClock) {
            formClock.value = timeString;
        }
    }
    setInterval(updateLiveClocks, 1000);
    updateLiveClocks();

    // SweetAlert2 Notifications on Page Load
    document.addEventListener('DOMContentLoaded', function () {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                icon: 'success',
                confirmButtonText: 'OK',
                confirmButtonColor: '#0d6efd'
            });
            </text>
        }
        @if (TempData["ErrorMessage"] != null || ViewBag.ErrorMessage != null)
        {
            <text>
            Swal.fire({
                title: 'Error!',
                text: '@(TempData["ErrorMessage"] ?? ViewBag.ErrorMessage)',
                icon: 'error',
                confirmButtonText: 'Close',
                confirmButtonColor: '#dc3545'
            });
            </text>
        }

        const txtDriverName = document.getElementById('txtDriverName');
        const txtParty = document.getElementById('txtPartyName');
        const txtVehicle = document.getElementById('txtVehicleNo');
        const txtDriverMobile = document.getElementById('txtDriverMobile');

        function refreshSearchableSelect(select) {
            if (select && window.jQuery && $.fn.select2) $(select).trigger('change.select2');
        }

        function makeSearchableSelect(select, placeholder, entityType) {
            if (!select || !window.jQuery || !$.fn.select2) return;
            $(select).select2({
                width: '100%',
                placeholder: placeholder,
                allowClear: true,
                minimumResultsForSearch: 0,
                dropdownParent: $(select).closest('.erp-card'),
                tags: true,
                selectOnClose: true,
                createTag: params => {
                    const term = (params.term || '').trim();
                    if (!term) return null;
                    const exists = Array.from(select.options).some(option =>
                        option.text.trim().toLocaleLowerCase() === term.toLocaleLowerCase() ||
                        option.value.trim().toLocaleLowerCase() === term.toLocaleLowerCase());
                    return exists ? null : { id: `__new__:${term}`, text: term, newTag: true };
                }
            });
            select.dataset.searchReady = 'true';
            $(select).on('select2:select', async event => {
                const data = event.params.data;
                if (data.newTag || String(data.id).startsWith('__new__:')) {
                    await confirmQuickCreate(select, entityType, data.text.trim(), data.element);
                    return;
                }
                select.dispatchEvent(new Event('change'));
            });
            $(select).on('select2:clear', () => {
                setTimeout(() => {
                    select.value = '';
                    select.dispatchEvent(new Event('change'));
                    refreshSearchableSelect(select);
                }, 0);
            });
        }

        const antiForgeryToken = () => document.querySelector('#gatemanForm input[name="__RequestVerificationToken"]')?.value || '';
        const postQuickAdd = async (url, values) => {
            values.append('__RequestVerificationToken', antiForgeryToken());
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: values.toString()
            });
            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.message || 'Record could not be saved.');
            return result;
        };
        const removeNewOption = (select, option) => {
            if (option?.value?.startsWith('__new__:')) option.remove();
            select.value = '';
            refreshSearchableSelect(select);
        };
        const selectSavedOption = (select, value, text, attributes = {}) => {
            Array.from(select.options).filter(option => option.value === String(value)).forEach(option => option.remove());
            const option = new Option(text, value, true, true);
            Object.entries(attributes).forEach(([key, item]) => option.dataset[key] = item || '');
            select.add(option);
            select.value = String(value);
            refreshSearchableSelect(select);
        };
        async function confirmQuickCreate(select, entityType, typedText, temporaryOption) {
            const label = entityType === 'party' ? 'Party / Supplier' : entityType === 'vehicle' ? 'Vehicle' : 'Driver';
            const partyId = Number(txtParty.value);
            let vehicleId = Number(txtVehicle.selectedOptions[0]?.dataset.vehicleId || 0);
            const requiresMobile = entityType === 'party';
            const escapedText = typedText.replace(/[&<>'"]/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]));
            if (entityType === 'vehicle' && !isValidIndianVehicleNumber(typedText)) {
                removeNewOption(select, temporaryOption);
                await Swal.fire({ icon: 'warning', title: 'Invalid Vehicle Number', text: 'Valid format enter karein, jaise UP63AT3088, DL1CAF5032 ya 22BH1234AA.' });
                return;
            }
            const confirmation = await Swal.fire({
                icon: 'question',
                title: `Add New ${label}?`,
                html: requiresMobile
                    ? `<div class="text-start"><strong>${escapedText}</strong> list mein nahi hai.<div class="mt-3"><label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label><input id="quickPartyMobile" class="swal2-input m-0 w-100" inputmode="numeric" maxlength="10" placeholder="10-digit Indian mobile number" /></div><div class="mt-3"><label class="form-label fw-semibold">Party Type <span class="text-danger">*</span></label><select id="quickPartyCategory" class="swal2-select m-0 w-100"><option value="">Select Party Type</option><option value="1">Direct Party</option><option value="2">Center Party</option></select></div></div>`
                    : `<div class="text-start"><strong>${escapedText}</strong> list mein nahi hai.<br/>Kya aap ise add karna chahte hain?</div>`,
                showCancelButton: true,
                confirmButtonText: `Yes, Add ${label}`,
                cancelButtonText: 'No',
                confirmButtonColor: '#07877c',
                preConfirm: requiresMobile ? () => {
                    const mobileNumber = document.getElementById('quickPartyMobile')?.value.trim() || '';
                    const partyCategory = Number(document.getElementById('quickPartyCategory')?.value || 0);
                    if (!/^[6-9][0-9]{9}$/.test(mobileNumber)) {
                        Swal.showValidationMessage('Enter a valid 10-digit Indian mobile number starting with 6, 7, 8 or 9.');
                        return false;
                    }
                    if (![1, 2].includes(partyCategory)) {
                        Swal.showValidationMessage('Select Direct Party or Center Party.');
                        return false;
                    }
                    return { mobileNumber, partyCategory };
                } : undefined
            });
            if (!confirmation.isConfirmed) { removeNewOption(select, temporaryOption); return; }
            try {
                if (entityType === 'party') {
                    const values = new URLSearchParams({
                        partyName: typedText,
                        mobileNumber: confirmation.value?.mobileNumber || '',
                        partyCategory: String(confirmation.value?.partyCategory || 0)
                    });
                    const result = await postQuickAdd('/Gateman/QuickAddParty', values);
                    const text = result.mobileNumber ? `${result.partyName} / ${result.mobileNumber}` : result.partyName;
                    temporaryOption?.remove();
                    selectSavedOption(txtParty, result.partyId, text);
                    txtParty.dispatchEvent(new Event('change'));
                } else if (entityType === 'vehicle') {
                    const values = new URLSearchParams({ partyId: String(partyId), vehicleNumber: typedText });
                    const result = await postQuickAdd('/Gateman/QuickAddVehicle', values);
                    temporaryOption?.remove();
                    selectSavedOption(txtVehicle, result.vehicleNumber, result.vehicleNumber, { vehicleId: String(result.vehicleId) });
                    txtVehicle.dispatchEvent(new Event('change'));
                } else {
                    const values = new URLSearchParams({ partyId: String(partyId), vehicleId: String(vehicleId), vehicleNumber: txtVehicle.value, driverName: typedText, mobileNumber: '' });
                    const result = await postQuickAdd('/Gateman/QuickAddDriver', values);
                    temporaryOption?.remove();
                    selectSavedOption(txtDriverName, result.driverName, result.driverNameMobile, { mobile: result.mobileNumber || '' });
                    txtDriverMobile.value = result.mobileNumber || '';
                    if (partyId > 0 && vehicleId > 0) {
                        document.getElementById('gatemanForm').dispatchEvent(new CustomEvent('gateman:mapping-added'));
                    } else {
                        txtDriverName.dispatchEvent(new Event('change'));
                    }
                }
                await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: `${label} added successfully`, showConfirmButton: false, timer: 2200 });
            } catch (error) {
                removeNewOption(select, temporaryOption);
                await Swal.fire({ icon: 'error', title: `${label} could not be added`, text: error.message });
            }
        }

        makeSearchableSelect(txtParty, 'Search or type new party', 'party');
        makeSearchableSelect(txtVehicle, 'Search or type new vehicle', 'vehicle');
        makeSearchableSelect(txtDriverName, 'Search or type new driver', 'driver');

        // Form Validation & SweetAlert Popup on Submit
        const form = document.getElementById('gatemanForm');
        const normalizeVehicleNumber = value => (value || '').toUpperCase().replace(/[\s-]+/g, '');
        const isValidIndianVehicleNumber = value => /^(?:[A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{1,4}|[0-9]{2}BH[0-9]{4}[A-Z]{1,2})$/.test(normalizeVehicleNumber(value));
        if (form) {
            form.addEventListener('submit', function (e) {
                const isTypeSelected = document.querySelector('input[name="InwardTypeId"]:checked');
                const partySelect = document.getElementById('txtPartyName');
                const partyId = partySelect?.value.trim();
                const partyLabel = partyId ? partySelect.options[partySelect.selectedIndex].text.trim() : '';
                const partyName = partyLabel.replace(/\s*\/\s*\d+\s*$/, '').trim();
                document.getElementById('selectedPartyName').value = partyName;
                const vehicleNo = document.getElementById('txtVehicleNo')?.value.trim();
                const driverName = document.getElementById('txtDriverName')?.value.trim();
                const gatemanDdl = document.getElementById('ddlGateman');

                let missingFields = [];

                if (!isTypeSelected) missingFields.push('Inward Type (With RST / Without RST)');
                if (!partyId) missingFields.push('Party / Supplier Name');
                if (!vehicleNo) missingFields.push('Vehicle Number');
                if (!driverName) missingFields.push('Driver Name');
                if (gatemanDdl && !gatemanDdl.value) missingFields.push('Gateman (Added By)');

                if (missingFields.length > 0) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Validation Error!',
                        html: '<div class="text-start"><strong>Kripya sabhi zaroori fields ko fill karein:</strong><ul class="mt-2 text-danger">' + 
                              missingFields.map(f => '<li>' + f + '</li>').join('') + 
                              '</ul><small class="text-muted">(Only Remarks is optional)</small></div>',
                        icon: 'warning',
                        confirmButtonText: 'Okay, I will fill them',
                        confirmButtonColor: '#0d6efd'
                    });
                    return false;
                }
                if (!isValidIndianVehicleNumber(vehicleNo)) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Invalid Vehicle Number',
                        text: 'Valid Indian vehicle number enter karein, jaise UP63AT3088, DL1CAF5032 ya 22BH1234AA.',
                        icon: 'warning',
                        confirmButtonColor: '#07877c'
                    });
                    return false;
                }
            });
        }
    });
</script>



<script src="~/js/gateman-linked-selection.js" asp-append-version="true" defer></script>
