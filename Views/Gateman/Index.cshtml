@model IEnumerable<RiceMillProject.Models.InwardHeader>
@{
    ViewData["Title"] = "Gateman Inward Entry";
    Layout = "_LayoutGateman";
    var newInward = ViewBag.NewInward as RiceMillProject.Models.InwardHeader ?? new RiceMillProject.Models.InwardHeader();
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
    var centerContactsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.CenterContacts ?? Array.Empty<object>());
}

@try
{
<!-- Page Header -->
<div class="erp-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>
        <div>
            <h3 class="erp-page-title">GATEMAN INWARD ENTRY</h3>
            <p class="erp-page-subtitle">Register vehicle entry, supplier party, and inward type</p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="bg-white border rounded px-3 py-2 text-end shadow-sm">
            <small class="text-muted d-block fw-bold" style="font-size: 0.75rem;">LIVE SYSTEM DATE & TIME</small>
            <span class="fw-bold text-primary" id="headerLiveClock">@DateTime.Now.ToString("dd MMM yyyy - hh:mm tt")</span>
        </div>
    </div>
</div>

<div class="row">
    <!-- GATE ENTRY FORM (FULL WIDTH) -->
    <div class="col-12">
        <div class="erp-card shadow-sm border-0 mb-4">
            <div class="erp-card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-pencil-square me-2"></i> Vehicle Inward Entry Form</span>
            </div>
            <div class="erp-card-body p-4">
                <form id="gatemanForm" asp-action="CreateGateEntry" method="post" class="row g-3" novalidate>
                    
                    <!-- Live Date & Time (Readonly / Non-editable) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-calendar-event me-1 text-primary"></i> Inward Date (Realtime)
                        </label>
                        <input type="text" class="form-control bg-light fw-bold text-dark" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-clock me-1 text-primary"></i> Inward Time (Realtime)
                        </label>
                        <input type="text" class="form-control bg-light fw-bold text-primary" id="formLiveClock" value="@DateTime.Now.ToString("hh:mm tt")" disabled readonly />
                    </div>

                    <div class="col-lg-6">
                        <div class="entry-choice-group">
                            <div class="entry-choice-heading"><i class="bi bi-arrow-down-square"></i> Inward Type <span class="text-danger">*</span></div>
                            <div class="entry-choice-options">
                                <input class="entry-choice-input" type="radio" name="InwardTypeId" id="inwardWithRST" value="1" required />
                                <label class="entry-choice-card" for="inwardWithRST">
                                    <span class="entry-choice-icon"><i class="bi bi-card-checklist"></i></span>
                                    <span><strong>With RST</strong><small>Weighment required</small></span>
                                    <i class="bi bi-check-circle-fill entry-choice-check"></i>
                                </label>
                                <input class="entry-choice-input" type="radio" name="InwardTypeId" id="inwardWithoutRST" value="2" required />
                                <label class="entry-choice-card" for="inwardWithoutRST">
                                    <span class="entry-choice-icon"><i class="bi bi-box-seam"></i></span>
                                    <span><strong>Without RST</strong><small>Direct gate record</small></span>
                                    <i class="bi bi-check-circle-fill entry-choice-check"></i>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="entry-choice-group">
                            <div class="entry-choice-heading"><i class="bi bi-people"></i> Party Source <span class="text-danger">*</span></div>
                            <div class="entry-choice-options">
                                <input class="entry-choice-input" type="radio" name="PartyCategory" id="partyTypeDirect" value="1" checked required />
                                <label class="entry-choice-card" for="partyTypeDirect">
                                    <span class="entry-choice-icon"><i class="bi bi-person-check"></i></span>
                                    <span><strong>Direct Party</strong><small>Person / supplier</small></span>
                                    <i class="bi bi-check-circle-fill entry-choice-check"></i>
                                </label>
                                <input class="entry-choice-input" type="radio" name="PartyCategory" id="partyTypeCenter" value="2" required />
                                <label class="entry-choice-card" for="partyTypeCenter">
                                    <span class="entry-choice-icon"><i class="bi bi-buildings"></i></span>
                                    <span><strong>Center / Farm</strong><small>Farm-based inward</small></span>
                                    <i class="bi bi-check-circle-fill entry-choice-check"></i>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Direct Party Person Dropdown -->
                    <div class="col-md-6" id="directPartySection">
                        <label class="form-label fw-bold text-dark">
                            Direct Party / Supplier <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                        <select name="PartyId" id="txtPartyName" class="form-select border-primary-subtle" asp-items="@(ViewBag.Parties as SelectList)" required>
                            <option value="">Select Party / Supplier</option>
                        </select>
                        </div>
                        <input type="hidden" name="PartyName" id="selectedPartyName" />
                    </div>

                    <div class="col-md-6 d-none" id="centerFarmSection">
                        <label class="form-label fw-bold text-dark">Center / Farm <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <select name="FarmId" id="txtFarmName" class="form-select border-primary-subtle">
                                <option value="">Select Center / Farm</option>
                                @if (ViewBag.CenterFarms != null)
                                {
                                    foreach (var farm in ViewBag.CenterFarms)
                                    {
                                        <option value="@farm.FarmId" data-party-id="@farm.PartyId" data-person-name="@farm.PersonName" data-mobile="@farm.MobileNumber">@farm.FarmName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-text">Farm select karein ya naya farm name type karein.</div>
                    </div>

                    <!-- Vehicle Number Dropdown -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Vehicle Number <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                        <select name="VehicleNo" id="txtVehicleNo" class="form-select border-primary-subtle" required>
                            <option value="">Select Vehicle</option>
                            @if(ViewBag.Vehicles != null)
                            {
                                foreach(var item in (IEnumerable<SelectListItem>)ViewBag.Vehicles)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        </div>
                    </div>

                    <!-- Driver Name -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Driver Name <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                        <select name="DriverName" id="txtDriverName" class="form-select" required>
                            <option value="">Select Driver</option>
                            @if(ViewBag.Drivers != null)
                            {
                                foreach(var item in (IEnumerable<SelectListItem>)ViewBag.Drivers)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        </div>
                    </div>
                    <input type="hidden" name="DriverMobile" id="txtDriverMobile" />

                    <!-- Added By (Gateman Selector for Admin / Readonly for Gateman) -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            <i class="bi bi-person-badge me-1 text-primary"></i> Gateman (Added By) <span class="text-danger">*</span>
                        </label>
                        @if (isAdmin)
                        {
                            <select name="CreatedBy" id="ddlGateman" asp-items="@(ViewBag.Gatemen as SelectList)" class="form-select border-primary-subtle" required>
                                <option value="">Select Gateman User</option>
                            </select>
                        }
                        else
                        {
                            <input type="text" class="form-control bg-light fw-bold text-dark" value="@(User?.Identity?.Name ?? "Gateman") (Logged In Gateman)" disabled readonly />
                            <input type="hidden" name="CreatedBy" value="@newInward.CreatedBy" />
                        }
                    </div>

                    <!-- Remarks (Optional) -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-muted">Remarks / Material Purpose (Optional)</label>
                        <input type="text" name="PurposeRemarks" class="form-control" placeholder="Remarks" />
                    </div>

                    <!-- Form Action Buttons -->
                    <div class="col-12 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> SAVE ENTRY
                        </button>
                        <button type="reset" class="btn btn-outline-secondary px-4 py-2">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> RESET
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


}
catch (Exception ex)
{
    <div class="alert alert-danger mt-4">
        <h4>View Render Error</h4>
        <pre>@ex.ToString()</pre>
    </div>
}

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .entry-choice-group { height:100%; padding:14px; border:1px solid #dbe6e5; border-radius:12px; background:#fbfdfd; }
    .entry-choice-heading { display:flex; align-items:center; gap:8px; margin-bottom:10px; color:#243b53; font-size:.78rem; font-weight:800; text-transform:uppercase; letter-spacing:.035em; }
    .entry-choice-heading > i { color:#07877c; font-size:1rem; }
    .entry-choice-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .entry-choice-input { position:absolute; opacity:0; pointer-events:none; }
    .entry-choice-card { position:relative; display:flex; align-items:center; gap:10px; min-height:60px; margin:0; padding:10px 34px 10px 11px; border:1px solid #d6e1e0; border-radius:10px; background:#fff; cursor:pointer; transition:.18s ease; }
    .entry-choice-card:hover { border-color:#80bdb7; background:#f5fbfa; transform:translateY(-1px); }
    .entry-choice-icon { width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; flex:0 0 34px; border-radius:9px; color:#087f78; background:#e8f6f4; font-size:1rem; }
    .entry-choice-card strong,.entry-choice-card small { display:block; }
    .entry-choice-card strong { color:#183b56; font-size:.83rem; line-height:1.2; }
    .entry-choice-card small { margin-top:3px; color:#7b8d9b; font-size:.67rem; font-weight:500; }
    .entry-choice-check { position:absolute; right:11px; color:#aab9b8; font-size:.9rem; }
    .entry-choice-input:checked + .entry-choice-card { border-color:#07877c; background:#edf9f7; box-shadow:0 0 0 2px rgba(7,135,124,.08); }
    .entry-choice-input:checked + .entry-choice-card .entry-choice-icon { color:#fff; background:#07877c; }
    .entry-choice-input:checked + .entry-choice-card .entry-choice-check { color:#07877c; }
    .input-group > .select2-container { flex: 1 1 auto; width: 1% !important; }
    .select2-container .select2-selection--single { height: 39px; border: 1px solid #dee2e6; }
    .select2-container .select2-selection--single .select2-selection__rendered { line-height: 37px; padding-left: 12px; }
    .select2-container .select2-selection--single .select2-selection__arrow { height: 37px; }
    .select2-container--open { z-index: 1060; }
    @@media (max-width:575.98px) { .entry-choice-options { grid-template-columns:1fr; } }
</style>

<script>
    function updateLiveClocks() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
        const dateString = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        
        const headerClock = document.getElementById('headerLiveClock');
        if (headerClock) {
            headerClock.innerText = dateString + ' - ' + timeString;
        }
        const formClock = document.getElementById('formLiveClock');
        if (formClock) {
            formClock.value = timeString;
        }
    }
    setInterval(updateLiveClocks, 1000);
    updateLiveClocks();

    // SweetAlert2 Notifications on Page Load
    document.addEventListener('DOMContentLoaded', function () {
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            Swal.fire({
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                icon: 'success',
                confirmButtonText: 'OK',
                confirmButtonColor: '#0d6efd'
            });
            </text>
        }
        @if (TempData["ErrorMessage"] != null || ViewBag.ErrorMessage != null)
        {
            <text>
            Swal.fire({
                title: 'Error!',
                text: '@(TempData["ErrorMessage"] ?? ViewBag.ErrorMessage)',
                icon: 'error',
                confirmButtonText: 'Close',
                confirmButtonColor: '#dc3545'
            });
            </text>
        }

        const txtDriverName = document.getElementById('txtDriverName');
        const txtParty = document.getElementById('txtPartyName');
        const txtFarm = document.getElementById('txtFarmName');
        const txtVehicle = document.getElementById('txtVehicleNo');
        const txtDriverMobile = document.getElementById('txtDriverMobile');
        const centerContacts = @Html.Raw(centerContactsJson);

        function refreshSearchableSelect(select) {
            if (select && window.jQuery && $.fn.select2) $(select).trigger('change.select2');
        }

        function makeSearchableSelect(select, placeholder, entityType) {
            if (!select || !window.jQuery || !$.fn.select2) return;
            $(select).select2({
                width: '100%',
                placeholder: placeholder,
                allowClear: true,
                minimumResultsForSearch: 0,
                dropdownParent: $(select).closest('.erp-card'),
                tags: true,
                selectOnClose: true,
                createTag: params => {
                    const term = (params.term || '').trim();
                    if (!term) return null;
                    const exists = Array.from(select.options).some(option =>
                        option.text.trim().toLocaleLowerCase() === term.toLocaleLowerCase() ||
                        option.value.trim().toLocaleLowerCase() === term.toLocaleLowerCase());
                    return exists ? null : { id: `__new__:${term}`, text: term, newTag: true };
                }
            });
            select.dataset.searchReady = 'true';
            $(select).on('select2:select', async event => {
                const data = event.params.data;
                if (data.newTag || String(data.id).startsWith('__new__:')) {
                    await confirmQuickCreate(select, entityType, data.text.trim(), data.element);
                    return;
                }
                select.dispatchEvent(new Event('change'));
            });
            $(select).on('select2:clear', () => {
                setTimeout(() => {
                    select.value = '';
                    select.dispatchEvent(new Event('change'));
                    refreshSearchableSelect(select);
                }, 0);
            });
        }

        const antiForgeryToken = () => document.querySelector('#gatemanForm input[name="__RequestVerificationToken"]')?.value || '';
        const postQuickAdd = async (url, values) => {
            values.append('__RequestVerificationToken', antiForgeryToken());
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: values.toString()
            });
            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.message || 'Record could not be saved.');
            return result;
        };
        const removeNewOption = (select, option) => {
            if (option?.value?.startsWith('__new__:')) option.remove();
            select.value = '';
            refreshSearchableSelect(select);
        };
        const selectSavedOption = (select, value, text, attributes = {}) => {
            Array.from(select.options).filter(option => option.value === String(value)).forEach(option => option.remove());
            const option = new Option(text, value, true, true);
            Object.entries(attributes).forEach(([key, item]) => option.dataset[key] = item || '');
            select.add(option);
            select.value = String(value);
            refreshSearchableSelect(select);
        };
        async function confirmQuickCreate(select, entityType, typedText, temporaryOption) {
            const label = entityType === 'party' ? 'Direct Party / Supplier' : entityType === 'farm' ? 'Center / Farm' : entityType === 'vehicle' ? 'Vehicle' : 'Driver';
            const partyId = Number(txtParty.value);
            let vehicleId = Number(txtVehicle.selectedOptions[0]?.dataset.vehicleId || 0);
            const requiresMobile = entityType === 'party';
            const escapedText = typedText.replace(/[&<>'"]/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]));
            if (entityType === 'vehicle' && !isValidIndianVehicleNumber(typedText)) {
                removeNewOption(select, temporaryOption);
                await Swal.fire({ icon: 'warning', title: 'Invalid Vehicle Number', text: 'Valid format enter karein, jaise UP63AT3088, DL1CAF5032 ya 22BH1234AA.' });
                return;
            }
            const confirmation = await Swal.fire({
                icon: 'question',
                title: `Add New ${label}?`,
                html: entityType === 'farm'
                    ? `<div class="text-start"><strong>${escapedText}</strong> farm list mein nahi hai.
                        <div class="mt-3"><label class="form-label fw-semibold">Contact Person <span class="text-danger">*</span></label>
                        <select id="quickFarmPerson" class="form-select w-100"><option value="">Search or type contact person</option>${centerContacts.map(person => `<option value="${person.PersonId}" data-name="${String(person.PersonName || '').replace(/"/g, '&quot;')}" data-mobile="${String(person.MobileNumber || '').replace(/"/g, '&quot;')}">${String(person.PersonName || '')}${person.MobileNumber ? ` / ${person.MobileNumber}` : ''}</option>`).join('')}</select>
                        <small class="text-muted">Existing person select karein ya naya naam type karein.</small></div>
                        <div class="mt-3"><label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label><input id="quickFarmMobile" class="swal2-input m-0 w-100" inputmode="numeric" maxlength="10" placeholder="10-digit Indian mobile number" /></div>
                        <div id="quickFarmShareSection" class="form-check mt-3 d-none"><input id="quickFarmShare" class="form-check-input" type="checkbox"><label class="form-check-label fw-semibold" for="quickFarmShare">Existing person ko is Center / Farm ke saath share karein</label><small class="d-block text-muted">Ek contact person multiple farms ke saath map ho sakta hai.</small></div></div>`
                    : requiresMobile
                    ? `<div class="text-start"><strong>${escapedText}</strong> list mein nahi hai.<div class="mt-3"><label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label><input id="quickPartyMobile" class="swal2-input m-0 w-100" inputmode="numeric" maxlength="10" placeholder="10-digit Indian mobile number" /></div></div>`
                    : `<div class="text-start"><strong>${escapedText}</strong> list mein nahi hai.<br/>Kya aap ise add karna chahte hain?</div>`,
                showCancelButton: true,
                allowOutsideClick: false,
                confirmButtonText: `Yes, Add ${label}`,
                cancelButtonText: 'No',
                confirmButtonColor: '#07877c',
                didOpen: entityType === 'farm' ? () => {
                    const personSelect = document.getElementById('quickFarmPerson');
                    const mobileInput = document.getElementById('quickFarmMobile');
                    const shareSection = document.getElementById('quickFarmShareSection');
                    if (!personSelect || !window.jQuery || !$.fn.select2) return;
                    $(personSelect).select2({
                        dropdownParent: $('.swal2-popup'), width: '100%', tags: true,
                        placeholder: 'Search or type contact person', minimumResultsForSearch: 0,
                        createTag: params => {
                            const term = (params.term || '').trim();
                            if (term.length < 2) return null;
                            const exists = Array.from(personSelect.options).some(option => (option.dataset.name || option.text).trim().toLocaleLowerCase() === term.toLocaleLowerCase());
                            return exists ? null : { id: `__new__:${term}`, text: term, newTag: true };
                        }
                    }).on('select2:select', event => {
                        const selected = event.params.data;
                        const isNew = selected.newTag || String(selected.id).startsWith('__new__:');
                        const option = selected.element;
                        mobileInput.value = isNew ? '' : (option?.dataset.mobile || '');
                        mobileInput.readOnly = !isNew;
                        shareSection?.classList.toggle('d-none', isNew);
                        const checkbox = document.getElementById('quickFarmShare');
                        if (checkbox) checkbox.checked = false;
                    });
                } : undefined,
                preConfirm: entityType === 'farm' ? () => {
                    const personSelect = document.getElementById('quickFarmPerson');
                    const selectedValue = personSelect?.value || '';
                    const selectedOption = personSelect?.selectedOptions?.[0];
                    const isNew = selectedValue.startsWith('__new__:');
                    const personId = isNew ? 0 : Number(selectedValue || 0);
                    const personName = isNew ? selectedValue.substring(8).trim() : (selectedOption?.dataset.name || selectedOption?.text || '').trim();
                    const mobileNumber = document.getElementById('quickFarmMobile')?.value.trim() || '';
                    const sharePerson = document.getElementById('quickFarmShare')?.checked || false;
                    if (personName.length < 2) { Swal.showValidationMessage('Contact person name is required.'); return false; }
                    if (!/^[6-9][0-9]{9}$/.test(mobileNumber)) { Swal.showValidationMessage('Enter a valid 10-digit Indian mobile number.'); return false; }
                    if (personId > 0 && !sharePerson) { Swal.showValidationMessage('Existing person ko share karne ke liye checkbox select karein.'); return false; }
                    return { personId, personName, mobileNumber, sharePerson };
                } : requiresMobile ? () => {
                    const mobileNumber = document.getElementById('quickPartyMobile')?.value.trim() || '';
                    if (!/^[6-9][0-9]{9}$/.test(mobileNumber)) {
                        Swal.showValidationMessage('Enter a valid 10-digit Indian mobile number starting with 6, 7, 8 or 9.');
                        return false;
                    }
                    return { mobileNumber };
                } : undefined
            });
            if (!confirmation.isConfirmed) { removeNewOption(select, temporaryOption); return; }
            try {
                if (entityType === 'party') {
                    const values = new URLSearchParams({
                        partyName: typedText,
                        mobileNumber: confirmation.value?.mobileNumber || '',
                        partyCategory: '1'
                    });
                    const result = await postQuickAdd('/Gateman/QuickAddParty', values);
                    const text = result.mobileNumber ? `${result.partyName} / ${result.mobileNumber}` : result.partyName;
                    temporaryOption?.remove();
                    selectSavedOption(txtParty, result.partyId, text);
                    txtParty.dispatchEvent(new Event('change'));
                } else if (entityType === 'farm') {
                    const values = new URLSearchParams({ farmName: typedText, personId: String(confirmation.value?.personId || 0), personName: confirmation.value?.personName || '', mobileNumber: confirmation.value?.mobileNumber || '', sharePerson: String(confirmation.value?.sharePerson || false) });
                    const result = await postQuickAdd('/Gateman/QuickAddCenterFarm', values);
                    temporaryOption?.remove();
                    selectSavedOption(txtFarm, result.farmId, result.farmName, { partyId: String(result.partyId), personName: result.partyName, mobile: result.mobileNumber });
                    txtFarm.dispatchEvent(new Event('change'));
                } else if (entityType === 'vehicle') {
                    const values = new URLSearchParams({ partyId: String(partyId), vehicleNumber: typedText });
                    const result = await postQuickAdd('/Gateman/QuickAddVehicle', values);
                    temporaryOption?.remove();
                    selectSavedOption(txtVehicle, result.vehicleNumber, result.vehicleNumber, { vehicleId: String(result.vehicleId) });
                    txtVehicle.dispatchEvent(new Event('change'));
                } else {
                    const values = new URLSearchParams({ partyId: String(partyId), vehicleId: String(vehicleId), vehicleNumber: txtVehicle.value, driverName: typedText, mobileNumber: '' });
                    const result = await postQuickAdd('/Gateman/QuickAddDriver', values);
                    temporaryOption?.remove();
                    selectSavedOption(txtDriverName, result.driverName, result.driverNameMobile, { mobile: result.mobileNumber || '' });
                    txtDriverMobile.value = result.mobileNumber || '';
                    if (partyId > 0 && vehicleId > 0) {
                        document.getElementById('gatemanForm').dispatchEvent(new CustomEvent('gateman:mapping-added'));
                    } else {
                        txtDriverName.dispatchEvent(new Event('change'));
                    }
                }
                await Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: `${label} added successfully`, showConfirmButton: false, timer: 2200 });
            } catch (error) {
                removeNewOption(select, temporaryOption);
                await Swal.fire({ icon: 'error', title: `${label} could not be added`, text: error.message });
            }
        }

        makeSearchableSelect(txtParty, 'Search or type new party', 'party');
        makeSearchableSelect(txtFarm, 'Search or type new farm', 'farm');
        makeSearchableSelect(txtVehicle, 'Search or type new vehicle', 'vehicle');
        makeSearchableSelect(txtDriverName, 'Search or type new driver', 'driver');

        const directPartySection = document.getElementById('directPartySection');
        const centerFarmSection = document.getElementById('centerFarmSection');
        function applyPartyType() {
            const isCenter = document.querySelector('input[name="PartyCategory"]:checked')?.value === '2';
            directPartySection?.classList.toggle('d-none', isCenter);
            centerFarmSection?.classList.toggle('d-none', !isCenter);
            txtParty.disabled = isCenter;
            txtFarm.disabled = !isCenter;
            txtParty.required = !isCenter;
            txtFarm.required = isCenter;
            if (isCenter) {
                const option = txtFarm.selectedOptions[0];
                document.getElementById('selectedPartyName').value = option?.dataset.personName || '';
                Array.from(txtParty.options).filter(item => item.dataset.centerContact === 'true').forEach(item => item.remove());
                if (option?.dataset.partyId) {
                    const contact = new Option(option.dataset.personName || 'Farm contact', option.dataset.partyId, true, true);
                    contact.dataset.centerContact = 'true';
                    txtParty.add(contact);
                } else txtParty.value = '';
                refreshSearchableSelect(txtParty);
                txtParty.dispatchEvent(new Event('change'));
            } else {
                const centerContactSelected = txtParty.selectedOptions[0]?.dataset.centerContact === 'true';
                Array.from(txtParty.options).filter(item => item.dataset.centerContact === 'true').forEach(item => item.remove());
                if (centerContactSelected) txtParty.value = '';
                refreshSearchableSelect(txtParty);
                txtParty.dispatchEvent(new Event('change'));
            }
        }
        document.querySelectorAll('input[name="PartyCategory"]').forEach(radio => radio.addEventListener('change', applyPartyType));
        txtFarm?.addEventListener('change', applyPartyType);
        applyPartyType();

        // Form Validation & SweetAlert Popup on Submit
        const form = document.getElementById('gatemanForm');
        const normalizeVehicleNumber = value => (value || '').toUpperCase().replace(/[\s-]+/g, '');
        const isValidIndianVehicleNumber = value => /^(?:[A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{1,4}|[0-9]{2}BH[0-9]{4}[A-Z]{1,2})$/.test(normalizeVehicleNumber(value));
        if (form) {
            form.addEventListener('submit', function (e) {
                const isTypeSelected = document.querySelector('input[name="InwardTypeId"]:checked');
                const partySelect = document.getElementById('txtPartyName');
                const isCenterParty = document.querySelector('input[name="PartyCategory"]:checked')?.value === '2';
                const partyId = isCenterParty ? txtFarm?.selectedOptions[0]?.dataset.partyId : partySelect?.value.trim();
                const partyLabel = isCenterParty ? (txtFarm?.selectedOptions[0]?.dataset.personName || '') : (partyId ? partySelect.options[partySelect.selectedIndex].text.trim() : '');
                const partyName = partyLabel.replace(/\s*\/\s*\d+\s*$/, '').trim();
                document.getElementById('selectedPartyName').value = partyName;
                const vehicleNo = document.getElementById('txtVehicleNo')?.value.trim();
                const driverName = document.getElementById('txtDriverName')?.value.trim();
                const gatemanDdl = document.getElementById('ddlGateman');

                let missingFields = [];

                if (!isTypeSelected) missingFields.push('Inward Type (With RST / Without RST)');
                if (!partyId) missingFields.push('Party / Supplier Name');
                if (isCenterParty && !txtFarm?.value) missingFields.push('Center / Farm');
                if (!vehicleNo) missingFields.push('Vehicle Number');
                if (!driverName) missingFields.push('Driver Name');
                if (gatemanDdl && !gatemanDdl.value) missingFields.push('Gateman (Added By)');

                if (missingFields.length > 0) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Validation Error!',
                        html: '<div class="text-start"><strong>Kripya sabhi zaroori fields ko fill karein:</strong><ul class="mt-2 text-danger">' + 
                              missingFields.map(f => '<li>' + f + '</li>').join('') + 
                              '</ul><small class="text-muted">(Only Remarks is optional)</small></div>',
                        icon: 'warning',
                        confirmButtonText: 'Okay, I will fill them',
                        confirmButtonColor: '#0d6efd'
                    });
                    return false;
                }
                if (!isValidIndianVehicleNumber(vehicleNo)) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Invalid Vehicle Number',
                        text: 'Valid Indian vehicle number enter karein, jaise UP63AT3088, DL1CAF5032 ya 22BH1234AA.',
                        icon: 'warning',
                        confirmButtonColor: '#07877c'
                    });
                    return false;
                }
            });
        }
    });
</script>



<script src="~/js/gateman-linked-selection.js" asp-append-version="true" defer></script>
