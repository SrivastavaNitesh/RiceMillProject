@model IEnumerable<RiceMillProject.Models.InwardHeader>
@{
    ViewData["Title"] = "Gate Entry & Inward Register";
    var newInward = ViewBag.NewInward as RiceMillProject.Models.InwardHeader ?? new RiceMillProject.Models.InwardHeader();
}

@try
{
<!-- Page Header -->
<div class="erp-page-header">
    <div class="erp-page-title-group">
        <div class="erp-page-icon">
            <i class="bi bi-door-open"></i>
        </div>
        <div>
            <h3 class="erp-page-title">GATE ENTRY FORM & INWARD REGISTER</h3>
            <p class="erp-page-subtitle">Vehicle inward registration, auto-numbering sequence, and pending weighment list</p>
        </div>
    </div>
    <span class="badge-erp badge-erp-info fs-6">Numbering Hierarchy: Inward No. &rarr; RST No.</span>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @ViewBag.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>


}

<!-- WORKFLOW & NUMBERING HIERARCHY OVERVIEW BANNER -->
<div class="erp-card bg-white p-3 mb-4 border-start border-4 border-primary shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="badge bg-primary text-white p-2 rounded"><i class="bi bi-1-circle me-1"></i> 1. GATE ENTRY</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-warning text-dark p-2 rounded"><i class="bi bi-2-circle me-1"></i> 2. WEIGHBRIDGE</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-info text-dark p-2 rounded"><i class="bi bi-3-circle me-1"></i> 3. SUPERVISOR</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-success text-white p-2 rounded"><i class="bi bi-4-circle me-1"></i> 4. FURTHER PROCESS</span>
            </div>
        </div>
        <div class="col-md-4 text-md-end border-start ps-4">
            <small class="text-muted d-block fw-bold">NUMBERING HIERARCHY</small>
            <span class="fw-bold text-primary">Inward No.</span> &rarr; <span class="fw-bold text-success">RST No.</span>
            <small class="d-block text-secondary">Ex: INW-2026-000125 &rarr; RST-2026-000458</small>
        </div>
    </div>
</div>

<div class="row">
    <!-- GATE ENTRY FORM (LEFT COLUMN) -->
    <div class="col-lg-8">
        <div class="erp-card">
            <div class="erp-card-header bg-primary text-white">
                <span><i class="bi bi-pencil-square me-2"></i> GATE ENTRY FORM (Create)</span>
            </div>
            <div class="erp-card-body">
                <form asp-action="CreateGateEntry" method="post" class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Gate Entry No.</label>
                        <input type="text" class="form-control bg-light" placeholder="[ Auto Generate: GE-2026-XXXXXX ]" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Driver Mobile No.</label>
                        <input name="DriverMobile" class="form-control" placeholder="9876543210" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Inward No. <span class="req-star">*</span></label>
                        <input type="text" class="form-control bg-light text-primary fw-bold" placeholder="[ Auto Generate: INW-2026-XXXXXX ]" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Purpose / Remarks</label>
                        <input name="PurposeRemarks" class="form-control" placeholder="Paddy Material Inward" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Inward Date <span class="req-star">*</span></label>
                        <input type="date" name="InwardDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Inward Time <span class="req-star">*</span></label>
                        <input type="text" name="InwardTime" class="form-control bg-light" value="@DateTime.Now.ToString("hh:mm tt")" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Challan No.</label>
                        <input name="ChallanNo" class="form-control" placeholder="CH-5689" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Gate / Gate No. <span class="req-star">*</span></label>
                        <select name="GateId" asp-items="@(ViewBag.Gates ?? Enumerable.Empty<SelectListItem>())" class="form-select" required>
                            <option value="">Select Gate</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">No. of Bags (Approx.)</label>
                        <input type="number" name="ApproxNoOfBags" class="form-control" placeholder="Bags count" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Inward Type <span class="req-star">*</span></label>
                        <select name="InwardTypeId" asp-items="@(ViewBag.InwardTypes ?? Enumerable.Empty<SelectListItem>())" class="form-select" required>
                            <option value="">Select Inward Type</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estimated Weight (Approx. KG)</label>
                        <input type="number" step="0.01" name="ApproxWeight" class="form-control" placeholder="Approx KG" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Party / Supplier <span class="req-star">*</span></label>
                        <select name="PartyId" asp-items="@(ViewBag.Parties ?? Enumerable.Empty<SelectListItem>())" class="form-select" required>
                            <option value="">Select Party / Supplier</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gate In Date & Time</label>
                        <input type="text" class="form-control bg-light" value="@DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Transporter Name</label>
                        <input name="TransporterName" class="form-control" placeholder="Enter Transporter Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gate Man / Created By</label>
                        <input type="text" class="form-control bg-light" value="@(User?.Identity?.Name ?? "System") (System)" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vehicle No. <span class="req-star">*</span></label>
                        <input name="VehicleNo" class="form-control" placeholder="UP65AB1234" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <input type="text" class="form-control bg-light text-success fw-bold" value="Active / Pending" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vehicle Type <span class="req-star">*</span></label>
                        <select name="VehicleTypeId" asp-items="@(ViewBag.VehicleTypes ?? Enumerable.Empty<SelectListItem>())" class="form-select" required>
                            <option value="">Select Vehicle Type</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Remarks</label>
                        <input name="PurposeRemarks" class="form-control" placeholder="Enter Remarks (Optional)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Driver Name <span class="req-star">*</span></label>
                        <input name="DriverName" class="form-control" placeholder="Ramesh Kumar" required />
                    </div>

                    <div class="col-12 text-start mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn-erp-primary px-4 py-2"><i class="bi bi-floppy me-1"></i> SAVE (Generate Inward No.)</button>
                        <button type="reset" class="btn-erp-secondary px-4 py-2"><i class="bi bi-arrow-counterclockwise me-1"></i> RESET</button>
                        <button type="button" class="btn-erp-outline px-4 py-2"><i class="bi bi-x-lg me-1"></i> CANCEL</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MASTERS & AUTO GENERATION RULES (RIGHT COLUMN) -->
    <div class="col-lg-4">
        <!-- MASTERS SUMMARY CARD -->
        <div class="erp-card mb-3">
            <div class="erp-card-header bg-dark text-white">
                <span><i class="bi bi-boxes me-2"></i> MASTERS SUMMARY</span>
            </div>
            <div class="erp-card-body p-3">
                <div class="mb-3">
                    <strong class="d-block text-primary small text-uppercase">1. Inward Type Master</strong>
                    <span class="badge bg-light text-dark border me-1">Paddy Inward (RST: Yes)</span>
                    <span class="badge bg-light text-dark border">Spare Parts (RST: No)</span>
                </div>
                <div class="mb-3">
                    <strong class="d-block text-primary small text-uppercase">2. Vehicle Type Master</strong>
                    <span class="badge bg-light text-dark border me-1">Truck</span>
                    <span class="badge bg-light text-dark border me-1">Tractor</span>
                    <span class="badge bg-light text-dark border me-1">Trolley</span>
                    <span class="badge bg-light text-dark border">Mini Truck</span>
                </div>
                <div class="mb-3">
                    <strong class="d-block text-primary small text-uppercase">3. Gate Master</strong>
                    <span class="badge bg-light text-dark border me-1">Main Gate (GATE-01)</span>
                    <span class="badge bg-light text-dark border">Side Gate (GATE-02)</span>
                </div>
                <div>
                    <strong class="d-block text-primary small text-uppercase">4. Status Master</strong>
                    <span class="badge bg-success-subtle text-success me-1">Active</span>
                    <span class="badge bg-danger-subtle text-danger me-1">Cancelled</span>
                    <span class="badge bg-warning-subtle text-warning">Pending</span>
                </div>
            </div>
        </div>

        <!-- AUTO GENERATION RULES CARD -->
        <div class="erp-card mb-3 bg-warning-subtle border-warning">
            <div class="erp-card-header bg-warning text-dark font-weight-bold">
                <span><i class="bi bi-magic me-2"></i> AUTO GENERATION RULES</span>
            </div>
            <div class="erp-card-body p-3 small text-dark">
                <p class="mb-1"><strong>1. Gate Entry No. Format:</strong> <code>GE-YYYY-######</code><br /><span class="text-muted">(Example: GE-2026-000125)</span></p>
                <p class="mb-1"><strong>2. Inward No. Format:</strong> <code>INW-YYYY-######</code><br /><span class="text-muted">(Example: INW-2026-000125)</span></p>
                <p class="mb-0"><strong>3. RST No. Format:</strong> <code>RST-YYYY-######</code><br /><span class="text-muted">(Generated in Weighbridge after Gross Weight)</span></p>
            </div>
        </div>

        <!-- IMPORTANT NOTES CARD -->
        <div class="erp-card bg-info-subtle border-info">
            <div class="erp-card-header bg-info text-white">
                <span><i class="bi bi-info-circle me-2"></i> IMPORTANT NOTES</span>
            </div>
            <div class="erp-card-body p-3 small text-dark">
                <ol class="ps-3 mb-0">
                    <li>Inward No. Gate Entry save karte hi generate hoga.</li>
                    <li>Weighbridge form me Inward No. dropdown mandatory hoga.</li>
                    <li>Dropdown me sirf wahi Inward dikhega jinka <strong>RST Required = Yes</strong> aur RST abhi generate nahi hua hai.</li>
                    <li>Inward ek baar RST generate hone ke baad dobara Weighbridge list me nahi dikhega.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- PENDING INWARD LIST (RST REQUIRED) -->
<div class="erp-card mt-4">
    <div class="erp-card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark"><i class="bi bi-clock-history text-primary me-2"></i> PENDING INWARD LIST (RST Required)</span>
        <div class="d-flex align-items-center gap-2">
            <small class="text-muted">Only Inward Type with RST Required = Yes and not yet RST Generated will be visible in Weighbridge dropdown.</small>
        </div>
    </div>
    <div class="erp-card-body p-0">
        <div class="table-responsive">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th class="ps-4">Inward No.</th>
                        <th>Inward Date</th>
                        <th>Vehicle No.</th>
                        <th>Party / Supplier</th>
                        <th>Inward Type</th>
                        <th>Gate In Time</th>
                        <th>Status</th>
                        <th class="text-end pe-4">RST Generated</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.InwardNo</td>
                                <td>@item.InwardDate.ToString("dd/MM/yyyy")</td>
                                <td><strong class="text-dark">@item.VehicleNo</strong></td>
                                <td>@item.PartyName</td>
                                <td><span class="badge-erp badge-erp-info">@item.InwardTypeName</span></td>
                                <td>@item.InwardTime</td>
                                <td>
                                    @if (item.StatusName == "Pending")
                                    {
                                        <span class="badge-erp badge-erp-warning">Pending</span>
                                    }
                                    else if (item.StatusName == "Processed")
                                    {
                                        <span class="badge-erp badge-erp-success">Processed</span>
                                    }
                                    else
                                    {
                                        <span class="badge-erp badge-erp-danger">@item.StatusName</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.IsRSTGenerated)
                                    {
                                        <span class="badge-erp badge-erp-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge-erp badge-erp-danger">No</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No pending inward records. Fill form above to generate.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

}
catch (Exception ex)
{
    <div class="alert alert-danger mt-4">
        <h4>View Render Error</h4>
        <pre>@ex.ToString()</pre>
    </div>
}


